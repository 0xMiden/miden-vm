# See Cargo.toml.orig for the original contents.

[package]
edition = "2024"
name = "p3-security"
version = "0.8.0"
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "Soundness analysis for STARK protocols: per-error-source modules composed at the protocol call site."
homepage = "https://github.com/Plonky3/Plonky3"
readme = false
keywords = [
    "cryptography",
    "SNARK",
    "PLONK",
    "FRI",
    "plonky3",
]
categories = ["cryptography::cryptocurrencies"]
license = "MIT OR Apache-2.0"
repository = "https://github.com/Plonky3/Plonky3"
resolver = "2"

[lib]
name = "p3_security"
path = "src/lib.rs"

[[test]]
name = "budget_parity"
path = "tests/budget_parity.rs"

[dependencies.libm]
version = "0.2"

[dependencies.p3-air]
version = "0.8.0"

[dependencies.p3-commit]
version = "0.8.0"

[dependencies.p3-field]
version = "0.8.0"

[dependencies.serde]
version = "1.0"
features = [
    "derive",
    "alloc",
]
default-features = false

[dependencies.thiserror]
version = "2.0"
default-features = false

[dev-dependencies.proptest]
version = "1.11"
features = ["std"]
default-features = false

[lints.clippy]
cognitive_complexity = "allow"
match_bool = "warn"
needless_pass_by_value = "warn"
redundant_pub_crate = "allow"
semicolon_if_nothing_returned = "warn"
too_long_first_doc_paragraph = "allow"
transmute_undefined_repr = "allow"
tuple_array_conversions = "allow"
unused_peekable = "allow"

[lints.clippy.all]
level = "warn"
priority = -1

[lints.clippy.nursery]
level = "warn"
priority = -1

[lints.rust]
rust_2024_incompatible_pat = "warn"
unused_must_use = "deny"

[lints.rust.rust_2018_idioms]
level = "deny"
priority = -1

[lints.rustdoc]
all = "warn"
