use miden::core::crypto::hashes::poseidon2
use miden::core::stark::constants
use miden::core::stark::constraints_eval_inputs
use miden::core::sys::pvm::layout

# CONSTANTS
# =================================================================================================

# Number of READ variables (inputs + constants) for the constraint evaluation circuit.
const NUM_INPUTS_CIRCUIT = 3104

# Number of evaluation gates in the constraint evaluation circuit
const NUM_EVAL_GATES_CIRCUIT = 10776

# Max cycle length for periodic columns
const MAX_CYCLE_LEN_LOG = 7

# Depth of the ACE circuit registry tree.
const ACE_REGISTRY_DEPTH = 22

# Number of valid proof-order tags (n! for n AIRs); higher slots are registry
# padding and must never be opened.
const ORDER_TAG_COUNT = 3628800

# Number of AIR instances in the relation.
const NUM_AIRS = 10

# Number of 8-felt blocks in each authenticated ACE circuit segment.
const ACE_PREFIX_BLOCKS = 571
const ACE_COMMON_BLOCKS = 1153

# Quotient recomposition inputs derived from the circuit's quotient arity and the
# relation's PCS configuration. QUOTIENT_SHIFT_RATIO depends on arity;
# QUOTIENT_FIRST_SHIFT depends on the canonical LDE shift and blowup; and
# QUOTIENT_FIRST_WEIGHT depends on both.
const QUOTIENT_SHIFT_RATIO = 281474976710656
const QUOTIENT_FIRST_SHIFT = 5473358340599679662
const QUOTIENT_FIRST_WEIGHT = 2704820172613542122

# Poseidon2 digest of the order-invariant common section of the ACE circuit stream
# (common ops + root padding). The registry leaf for each ORDER_TAG is
# merge(H(constants | shuffle ops), ACE_COMMON_COMMITMENT).
const ACE_COMMON_COMMITMENT_0 = 1403200468606935903
const ACE_COMMON_COMMITMENT_1 = 5714843646797225662
const ACE_COMMON_COMMITMENT_2 = 2825901234706956285
const ACE_COMMON_COMMITMENT_3 = 569582642252275992

# ERRORS
# =================================================================================================

const ERR_CIRCUIT_COMMITMENT_MISMATCH = "merged ACE circuit segment digests do not match the registry commitment"

const ERR_COMMON_SECTION_MISMATCH = "common ACE circuit section does not match the compiled-in digest"

# CONSTRAINT EVALUATION CHECKER
# =================================================================================================

#! Executes the constraints evaluation check for the proof order selected by ORDER_TAG.
#!
#! Inputs:  []
#! Outputs: []
pub proc execute_constraint_evaluation_check()
    push.ORDER_TAG_COUNT exec.constants::assert_valid_order_tag

    push.QUOTIENT_SHIFT_RATIO
    push.QUOTIENT_FIRST_SHIFT
    push.QUOTIENT_FIRST_WEIGHT
    exec.layout::auxiliary_ace_inputs_ptr
    exec.constants::air_trace_length_logs_ptr
    push.NUM_AIRS
    push.MAX_CYCLE_LEN_LOG
    exec.constraints_eval_inputs::set_up_auxiliary_inputs_ace

    exec.load_and_authenticate_ace_circuit

    push.NUM_EVAL_GATES_CIRCUIT
    push.NUM_INPUTS_CIRCUIT
    exec.constants::public_inputs_address_ptr mem_load
    eval_circuit
    drop drop drop
end

#! Loads and authenticates the ACE circuit selected by ORDER_TAG.
#!
#! The circuit stream is factored into two adv_pipe-aligned segments: a per-order
#! prefix [constants | shuffle ops] and an order-invariant common section
#! [common ops | root padding]. Both are hashed separately; the common digest is
#! pinned to the compiled-in ACE_COMMON_COMMITMENT, and the registry leaf
#! selected by ORDER_TAG must equal
#! merge(PREFIX_COMMITMENT, ACE_COMMON_COMMITMENT).
proc load_and_authenticate_ace_circuit
    exec.load_ace_registry_commitment
    # => [LEAF]
    adv.push_mapval
    exec.layout::ace_circuit_stream_ptr
    padw padw padw
    # => [ZERO, ZERO, ZERO, ptr, LEAF]
    repeat.ACE_PREFIX_BLOCKS
        adv_pipe
        exec.poseidon2::permute
    end
    exec.poseidon2::squeeze_digest
    # => [PREFIX_COMMITMENT, ptr, LEAF]
    movup.4
    # => [ptr, PREFIX_COMMITMENT, LEAF]
    padw padw padw
    repeat.ACE_COMMON_BLOCKS
        adv_pipe
        exec.poseidon2::permute
    end
    exec.poseidon2::squeeze_digest
    # => [COMMON_COMMITMENT, ptr, PREFIX_COMMITMENT, LEAF]
    movup.4 drop
    # => [COMMON_COMMITMENT, PREFIX_COMMITMENT, LEAF]
    dupw push.ACE_COMMON_COMMITMENT_3.ACE_COMMON_COMMITMENT_2.ACE_COMMON_COMMITMENT_1.ACE_COMMON_COMMITMENT_0
    assert_eqw.err=ERR_COMMON_SECTION_MISMATCH
    # => [COMMON_COMMITMENT, PREFIX_COMMITMENT, LEAF]
    swapw
    # => [PREFIX_COMMITMENT, COMMON_COMMITMENT, LEAF]
    exec.poseidon2::merge
    # => [CIRCUIT_COMMITMENT, LEAF]
    assert_eqw.err=ERR_CIRCUIT_COMMITMENT_MISMATCH
end

#! Loads the ACE circuit commitment selected by ORDER_TAG from the registry tree.
proc load_ace_registry_commitment
    padw exec.constants::ace_registry_root_ptr mem_loadw_le
    exec.constants::get_order_tag
    push.ACE_REGISTRY_DEPTH
    mtree_get
    swapw dropw
end
