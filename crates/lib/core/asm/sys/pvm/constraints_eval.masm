use miden::core::crypto::hashes::eidos
use {
    CONSTRAINT_COMPOSITION_COEFS_PTR,
    LOG_AIR_TRACE_LENGTHS_PTR,
    PUBLIC_INPUTS_ADDRESS_PTR,
} from miden::core::stark::constants
use miden::core::stark::constraints_eval_inputs
use miden::core::sys::pvm::layout

# ERRORS
# =================================================================================================

const ERR_CIRCUIT_DIGEST_MISMATCH = "ACE circuit stream does not match the compiled-in circuit digest"

# CONSTRAINT EVALUATION CHECKER
# =================================================================================================

#! Executes the constraints evaluation check.
#!
#! Inputs:  []
#! Outputs: []
pub proc execute_constraint_evaluation_check()
    exec.layout::quotient_shift_ratio
    exec.layout::quotient_first_shift
    exec.layout::quotient_first_weight
    exec.layout::auxiliary_ace_inputs_ptr
    push.LOG_AIR_TRACE_LENGTHS_PTR
    exec.layout::num_airs
    exec.layout::max_cycle_len_log
    exec.constraints_eval_inputs::set_up_auxiliary_inputs_ace

    exec.stage_air_fold_coefficients

    exec.load_and_authenticate_ace_circuit

    exec.layout::num_eval_gates_circuit
    exec.layout::num_inputs_circuit
    mem_load.PUBLIC_INPUTS_ADDRESS_PTR
    eval_circuit
    drop drop drop
end

#! Loads the ACE circuit from the advice map and pins it to the compiled-in digest.
#!
#! The stream is one adv_pipe-aligned segment hashed in a single pass. Its digest is both
#! the advice-map key the stream is fetched under and the value the hash must reproduce,
#! so a stream that is not the accepted circuit fails here rather than mis-evaluating.
proc load_and_authenticate_ace_circuit
    exec.layout::ace_circuit_digest
    # => [ACE_CIRCUIT_DIGEST]
    adv.push_mapval
    exec.layout::ace_circuit_stream_ptr
    exec.layout::ace_stream_init_cv
    padw padw
    # => [ZERO, ZERO, CV, ptr, ACE_CIRCUIT_DIGEST]
    exec.layout::ace_loader_ptr dynexec
    exec.eidos::digest
    # => [STREAM_DIGEST, ptr, ACE_CIRCUIT_DIGEST]
    movup.4 drop
    # => [STREAM_DIGEST, ACE_CIRCUIT_DIGEST]
    assert_eqw.err=ERR_CIRCUIT_DIGEST_MISMATCH
end

#! Stages AIR k's multi-AIR fold coefficient `beta^(NUM_AIRS - 1 - pos_k)` in its READ slot.
#!
#! The native verifier folds the per-AIR roots as a Horner chain over the height-sorted proof
#! order, so the AIR opened last carries `beta^0` and the one opened first
#! `beta^(NUM_AIRS - 1)`. Walking `id_by_pos` from the last proof position to the first
#! produces every power with one multiplication between consecutive positions; each is written
#! to the slot of whichever AIR sits at that position. `beta` is sampled after the auxiliary
#! trace, so this runs after `set_up_auxiliary_inputs_ace`, and the proof-order pass
#! must already have filled `id_by_pos`.
#!
#! Inputs:  []
#! Outputs: []
@locals(1)
proc stage_air_fold_coefficients
    exec.layout::proof_order_ids_ptr
    exec.layout::air_fold_coefficients_ptr
    padw mem_loadw_le.CONSTRAINT_COMPOSITION_COEFS_PTR drop drop
    push.0.1
    # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    # Only the full relation has twelve AIRs (checked by the regeneration tool).
    exec.layout::num_airs eq.12
    if.true
        # Each step copies its coefficient and destination before storing c0 then c1.
        # proof position 11: coefficient beta^0 to that AIR's slot
        dup.5 add.11 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 10: coefficient beta^1 to that AIR's slot
        dup.5 add.10 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 9: coefficient beta^2 to that AIR's slot
        dup.5 add.9 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 8: coefficient beta^3 to that AIR's slot
        dup.5 add.8 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 7: coefficient beta^4 to that AIR's slot
        dup.5 add.7 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 6: coefficient beta^5 to that AIR's slot
        dup.5 add.6 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 5: coefficient beta^6 to that AIR's slot
        dup.5 add.5 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 4: coefficient beta^7 to that AIR's slot
        dup.5 add.4 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 3: coefficient beta^8 to that AIR's slot
        dup.5 add.3 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 2: coefficient beta^9 to that AIR's slot
        dup.5 add.2 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 1: coefficient beta^10 to that AIR's slot
        dup.5 add.1 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.3 dup.3 ext2mul
        # proof position 0: coefficient beta^11 to that AIR's slot
        dup.5 mem_load mul.2 dup.5 add
        # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
        dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
        # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    else
        exec.layout::num_airs loc_store.0
        push.1
        while.true
            dup.5 loc_load.0 sub.1 add mem_load mul.2 dup.5 add
            dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
            dup.3 dup.3 ext2mul
            loc_load.0 sub.1 dup loc_store.0 neq.0
        end
    end
    drop drop drop drop drop drop
end
