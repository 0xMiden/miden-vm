#! Loads the ACE circuit from the advice map and pins it to the compiled-in digest.
#!
#! The stream is one adv_pipe-aligned segment hashed in a single pass. Its digest is both
#! the advice-map key the stream is fetched under and the value the hash must reproduce,
#! so a stream that is not the accepted circuit fails here rather than mis-evaluating.
proc load_and_authenticate_ace_circuit
    push.ACE_CIRCUIT_DIGEST_3.ACE_CIRCUIT_DIGEST_2.ACE_CIRCUIT_DIGEST_1.ACE_CIRCUIT_DIGEST_0
    # => [ACE_CIRCUIT_DIGEST]
    adv.push_mapval
    exec.layout::ace_circuit_stream_ptr
    push.ACE_STREAM_INIT_CV_3.ACE_STREAM_INIT_CV_2.ACE_STREAM_INIT_CV_1.ACE_STREAM_INIT_CV_0
    padw padw
    # => [ZERO, ZERO, CV, ptr, ACE_CIRCUIT_DIGEST]
    repeat.ACE_STREAM_BLOCKS
        adv_pipe
        exec.eidos::compress
    end
    exec.eidos::digest
    # => [STREAM_DIGEST, ptr, ACE_CIRCUIT_DIGEST]
    movup.4 drop
    # => [STREAM_DIGEST, ACE_CIRCUIT_DIGEST]
    assert_eqw.err=ERR_CIRCUIT_DIGEST_MISMATCH
end

