    assert_eqw.err=MAIN_LEAF_VALUE_MISMATCH
    dropw
end

proc load_main_trace( state: types::EidosState, evaluation: types::HornerState, ) -> (types::EidosState, types::HornerState)
    repeat.MAIN_ROW_DOUBLE_WORDS
        adv_pipe
        horner_eval_base
