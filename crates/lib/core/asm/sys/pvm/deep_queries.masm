use miden::core::stark::deep_queries
use miden::core::sys::pvm::layout

const PREPROCESSED_TREE_DEPTH = 19
const PREPROCESSED_INDEX_MASK = 524287
const PREPROCESSED_ROW_DOUBLE_WORDS = 1
const MAIN_ROW_DOUBLE_WORDS = 73
const AUX_ROW_DOUBLE_WORDS = 39
const QUOTIENT_ROW_DOUBLE_WORDS = 1
const PREPROCESSED_LEAF_VALUE_MISMATCH = "preprocessed query leaf hash mismatch"
const MAIN_LEAF_VALUE_MISMATCH = "main query leaf hash mismatch"
const AUX_LEAF_VALUE_MISMATCH = "aux query leaf hash mismatch"
const QUOTIENT_LEAF_VALUE_MISMATCH = "quotient query leaf hash mismatch"
const PREPROCESSED_LMCS_INIT_CV = [13503953893947607809, 11912009168875159560, 11170449401267093504, 6620516959492505600]
const MAIN_LMCS_INIT_CV = [13503953893947607809, 11912009168875160136, 11170449401267093504, 6620516959492505600]
const AUX_LMCS_INIT_CV = [13503953893947607809, 11912009168875159864, 11170449401267093504, 6620516959492505600]
const QUOTIENT_LMCS_INIT_CV = [13503953893947607809, 11912009168875159560, 11170449401267093504, 6620516959492505600]

#! Authenticate each row before generic DEEP evaluation.
pub proc compute_deep_composition_polynomial_queries( scratch: word, query_ptr: ptr<word>, query_end_ptr: ptr<word>, fixed_terms: types::EvaluationPair, queries_start: ptr<word>, )
    push.1
    while.true
        exec.load_query_row
        exec.deep_queries::compute_deep_query
    end
    dropw
    dropw
    drop
    drop
    drop
end

#! Preserve preprocessed, main, auxiliary and quotient opening order.
proc load_query_row( scratch: word, query_ptr: ptr<word>, ) -> (word, types::EvaluationPair, u32, ptr<word>)
    exec.process_preprocessed_trace
    exec.process_main_trace
    exec.process_aux_trace
    exec.process_quotient_trace
    swapw
    drop
    drop
    dup.1
    dup.1
    swapw
end

proc process_preprocessed_trace( scratch: word, query_ptr: ptr<word>, ) -> (word, types::HornerState, u8, u32, ptr<word>)
    dup.4
    mem_loadw_le
    movdn.3
    movdn.2
    push.0.0
    exec.layout::preprocessed_com_ptr
    mem_loadw_le
    dup.5
    push.PREPROCESSED_INDEX_MASK
    u32and
    push.PREPROCESSED_TREE_DEPTH
    mtree_get
    mem_storew_le.TMP3_PTR
    adv.push_mapval
    mem_loadw_le.TMP2_PTR
    swapw
    push.PREPROCESSED_LMCS_INIT_CV
    swapw
    padw
    exec.load_preprocessed_trace
    swapw.2
    padw
    mem_loadw_le.TMP3_PTR
    assert_eqw.err=PREPROCESSED_LEAF_VALUE_MISMATCH
    dropw
end

proc load_preprocessed_trace( state: types::EidosState, evaluation: types::HornerState, ) -> (types::EidosState, types::HornerState)
    repeat.PREPROCESSED_ROW_DOUBLE_WORDS
        adv_pipe
        horner_eval_base
        exec.eidos::compress
    end
end

proc process_main_trace( scratch: word, evaluation: types::HornerState, depth: u8, index: u32, query_ptr: ptr<word>, ) -> (word, types::HornerState, u8, u32, ptr<word>)
    mem_loadw_le.MAIN_TRACE_COM_PTR
    dup.9
