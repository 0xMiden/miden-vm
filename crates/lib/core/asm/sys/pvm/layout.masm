### PVM relation memory layout.
###
### Public values and scratch have fixed addresses. The dense ACE READ boundaries and trusted
### relation shapes are selected by `variants::load`, which initializes the metadata below.
### Scratch retains the full relation's allocation, so every supported configuration fits.

use miden::core::stark::types

### 8 felts: 3225432064..3225432072.
const PUBLIC_INPUTS_PTR = 3225432064

### 4 felts: 3225450336..3225450340. Stores gamma = beta^18.
const BUS_GAMMA_PTR = 3225450336

### 4 felts: 3225450340..3225450344. Stores the two-felt fixed-boundary correction; the remaining two felts are reserved.
const C_TOTAL_PTR = 3225450340

### 968 felts: 3225450344..3225451312. Stores one opened query row in commitment-group order.
const CURRENT_TRACE_ROW_PTR = 3225450344

### 4 felts: 3225451312..3225451316. Stores the trusted preprocessed-tree commitment for DEEP openings.
const PREPROCESSED_COM_PTR = 3225451312

### 96 felts: 3225451316..3225451412. Out-of-domain ingest scatter table:
###
###   +0            base address of the out-of-domain row being ingested
###   +4  .. +51    per proof position, in stream order: (row-relative destination, digest address)
###   +52 .. +95    `pipe_k` procedure digests reached by `dynexec`, one word each
###
### The internal offsets and the reserve's sufficiency are owned by the regeneration tool,
### which derives them from the chiplet widths and fills `sys/pvm/ood_frames.masm`
### accordingly.
const OOD_SCATTER_TABLE_PTR = 3225451316

### 12 felts: 3225451412..3225451424. `pos_by_id`: the position of each
### selected chiplet, in canonical order, within the height-sorted proof order.
### The first `num_airs` cells are live.
### Staged once per proof by `sys/pvm/ood_frames.masm::stage_proof_order_maps`; read by both
### ingest scatters.
const PROOF_ORDER_POSITIONS_PTR = 3225451412

### 12 felts: 3225451424..3225451436. `id_by_pos`: the
### canonical index committed at each proof position. Staged with `pos_by_id`;
### read by the reverse fold-coefficient walk in `sys/pvm/constraints_eval.masm`.
const PROOF_ORDER_IDS_PTR = 3225451424

pub proc public_inputs_ptr() -> types::Address
    push.PUBLIC_INPUTS_PTR
end

pub proc bus_gamma_ptr() -> types::Address
    push.BUS_GAMMA_PTR
end

pub proc c_total_ptr() -> types::Address
    push.C_TOTAL_PTR
end

pub proc current_trace_row_ptr() -> types::Address
    push.CURRENT_TRACE_ROW_PTR
end

pub proc preprocessed_com_ptr() -> types::Address
    push.PREPROCESSED_COM_PTR
end

pub proc ood_scatter_table_ptr() -> types::Address
    push.OOD_SCATTER_TABLE_PTR
end

pub proc proof_order_positions_ptr() -> types::Address
    push.PROOF_ORDER_POSITIONS_PTR
end

pub proc proof_order_ids_ptr() -> types::Address
    push.PROOF_ORDER_IDS_PTR
end

