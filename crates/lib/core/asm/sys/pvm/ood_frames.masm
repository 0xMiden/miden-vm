    movup.5 u32and.15 push.1 dup.1 dup.5 add mem_store    # position 1 => [id1, id2, id3, pos_ptr, ids_ptr, sorted0, sorted4, sorted5, sorted6, sorted7, sorted8, sorted9, sorted10]
    movup.5 u32and.15 push.0 dup.1 dup.6 add mem_store dup.5 mem_storew_le dropw    # position 0 => [pos_ptr, ids_ptr, sorted4, sorted5, sorted6, sorted7, sorted8, sorted9, sorted10]
    movup.5 u32and.15 push.7 dup.1 dup.3 add mem_store    # position 7 => [id7, pos_ptr, ids_ptr, sorted4, sorted5, sorted6, sorted8, sorted9, sorted10]
    movup.5 u32and.15 push.6 dup.1 dup.4 add mem_store    # position 6 => [id6, id7, pos_ptr, ids_ptr, sorted4, sorted5, sorted8, sorted9, sorted10]
    movup.5 u32and.15 push.5 dup.1 dup.5 add mem_store    # position 5 => [id5, id6, id7, pos_ptr, ids_ptr, sorted4, sorted8, sorted9, sorted10]
    movup.5 u32and.15 push.4 dup.1 dup.6 add mem_store dup.5 add.4 mem_storew_le dropw    # position 4 => [pos_ptr, ids_ptr, sorted8, sorted9, sorted10]
    movup.2 u32and.15 dup dup.3 add.8 mem_store push.8 dup.1 dup.3 add mem_store drop    # position 8 => [pos_ptr, ids_ptr, sorted9, sorted10]
    movup.2 u32and.15 dup dup.3 add.9 mem_store push.9 dup.1 dup.3 add mem_store drop    # position 9 => [pos_ptr, ids_ptr, sorted10]
    movup.2 u32and.15 dup dup.3 add.10 mem_store push.10 dup.1 dup.3 add mem_store drop    # position 10 => [pos_ptr, ids_ptr]
    drop drop
end
#! Derives the height-sorted proof order once and materializes its two inverse maps.
#!
#! Packs each AIR's key as `16 * log_height + instance_index`, sorts the keys with a fixed
#! 41-comparator network (data-oblivious: one `cswap` per comparator), and unpacks them into
#! `id_by_pos` (instance index at each proof position) and `pos_by_id` (proof position of each
#! instance). Equal heights order by instance index, exactly like the native `TraceOrder`.
#!
#! Must run after every height has been bounded; keys are compared as u32 values.
#!
#! Inputs:  []
#! Outputs: []
#! Invocation: exec
proc stage_proof_order_maps_12()
    # keys: [k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11]
    push.LOG_AIR_TRACE_LENGTHS_PTR dup add.11 mem_load mul.16 add.11 dup.1 add.10 mem_load mul.16 add.10 dup.2 add.9 mem_load mul.16 add.9 dup.3 add.8 mem_load mul.16 add.8 dup.4 add.7 mem_load mul.16 add.7 dup.5 add.6 mem_load mul.16 add.6 dup.6 add.5 mem_load mul.16 add.5 dup.7 add.4 mem_load mul.16 add.4 dup.8 add.3 mem_load mul.16 add.3 dup.9 add.2 mem_load mul.16 add.2 dup.10 add.1 mem_load mul.16 add.1 dup.11 mem_load mul.16 movup.12 drop
    # 41 compare-exchanges; each leaves the smaller key at the lower index.
    movup.8 swap dup.1 dup.1 u32lt cswap swap movdn.8    # (0, 8)
    movup.9 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.9    # (1, 9)
    movup.10 movup.3 dup.1 dup.1 u32lt cswap movdn.3 movdn.10    # (2, 10)
    movup.11 movup.4 dup.1 dup.1 u32lt cswap movdn.4 movdn.11    # (3, 11)
    movup.4 swap dup.1 dup.1 u32lt cswap swap movdn.4    # (0, 4)
    movup.5 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.5    # (1, 5)
    movup.6 movup.3 dup.1 dup.1 u32lt cswap movdn.3 movdn.6    # (2, 6)
    movup.7 movup.4 dup.1 dup.1 u32lt cswap movdn.4 movdn.7    # (3, 7)
    movup.8 movup.5 dup.1 dup.1 u32lt cswap movdn.5 movdn.8    # (4, 8)
    movup.9 movup.6 dup.1 dup.1 u32lt cswap movdn.6 movdn.9    # (5, 9)
    movup.10 movup.7 dup.1 dup.1 u32lt cswap movdn.7 movdn.10    # (6, 10)
    movup.11 movup.8 dup.1 dup.1 u32lt cswap movdn.8 movdn.11    # (7, 11)
    movup.2 swap dup.1 dup.1 u32lt cswap swap movdn.2    # (0, 2)
    movup.3 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.3    # (1, 3)
    movup.6 movup.5 dup.1 dup.1 u32lt cswap movdn.5 movdn.6    # (4, 6)
    movup.7 movup.6 dup.1 dup.1 u32lt cswap movdn.6 movdn.7    # (5, 7)
    movup.10 movup.9 dup.1 dup.1 u32lt cswap movdn.9 movdn.10    # (8, 10)
    movup.11 movup.10 dup.1 dup.1 u32lt cswap movdn.10 movdn.11    # (9, 11)
    movup.8 movup.3 dup.1 dup.1 u32lt cswap movdn.3 movdn.8    # (2, 8)
    movup.9 movup.4 dup.1 dup.1 u32lt cswap movdn.4 movdn.9    # (3, 9)
    movup.4 movup.3 dup.1 dup.1 u32lt cswap movdn.3 movdn.4    # (2, 4)
    movup.5 movup.4 dup.1 dup.1 u32lt cswap movdn.4 movdn.5    # (3, 5)
    movup.8 movup.7 dup.1 dup.1 u32lt cswap movdn.7 movdn.8    # (6, 8)
    movup.9 movup.8 dup.1 dup.1 u32lt cswap movdn.8 movdn.9    # (7, 9)
    dup.1 dup.1 u32lt cswap    # (0, 1)
    movup.3 movup.3 dup.1 dup.1 u32lt cswap movdn.3 movdn.3    # (2, 3)
    movup.5 movup.5 dup.1 dup.1 u32lt cswap movdn.5 movdn.5    # (4, 5)
    movup.7 movup.7 dup.1 dup.1 u32lt cswap movdn.7 movdn.7    # (6, 7)
    movup.9 movup.9 dup.1 dup.1 u32lt cswap movdn.9 movdn.9    # (8, 9)
    movup.11 movup.11 dup.1 dup.1 u32lt cswap movdn.11 movdn.11    # (10, 11)
    movup.8 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.8    # (1, 8)
    movup.10 movup.4 dup.1 dup.1 u32lt cswap movdn.4 movdn.10    # (3, 10)
    movup.4 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.4    # (1, 4)
    movup.6 movup.4 dup.1 dup.1 u32lt cswap movdn.4 movdn.6    # (3, 6)
    movup.8 movup.6 dup.1 dup.1 u32lt cswap movdn.6 movdn.8    # (5, 8)
    movup.10 movup.8 dup.1 dup.1 u32lt cswap movdn.8 movdn.10    # (7, 10)
    movup.2 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.2    # (1, 2)
    movup.4 movup.4 dup.1 dup.1 u32lt cswap movdn.4 movdn.4    # (3, 4)
    movup.6 movup.6 dup.1 dup.1 u32lt cswap movdn.6 movdn.6    # (5, 6)
    movup.8 movup.8 dup.1 dup.1 u32lt cswap movdn.8 movdn.8    # (7, 8)
    movup.10 movup.10 dup.1 dup.1 u32lt cswap movdn.10 movdn.10    # (9, 10)
    # => [pos_ptr, ids_ptr, sorted0, sorted1, sorted2, sorted3, sorted4, sorted5, sorted6, sorted7, sorted8, sorted9, sorted10, sorted11]
    exec.layout::proof_order_ids_ptr exec.layout::proof_order_positions_ptr
    # Unpack each sorted key into the maps.
    movup.5 u32and.15 push.3 dup.1 dup.3 add mem_store    # position 3 => [id3, pos_ptr, ids_ptr, sorted0, sorted1, sorted2, sorted4, sorted5, sorted6, sorted7, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.2 dup.1 dup.4 add mem_store    # position 2 => [id2, id3, pos_ptr, ids_ptr, sorted0, sorted1, sorted4, sorted5, sorted6, sorted7, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.1 dup.1 dup.5 add mem_store    # position 1 => [id1, id2, id3, pos_ptr, ids_ptr, sorted0, sorted4, sorted5, sorted6, sorted7, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.0 dup.1 dup.6 add mem_store dup.5 mem_storew_le dropw    # position 0 => [pos_ptr, ids_ptr, sorted4, sorted5, sorted6, sorted7, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.7 dup.1 dup.3 add mem_store    # position 7 => [id7, pos_ptr, ids_ptr, sorted4, sorted5, sorted6, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.6 dup.1 dup.4 add mem_store    # position 6 => [id6, id7, pos_ptr, ids_ptr, sorted4, sorted5, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.5 dup.1 dup.5 add mem_store    # position 5 => [id5, id6, id7, pos_ptr, ids_ptr, sorted4, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.4 dup.1 dup.6 add mem_store dup.5 add.4 mem_storew_le dropw    # position 4 => [pos_ptr, ids_ptr, sorted8, sorted9, sorted10, sorted11]
    movup.5 u32and.15 push.11 dup.1 dup.3 add mem_store    # position 11 => [id11, pos_ptr, ids_ptr, sorted8, sorted9, sorted10]
    movup.5 u32and.15 push.10 dup.1 dup.4 add mem_store    # position 10 => [id10, id11, pos_ptr, ids_ptr, sorted8, sorted9]
    movup.5 u32and.15 push.9 dup.1 dup.5 add mem_store    # position 9 => [id9, id10, id11, pos_ptr, ids_ptr, sorted8]
    movup.5 u32and.15 push.8 dup.1 dup.6 add mem_store dup.5 add.8 mem_storew_le dropw    # position 8 => [pos_ptr, ids_ptr]
    drop drop
end

pub proc stage_proof_order_maps()
    exec.layout::num_airs eq.8
    if.true exec.stage_proof_order_maps_8 else
    exec.layout::num_airs eq.9
    if.true exec.stage_proof_order_maps_9 else
    exec.layout::num_airs eq.10
    if.true exec.stage_proof_order_maps_10 else
    exec.layout::num_airs eq.11
    if.true exec.stage_proof_order_maps_11 else
    exec.stage_proof_order_maps_12
    end
    end
    end
    end
end

pub proc stage_ood_scatter_table()
    procref.pipe_2 exec.layout::ood_scatter_table_ptr add.52 mem_storew_le dropw
    procref.pipe_6 exec.layout::ood_scatter_table_ptr add.56 mem_storew_le dropw
    procref.pipe_8 exec.layout::ood_scatter_table_ptr add.60 mem_storew_le dropw
    procref.pipe_10 exec.layout::ood_scatter_table_ptr add.64 mem_storew_le dropw
    procref.pipe_12 exec.layout::ood_scatter_table_ptr add.68 mem_storew_le dropw
    procref.pipe_14 exec.layout::ood_scatter_table_ptr add.72 mem_storew_le dropw
    procref.pipe_16 exec.layout::ood_scatter_table_ptr add.76 mem_storew_le dropw
    procref.pipe_24 exec.layout::ood_scatter_table_ptr add.80 mem_storew_le dropw
    procref.pipe_28 exec.layout::ood_scatter_table_ptr add.84 mem_storew_le dropw
    exec.layout::ood_scatter_table_ptr add.4
    exec.layout::main_ood_pipe_offsets_ptr
    exec.layout::main_ood_offsets_ptr
    exec.stage_group
    exec.layout::ood_scatter_table_ptr add.4
    exec.layout::num_airs mul.2 add
    exec.layout::aux_ood_pipe_offsets_ptr
    exec.layout::aux_ood_offsets_ptr
    exec.stage_group
end

# Input: [offsets_ptr, pipe_offsets_ptr, slots_ptr]. Every source is trusted selected metadata.
proc stage_group
    push.0
    dup exec.layout::num_airs u32lt
    while.true
        dup exec.layout::proof_order_positions_ptr add mem_load mul.2 dup.4 add
        # [pair, i, offsets, pipe_offsets, slots]
        dup.1 dup.3 add mem_load
        dup.1 mem_store
        dup.1 dup.4 add mem_load exec.layout::ood_scatter_table_ptr add
        dup.1 add.1 mem_store
        drop add.1
        dup exec.layout::num_airs u32lt
    end
    drop drop drop drop
end

#! Absorbs proof-ordered OOD values while scattering them into canonical READ addresses.
pub proc process_row_ood_evaluations(
    state: types::EidosState,
    evaluation: types::HornerState,
) -> (types::EidosState, types::HornerState)
    dup.12 exec.layout::ood_scatter_table_ptr mem_store
    # BytePairLut is the sole preprocessed occupant in every variant.
    exec.pipe_2

    exec.layout::ood_scatter_table_ptr dup add.4 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.5 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.6 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.7 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.8 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.9 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.10 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.11 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.12 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.13 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.14 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.15 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.16 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.17 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.18 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.19 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.20 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.21 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.22 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.23 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.24 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.25 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.26 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.27 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.28 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.29 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.30 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.31 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.32 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.33 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.34 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.35 mem_load
    dynexec
    exec.layout::num_airs u32gt.8
    if.true
    exec.layout::ood_scatter_table_ptr dup add.36 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.37 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.38 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.39 mem_load
    dynexec
    exec.layout::num_airs u32gt.9
    if.true
    exec.layout::ood_scatter_table_ptr dup add.40 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.41 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.42 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.43 mem_load
    dynexec
    exec.layout::num_airs u32gt.10
    if.true
    exec.layout::ood_scatter_table_ptr dup add.44 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.45 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.46 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.47 mem_load
    dynexec
    exec.layout::num_airs u32gt.11
    if.true
    exec.layout::ood_scatter_table_ptr dup add.48 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.49 mem_load
    dynexec
    exec.layout::ood_scatter_table_ptr dup add.50 mem_load swap mem_load add
    swap.13 drop
    exec.layout::ood_scatter_table_ptr add.51 mem_load
    dynexec
    end
    end
    end
    end

    exec.layout::ood_scatter_table_ptr mem_load exec.layout::quotient_row_offset add
    swap.13 drop
    exec.pipe_2
    exec.layout::ood_scatter_table_ptr mem_load exec.layout::ood_row_felts add
    swap.13 drop
end
