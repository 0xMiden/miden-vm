    # main group, proof position 10
    mem_loadw_le.OOD_SCATTER_RECORD_10_PTR
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # main group, proof position 11
    mem_loadw_le.OOD_SCATTER_RECORD_11_PTR
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # aux group, proof position 0
    mem_loadw_le.OOD_SCATTER_RECORD_0_PTR movup.3 movup.3
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
