use miden::core::stark::constants
use miden::core::stark::public_inputs
use miden::core::stark::random_coin
use miden::core::sys::pvm::layout

# Statement schema derived from ChipletMultiAir and SessionTraces::air_inputs.
const NUM_PUBLIC_VALUES = 4
const MAX_AUX_INPUTS = 0
const NUM_AUX_INPUTS = 0
const NUM_CHIPLETS = 10

# Trusted setup commitment observed by the lifted STARK verifier before the statement.
# Pinned against PVM_PREPROCESSED_COMMITMENT by a Rust/MASM oracle.
const PREPROCESSED_COMMITMENT_0 = 7881474831680931516
const PREPROCESSED_COMMITMENT_1 = 14394696689869899287
const PREPROCESSED_COMMITMENT_2 = 1264609894509183924
const PREPROCESSED_COMMITMENT_3 = 18313229530128768945

pub proc preprocessed_commitment
    push.PREPROCESSED_COMMITMENT_3.PREPROCESSED_COMMITMENT_2.PREPROCESSED_COMMITMENT_1.PREPROCESSED_COMMITMENT_0
end

#! Stores the deferred root as the PVM's four base-field public values.
#!
#! The ACE READ layout represents each base value as a quadratic-extension element, so the root
#! is stored as `[D0, 0, D1, 0, D2, 0, D3, 0]` at the generated public-input boundary. Every cell
#! is overwritten, including the zero coordinates, so sequential verification cannot read stale
#! relation state.
#!
#! Inputs:  [D0, D1, D2, D3, ...]
#! Outputs: [...]
pub proc stage_public_root
    exec.layout::public_inputs_ptr mem_store
    exec.layout::public_inputs_ptr add.2 mem_store
    exec.layout::public_inputs_ptr add.4 mem_store
    exec.layout::public_inputs_ptr add.6 mem_store

    push.0 exec.layout::public_inputs_ptr add.1 mem_store
    push.0 exec.layout::public_inputs_ptr add.3 mem_store
    push.0 exec.layout::public_inputs_ptr add.5 mem_store
    push.0 exec.layout::public_inputs_ptr add.7 mem_store
end

#! Observes the PVM statement and instance shape (step I of the verifier).
#!
#! This mirrors the lifted verifier's exact order:
#!
#! 1. trusted preprocessed commitment;
#! 2. default statement encoding `[4, D0, D1, D2, D3, 0, 0]`, where the final zeroes are
#!    `max_aux_inputs` and `aux_inputs.len()`;
#! 3. instance shape `[10, h0, ..., h9]` in `ChipletAir::all()` order.
#!
#! The resulting 22-felt stream performs two full-rate duplexes and leaves six felts buffered.
#! The generic verifier appends the four-felt main commitment and flushes before sampling, exactly
#! matching the Rust challenger. The four root values were staged by `stage_public_root`.
#!
#! Precondition: random-coin input_len is zero after protocol-parameter initialization.
#! Postcondition: random-coin input_len is six; output_len is zero.
#!
#! Inputs:  [...]
#! Outputs: [...]
pub proc process_public_inputs
    exec.constants::random_coin_input_len_ptr mem_load
    assertz.err="PVM process_public_inputs: input buffer must be empty"

    # The trusted setup commitment precedes every statement-owned observation.
    exec.preprocessed_commitment
    exec.layout::preprocessed_com_ptr mem_storew_le
    exec.random_coin::observe_word

    # Publish the dense ACE READ public-input start through the generic verifier cell.
    push.NUM_PUBLIC_VALUES
    exec.layout::aux_rand_elem_ptr
    exec.public_inputs::compute_and_store_public_inputs_address

    # Default Statement::observe: length-prefixed public inputs, then empty aux-input metadata.
    push.NUM_PUBLIC_VALUES exec.random_coin::observe_felt
    exec.layout::public_inputs_ptr mem_load exec.random_coin::observe_felt
    exec.layout::public_inputs_ptr add.2 mem_load exec.random_coin::observe_felt
    exec.layout::public_inputs_ptr add.4 mem_load exec.random_coin::observe_felt
    exec.layout::public_inputs_ptr add.6 mem_load exec.random_coin::observe_felt
    push.MAX_AUX_INPUTS exec.random_coin::observe_felt
    push.NUM_AUX_INPUTS exec.random_coin::observe_felt

    # TraceOrder::observe_shape: relation count followed by heights in canonical instance order.
    push.NUM_CHIPLETS exec.random_coin::observe_felt
    push.0
    repeat.NUM_CHIPLETS
        dup exec.constants::air_trace_length_logs_ptr add mem_load
        exec.random_coin::observe_felt
        add.1
    end
    drop

    exec.constants::random_coin_input_len_ptr mem_load
    push.6 assert_eq.err="PVM process_public_inputs: transcript framing drifted"
    exec.constants::random_coin_output_len_ptr mem_load
    assertz.err="PVM process_public_inputs: observed input exposed stale output"
end
