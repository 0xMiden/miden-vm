use {
    LOG_AIR_TRACE_LENGTHS_PTR,
    RANDOM_COIN_INPUT_LENGTH_PTR,
    RANDOM_COIN_OUTPUT_LENGTH_PTR,
} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::stark::random_coin
use {
    PUBLIC_INPUTS_PTR,
    PUBLIC_INPUT_1_C0_PTR,
    PUBLIC_INPUT_2_C0_PTR,
    PUBLIC_INPUT_3_C0_PTR,
} from miden::core::sys::pvm::layout

# Statement schema derived from ChipletMultiAir and SessionTraces::air_inputs.
const NUM_PUBLIC_VALUES = 4
const MAX_AUX_INPUTS = 0
const NUM_AUX_INPUTS = 0
const NUM_CHIPLETS = 12

# The shape stream ends on an Eidos block boundary, so no shape value remains buffered.
const BUFFERED_SHAPE_VALUE_COUNT = 0

#! Stores the deferred root as the PVM's four base-field public values.
#!
#! The ACE READ layout represents each base value as a quadratic-extension element, so the root
#! is stored as `[D0, 0, D1, 0, D2, 0, D3, 0]` at the generated public-input boundary. Every cell
#! is overwritten, including the zero coordinates, so sequential verification cannot read stale
#! relation state.
#!
#! Inputs:  [D0, D1, D2, D3, ...]
#! Outputs: [...]
pub proc stage_public_root(root: types::Digest)
    padw movdn.7 movdn.5 movdn.3 swap
    # => [D0, 0, D1, 0, D2, 0, D3, 0, ...]
    mem_storew_le.PUBLIC_INPUTS_PTR dropw
    mem_storew_le.PUBLIC_INPUT_2_C0_PTR dropw
end

#! Observes the PVM statement and instance shape (step I of the verifier).
#!
#! This mirrors the lifted verifier's exact order:
#!
#! 1. default statement encoding `[4, D0, D1, D2, D3, 0, 0]`, where the final zeroes are
#!    `max_aux_inputs` and `aux_inputs.len()`;
#! 2. instance shape `[12, h0, ..., h11]` in `ChipletAir::all()` order.
#!
#! The trusted preprocessed commitment is already buffered by `random_coin::init_seed`; with this
#! 20-felt statement-and-shape stream, the combined 24 felts perform three Eidos compressions and
#! leave no felts buffered. The generic verifier appends the main commitment and flushes before
#! sampling, exactly matching the Rust challenger.
#!
#! Precondition: random-coin input_len is four after protocol parameters and the trusted setup.
#! Postcondition: random-coin input_len is zero; output_len is zero.
#!
#! Inputs:  [...]
#! Outputs: [...]
pub proc process_public_inputs()
    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    push.4 assert_eq.err="PVM process_public_inputs: preprocessed commitment is not buffered"

    # Observe consecutive words of the statement-and-shape stream through the streaming API.
    mem_load.PUBLIC_INPUT_2_C0_PTR
    mem_load.PUBLIC_INPUT_1_C0_PTR
    mem_load.PUBLIC_INPUTS_PTR
    push.NUM_PUBLIC_VALUES
    # => [num_public_values, D0, D1, D2, ...]
    exec.random_coin::observe_word

    push.NUM_CHIPLETS.NUM_AUX_INPUTS.MAX_AUX_INPUTS
    mem_load.PUBLIC_INPUT_3_C0_PTR
    # => [D3, max_aux_inputs, num_aux_inputs, num_chiplets, ...]
    exec.random_coin::observe_word

    # Instance heights in canonical ChipletAir order.
    push.LOG_AIR_TRACE_LENGTHS_PTR
    repeat.NUM_CHIPLETS
        dup mem_load exec.random_coin::observe_felt
        add.1
    end
    drop

    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    push.BUFFERED_SHAPE_VALUE_COUNT assert_eq.err="PVM process_public_inputs: transcript framing drifted"
    mem_load.RANDOM_COIN_OUTPUT_LENGTH_PTR
    assertz.err="PVM process_public_inputs: observed input exposed stale output"
end
