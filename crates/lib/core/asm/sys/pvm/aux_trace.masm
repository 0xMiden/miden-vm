#! Multiplies a canonical normalized boundary sum by its AIR's trace length.
#!
#! `boundary_offset` is twice the canonical AIR index; the sums must be in canonical order.
#!
#! Input:  [boundary_offset, log_height, ...]
#! Output: [weighted_sum0, weighted_sum1, ...]
proc load_weighted_aux_sum(boundary_offset: u8, log_height: u8) -> types::QuadFelt
    swap pow2
    push.AUX_BUS_BOUNDARY_PTR movup.2 add
    # => [sum_ptr, trace_length, ...]
    dup mem_load dup.2 mul
    # => [weighted_sum0, sum_ptr, trace_length, ...]
    swap add.1 mem_load movup.2 mul swap
end

#! Reads the normalized sum at one proof-order position.
#!
#! Input:  [proof_order_position, ...]
#! Output: [sum0, sum1, ...]
proc load_boundary_pair(proof_order_position: u8) -> types::QuadFelt
    mul.2 push.AUX_BUS_BOUNDARY_PTR add
    dup add.1 mem_load swap mem_load
end

