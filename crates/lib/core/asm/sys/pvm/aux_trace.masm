use {
    AUX_TRACE_COM_PTR,
    LOG_AIR_TRACE_LENGTHS_PTR,
    PROOF_ORDER_POSITIONS_PTR,
    RANDOM_COIN_INPUT_LENGTH_PTR,
    RANDOM_COIN_OUTPUT_LENGTH_PTR,
} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::stark::random_coin
use miden::core::sys::pvm::fixed_boundary
use miden::core::sys::pvm::layout
use {
    AUX_BOUNDARY_WORD_1_PTR,
    AUX_BOUNDARY_WORD_2_PTR,
    AUX_BOUNDARY_WORD_3_PTR,
    AUX_BOUNDARY_WORD_4_PTR,
    AUX_BOUNDARY_WORD_5_PTR,
    AUX_BUS_BOUNDARY_PTR,
    C_TOTAL_C1_PTR,
    C_TOTAL_PTR,
} from miden::core::sys::pvm::layout

# Immediate addresses for the relation's live AIR indices.
const AIR_1_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 1
const AIR_2_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 2
const AIR_3_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 3
const AIR_4_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 4
const AIR_5_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 5
const AIR_6_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 6
const AIR_7_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 7
const AIR_8_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 8
const AIR_9_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 9
const AIR_10_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 10
const AIR_11_PROOF_POSITION_PTR = PROOF_ORDER_POSITIONS_PTR + 11
const CANONICAL_AIR_1_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 1
const CANONICAL_AIR_2_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 2
const CANONICAL_AIR_3_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 3
const CANONICAL_AIR_4_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 4
const CANONICAL_AIR_5_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 5
const CANONICAL_AIR_6_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 6
const CANONICAL_AIR_7_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 7
const CANONICAL_AIR_8_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 8
const CANONICAL_AIR_9_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 9
const CANONICAL_AIR_10_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 10
const CANONICAL_AIR_11_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 11

# Number of chiplet instances in the relation, each contributing one boundary value.
# NUM_CHIPLETS = 12
# Words spanned by the twelve proof-ordered, two-felt normalized boundary sums.
# NUM_AUX_VALUE_WORDS = 6

#! Load one normalized committed LogUp sum and scale both extension coordinates by the chiplet's
#! row count `n = 2^log_height`.
#!
#! `boundary_offset` is `2k` for canonical instance index `k`, so the caller must have scattered
#! the sums to their canonical addresses first.
#!
#! Input:  [boundary_offset, log_height, ...]
#! Output: [n_sigma_prime_0, n_sigma_prime_1, ...]
proc load_weighted_aux_sum(boundary_offset: u8, log_height: u8) -> types::QuadFelt
    swap pow2
    exec.layout::aux_bus_boundary_ptr movup.2 add

    dup mem_load
    dup.2 mul

    swap add.1 mem_load
    movup.2 mul swap
end

#! Reads the normalized boundary sum submitted at one position of the proof order.
#!
#! Input:  [proof_order_position, ...]
#! Output: [sigma_prime_0, sigma_prime_1, ...]
proc load_boundary_pair(proof_order_position: u8) -> types::QuadFelt
    mul.2 exec.layout::aux_bus_boundary_ptr add

    dup add.1 mem_load
    swap mem_load
end

#! Moves each normalized boundary sum from its proof-order slot to its canonical instance-order
#! slot.
#!
#! The proof submits one sum per chiplet ordered by trace height, so the absorb above stores them
#! in that order. The constraint circuit instead reads chiplet `k`'s sum at
#! `AUX_BUS_BOUNDARY_PTR + 2k`, the address `InputKey::AuxBusBoundary(k)` names, with `k` the
#! canonical instance index. The `pos_by_id` table staged once per proof by
#! `ood_frames::stage_proof_order_maps` supplies these positions.
#!
#! Every sum is read onto the operand stack before any is written back, so the region is permuted
#! in place without scratch memory. The AIR heights and their proof-order positions must already
#! be staged; the sums must already be absorbed.
#!
#! Input:  [...]
#! Output: [...]
pub proc scatter_aux_bus_boundary()
    mem_load.AIR_11_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_10_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_9_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_8_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_7_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_6_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_5_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_4_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_3_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_2_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.AIR_1_PROOF_POSITION_PTR
    exec.load_boundary_pair

    mem_load.PROOF_ORDER_POSITIONS_PTR
    exec.load_boundary_pair
    # => [sigma_prime_0, ..., sigma_prime_11, ...] in canonical instance order

    mem_storew_le.AUX_BUS_BOUNDARY_PTR dropw
    mem_storew_le.AUX_BOUNDARY_WORD_1_PTR dropw
    mem_storew_le.AUX_BOUNDARY_WORD_2_PTR dropw
    mem_storew_le.AUX_BOUNDARY_WORD_3_PTR dropw
    mem_storew_le.AUX_BOUNDARY_WORD_4_PTR dropw
    mem_storew_le.AUX_BOUNDARY_WORD_5_PTR dropw
end

#! Observes the PVM auxiliary trace commitment and its twelve normalized LogUp values.
#!
#! The advice provider supplies the commitment followed by each chiplet's exposed value in proof
#! order. Every chiplet exposes one `sigma_prime = sigma / n`, which is weighted by that chiplet's
#! trace length before closing the external LogUp identity.
#!
#! The stream is 28 base felts: the four-felt commitment followed by twenty-four LogUp-value
#! coordinates. It fills three Eidos rate blocks and leaves a four-felt tail buffered, matching the
#! lifted-STARK transcript before it samples composition challenges.
#!
#! Once absorbed, the values are moved to the canonical addresses the constraint circuit reads
#! them from.
#!
#! The hook also adds the verifier-side consumes for the fixed uint/curve environment and asserts
#! `fixed_boundary_correction + sum_i(n_i * sigma_prime_i) == 0` coordinate-wise.
#!
#! Precondition:  input_len=0 (the main commitment was flushed before this hook).
#! Postcondition: input_len=4, output_len=0.
#!
#! Input:  [...]
#! Output: [...]
pub proc observe_aux_trace()
    # Draw [alpha, beta] and store [beta0, beta1, alpha0, alpha1] at the staged PVM READ boundary.
    exec.random_coin::generate_aux_randomness

    # The fixed-environment consumes depend on the sampled challenges but not on proof data.
    exec.fixed_boundary::compute_fixed_boundary_correction

    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    assertz.err="PVM observe_aux_trace: input buffer must be empty"
    # Store and absorb the commitment plus all twelve proof-ordered boundary values.
    padw adv_loadw
    mem_storew_le.AUX_TRACE_COM_PTR
    exec.random_coin::eidos_observe_word
    padw adv_loadw
    mem_storew_le.AUX_BUS_BOUNDARY_PTR
    exec.random_coin::eidos_observe_word

    padw adv_loadw
    mem_storew_le.AUX_BOUNDARY_WORD_1_PTR
    exec.random_coin::eidos_observe_word
    padw adv_loadw
    mem_storew_le.AUX_BOUNDARY_WORD_2_PTR
    exec.random_coin::eidos_observe_word

    padw adv_loadw
    mem_storew_le.AUX_BOUNDARY_WORD_3_PTR
    exec.random_coin::eidos_observe_word
    padw adv_loadw
    mem_storew_le.AUX_BOUNDARY_WORD_4_PTR
    exec.random_coin::eidos_observe_word
    padw adv_loadw
    mem_storew_le.AUX_BOUNDARY_WORD_5_PTR
    exec.random_coin::eidos_observe_word

    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    push.4 assert_eq.err="PVM observe_aux_trace: boundary transcript framing drifted"
    mem_load.RANDOM_COIN_OUTPUT_LENGTH_PTR
    assertz.err="PVM observe_aux_trace: observed input exposed stale output"

    # The transcript has now seen the wire order, so the sums may move to the canonical addresses
    # the constraint circuit reads them from. Everything below indexes the region by canonical
    # instance index, so this must precede the weighted sum, not follow it.
    exec.scatter_aux_bus_boundary

    # Scale chiplet k's normalized sum, now at offset 2k, by chiplet k's trace length. Each call
    # produces its pair on top of the running sum, which sits undisturbed beneath it until folded.
    mem_load.LOG_AIR_TRACE_LENGTHS_PTR push.0 exec.load_weighted_aux_sum

    mem_load.CANONICAL_AIR_1_LOG_HEIGHT_PTR push.2 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_2_LOG_HEIGHT_PTR push.4 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_3_LOG_HEIGHT_PTR push.6 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_4_LOG_HEIGHT_PTR push.8 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_5_LOG_HEIGHT_PTR push.10 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_6_LOG_HEIGHT_PTR push.12 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_7_LOG_HEIGHT_PTR push.14 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_8_LOG_HEIGHT_PTR push.16 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_9_LOG_HEIGHT_PTR push.18 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_10_LOG_HEIGHT_PTR push.20 exec.load_weighted_aux_sum
    ext2add

    mem_load.CANONICAL_AIR_11_LOG_HEIGHT_PTR push.22 exec.load_weighted_aux_sum
    ext2add

    mem_load.C_TOTAL_C1_PTR
    mem_load.C_TOTAL_PTR
    ext2add
    assertz.err="PVM fixed-boundary mismatch: correction + weighted LogUp sum coord 0"
    assertz.err="PVM fixed-boundary mismatch: correction + weighted LogUp sum coord 1"
end
