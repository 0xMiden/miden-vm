proc load_and_authenticate_ace_circuit
    padw mem_loadw_le.ACE_DIGEST
    adv.push_mapval
    exec.parameters::ace_circuit_stream_ptr
    padw mem_loadw_le.ACE_INITIAL_CV
    padw padw
    push.ACE_PIPE dynexec
    exec.eidos::digest
    movup.4 drop
    assert_eqw.err=ERR_CIRCUIT_DIGEST_MISMATCH
end
