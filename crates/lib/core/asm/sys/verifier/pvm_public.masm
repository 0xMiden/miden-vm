#! Generated shared PVM statement hook. Trusted parameters must be staged.
use {LOG_AIR_TRACE_LENGTHS_PTR, RANDOM_COIN_INPUT_LENGTH_PTR, RANDOM_COIN_OUTPUT_LENGTH_PTR} from miden::core::stark::constants
use miden::core::stark::random_coin
use miden::core::stark::public_inputs
use miden::core::sys::verifier::parameters
use {
    AUX_RAND_ELEM_PTR,
    AUX_BUS_BOUNDARY_PTR,
    AUXILIARY_ACE_INPUTS_PTR,
    ACE_CIRCUIT_STREAM_PTR,
    STREAM_BLOCKS,
    NUM_INPUTS,
    NUM_GATES,
    CYCLE_LOG,
    NUM_AIRS,
    FOLD_OFFSET,
    OOD_SCATTER_TABLE_PTR,
    PROOF_ORDER_POSITIONS_PTR,
    PROOF_ORDER_IDS_PTR,
    ROW_FELTS,
    BUS_GAMMA_PTR,
    C_TOTAL_PTR,
    PUBLIC_INPUTS_PTR,
    PREPROCESSED_COM_PTR,
    PREPROCESSED_DEPTH,
    SHAPE_BUFFERED,
    ACE_INITIAL_CV,
    ACE_DIGEST,
    QUOTIENT_SHIFT_RATIO,
    QUOTIENT_FIRST_SHIFT,
    QUOTIENT_FIRST_WEIGHT,
    RESERVED_31,
    PREPROCESSED_LEAF_CV,
    MAIN_LEAF_CV,
    AUX_LEAF_CV,
    QUOTIENT_LEAF_CV,
    PREPROCESSED_BASE_PIPE,
    MAIN_BASE_PIPE,
    AUX_BASE_PIPE,
    QUOTIENT_BASE_PIPE,
    PREPROCESSED_EXT_PIPE,
    QUOTIENT_EXT_PIPE,
    QUOTIENT_DESTINATION,
    FOLD_COEFFICIENTS_PTR,
    RESERVED_74,
    RESERVED_75,
    ACE_PIPE,
} from miden::core::sys::verifier::parameters
# Full relation reference: 20 statement/shape felts.
# Every selected relation uses the staged count/remainder; no heights are observed by staging.
const NUM_PUBLIC_VALUES = 4
const MAX_AUX_INPUTS = 0
const NUM_AUX_INPUTS = 0
pub proc process_public_inputs()
    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    push.4 assert_eq.err="PVM process_public_inputs: preprocessed commitment is not buffered"

    # Publish the dense ACE READ public-input start through the generic verifier cell.
    push.NUM_PUBLIC_VALUES
    exec.parameters::aux_rand_elem_ptr
    exec.public_inputs::compute_and_store_public_inputs_address

    # Default statement encoding (7 felts), before the instance heights.
    push.NUM_PUBLIC_VALUES exec.random_coin::observe_felt
    exec.parameters::public_inputs_ptr mem_load exec.random_coin::observe_felt
    exec.parameters::public_inputs_ptr add.2 mem_load exec.random_coin::observe_felt
    exec.parameters::public_inputs_ptr add.4 mem_load exec.random_coin::observe_felt
    exec.parameters::public_inputs_ptr add.6 mem_load exec.random_coin::observe_felt
    push.MAX_AUX_INPUTS exec.random_coin::observe_felt
    push.NUM_AUX_INPUTS exec.random_coin::observe_felt

    # Instance shape: canonical AIR count followed by its canonical heights.
    mem_load.NUM_AIRS exec.random_coin::observe_felt
    push.LOG_AIR_TRACE_LENGTHS_PTR mem_load.NUM_AIRS add
    push.LOG_AIR_TRACE_LENGTHS_PTR
    dup.1 dup.1 neq
    while.true
        dup mem_load exec.random_coin::observe_felt
        add.1
        dup.1 dup.1 neq
    end
    drop drop

    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    mem_load.SHAPE_BUFFERED assert_eq.err="PVM process_public_inputs: transcript framing drifted"
    mem_load.RANDOM_COIN_OUTPUT_LENGTH_PTR
    assertz.err="PVM process_public_inputs: observed input exposed stale output"
end
