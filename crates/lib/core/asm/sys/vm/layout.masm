use {LOG_AIR_TRACE_LENGTHS_PTR} from miden::core::stark::constants
use {AND8_LOOKUP_LOG_HEIGHT} from miden::core::sys::vm::parameters

### Statement storage and AIR-height access for the Miden VM verifier.
###
### The shared STARK layout owns protocol state and per-AIR scratch. This module owns the
### authenticated claim, boundary statement, kernel witness and LogUp scratch. Its height accessors
### assign canonical AIR indices: core 0, chiplets 1, Eidos compression 2, and And8 lookup 3.
### The variable-width ACE boundaries are generated in `parameters.masm`.

# Canonical AIR indices of the VM relation.
const CHIPLETS_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 1
const EIDOS_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 2
const AND8_LOG_HEIGHT_PTR = LOG_AIR_TRACE_LENGTHS_PTR + 3

### LogUp bus separator [gamma0, gamma1, 0, 0], where gamma = beta^16.
pub const BUS_GAMMA_PTR = 3223323136
pub const BUS_GAMMA_C1_PTR = BUS_GAMMA_PTR + 1

### Number of kernel procedures in the authenticated witness.
pub const NUM_KERNEL_PROCEDURES_PTR = 3223323140

### Word-alignment padding before the claim commitment: 3 felts at 3223323141..3223323144.

### Caller-provided claim commitment. The verifier checks the advice-supplied preimage against it.
pub const CLAIM_COMMITMENT_PTR = 3223323144

### Verifier-owned claim preimage (40 felts: P | K | I | O). The stack I/O values are also
### copied into ACE public inputs; the claim itself remains outside the ACE READ vector.
pub const CLAIM_PTR = 3223323148
### Kernel commitment in the P | K | I | O claim encoding.
pub const KERNEL_COMMITMENT_PTR = CLAIM_PTR + 4

### Boundary block [program_digest | deferred_root].
pub const BOUNDARY_INPUTS_PTR = 3223323188
pub const BOUNDARY_INPUTS_PROGRAM_OFFSET = 0
pub const BOUNDARY_INPUTS_DEFERRED_OFFSET = 4
pub const DEFERRED_ROOT_PTR = BOUNDARY_INPUTS_PTR + BOUNDARY_INPUTS_DEFERRED_OFFSET

### Kernel digest witness (up to 255 word-aligned procedure digests).
pub const KERNEL_WITNESS_PTR = 3223323196

pub proc set_core_trace_length_log(height: u8)
    mem_store.LOG_AIR_TRACE_LENGTHS_PTR
end

pub proc get_core_trace_length_log() -> u8
    mem_load.LOG_AIR_TRACE_LENGTHS_PTR
end

pub proc set_chiplets_trace_length_log(height: u8)
    mem_store.CHIPLETS_LOG_HEIGHT_PTR
end

pub proc get_chiplets_trace_length_log() -> u8
    mem_load.CHIPLETS_LOG_HEIGHT_PTR
end

pub proc set_eidos_compression_trace_length_log(height: u8)
    mem_store.EIDOS_LOG_HEIGHT_PTR
end

pub proc get_eidos_compression_trace_length_log() -> u8
    mem_load.EIDOS_LOG_HEIGHT_PTR
end

#! Stores the fixed And8 setup height in the canonical array used by proof ordering and selectors.
pub proc init_and8_lookup_trace_length_log()
    push.AND8_LOOKUP_LOG_HEIGHT
    mem_store.AND8_LOG_HEIGHT_PTR
end
