# Number of AIR instances in the relation.
# NUM_AIRS = 4

# Per-row OOD layout uses LMCS alignment 8:
#   preprocessed: 0 + 0 + 0 + 8 = 8 scalar evaluations
#   main:         48 + 24 + 104 + 8 = 184 scalar evaluations
#   aux:          8 + 8 + 40 + 8 = 64 scalar evaluations
#   quotient:     16 scalar evaluations
# The advice stream supplies 544 base felts, read as 68 `adv_pipe` blocks.

const OOD_SCATTER_RECORD_0_PTR = OOD_SCATTER_TABLE_PTR + 4
const OOD_SCATTER_RECORD_1_PTR = OOD_SCATTER_TABLE_PTR + 8
const OOD_SCATTER_RECORD_2_PTR = OOD_SCATTER_TABLE_PTR + 12
const OOD_SCATTER_RECORD_3_PTR = OOD_SCATTER_TABLE_PTR + 16

#! Stores, Horner-folds, and absorbs 2 advice blocks at the caller's destination.
#!
#! Inputs:  [rate(8), cv(4), ptr, alpha_ptr, acc0, acc1]
#! Outputs: [rate'(8), cv'(4), ptr + 16, alpha_ptr, acc0', acc1']
proc pipe_2
    repeat.2
        adv_pipe
        horner_eval_ext
        compress
    end
end

