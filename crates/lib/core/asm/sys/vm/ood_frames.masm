    procref.pipe_4 dup.4 add.24 mem_storew_le dropw
    procref.pipe_6 dup.4 add.28 mem_storew_le dropw
    procref.pipe_10 dup.4 add.32 mem_storew_le dropw
    procref.pipe_12 dup.4 add.36 mem_storew_le dropw
    procref.pipe_28 dup.4 add.40 mem_storew_le dropw
    exec.layout::proof_order_positions_ptr
    # => [pos_ptr, table]

    # AIR 0: its pair slots start at table + 2 * pos_by_id[0]
    dup mem_load mul.2 dup.2 add
    # => [base, pos_ptr, table]
    # main: 12 blocks at row offset 16
    push.16 dup.1 add.4 mem_store
    dup.2 add.36 dup.1 add.5 mem_store
    # aux: 2 blocks at row offset 400
    push.400 dup.1 add.12 mem_store
    dup.2 add.20 dup.1 add.13 mem_store
    drop

    # AIR 1: its pair slots start at table + 2 * pos_by_id[1]
    dup add.1 mem_load mul.2 dup.2 add
    # => [base, pos_ptr, table]
    # main: 6 blocks at row offset 112
    push.112 dup.1 add.4 mem_store
    dup.2 add.28 dup.1 add.5 mem_store
    # aux: 2 blocks at row offset 416
    push.416 dup.1 add.12 mem_store
    dup.2 add.20 dup.1 add.13 mem_store
    drop

    # AIR 2: its pair slots start at table + 2 * pos_by_id[2]
    dup add.2 mem_load mul.2 dup.2 add
    # => [base, pos_ptr, table]
    # main: 28 blocks at row offset 160
    push.160 dup.1 add.4 mem_store
    dup.2 add.40 dup.1 add.5 mem_store
    # aux: 10 blocks at row offset 432
    push.432 dup.1 add.12 mem_store
    dup.2 add.32 dup.1 add.13 mem_store
    drop

    # AIR 3: its pair slots start at table + 2 * pos_by_id[3]
    dup add.3 mem_load mul.2 dup.2 add
    # => [base, pos_ptr, table]
    # main: 2 blocks at row offset 384
    push.384 dup.1 add.4 mem_store
    dup.2 add.20 dup.1 add.5 mem_store
    # aux: 2 blocks at row offset 512
    push.512 dup.1 add.12 mem_store
    dup.2 add.20 dup.1 add.13 mem_store
    drop
    drop drop
end

