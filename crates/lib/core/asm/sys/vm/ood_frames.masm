#! Derives the height-sorted proof order once and materializes its two inverse maps.
#!
#! Packs each AIR's key as `16 * log_height + instance_index`, sorts the keys with a fixed
#! 5-comparator network (data-oblivious: one `cswap` per comparator), and unpacks them into
#! `id_by_pos` (instance index at each proof position) and `pos_by_id` (proof position of each
#! instance). Equal heights order by instance index, exactly like the native `TraceOrder`.
#!
#! Must run after every height has been bounded; keys are compared as u32 values.
#!
#! Inputs:  []
#! Outputs: []
#! Invocation: exec
pub proc stage_proof_order_maps()
    push.PROOF_ORDER_IDS_PTR push.PROOF_ORDER_POSITIONS_PTR
    # => [pos_ptr, ids_ptr]
    padw push.LOG_AIR_TRACE_LENGTHS_PTR mem_loadw_le mul.16 movdn.3 mul.16 add.1 movdn.3 mul.16 add.2 movdn.3 mul.16 add.3 movdn.3
    # keys: [k0, k1, k2, k3, pos_ptr, ids_ptr]
    # 5 compare-exchanges; each leaves the smaller key at the lower index.
    movup.2 swap dup.1 dup.1 u32lt cswap swap movdn.2    # (0, 2)
    movup.3 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.3    # (1, 3)
    dup.1 dup.1 u32lt cswap    # (0, 1)
    movup.3 movup.3 dup.1 dup.1 u32lt cswap movdn.3 movdn.3    # (2, 3)
    movup.2 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.2    # (1, 2)
    # Unpack each sorted key into the maps.
    movup.3 u32and.15 push.3 dup.1 dup.6 add mem_store    # position 3 => [id3, sorted0, sorted1, sorted2, pos_ptr, ids_ptr]
    movup.3 u32and.15 push.2 dup.1 dup.6 add mem_store    # position 2 => [id2, id3, sorted0, sorted1, pos_ptr, ids_ptr]
    movup.3 u32and.15 push.1 dup.1 dup.6 add mem_store    # position 1 => [id1, id2, id3, sorted0, pos_ptr, ids_ptr]
    movup.3 u32and.15 push.0 dup.1 dup.6 add mem_store dup.5 mem_storew_le dropw    # position 0 => [pos_ptr, ids_ptr]
    drop drop
end

#! Stages canonical destinations and pipe-procedure addresses by proof position.
#!
#! Must run after `stage_proof_order_maps` and before ingesting the first OOD row.
#! Each record packs up to two groups' (row-relative destination, pipe-digest address) pairs.
#! An unused second pair is zero.
#!
#! Inputs:  []
#! Outputs: []
#! Invocation: exec
pub proc stage_ood_scatter_table()
    push.OOD_SCATTER_TABLE_PTR
    # => [table]
    procref.pipe_2 dup.4 add.20 mem_storew_le dropw
    procref.pipe_4 dup.4 add.24 mem_storew_le dropw
    procref.pipe_6 dup.4 add.28 mem_storew_le dropw
    procref.pipe_10 dup.4 add.32 mem_storew_le dropw
    procref.pipe_12 dup.4 add.36 mem_storew_le dropw
    procref.pipe_26 dup.4 add.40 mem_storew_le dropw
    push.PROOF_ORDER_POSITIONS_PTR
    # => [pos_ptr, table]

    # AIR 0: address each packed word by its proof position.
    dup mem_load mul.4 dup.2 add
    # => [base, pos_ptr, table]
    dup.2 add.20 push.384
    dup.4 add.36 push.16
    # => [dst0, pipe0, dst1, pipe1, base, pos_ptr, table]
    dup.4 add.4 mem_storew_le dropw
    drop

    # AIR 1: address each packed word by its proof position.
    dup add.1 mem_load mul.4 dup.2 add
    # => [base, pos_ptr, table]
    dup.2 add.20 push.400
    dup.4 add.28 push.112
    # => [dst0, pipe0, dst1, pipe1, base, pos_ptr, table]
    dup.4 add.4 mem_storew_le dropw
    drop

    # AIR 2: address each packed word by its proof position.
    dup add.2 mem_load mul.4 dup.2 add
    # => [base, pos_ptr, table]
    dup.2 add.32 push.416
    dup.4 add.40 push.160
    # => [dst0, pipe0, dst1, pipe1, base, pos_ptr, table]
    dup.4 add.4 mem_storew_le dropw
    drop

    # AIR 3: address each packed word by its proof position.
    dup add.3 mem_load mul.4 dup.2 add
    # => [base, pos_ptr, table]
    dup.2 add.20 push.496
    dup.4 add.20 push.368
    # => [dst0, pipe0, dst1, pipe1, base, pos_ptr, table]
    dup.4 add.4 mem_storew_le dropw
    drop
    drop drop
end

#! Loads one OOD row from advice and scatters it to canonical AIR addresses.
#!
#! The wire groups are preprocessed, main, auxiliary coordinates, and quotient. Each per-AIR
#! group arrives in proof order. Eidos absorption and DEEP Horner accumulation follow wire order;
#! the staged scatter table determines the memory destinations. The returned rate is the last
#! absorbed block. Call `stage_ood_scatter_table` before ingesting the first row.
#!
#! Inputs:  [rate(8), cv(4), ptr, alpha_ptr, acc0, acc1]
#! Outputs: [rate'(8), cv'(4), ptr + 544, alpha_ptr, acc0', acc1']
#! Invocation: exec
pub proc process_row_ood_evaluations(
    state: types::EidosState,
    evaluation: types::HornerState,
) -> (types::EidosState, types::HornerState)
    dup.12 mem_store.OOD_SCATTER_TABLE_PTR
    # Dispatch records reuse rate slots; every nonempty pipe overwrites both rate words.
    # Word swaps expose the destination beside the record, preserving CV and Horner state.
    # preprocessed group, sole occupant: 2 blocks at row offset 0
    exec.pipe_2
    # main group, proof position 0
    mem_loadw_le.OOD_SCATTER_RECORD_0_PTR
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # main group, proof position 1
    mem_loadw_le.OOD_SCATTER_RECORD_1_PTR
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # main group, proof position 2
    mem_loadw_le.OOD_SCATTER_RECORD_2_PTR
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # main group, proof position 3
    mem_loadw_le.OOD_SCATTER_RECORD_3_PTR
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # aux group, proof position 0
    mem_loadw_le.OOD_SCATTER_RECORD_0_PTR movup.3 movup.3
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # aux group, proof position 1
    mem_loadw_le.OOD_SCATTER_RECORD_1_PTR movup.3 movup.3
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # aux group, proof position 2
    mem_loadw_le.OOD_SCATTER_RECORD_2_PTR movup.3 movup.3
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # aux group, proof position 3
    mem_loadw_le.OOD_SCATTER_RECORD_3_PTR movup.3 movup.3
    mem_load.OOD_SCATTER_TABLE_PTR add
    swapw swapw.3 swap.4 swapw.3
    # => [scratch(5), pipe_address, scratch(2), cv(4), ptr, alpha_ptr, acc0, acc1]
    dup.5 dynexec
    # quotient group, sole occupant: 4 blocks at row offset 512
    mem_load.OOD_SCATTER_TABLE_PTR add.512
    swap.13 drop
    exec.pipe_4
end
