#! Derives the height-sorted proof order once and materializes its two inverse maps.
#!
#! Packs each AIR's key as `16 * log_height + instance_index`, sorts the keys with a fixed
#! 5-comparator network (data-oblivious: one `cswap` per comparator), and unpacks them into
#! `id_by_pos` (instance index at each proof position) and `pos_by_id` (proof position of each
#! instance). Equal heights order by instance index, exactly like the native `TraceOrder`.
#!
#! Must run after every height has been bounded; keys are compared as u32 values.
#!
#! Inputs:  []
#! Outputs: []
pub proc stage_proof_order_maps
    # => [pos_ptr, ids_ptr]
    exec.layout::proof_order_ids_ptr exec.layout::proof_order_positions_ptr
    # keys: [k0, k1, k2, k3, pos_ptr, ids_ptr]
    padw exec.constants::air_trace_length_logs_ptr mem_loadw_le mul.16 movdn.3 mul.16 add.1 movdn.3 mul.16 add.2 movdn.3 mul.16 add.3 movdn.3
    # 5 compare-exchanges; each leaves the smaller key at the lower index.
    movup.2 swap dup.1 dup.1 u32lt cswap swap movdn.2    # (0, 2)
    movup.3 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.3    # (1, 3)
    dup.1 dup.1 u32lt cswap    # (0, 1)
    movup.3 movup.3 dup.1 dup.1 u32lt cswap movdn.3 movdn.3    # (2, 3)
    movup.2 movup.2 dup.1 dup.1 u32lt cswap movdn.2 movdn.2    # (1, 2)
    # Unpack each sorted key into the maps.
    movup.3 u32and.15 push.3 dup.1 dup.6 add mem_store    # position 3 => [id3, sorted0, sorted1, sorted2, pos_ptr, ids_ptr]
    movup.3 u32and.15 push.2 dup.1 dup.6 add mem_store    # position 2 => [id2, id3, sorted0, sorted1, pos_ptr, ids_ptr]
    movup.3 u32and.15 push.1 dup.1 dup.6 add mem_store    # position 1 => [id1, id2, id3, sorted0, pos_ptr, ids_ptr]
    movup.3 u32and.15 push.0 dup.1 dup.6 add mem_store dup.5 mem_storew_le dropw    # position 0 => [pos_ptr, ids_ptr]
    drop drop
end

#! Stages the proof-order-dependent half of the out-of-domain scatter table.
#!
#! The proof commits each AIR's trace at its position in the height-sorted proof order, while the
#! constraint circuit reads it at the AIR's canonical instance offset. Both the canonical
#! destination and the segment length are compile-time per AIR; this procedure only routes them to
#! the stream position `stage_proof_order_maps` recorded for that AIR.
#!
#! Must run after the proof-order maps are staged and before the first out-of-domain row is
#! ingested.
#!
#! Inputs:  []
#! Outputs: []
pub proc stage_ood_scatter_table
    exec.layout::ood_scatter_table_ptr
