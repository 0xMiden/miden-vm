pub mod aux_trace
pub mod claim
pub mod constraints_eval
pub mod deep_queries
pub mod layout
pub mod ood_frames
pub mod public_inputs

use miden::core::mem
use miden::core::stark::constants
use miden::core::stark::utils
use miden::core::stark::verifier

# Relation constants returned with the transcript-bound proof parameters. `LOOKUP_POW_BITS` is
# zero because Lifted STARK does not grind lookup challenges.
const LOOKUP_POW_BITS = 0
const MAX_MESSAGE_WIDTH = 16
const NUM_COMPOSED_CONSTRAINTS = 674
const MAX_CONSTRAINT_DEGREE = 9
const NUM_DEEP_TERMS = 282
const LOOKUP_FRACTIONS_PER_ROW = 78     # matches AIR_SHAPE.lookup.fractions_per_row
const CORE_BOUNDARY_LOOKUP_TERMS = 3    # emit_core_boundary: block-hash seed + 2 log-deferred terms

# Bounds on an AIR log trace height, matching `assert_shape_log`. They reject invalid relation
# shapes before a security descriptor is constructed and keep its fixed-point arithmetic in the
# common estimator's supported u32 domain.
const LOG_HEIGHT_MIN = 6
const LOG_HEIGHT_MAX = 29

# Offset of K in the P | K | I | O claim encoding.
const KERNEL_COMMITMENT_OFFSET = 4

# Domain tag for the kernel commitment: the registered selector
# (KERNEL_COMMITMENT_DOMAIN_ID << 8) | version = (0x010000 << 8) | 1.
# Must match miden_core::program::KERNEL_DOMAIN_TAG (enforced by cross-tests).
const KERNEL_DOMAIN_TAG = 0x01000001

const FELTS_PER_KERNEL_DIGEST = 4

# Must match KernelDescriptor::MAX_NUM_PROCEDURES.
const MAX_NUM_KERNEL_PROCEDURES = 255
const AND8_LOOKUP_LOG_HEIGHT = 16

# RELATION_DIGEST = Eidos::hash_elements([PROTOCOL_ID, ACE_CIRCUIT_DIGEST]).
const RELATION_DIGEST_0 = 1334130675330914798
const RELATION_DIGEST_1 = 9150815126231542754
const RELATION_DIGEST_2 = 1441196807745704811
const RELATION_DIGEST_3 = 3761162031092671873

# Commitment to the canonical And8 preprocessed table under the Eidos LMCS setup.
const AND8_PREPROCESSED_TRACE_COM_0 = 6268951225194987386
const AND8_PREPROCESSED_TRACE_COM_1 = 4849911536323772979
const AND8_PREPROCESSED_TRACE_COM_2 = 8427269700199674086
const AND8_PREPROCESSED_TRACE_COM_3 = 7952151839024097748

#! Loads the VM-specific AIR context used by the generic STARK verifier.
#!
#! Advice supplies log heights in fixed instance order:
#!   [log_core, log_chiplets, log_eidos_compression]
#!
#! The And8 lookup height is fixed verifier setup.
#!
#! Writes the trace shape, proof-order tag, relation commitments, and fixed OOD/query-row
#! addresses to verifier memory.
pub proc load_air_context
    adv_push
    exec.assert_shape_log
    exec.layout::set_core_trace_length_log

    adv_push
    exec.assert_shape_log
    exec.layout::set_chiplets_trace_length_log

    adv_push
    exec.assert_shape_log
    exec.layout::set_eidos_compression_trace_length_log

    push.AND8_LOOKUP_LOG_HEIGHT
    exec.layout::set_and8_lookup_trace_length_log

    exec.layout::get_core_trace_length_log
    exec.layout::get_chiplets_trace_length_log
    u32max
    exec.layout::get_eidos_compression_trace_length_log
    u32max
    exec.layout::get_and8_lookup_trace_length_log
    u32max
    exec.constants::set_trace_length_log

    # Route each AIR's canonical out-of-domain destination to its proof-order stream position.
    # The heights are stored above and unchanged from here on, so this runs once per proof rather
    # than once per ingested row.
    exec.ood_frames::stage_ood_scatter_table

    exec.store_relation_digest
    exec.store_and8_preprocessed_trace_commitment
    exec.layout::ood_evaluations_ptr
    exec.constants::set_ood_evaluations_address
    exec.layout::current_trace_row_ptr
    exec.constants::set_current_trace_row_address
    exec.layout::auxiliary_ace_inputs_ptr
    exec.constants::set_auxiliary_ace_inputs_address
    exec.layout::aux_rand_elem_ptr
    exec.constants::set_aux_rand_elem_address
end

proc assert_shape_log
    dup u32assert.err="AIR log height must be u32"
    dup u32gte.LOG_HEIGHT_MIN assert.err="AIR log height below minimum"
    dup u32lte.LOG_HEIGHT_MAX assert.err="AIR log height above maximum"
    drop
end

proc store_relation_digest
    push.RELATION_DIGEST_3.RELATION_DIGEST_2.RELATION_DIGEST_1.RELATION_DIGEST_0
    exec.constants::relation_digest_ptr mem_storew_le
    # Relation metadata is memory-only; leave the caller stack unchanged.
    dropw
end

proc store_and8_preprocessed_trace_commitment
    push.AND8_PREPROCESSED_TRACE_COM_3.AND8_PREPROCESSED_TRACE_COM_2.AND8_PREPROCESSED_TRACE_COM_1.AND8_PREPROCESSED_TRACE_COM_0
    exec.constants::preprocessed_trace_com_ptr mem_storew_le
    dropw
end

#! Materializes and authenticates the kernel witness named by the staged claim.
#!
#! The digest list and its validated procedure count are stored for the kernel-ROM boundary check.
#!
#! Input:  [...]
#! Output: [...]
proc materialize_kernel_witness
    padw exec.layout::claim_ptr add.KERNEL_COMMITMENT_OFFSET mem_loadw_le
    # => [K, ...]
    adv.push_mapvaln
    adv_push
    # => [num_kernel_felts, K, ...]   advice: [digest_0, .., digest_{n-1}]

    u32assert.err="kernel witness length must fit in a u32"
    dup u32mod.FELTS_PER_KERNEL_DIGEST
    assertz.err="kernel witness length must be word-aligned"
    div.FELTS_PER_KERNEL_DIGEST
    dup u32lte.MAX_NUM_KERNEL_PROCEDURES
    assert.err="number of kernel procedures exceeds KernelDescriptor::MAX_NUM_PROCEDURES"
    # => [num_kernel_procedures, K, ...]

    dup exec.layout::num_kernel_procedures_ptr mem_store
    # => [num_kernel_procedures, K, ...]

    exec.layout::kernel_witness_ptr swap
    push.KERNEL_DOMAIN_TAG
    exec.mem::pipe_words_to_memory_in_domain
    # => [K', end_ptr, K, ...]

    # Discard the end pointer, then authenticate the copied witness.
    movup.4 drop
    # => [K', K, ...]
    assert_eqw.err="fetched kernel digests do not hash to the claim's kernel commitment"
    # => [...]
end

#! Builds the common security descriptor from the four transcript-bound proof parameters returned
#! by the generic STARK verifier and the MVM relation data.
#!
#! The AIR shape and per-row lookup count are fixed by this relation. The one-time lookup boundary
#! count is `CORE_BOUNDARY_LOOKUP_TERMS + num_kernel_procedures`; the latter was derived from the
#! kernel witness and authenticated against the claim's kernel commitment before proof
#! verification.
#!
#! Inputs:  [num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]
#! Outputs: [lookup_pow_bits, num_composed_constraints, max_constraint_degree, num_deep_terms,
#!          max_message_width, num_lookup_boundary_terms, lookup_fractions_per_row,
#!          log_max_height, num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]
proc build_security_descriptor
    exec.constants::get_trace_length_log
    push.LOOKUP_FRACTIONS_PER_ROW
    exec.layout::num_kernel_procedures_ptr mem_load
    add.CORE_BOUNDARY_LOOKUP_TERMS
    push.MAX_MESSAGE_WIDTH
    push.NUM_DEEP_TERMS
    push.MAX_CONSTRAINT_DEGREE
    push.NUM_COMPOSED_CONSTRAINTS
    push.LOOKUP_POW_BITS
end

#! Verifies a lifted-STARK proof of the Miden VM execution claim named by the caller-provided
#! commitment and returns the common security descriptor followed by the deferred obligation.
#!
#! The claim preimage is fetched from the advice map under the caller-provided claim commitment,
#! authenticated, and stored in verifier-owned memory. The proof is consumed from the advice
#! stack; request keys name this procedure's MAST root
#! (`CoreLibrary::vm_recursive_verifier_root` on the operator side). A consumer that fetches the
#! proof by content derives the identical root in-VM via `procref` of this procedure, computes
#! `proof_request_key(verifier_root, claim_commitment)` with `sys::build_proof_request_key`, and
#! moves the registered proof package onto the advice stack before calling it.
#!
#! The four proof parameters are loaded from advice, structurally validated, and bound into the
#! Fiat-Shamir transcript. The maximum trace height is likewise transcript-bound. The remaining
#! descriptor fields are fixed by this verifier's relation, except for the boundary count derived
#! from the kernel witness authenticated against the claim. The caller passes the returned twelve
#! elements unchanged to `stark::security::compute_conjectured_security_level`, then applies its
#! own acceptance policy. The estimation formula and policy remain outside this procedure.
#! Changing only the formula therefore changes the estimator root without changing this verifier's
#! root. A change to the proof format or to any value supplied by the verifier still changes this
#! procedure.
#!
#! This verifier accepts 7..=150 queries, 0..=31 query/DEEP/folding grinding bits, fixed zero
#! lookup grinding, 6..=29 for every AIR log trace height, and 0..=255 kernel procedures.
#!
#! The claim preimage is encoded as `P (+0) | K (+4) | I (+8) | O (+24)`. The verifier checks its
#! commitment before using these values as AIR public inputs.
#!
#! The verifier fetches the kernel digest list from the advice map under K, copies it to
#! `layout::kernel_witness_ptr`, and checks that it hashes to K. It binds the transcript to the
#! claim commitment and checks the kernel-ROM boundary against this list.
#!
#! The returned deferred root is bound by the verified statement. The caller must settle it or
#! include it in its own statement. `D == TRUE_DIGEST` means no deferred statements were logged.
#!
#! Inputs:  [CLAIM_COMMITMENT, ...]
#! Outputs: [lookup_pow_bits, num_composed_constraints, max_constraint_degree, num_deep_terms,
#!           max_message_width, num_lookup_boundary_terms, lookup_fractions_per_row,
#!           log_max_height, num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, D, ...]
#!
#! Where:
#! - CLAIM_COMMITMENT is supplied by the caller and binds the advice-supplied claim preimage.
#! - The first twelve elements are the common security descriptor documented by
#!   `stark::security::compute_conjectured_security_level`.
#! - D is the deferred root bound by the verified statement.
#!
#! Invocation: exec
pub proc verify_proof(claim_commitment: word) -> (
    lookup_pow_bits: u32,
    num_composed_constraints: u32,
    max_constraint_degree: u32,
    num_deep_terms: u32,
    max_message_width: u32,
    num_lookup_boundary_terms: u32,
    lookup_fractions_per_row: u32,
    log_max_height: u32,
    num_queries: u32,
    query_pow_bits: u32,
    deep_pow_bits: u32,
    folding_pow_bits: u32,
    deferred_root: word,
)
    # --- Authenticate execution claim -----------------------------------------------------------

    # Preserve the commitment until public inputs are absorbed after transcript initialization.
    exec.layout::claim_commitment_ptr mem_storew_le
    exec.layout::claim_ptr exec.claim::materialize_claim
    # => [...]

    # --- Prepare MVM verifier state --------------------------------------------------------------

    exec.utils::load_security_params
    exec.materialize_kernel_witness
    exec.public_inputs::stage_boundary_inputs
    exec.load_air_context

    # --- Verify ----------------------------------------------------------------------------------

    # Dynamic hook digests in the generic verifier's ABI order.
    procref.deep_queries::compute_deep_composition_polynomial_queries
    procref.constraints_eval::execute_constraint_evaluation_check
    procref.ood_frames::process_row_ood_evaluations
    procref.public_inputs::process_public_inputs
    procref.aux_trace::observe_aux_trace
    # => [D0, D1, D2, D3, D4]

    exec.verifier::verify
    # => [num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]

    # --- Return result ---------------------------------------------------------------------------

    exec.public_inputs::load_deferred_root
    # => [D, num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]
    swapw
    # => [num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, D, ...]
    exec.build_security_descriptor
    # => [security_descriptor, D, ...]
end
