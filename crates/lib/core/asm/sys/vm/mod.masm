    exec.layout::get_eidos_compression_trace_length_log
    u32max
    exec.layout::get_and8_lookup_trace_length_log
    u32max
    mem_store.LOG_TRACE_LENGTH_PTR
    exec.layout::stage_verifier_parameters
    exec.proof_order::stage_proof_order_maps_4
    exec.layout::stage_ood_scatter_table
    exec.store_relation_digest
    exec.store_and8_preprocessed_trace_commitment
    exec.layout::ood_evaluations_ptr
    mem_store.OOD_EVALUATIONS_ADDRESS_PTR
    exec.layout::current_trace_row_ptr
    mem_store.CURRENT_TRACE_ROW_ADDRESS_PTR
