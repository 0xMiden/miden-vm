pub mod aux_trace
pub mod claim
pub mod constraints_eval
pub mod deep_queries
pub mod layout
pub mod ood_frames
pub mod public_inputs

use miden::core::mem
use miden::core::stark::utils
use miden::core::stark::constants
use miden::core::stark::verifier

# Offset of K in the P | K | I | O claim encoding.
const KERNEL_COMMITMENT_OFFSET = 4

# Domain tag for the kernel commitment: the registered selector
# (KERNEL_COMMITMENT_DOMAIN_ID << 8) | version = (0x010000 << 8) | 1, per the Miden
# domain-separation RFC (https://github.com/0xMiden/crypto/pull/1026).
# Must match miden_core::program::KERNEL_DOMAIN_TAG (enforced by cross-tests).
const KERNEL_DOMAIN_TAG = 0x01000001

const FELTS_PER_KERNEL_DIGEST = 4

# Must match KernelDescriptor::MAX_NUM_PROCEDURES.
const MAX_NUM_KERNEL_PROCEDURES = 255
# Number of AIR instances contributing to the proof order.
const NUM_MIDEN_AIRS = 3

# RELATION_DIGEST = hash(PROTOCOL_ID, ACE_REGISTRY_ROOT).
const RELATION_DIGEST_0 = 8509919582315365814
const RELATION_DIGEST_1 = 12865978328275266043
const RELATION_DIGEST_2 = 12073117316737140237
const RELATION_DIGEST_3 = 5647109555087128169

# Root of the accepted ACE circuit registry. Leaves are indexed by ORDER_TAG.
const ACE_REGISTRY_ROOT_0 = 8563712008625779037
const ACE_REGISTRY_ROOT_1 = 2346635758357605862
const ACE_REGISTRY_ROOT_2 = 17725435322360039753
const ACE_REGISTRY_ROOT_3 = 12106900609136090006

#! Loads the VM-specific AIR context used by the generic STARK verifier.
#!
#! Advice supplies log heights in fixed instance order:
#!   [log_core, log_chiplets, log_poseidon2_permutation]
#!
#! Writes the trace shape, proof-order tag, relation commitments, and fixed OOD/query-row
#! addresses to verifier memory.
pub proc load_air_context
    adv_push
    exec.assert_shape_log
    exec.layout::set_core_trace_length_log

    adv_push
    exec.assert_shape_log
    exec.layout::set_chiplets_trace_length_log

    adv_push
    exec.assert_shape_log
    exec.layout::set_poseidon2_permutation_trace_length_log

    exec.layout::get_core_trace_length_log
    exec.layout::get_chiplets_trace_length_log
    u32max
    exec.layout::get_poseidon2_permutation_trace_length_log
    u32max
    exec.constants::set_trace_length_log

    exec.derive_order_tag
    exec.constants::set_order_tag

    exec.store_relation_digest
    exec.store_ace_registry_root
    exec.layout::ood_evaluations_ptr
    exec.constants::set_ood_evaluations_address
    exec.layout::current_trace_row_ptr
    exec.constants::set_current_trace_row_address
end

proc assert_shape_log
    dup u32assert.err="AIR log height must be u32"
    dup u32gt.5 assert.err="AIR log height below minimum"
    dup u32lt.30 assert.err="AIR log height above maximum"
    drop
end

#! Derives the Lehmer proof-order tag of the height-sorted proof order.
#!
#! The proof order sorts the AIRs by ascending log height; the canonical instance order
#! breaks ties (a stable sort). For each canonical AIR k with log height h_k:
#!
#!   inv_k   = #{m < k : h_m > h_k}     inversions contributed by AIR k
#!   after_k = #{m > k : h_m < h_k}
#!   pos_k   = k - inv_k + after_k      position of AIR k in the proof order
#!   tag    += inv_k * (NUM_MIDEN_AIRS - 1 - pos_k)!
#!
#! The comparisons are branch-free (flag products), so the derivation is a flat
#! NUM_MIDEN_AIRS^2 comparison sweep plus one small factorial per AIR.
#!
#! `pos_k` is always in `0 .. NUM_MIDEN_AIRS - 1` (inv_k <= k and k + after_k <= N - 1), so the
#! factorial argument never underflows the field.
#!
#! This VM-local specialization keeps the three-AIR loop bounds compile-time constants. New
#! relations should use `stark::utils::derive_order_tag_from_heights`; tests pin both paths to the
#! same Rust ranking. Changing the VM AIR set requires updating `NUM_MIDEN_AIRS`, its relation
#! layout accessors, and the public-input schema; regeneration checks pin those copies.
#!
#! Input:  []
#! Output: [tag]
proc derive_order_tag
    push.0.0
    # => [k = 0, tag = 0]

    repeat.NUM_MIDEN_AIRS
        dup exec.constants::air_trace_length_logs_ptr add mem_load
        # => [h_k, k, tag]

        push.0.0 push.0
        # => [m = 0, inv = 0, after = 0, h_k, k, tag]

        repeat.NUM_MIDEN_AIRS
            dup exec.constants::air_trace_length_logs_ptr add mem_load
            # => [h_m, m, inv, after, h_k, k, tag]

            # inv += (m < k) * (h_m > h_k)
            dup dup.5 u32gt
            dup.2 dup.7 u32lt
            mul
            # => [flag, h_m, m, inv, after, h_k, k, tag]
            movup.3 add movdn.2
            # => [h_m, m, inv', after, h_k, k, tag]

            # after += (m > k) * (h_m < h_k)
            dup dup.5 u32lt
            dup.2 dup.7 u32gt
            mul
            # => [flag, h_m, m, inv, after, h_k, k, tag]
            movup.4 add movdn.3
            # => [h_m, m, inv, after', h_k, k, tag]

            drop add.1
            # => [m + 1, inv, after, h_k, k, tag]
        end
        drop
        # => [inv, after, h_k, k, tag]

        # pos = k - inv + after
        dup.3 dup.1 sub
        movup.2 add
        # => [pos, inv, h_k, k, tag]

        # tag += inv * (NUM_MIDEN_AIRS - 1 - pos)!
        push.NUM_MIDEN_AIRS sub.1 swap sub
        exec.factorial
        mul
        # => [inv * weight, h_k, k, tag]
        movup.3 add movdn.2
        # => [h_k, k, tag']

        drop add.1
        # => [k + 1, tag']
    end
    drop
    # => [tag]
end

#! Computes x! for small x.
#!
#! Input:  [x]
#! Output: [x!]
proc factorial
    push.1 swap
    # => [x, acc = 1]
    dup push.0 neq
    while.true
        # => [x, acc] with x > 0
        dup movup.2 mul
        # => [acc * x, x]
        swap sub.1
        # => [x - 1, acc']
        dup push.0 neq
    end
    drop
    # => [acc]
end

proc store_relation_digest
    push.RELATION_DIGEST_3.RELATION_DIGEST_2.RELATION_DIGEST_1.RELATION_DIGEST_0
    exec.constants::relation_digest_ptr mem_storew_le
    # Relation metadata is memory-only; leave the caller stack unchanged.
    dropw
end

proc store_ace_registry_root
    push.ACE_REGISTRY_ROOT_3.ACE_REGISTRY_ROOT_2.ACE_REGISTRY_ROOT_1.ACE_REGISTRY_ROOT_0
    exec.constants::ace_registry_root_ptr mem_storew_le
    # Relation metadata is memory-only; leave the caller stack unchanged.
    dropw
end

#! Materializes and authenticates the kernel witness named by the staged claim.
#!
#! The digest list and its validated procedure count are stored for the kernel-ROM boundary check.
#!
#! Input:  [...]
#! Output: [...]
proc materialize_kernel_witness
    padw exec.layout::claim_ptr add.KERNEL_COMMITMENT_OFFSET mem_loadw_le
    # => [K, ...]
    adv.push_mapvaln
    adv_push
    # => [num_kernel_felts, K, ...]   advice: [digest_0, .., digest_{n-1}]

    u32assert.err="kernel witness length must fit in a u32"
    dup u32mod.FELTS_PER_KERNEL_DIGEST
    assertz.err="kernel witness length must be word-aligned"
    div.FELTS_PER_KERNEL_DIGEST
    dup u32lte.MAX_NUM_KERNEL_PROCEDURES
    assert.err="number of kernel procedures exceeds KernelDescriptor::MAX_NUM_PROCEDURES"
    # => [num_kernel_procedures, K, ...]

    dup exec.layout::num_kernel_procedures_ptr mem_store
    # => [num_kernel_procedures, K, ...]

    exec.layout::kernel_witness_ptr swap
    push.KERNEL_DOMAIN_TAG
    exec.mem::pipe_words_to_memory_in_domain
    # => [K', end_ptr, K, ...]

    # Discard the end pointer, then authenticate the copied witness.
    movup.4 drop
    # => [K', K, ...]
    assert_eqw.err="fetched kernel digests do not hash to the claim's kernel commitment"
    # => [...]
end

#! Verifies a STARK proof of the execution claim named by the caller-provided commitment and
#! returns the deferred obligation and transcript-bound security parameters.
#!
#! The claim preimage is fetched from the advice map under the caller-provided claim commitment,
#! authenticated, and stored in verifier-owned memory. The proof is consumed from the advice
#! stack; request keys name this procedure's MAST root
#! (`CoreLibrary::recursive_verifier_root` on the operator side). A consumer that fetches the
#! proof by content derives the identical root in-VM via `procref` of this procedure, computes
#! `proof_request_key(verifier_root, claim_commitment)` with `sys::build_proof_request_key`, and
#! moves the registered proof package onto the advice stack before calling it.
#!
#! Security parameters (num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits) are loaded
#! from the advice stack and stored in memory for the generic verifier, which enforces their
#! structural bounds and binds them into the Fiat-Shamir transcript - so a proof cannot claim
#! parameters it was not produced with. This procedure holds no security-estimate formula and
#! no acceptance policy: it returns the transcript-bound parameters for the caller to grade (e.g.
#! with `stark::utils::conjectured_security_level`) under its own policy. An estimate or policy
#! change therefore never moves this procedure's root - request keys and registered proof packages
#! stay valid across such changes.
#!
#! The claim preimage is encoded as `P (+0) | K (+4) | I (+8) | O (+24)`. The verifier checks its
#! commitment before using these values as AIR public inputs.
#!
#! The verifier fetches the kernel digest list from the advice map under K, copies it to
#! `layout::kernel_witness_ptr`, and checks that it hashes to K. It binds the transcript to the
#! claim commitment and checks the kernel-ROM boundary against this list.
#!
#! The returned deferred root is bound by the verified statement. The caller must settle it or
#! include it in its own statement. `D == TRUE_DIGEST` means no deferred statements were logged.
#!
#! Inputs:  [CLAIM_COMMITMENT, ...]
#! Outputs: [D, num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]
#!
#! Where:
#! - CLAIM_COMMITMENT is supplied by the caller and binds the advice-supplied claim preimage.
#! - D is the deferred root bound by the verified statement.
#! - num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits are the proof's
#!   transcript-bound security parameters.
pub proc verify_vm_proof(claim_commitment: word) -> (
    deferred_root: word,
    num_queries: u32,
    query_pow_bits: u32,
    deep_pow_bits: u32,
    folding_pow_bits: u32,
)
    # --- Authenticate execution claim -----------------------------------------------------------

    # Preserve the commitment until public inputs are absorbed after transcript initialization.
    exec.layout::claim_commitment_ptr mem_storew_le
    exec.layout::claim_ptr exec.claim::materialize_claim
    # => [...]

    # --- Prepare VM verifier state ---------------------------------------------------------------

    exec.utils::load_security_params
    exec.materialize_kernel_witness
    exec.public_inputs::stage_boundary_inputs
    exec.load_air_context

    # --- Verify ----------------------------------------------------------------------------------

    procref.deep_queries::compute_deep_composition_polynomial_queries
    procref.constraints_eval::execute_constraint_evaluation_check
    procref.ood_frames::process_row_ood_evaluations
    procref.public_inputs::process_public_inputs
    procref.aux_trace::observe_aux_trace
    # => [D0, D1, D2, D3, D4]

    exec.verifier::verify
    # => [...]

    # --- Return result ---------------------------------------------------------------------------

    # => [num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]
    exec.public_inputs::load_deferred_root
    # => [D, num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]
end
