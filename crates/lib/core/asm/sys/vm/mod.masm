    mem_store.AUXILIARY_ACE_INPUTS_ADDRESS_PTR
    exec.layout::aux_rand_elem_ptr
    mem_store.AUX_RAND_ELEM_ADDRESS_PTR
end

#! Preserve the relation-specific order of shape validation errors.
proc assert_shape_log(height: felt) -> u8
    dup
    u32assert.err="AIR log height must be u32"
    dup
    u32gte.LOG_HEIGHT_MIN
    assert.err="AIR log height below minimum"
    dup
    u32lte.LOG_HEIGHT_MAX
    assert.err="AIR log height above maximum"
    drop
end

proc store_relation_digest()
    push.RELATION_DIGEST_3.RELATION_DIGEST_2.RELATION_DIGEST_1.RELATION_DIGEST_0
    mem_storew_le.RELATION_DIGEST_PTR
    dropw
end

proc store_and8_preprocessed_trace_commitment
    push.AND8_PREPROCESSED_TRACE_COM_3.AND8_PREPROCESSED_TRACE_COM_2.AND8_PREPROCESSED_TRACE_COM_1.AND8_PREPROCESSED_TRACE_COM_0
    mem_storew_le.PREPROCESSED_TRACE_COM_PTR
    dropw
end

#! Validate witness length before copying and authenticating under the kernel domain.
proc materialize_kernel_witness()
    padw
    exec.layout::claim_ptr
    add.KERNEL_COMMITMENT_OFFSET
    mem_loadw_le
    adv.push_mapvaln
    adv_push
    u32assert.err="kernel witness length must fit in a u32"
    dup
    u32mod.FELTS_PER_KERNEL_DIGEST
    assertz.err="kernel witness length must be word-aligned"
    div.FELTS_PER_KERNEL_DIGEST
    dup
    u32lte.MAX_NUM_KERNEL_PROCEDURES
    assert.err="number of kernel procedures exceeds KernelDescriptor::MAX_NUM_PROCEDURES"
    dup
    exec.layout::num_kernel_procedures_ptr
    mem_store
    exec.layout::kernel_witness_ptr
    swap
    push.KERNEL_DOMAIN_TAG
    exec.mem::pipe_words_to_memory_in_domain
    movup.4
    drop
    assert_eqw.err="fetched kernel digests do not hash to the claim's kernel commitment"
end

#! Assemble the security descriptor in the required ABI push order.
proc build_security_descriptor(parameters: types::StackProofParameters) -> types::StackSecurityDescriptor
    mem_load.LOG_TRACE_LENGTH_PTR
    push.LOOKUP_FRACTIONS_PER_ROW
    exec.layout::num_kernel_procedures_ptr
    mem_load
    add.CORE_BOUNDARY_LOOKUP_TERMS
    push.MAX_MESSAGE_WIDTH
    push.NUM_DEEP_TERMS
    push.MAX_CONSTRAINT_DEGREE
    push.NUM_COMPOSED_CONSTRAINTS
    push.LOOKUP_POW_BITS
end

#! Reserve the call window before entering the isolated verifier.
pub proc verify_proof(claim_commitment: types::Digest) -> (types::StackSecurityDescriptor, types::Digest)
    padw
    padw
    padw
    swapw.3
    call.verify_proof_inner
end

#! Stage context, register hooks in ABI order, verify, then construct the descriptor.
proc verify_proof_inner(claim_commitment: types::Digest) -> (types::StackSecurityDescriptor, types::Digest)
    exec.layout::claim_commitment_ptr
    mem_storew_le
    exec.layout::claim_ptr
    exec.claim::materialize_claim
    exec.utils::load_security_params
    exec.materialize_kernel_witness
    exec.public_inputs::stage_boundary_inputs
    exec.load_air_context
    procref.deep::compute_deep_composition_polynomial_queries
    procref.evaluator::execute_constraint_evaluation_check_4
    procref.ood::process_row_ood_evaluations_4
    procref.public_inputs::process_public_inputs
    procref.aux_trace::observe_aux_trace
    exec.verifier::verify
    exec.build_security_descriptor
    repeat.3
        movupw.3
        dropw
    end
    swapw.3
    exec.layout::boundary_inputs_ptr
    add.DEFERRED_ROOT_OFFSET
    mem_loadw_le
    swapw.3
end
