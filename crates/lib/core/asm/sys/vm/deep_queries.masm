proc process_constraints_composition_poly_trace( scratch: word, evaluation: types::HornerState, depth: u8, index: u32, query_ptr: ptr<word>, ) -> (word, types::EvaluationPair, u32, ptr<word>)
    mem_loadw_le.COMPOSITION_POLY_COM_PTR
