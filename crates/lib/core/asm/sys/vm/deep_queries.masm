const AND8_LDE_INDEX_MASK = 524287

#! Authenticate each row before generic DEEP evaluation.
pub proc compute_deep_composition_polynomial_queries( scratch: word, query_ptr: ptr<word>, query_end_ptr: ptr<word>, fixed_terms: types::EvaluationPair, queries_start: ptr<word>, )
    push.1
    while.true
        exec.load_query_row
        exec.deep_queries::compute_deep_query
    end
    dropw
    dropw
    drop
    drop
    drop
end

#! Preserve preprocessed, main, auxiliary and quotient opening order.
proc load_query_row( scratch: word, query_ptr: ptr<word>, ) -> (word, types::EvaluationPair, u32, ptr<word>)
    exec.process_preprocessed_segment
    exec.process_main_segment_execution_trace
    exec.process_aux_segment_execution_trace
    exec.process_constraints_composition_poly_trace
end

proc process_preprocessed_segment
    dup.4
    mem_loadw_le
    movdn.3
    movdn.2
    push.0.0
    mem_loadw_le.PREPROCESSED_TRACE_COM_PTR
    dup.5
    push.AND8_LDE_INDEX_MASK
    u32and
    exec.layout::get_and8_lookup_trace_length_log
    push.LOG_BLOWUP_FACTOR
    add
    mtree_get
    mem_storew_le.TMP3_PTR
    adv.push_mapval
    mem_loadw_le.TMP2_PTR
    swapw
    push.EIDOS_LMCS_INIT_CV_8
    swapw
    padw
    exec.load_preprocessed_segment
    swapw.2
    padw
    mem_loadw_le.TMP3_PTR
    assert_eqw.err=PREPROCESSED_LEAF_VALUE_MISMATCH
    dropw
end

proc load_preprocessed_segment
    repeat.1
        adv_pipe
        horner_eval_base
        exec.eidos::compress
    end
end

proc process_main_segment_execution_trace( scratch: word, query_ptr: ptr<word>, ) -> (word, types::HornerState, u8, u32, ptr<word>)
