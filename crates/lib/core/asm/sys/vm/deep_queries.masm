    COMPOSITION_POLY_COM_PTR,
    MAIN_TRACE_COM_PTR,
    PREPROCESSED_TRACE_COM_PTR,
    TMP2_PTR,
    TMP3_PTR,
} from miden::core::stark::constants
use miden::core::stark::types
use {
    AUX_LMCS_INIT_CV,
    AUX_ROW_DOUBLE_WORDS,
    MAIN_LMCS_INIT_CV,
    MAIN_ROW_DOUBLE_WORDS,
    PREPROCESSED_INDEX_MASK,
