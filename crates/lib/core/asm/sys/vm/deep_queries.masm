} from miden::core::sys::vm::parameters
use miden::core::crypto::hashes::eidos
use miden::core::stark::deep_queries

# ERRORS
# =================================================================================================

const PREPROCESSED_LEAF_VALUE_MISMATCH = "preprocessed query leaf hash mismatch"
const MAIN_LEAF_VALUE_MISMATCH = "main query leaf hash mismatch"
const AUX_LEAF_VALUE_MISMATCH = "aux query leaf hash mismatch"
const QUOTIENT_LEAF_VALUE_MISMATCH = "quotient query leaf hash mismatch"

# MAIN PROCEDURE
# =================================================================================================

#! Computes the DEEP composition-polynomial FRI queries.
#!
#! The opened row is reduced in commitment-group order: preprocessed, main, auxiliary, quotient.
#! The preprocessed group authenticates at its setup-fixed depth using the low bits of the
#! full-domain query index; every other group authenticates at the full query depth.
#!
#! Call after `stark::deep_queries::prepare_stack_deep_queries_computation`. The word-aligned
#! range [query_ptr, query_end_ptr) must be nonempty. Each [index, depth, index, 0] record is
#! replaced by [domain_generator^index, index, evaluation_0, evaluation_1].
#!
#! Inputs:  [scratch(4), query_ptr, query_end_ptr, fixed_terms(4), queries_start, ...]
#! Outputs: [...]
pub proc compute_deep_composition_polynomial_queries(
    scratch: word,
    query_ptr: ptr<word>,
    query_end_ptr: ptr<word>,
    fixed_terms: types::EvaluationPair,
    queries_start: ptr<word>,
)
    # The verifier checks earlier that there is at least one query.
    push.1
    while.true
        exec.load_query_row
        # => [scratch(4), row_evaluations(4), index, query_ptr, query_end_ptr,
        #     fixed_terms(4), queries_start, ...]

        exec.deep_queries::compute_deep_query
        # => [has_more_queries, scratch(4), query_ptr+4, query_end_ptr,
        #     fixed_terms(4), queries_start, ...]
    end

    dropw dropw drop drop drop
end

# QUERY ROW
# =================================================================================================

#! Authenticates all four commitment groups and carries one Horner accumulator across them.
#! Auxiliary and quotient rows contain flattened base-field coordinates.
#! TMP2 supplies the initial [row_ptr, alpha_ptr, 0, 0] state.
#!
#! Inputs:  [scratch(4), query_ptr, ...]
#! Outputs: [scratch(4), q_x_0, q_x_1, q_x_0, q_x_1, index, query_ptr, ...]
proc load_query_row(
    scratch: word,
    query_ptr: ptr<word>,
) -> (word, types::EvaluationPair, u32, ptr<word>)
    # Load [index, full_depth, index, 0] from the query word.
    dup.4 mem_loadw_le
    movdn.3 movdn.2
    push.0.0
    mem_loadw_le.PREPROCESSED_TRACE_COM_PTR
    # => [ROOT(4), full_depth, index, query_ptr, ...]

    # Only the preprocessed opening masks the index to its fixed setup domain.
    dup.5 push.PREPROCESSED_INDEX_MASK u32and
    push.PREPROCESSED_TREE_DEPTH
    exec.open_row
    # => [LEAF(4), ROOT(4), full_depth, index, query_ptr, ...]

    # Initialize the row pointer and accumulator once, below the first hash state.
    padw mem_loadw_le.TMP2_PTR
    push.PREPROCESSED_LMCS_INIT_CV
    swapdw
    # => [block_scratch(8), cv(4), row_ptr, alpha_ptr, acc0, acc1,
    #     full_depth, index, query_ptr, ...]
    exec.read_preprocessed_row
    # => [scratch(4), evaluation(4), full_depth, index, query_ptr, ...]

    # Main and auxiliary openings use the full-domain depth and index.
    mem_loadw_le.MAIN_TRACE_COM_PTR
    dup.9 dup.9
    exec.open_row
    push.MAIN_LMCS_INIT_CV
    movdnw.2
    exec.read_main_row

    mem_loadw_le.AUX_TRACE_COM_PTR
    dup.9 dup.9
    exec.open_row
    push.AUX_LMCS_INIT_CV
    movdnw.2
    exec.read_aux_row
    # => [scratch(4), evaluation(4), full_depth, index, query_ptr, ...]

    # The last opening consumes the shared depth, preserving the full query index.
    mem_loadw_le.COMPOSITION_POLY_COM_PTR
    movup.8 dup.9 swap
    exec.open_row
    push.QUOTIENT_LMCS_INIT_CV
    movdnw.2
    exec.read_quotient_row
    # => [scratch(4), row_ptr, alpha_ptr, acc0, acc1, index, query_ptr, ...]

    # Both OOD quotients use the same reduced row value.
    swapw
    drop drop
    dup.1 dup.1
    swapw
end

#! Fetches the leaf digest and places its advice-map entry on the advice stack.
#! TMP3 holds the authenticated digest until the row reader checks the hash of those advice values.
#!
#! Inputs:  [depth, index, ROOT(4), ...]
#! Outputs: [LEAF(4), ROOT(4), ...]
proc open_row(depth: u8, index: u32, root: types::Digest) -> (types::Digest, types::Digest)
    mtree_get
    mem_storew_le.TMP3_PTR
    adv.push_mapval
end

# ROW HASHING AND REDUCTION
# =================================================================================================

#! Streams and hashes one row of base-field coordinates, extending the Horner reduction.
#! Requires the row values on advice and the authenticated leaf digest from `open_row` in TMP3.
#! The caller supplies this group's LMCS initializer in `state`; the first advice load overwrites
#! the two scratch words. The generator requires a positive block count.
#!
#! Inputs:  [block_scratch(8), cv(4), row_ptr, alpha_ptr, acc0, acc1, ...]
#! Outputs: [scratch(4), row_ptr', alpha_ptr, acc0', acc1', ...]
proc read_preprocessed_row(
    state: types::EidosState,
    evaluation: types::HornerState,
) -> (word, types::HornerState)
    repeat.PREPROCESSED_ROW_DOUBLE_WORDS
        adv_pipe
        horner_eval_base
        exec.eidos::compress
    end

    mem_loadw_le.TMP3_PTR
    movupw.2
    assert_eqw.err=PREPROCESSED_LEAF_VALUE_MISMATCH
end

#! Streams and hashes one row of base-field coordinates, extending the Horner reduction.
#! Requires the row values on advice and the authenticated leaf digest from `open_row` in TMP3.
#! The caller supplies this group's LMCS initializer in `state`; the first advice load overwrites
#! the two scratch words. The generator requires a positive block count.
#!
#! Inputs:  [block_scratch(8), cv(4), row_ptr, alpha_ptr, acc0, acc1, ...]
#! Outputs: [scratch(4), row_ptr', alpha_ptr, acc0', acc1', ...]
proc read_main_row(
    state: types::EidosState,
