use miden::core::crypto::hashes::eidos
use miden::core::mem

# EXECUTION CLAIM
# =================================================================================================
#
# The execution claim is the statement a Miden VM proof attests, encoded as a canonical 40-felt
# memory region:
#
#   claim_ptr + 0   P   program_digest              (1 word)
#   claim_ptr + 4   K   kernel_commitment           (1 word)
#   claim_ptr + 8   I   stack_inputs                (16 felts, canonical zero-padded)
#   claim_ptr + 24  O   stack_outputs               (16 felts, canonical zero-padded)
#
# The deferred root D is not part of the claim: it is the obligation a verified claim hands back.
#
# The claim commitment is the domain-tagged sequential hash of the region. 40 felts is exactly
# five Eidos blocks, so no padding block is absorbed and the (P, K) prefix state after block 1 is
# resumable by callsites that pin those fields. Mirrors
# miden_core::program::ExecutionClaim::commitment (enforced by cross-tests).

# Number of field elements in the canonical claim encoding.
const NUM_CLAIM_ELEMENTS = 40

# Initial CV for the claim commitment:
# init(EXECUTION_CLAIM = 0x01000101, [40, 0, 0]).
const CLAIM_INIT_CV = [4280581857109606657, 2688637132020383784, 1947077364412317696, 6620516959492505600]

#! Fetches a claim preimage from the advice map, copies it into memory, and checks its commitment.
#!
#! The advice-map value under CLAIM_COMMITMENT must be the canonical 40-felt claim encoding.
#!
#! Inputs:  [claim_ptr, CLAIM_COMMITMENT, ...]
#! Outputs: [...]
pub proc materialize_claim
    # Use CLAIM_COMMITMENT as the advice-map key while preserving claim_ptr.
    movdn.4
    adv.push_mapvaln
    adv_push
    eq.NUM_CLAIM_ELEMENTS assert.err="claim preimage has a non-canonical length"
    movup.4

    dup add.NUM_CLAIM_ELEMENTS swap
    # => [claim_ptr, end_ptr, CLAIM_COMMITMENT, ...]

    push.CLAIM_INIT_CV
    padw padw
    # => [BLOCK_LO=0w, BLOCK_HI=0w, CLAIM_INIT_CV, claim_ptr, end_ptr, CLAIM_COMMITMENT, ...]

    exec.mem::pipe_double_words_to_memory
    exec.eidos::digest
    # => [DIGEST, end_ptr, CLAIM_COMMITMENT, ...]

    movup.4 movdn.8
    assert_eqw.err="claim preimage commitment does not match"
    drop
end

#! Computes the canonical claim commitment (CLAIM_HASH) over a claim region.
#!
#! The region must hold the fully populated 40-felt claim encoding P ‖ K ‖ I ‖ O. The commitment
#! names the claim: it forms proof-request keys and binds verified claims into a consumer's own
#! statement. The procedure verifies nothing.
#!
#! Inputs:  [claim_ptr, ...]
#! Outputs: [CLAIM_HASH, ...]
#!
#! Where:
#! - claim_ptr is the word-aligned address of the claim region.
#! - CLAIM_HASH is the domain-tagged Eidos hash of the 40-element encoding.
pub proc claim_commitment
    dup add.NUM_CLAIM_ELEMENTS
    push.0 movdn.2 swap
    # => [claim_ptr, end_ptr, remainder=0, ...]

    push.CLAIM_INIT_CV
    padw padw
    # => [BLOCK_LO=0w, BLOCK_HI=0w, CLAIM_INIT_CV, claim_ptr, end_ptr, remainder=0, ...]

    exec.eidos::hash_elements_with_state
    # => [CLAIM_HASH, ...]
end
