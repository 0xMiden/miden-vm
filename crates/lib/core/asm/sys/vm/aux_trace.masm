use miden::core::stark::constants
use miden::core::stark::random_coin
use miden::core::sys::vm::public_inputs
use miden::core::sys::vm::layout

const ORDER_TAG_COUNT = 24

#! Load one normalized committed LogUp sum and scale both extension coordinates by the AIR's row
#! count `n = 2^log_height`.
#!
#! Input:  [boundary_offset, log_height, ...]
#! Output: [n_sigma_prime_0, n_sigma_prime_1, ...]
proc load_weighted_aux_sum
    swap pow2
    exec.layout::aux_bus_boundary_ptr movup.2 add

    dup mem_load
    dup.2 mul

    swap add.1 mem_load
    movup.2 mul swap
end

#! Push the four AIR log heights in the same proof order as the absorbed auxiliary boundary values.
#!
#! `ORDER_TAG` is the Lehmer rank of the proof-order permutation over
#! [Core, Chiplets, EidosCompression, And8Lookup].
#! The AIR set is fixed, so direct dispatch loads each height once instead of rescanning the
#! height array for every output position.
#!
#! Input:  [...]
#! Output: [log_0, log_1, log_2, log_3, ...]
pub proc push_proof_order_log_heights
    push.ORDER_TAG_COUNT exec.constants::assert_valid_order_tag
    exec.constants::get_order_tag
    dup eq.0
    if.true
        drop
        # Core, Chiplets, EidosCompression, And8Lookup.
        exec.layout::get_and8_lookup_trace_length_log
        exec.layout::get_eidos_compression_trace_length_log
        exec.layout::get_chiplets_trace_length_log
        exec.layout::get_core_trace_length_log
    else
        dup eq.1
        if.true
            drop
            # Core, Chiplets, And8Lookup, EidosCompression.
            exec.layout::get_eidos_compression_trace_length_log
            exec.layout::get_and8_lookup_trace_length_log
            exec.layout::get_chiplets_trace_length_log
            exec.layout::get_core_trace_length_log
        else
            dup eq.2
            if.true
                drop
                # Core, EidosCompression, Chiplets, And8Lookup.
                exec.layout::get_and8_lookup_trace_length_log
                exec.layout::get_chiplets_trace_length_log
                exec.layout::get_eidos_compression_trace_length_log
                exec.layout::get_core_trace_length_log
            else
                dup eq.3
                if.true
                    drop
                    # Core, EidosCompression, And8Lookup, Chiplets.
                    exec.layout::get_chiplets_trace_length_log
                    exec.layout::get_and8_lookup_trace_length_log
                    exec.layout::get_eidos_compression_trace_length_log
                    exec.layout::get_core_trace_length_log
                else
                    dup eq.4
                    if.true
                        drop
                        # Core, And8Lookup, Chiplets, EidosCompression.
                        exec.layout::get_eidos_compression_trace_length_log
                        exec.layout::get_chiplets_trace_length_log
                        exec.layout::get_and8_lookup_trace_length_log
                        exec.layout::get_core_trace_length_log
                    else
                        dup eq.5
                        if.true
                            drop
                            # Core, And8Lookup, EidosCompression, Chiplets.
                            exec.layout::get_chiplets_trace_length_log
                            exec.layout::get_eidos_compression_trace_length_log
                            exec.layout::get_and8_lookup_trace_length_log
                            exec.layout::get_core_trace_length_log
                        else
                            dup eq.6
                            if.true
                                drop
                                # Chiplets, Core, EidosCompression, And8Lookup.
                                exec.layout::get_and8_lookup_trace_length_log
                                exec.layout::get_eidos_compression_trace_length_log
                                exec.layout::get_core_trace_length_log
                                exec.layout::get_chiplets_trace_length_log
                            else
                                dup eq.7
                                if.true
                                    drop
                                    # Chiplets, Core, And8Lookup, EidosCompression.
                                    exec.layout::get_eidos_compression_trace_length_log
                                    exec.layout::get_and8_lookup_trace_length_log
                                    exec.layout::get_core_trace_length_log
                                    exec.layout::get_chiplets_trace_length_log
                                else
                                    dup eq.8
                                    if.true
                                        drop
                                        # Chiplets, EidosCompression, Core, And8Lookup.
                                        exec.layout::get_and8_lookup_trace_length_log
                                        exec.layout::get_core_trace_length_log
                                        exec.layout::get_eidos_compression_trace_length_log
                                        exec.layout::get_chiplets_trace_length_log
                                    else
                                        dup eq.9
                                        if.true
                                            drop
                                            # Chiplets, EidosCompression, And8Lookup, Core.
                                            exec.layout::get_core_trace_length_log
                                            exec.layout::get_and8_lookup_trace_length_log
                                            exec.layout::get_eidos_compression_trace_length_log
                                            exec.layout::get_chiplets_trace_length_log
                                        else
                                            dup eq.10
                                            if.true
                                                drop
                                                # Chiplets, And8Lookup, Core, EidosCompression.
                                                exec.layout::get_eidos_compression_trace_length_log
                                                exec.layout::get_core_trace_length_log
                                                exec.layout::get_and8_lookup_trace_length_log
                                                exec.layout::get_chiplets_trace_length_log
                                            else
                                                dup eq.11
                                                if.true
                                                    drop
                                                    # Chiplets, And8Lookup, EidosCompression, Core.
                                                    exec.layout::get_core_trace_length_log
                                                    exec.layout::get_eidos_compression_trace_length_log
                                                    exec.layout::get_and8_lookup_trace_length_log
                                                    exec.layout::get_chiplets_trace_length_log
                                                else
                                                    dup eq.12
                                                    if.true
                                                        drop
                                                        # EidosCompression, Core, Chiplets, And8Lookup.
                                                        exec.layout::get_and8_lookup_trace_length_log
                                                        exec.layout::get_chiplets_trace_length_log
                                                        exec.layout::get_core_trace_length_log
                                                        exec.layout::get_eidos_compression_trace_length_log
                                                    else
                                                        dup eq.13
                                                        if.true
                                                            drop
                                                            # EidosCompression, Core, And8Lookup, Chiplets.
                                                            exec.layout::get_chiplets_trace_length_log
                                                            exec.layout::get_and8_lookup_trace_length_log
                                                            exec.layout::get_core_trace_length_log
                                                            exec.layout::get_eidos_compression_trace_length_log
                                                        else
                                                            dup eq.14
                                                            if.true
                                                                drop
                                                                # EidosCompression, Chiplets, Core, And8Lookup.
                                                                exec.layout::get_and8_lookup_trace_length_log
                                                                exec.layout::get_core_trace_length_log
                                                                exec.layout::get_chiplets_trace_length_log
                                                                exec.layout::get_eidos_compression_trace_length_log
                                                            else
                                                                dup eq.15
                                                                if.true
                                                                    drop
                                                                    # EidosCompression, Chiplets, And8Lookup, Core.
                                                                    exec.layout::get_core_trace_length_log
                                                                    exec.layout::get_and8_lookup_trace_length_log
                                                                    exec.layout::get_chiplets_trace_length_log
                                                                    exec.layout::get_eidos_compression_trace_length_log
                                                                else
                                                                    dup eq.16
                                                                    if.true
                                                                        drop
                                                                        # EidosCompression, And8Lookup, Core, Chiplets.
                                                                        exec.layout::get_chiplets_trace_length_log
                                                                        exec.layout::get_core_trace_length_log
                                                                        exec.layout::get_and8_lookup_trace_length_log
                                                                        exec.layout::get_eidos_compression_trace_length_log
                                                                    else
                                                                        dup eq.17
                                                                        if.true
                                                                            drop
                                                                            # EidosCompression, And8Lookup, Chiplets, Core.
                                                                            exec.layout::get_core_trace_length_log
                                                                            exec.layout::get_chiplets_trace_length_log
                                                                            exec.layout::get_and8_lookup_trace_length_log
                                                                            exec.layout::get_eidos_compression_trace_length_log
                                                                        else
                                                                            dup eq.18
                                                                            if.true
                                                                                drop
                                                                                # And8Lookup, Core, Chiplets, EidosCompression.
                                                                                exec.layout::get_eidos_compression_trace_length_log
                                                                                exec.layout::get_chiplets_trace_length_log
                                                                                exec.layout::get_core_trace_length_log
                                                                                exec.layout::get_and8_lookup_trace_length_log
                                                                            else
                                                                                dup eq.19
                                                                                if.true
                                                                                    drop
                                                                                    # And8Lookup, Core, EidosCompression, Chiplets.
                                                                                    exec.layout::get_chiplets_trace_length_log
                                                                                    exec.layout::get_eidos_compression_trace_length_log
                                                                                    exec.layout::get_core_trace_length_log
                                                                                    exec.layout::get_and8_lookup_trace_length_log
                                                                                else
                                                                                    dup eq.20
                                                                                    if.true
                                                                                        drop
                                                                                        # And8Lookup, Chiplets, Core, EidosCompression.
                                                                                        exec.layout::get_eidos_compression_trace_length_log
                                                                                        exec.layout::get_core_trace_length_log
                                                                                        exec.layout::get_chiplets_trace_length_log
                                                                                        exec.layout::get_and8_lookup_trace_length_log
                                                                                    else
                                                                                        dup eq.21
                                                                                        if.true
                                                                                            drop
                                                                                            # And8Lookup, Chiplets, EidosCompression, Core.
                                                                                            exec.layout::get_core_trace_length_log
                                                                                            exec.layout::get_eidos_compression_trace_length_log
                                                                                            exec.layout::get_chiplets_trace_length_log
                                                                                            exec.layout::get_and8_lookup_trace_length_log
                                                                                        else
                                                                                            dup eq.22
                                                                                            if.true
                                                                                                drop
                                                                                                # And8Lookup, EidosCompression, Core, Chiplets.
                                                                                                exec.layout::get_chiplets_trace_length_log
                                                                                                exec.layout::get_core_trace_length_log
                                                                                                exec.layout::get_eidos_compression_trace_length_log
                                                                                                exec.layout::get_and8_lookup_trace_length_log
                                                                                            else
                                                                                                eq.23 assert.err="invalid proof-order tag"
                                                                                                # And8Lookup, EidosCompression, Chiplets, Core.
                                                                                                exec.layout::get_core_trace_length_log
                                                                                                exec.layout::get_chiplets_trace_length_log
                                                                                                exec.layout::get_eidos_compression_trace_length_log
                                                                                                exec.layout::get_and8_lookup_trace_length_log
                                                                                            end
                                                                                        end
                                                                                    end
                                                                                end
                                                                            end
                                                                        end
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

#! Observes the auxiliary trace for the Miden VM AIR.
#!
#! Draws auxiliary randomness, absorbs the auxiliary trace commitment and four normalized
#! boundary sums, then checks the modeless outer-LogUp boundary identity.
#!
#! The advice provider supplies:
#!   [commitment, sigma_prime_0, sigma_prime_1, sigma_prime_2, sigma_prime_3]
#!
#! Input:  [...]
#! Output: [...]
pub proc observe_aux_trace
    exec.random_coin::generate_aux_randomness

    # The correction depends on the sampled auxiliary randomness and staged statement values.
    exec.public_inputs::compute_outer_logup_correction

    # Absorb commitment followed by the four normalized sums in proof order.
    padw adv_loadw
    exec.constants::aux_trace_com_ptr mem_storew_le
    exec.random_coin::eidos_observe_word

    padw adv_loadw
    exec.layout::aux_bus_boundary_ptr mem_storew_le
    exec.random_coin::eidos_observe_word

    padw adv_loadw
    exec.layout::aux_bus_boundary_ptr add.4 mem_storew_le
    exec.random_coin::eidos_observe_word

    # Scale each normalized sum by its proof-ordered trace length.
    exec.push_proof_order_log_heights

    push.0 exec.load_weighted_aux_sum

    movup.2 push.2 exec.load_weighted_aux_sum
    ext2add

    movup.2 push.4 exec.load_weighted_aux_sum
    ext2add

    movup.2 push.6 exec.load_weighted_aux_sum
    ext2add

    exec.layout::c_total_ptr add.1 mem_load
    exec.layout::c_total_ptr mem_load
    ext2add
    assertz.err="outer-LogUp boundary mismatch: weighted sums coord 0"
    assertz.err="outer-LogUp boundary mismatch: weighted sums coord 1"
end
