use miden::core::stark::constants
use miden::core::stark::random_coin
use miden::core::stark::utils
use miden::core::sys::vm::public_inputs
use miden::core::sys::vm::layout

# Number of AIR instances in the relation, each contributing one boundary value.
const NUM_AIRS = 4

#! Load one normalized committed LogUp sum and scale both extension coordinates by the AIR's row
#! count `n = 2^log_height`.
#!
#! `boundary_offset` is `2k` for canonical instance index `k`, so the caller must have scattered
#! the sums to their canonical addresses first.
#!
#! Input:  [boundary_offset, log_height, ...]
#! Output: [n_sigma_prime_0, n_sigma_prime_1, ...]
proc load_weighted_aux_sum
    swap pow2
    exec.layout::aux_bus_boundary_ptr movup.2 add

    dup mem_load
    dup.2 mul

    swap add.1 mem_load
    movup.2 mul swap
end

#! Push the four AIR log heights in canonical instance order: Core, Chiplets,
#! EidosCompression, And8Lookup.
#!
#! The order the values these heights weight arrived in does not appear here: the boundary sums
#! are moved to their canonical addresses before the weighted sum reads them, so pairing is by
#! canonical instance index on both sides.
#!
#! Input:  [...]
#! Output: [log_0, log_1, log_2, log_3, ...]
pub proc push_canonical_log_heights
    exec.layout::get_and8_lookup_trace_length_log
    exec.layout::get_eidos_compression_trace_length_log
    exec.layout::get_chiplets_trace_length_log
    exec.layout::get_core_trace_length_log
end

#! Reads the normalized boundary sum submitted at one position of the proof order.
#!
#! Input:  [proof_order_position, ...]
#! Output: [sigma_prime_0, sigma_prime_1, ...]
proc load_boundary_pair
    mul.2 exec.layout::aux_bus_boundary_ptr add

    dup add.1 mem_load
    swap mem_load
end

#! Moves each normalized boundary sum from its proof-order slot to its canonical instance-order
#! slot.
#!
#! The proof submits one sum per AIR ordered by trace height, so the absorb above stores them in
#! that order. The constraint circuit instead reads AIR `k`'s sum at `AUX_BUS_BOUNDARY_PTR + 2k`,
#! the address `InputKey::AuxBusBoundary(k)` names, with `k` the canonical instance index.
#!
#! Every sum is read onto the operand stack before any is written back, so the region is permuted
#! in place without scratch memory. The AIR heights must already be stored; the sums must already
#! be absorbed.
#!
#! Input:  [...]
#! Output: [...]
pub proc scatter_aux_bus_boundary
    exec.constants::air_trace_length_logs_ptr push.NUM_AIRS push.3
    exec.utils::proof_order_position_from_heights
    exec.load_boundary_pair

    exec.constants::air_trace_length_logs_ptr push.NUM_AIRS push.2
    exec.utils::proof_order_position_from_heights
    exec.load_boundary_pair

    exec.constants::air_trace_length_logs_ptr push.NUM_AIRS push.1
    exec.utils::proof_order_position_from_heights
    exec.load_boundary_pair

    exec.constants::air_trace_length_logs_ptr push.NUM_AIRS push.0
    exec.utils::proof_order_position_from_heights
    exec.load_boundary_pair
    # => [sigma_prime_0, ..., sigma_prime_3, ...] in canonical instance order

    exec.layout::aux_bus_boundary_ptr mem_storew_le dropw
    exec.layout::aux_bus_boundary_ptr add.4 mem_storew_le dropw
end

#! Observes the auxiliary trace for the Miden VM AIR.
#!
#! Draws auxiliary randomness, absorbs the auxiliary trace commitment and four normalized
#! boundary sums, moves the sums to the canonical addresses the constraint circuit reads them
#! from, and checks the modeless outer-LogUp boundary identity there.
#!
#! The advice provider supplies:
#!   [commitment, sigma_prime_0, sigma_prime_1, sigma_prime_2, sigma_prime_3]
#!
#! Input:  [...]
#! Output: [...]
pub proc observe_aux_trace
    exec.random_coin::generate_aux_randomness

    # The correction depends on the sampled auxiliary randomness and staged statement values.
    exec.public_inputs::compute_outer_logup_correction

    # Absorb commitment followed by the four normalized sums in proof order.
    padw adv_loadw
    exec.constants::aux_trace_com_ptr mem_storew_le
    exec.random_coin::eidos_observe_word

    padw adv_loadw
    exec.layout::aux_bus_boundary_ptr mem_storew_le
    exec.random_coin::eidos_observe_word

    padw adv_loadw
    exec.layout::aux_bus_boundary_ptr add.4 mem_storew_le
    exec.random_coin::eidos_observe_word

    # The transcript has now seen the wire order, so the sums may move to the canonical addresses
    # the constraint circuit reads them from. Everything below indexes the region by canonical
    # instance index, so this must precede the weighted sum, not follow it.
    exec.scatter_aux_bus_boundary

    # Scale AIR k's normalized sum, now at offset 2k, by AIR k's trace length.
    exec.push_canonical_log_heights

    push.0 exec.load_weighted_aux_sum

    movup.2 push.2 exec.load_weighted_aux_sum
    ext2add

    movup.2 push.4 exec.load_weighted_aux_sum
    ext2add

    movup.2 push.6 exec.load_weighted_aux_sum
    ext2add

    exec.layout::c_total_ptr add.1 mem_load
    exec.layout::c_total_ptr mem_load
    ext2add
    assertz.err="outer-LogUp boundary mismatch: weighted sums coord 0"
    assertz.err="outer-LogUp boundary mismatch: weighted sums coord 1"
end
