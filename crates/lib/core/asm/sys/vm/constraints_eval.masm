# CONSTRAINT EVALUATION CHECKER
# =================================================================================================

#! Prepares selector and fold-coefficient inputs, authenticates the ACE circuit, and
#! checks that the circuit evaluates to zero.
#!
#! Requires bounded AIR heights, a complete height-sorted proof-order map, and the
#! relation's public, lookup-boundary, and OOD values in ACE READ order. The transcript
#! must have stored the OOD point and constraint-composition challenges.
#!
#! Inputs:  [...]
#! Outputs: [...]
pub proc execute_constraint_evaluation_check()
    push.PROOF_ORDER_IDS_PTR
    push.QUOTIENT_SHIFT_RATIO
    push.QUOTIENT_FIRST_SHIFT
    push.QUOTIENT_FIRST_WEIGHT
    push.AUXILIARY_ACE_INPUTS_PTR
    push.LOG_AIR_TRACE_LENGTHS_PTR
    push.NUM_AIRS
    push.MAX_CYCLE_LEN_LOG
    exec.constraints_eval_inputs::set_up_auxiliary_inputs_ace

    exec.stage_air_fold_coefficients

    exec.load_and_authenticate_ace_circuit

    push.NUM_EVAL_GATES_CIRCUIT
    push.NUM_INPUTS_CIRCUIT
    push.PUBLIC_INPUTS_PTR
    eval_circuit
    drop drop drop
end

#! Loads the ACE circuit from the advice map and pins it to the compiled-in digest.
#!
#! Fetches the stream under its expected digest, writes it at `ACE_CIRCUIT_STREAM_PTR`,
#! and checks the digest computed from those same blocks.
proc load_and_authenticate_ace_circuit
    push.ACE_CIRCUIT_DIGEST_3.ACE_CIRCUIT_DIGEST_2.ACE_CIRCUIT_DIGEST_1.ACE_CIRCUIT_DIGEST_0
    # => [ACE_CIRCUIT_DIGEST(4), ...]
    adv.push_mapval
    push.ACE_CIRCUIT_STREAM_PTR
    push.ACE_STREAM_INIT_CV_3.ACE_STREAM_INIT_CV_2.ACE_STREAM_INIT_CV_1.ACE_STREAM_INIT_CV_0
    padw padw
    # => [zero(8), CV(4), ptr, ACE_CIRCUIT_DIGEST(4), ...]
    repeat.ACE_STREAM_BLOCKS
        adv_pipe
        exec.eidos::compress
    end
    exec.eidos::digest
    # => [STREAM_DIGEST(4), end_ptr, ACE_CIRCUIT_DIGEST(4), ...]
    movup.4 drop
    # => [STREAM_DIGEST(4), ACE_CIRCUIT_DIGEST(4), ...]
    assert_eqw.err=ERR_CIRCUIT_DIGEST_MISMATCH
end

#! Stages AIR k's multi-AIR fold coefficient `beta^(NUM_AIRS - 1 - pos_k)` in its READ slot.
#!
#! The native verifier folds the per-AIR constraint evaluations in height-sorted proof
#! order, so the AIR opened last carries `beta^0` and the one opened first
#! `beta^(NUM_AIRS - 1)`. Walking `id_by_pos` from the last proof position to the first
#! produces every power with one multiplication between consecutive positions; each is written
#! to that AIR's slot. The proof-order pass must have filled `id_by_pos`, and the transcript
#! must have sampled `beta` into `CONSTRAINT_COMPOSITION_COEFS_PTR`.
#!
#! Inputs:  [...]
#! Outputs: [...]
proc stage_air_fold_coefficients
    push.PROOF_ORDER_IDS_PTR
    push.AUXILIARY_ACE_INPUTS_PTR add.44
    padw mem_loadw_le.CONSTRAINT_COMPOSITION_COEFS_PTR drop drop
    push.0.1
    # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    # Each step copies its coefficient and destination before storing c0 then c1.
    # proof position 3: coefficient beta^0 to that AIR's slot
    dup.5 add.3 mem_load mul.2 dup.5 add
    # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
    # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    dup.3 dup.3 ext2mul
    # proof position 2: coefficient beta^1 to that AIR's slot
    dup.5 add.2 mem_load mul.2 dup.5 add
    # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
    # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    dup.3 dup.3 ext2mul
    # proof position 1: coefficient beta^2 to that AIR's slot
    dup.5 add.1 mem_load mul.2 dup.5 add
    # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
    # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    dup.3 dup.3 ext2mul
    # proof position 0: coefficient beta^3 to that AIR's slot
    dup.5 mem_load mul.2 dup.5 add
    # => [destination, c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    dup.2 dup.2 dup.2 mem_store swap add.1 mem_store
    # => [c0, c1, beta0, beta1, coefficient_ptr, id_by_pos_ptr]
    drop drop drop drop drop drop
end
