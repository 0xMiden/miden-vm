use miden::core::crypto::hashes::poseidon2
use miden::core::stark::constants
use miden::core::sys::vm::constraints_eval_inputs

# CONSTANTS
# =================================================================================================

# Number of READ variables (inputs + constants) for the constraint evaluation circuit.
const NUM_INPUTS_CIRCUIT = 628

# Number of evaluation gates in the constraint evaluation circuit
const NUM_EVAL_GATES_CIRCUIT = 5392

# Max cycle length for periodic columns
const MAX_CYCLE_LEN_LOG = 4

# Depth of the ACE circuit registry tree.
const ACE_REGISTRY_DEPTH = 3

# Poseidon2 digest of the order-invariant common section of the ACE circuit stream
# (common ops + root padding). The registry leaf for each ORDER_TAG is
# merge(H(constants | shuffle ops), H_COMMON).
const H_COMMON_0 = 15433024867901467812
const H_COMMON_1 = 8913262848297184576
const H_COMMON_2 = 10266320086976787717
const H_COMMON_3 = 3183468947319856490

# ERRORS
# =================================================================================================

const ERR_CIRCUIT_COMMITMENT_MISMATCH = "merged ACE circuit segment digests do not match the registry commitment"

const ERR_COMMON_SECTION_MISMATCH = "common ACE circuit section does not match the compiled-in digest"

# CONSTRAINT EVALUATION CHECKER
# =================================================================================================

#! Executes the constraints evaluation check for the proof order selected by ORDER_TAG.
#!
#! Inputs:  []
#! Outputs: []
pub proc execute_constraint_evaluation_check()
    exec.constants::assert_valid_order_tag

    push.MAX_CYCLE_LEN_LOG
    exec.constraints_eval_inputs::set_up_auxiliary_inputs_ace

    exec.load_and_authenticate_ace_circuit

    push.NUM_EVAL_GATES_CIRCUIT
    push.NUM_INPUTS_CIRCUIT
    exec.constants::public_inputs_address_ptr mem_load
    eval_circuit
    drop drop drop
end

#! Loads and authenticates the ACE circuit selected by ORDER_TAG.
#!
#! The circuit stream is factored into two adv_pipe-aligned segments: a per-order
#! prefix [constants | shuffle ops] and an order-invariant common section
#! [common ops | root padding]. Both are hashed separately; the common digest is
#! pinned to the compiled-in H_COMMON (so a batch verifier may keep the common
#! section resident and re-authenticate only the shuffle), and the registry leaf
#! selected by ORDER_TAG must equal merge(H_PREFIX, H_COMMON).
proc load_and_authenticate_ace_circuit
    exec.load_ace_registry_commitment
    # => [LEAF]
    adv.push_mapval
    exec.constants::ace_circuit_stream_ptr
    padw padw padw
    # => [ZERO, ZERO, ZERO, ptr, LEAF]
    repeat.105
        adv_pipe
        exec.poseidon2::permute
    end
    exec.poseidon2::squeeze_digest
    # => [H_PREFIX, ptr, LEAF]
    movup.4
    # => [ptr, H_PREFIX, LEAF]
    padw padw padw
    repeat.643
        adv_pipe
        exec.poseidon2::permute
    end
    exec.poseidon2::squeeze_digest
    # => [H_COMMON, ptr, H_PREFIX, LEAF]
    movup.4 drop
    # => [H_COMMON, H_PREFIX, LEAF]
    dupw push.H_COMMON_3.H_COMMON_2.H_COMMON_1.H_COMMON_0
    assert_eqw.err=ERR_COMMON_SECTION_MISMATCH
    # => [H_COMMON, H_PREFIX, LEAF]
    swapw
    # => [H_PREFIX, H_COMMON, LEAF]
    exec.poseidon2::merge
    # => [MERGED, LEAF]
    assert_eqw.err=ERR_CIRCUIT_COMMITMENT_MISMATCH
end

#! Loads the ACE circuit commitment selected by ORDER_TAG from the registry tree.
proc load_ace_registry_commitment
    padw exec.constants::ace_registry_root_ptr mem_loadw_le
    exec.constants::get_order_tag
    push.ACE_REGISTRY_DEPTH
    mtree_get
    swapw dropw
end
