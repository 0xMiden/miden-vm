# CONSTANTS
# =================================================================================================

# General constants
const ROOT_UNITY = 1753635133440165772
# Number of random extension field coefficients related to the auxiliary trace (i.e. the alphas)
const NUM_AUX_TRACE_COEFS = 2

# Blowup factor
const BLOWUP_FACTOR = 8
const BLOWUP_FACTOR_LOG = 3

# FRI parameters (hardcoded; future versions may make these configurable)
const LOG_FINAL_DEGREE = 7
const FRI_FOLD_ARITY = 4

# MEMORY POINTERS
# =================================================================================================

## General
## The generic frame occupies the half-open range 3223322624..3223322764. Relation-owned
## storage begins at the next address.

### Addresses to store the LDE domain parameters
### The info word layout is [lde_size, log(lde_size), lde_g, 0].
const LDE_DOMAIN_INFO_PTR = 3223322624
const LDE_DOMAIN_SIZE_PTR = 3223322624
const LDE_DOMAIN_LOG_SIZE_PTR = 3223322625
const LDE_DOMAIN_GEN_PTR = 3223322626

### Address to store the number of FRI queries
const NUM_QUERIES_PTR = 3223322628

### Address to store the size of the FRI remainder polynomial: the number of coefficients,
### equivalently its degree plus one.
const REMAINDER_POLY_SIZE_PTR = 3223322629

### Address to store the number of FRI folded oracles
const NUM_FRI_LAYERS_PTR = 3223322630

### The first address of the region of memory storing the FRI remainder polynomial
const REMAINDER_POLY_ADDRESS_PTR = 3223322631

### Address to store the length of the execution trace
const TRACE_LENGTH_PTR = 3223322632

### The first address of the region of memory storing the FRI queries, together with some useful
### data for running FRI check
const FRI_QUERIES_ADDRESS_PTR = 3223322633

### Address storing the maximum per-AIR log height.
### Used for the lifted-domain math (LDE size, max-AIR selectors, vanishing).
const TRACE_LENGTH_LOG_PTR = 3223322634

### The LDE coset offset is the canonical lifted-domain shift
### `g^(2^(TWO_ADICITY - log_lde))` (g = 7, the field generator), so it depends on the
### LDE domain size and is computed per proof in `random_coin::init_seed`.
const DOMAIN_OFFSET_PTR = 3223322635
const DOMAIN_OFFSET_INV_PTR = 3223322636

### Address storing the trace-domain generator.
const TRACE_DOMAIN_GENERATOR_PTR = 3223322637

### Address storing a pointer to the public inputs.
const PUBLIC_INPUTS_ADDRESS_PTR = 3223322638

### Proof-order tag. Its relation-specific active-leaf bound is supplied by the caller.
const ORDER_TAG_PTR = 3223322639

### Addresses to store the commitments to main, auxiliary and constraints composition polynomials traces
const MAIN_TRACE_COM_PTR = 3223322640
const AUX_TRACE_COM_PTR = 3223322644
const COMPOSITION_POLY_COM_PTR = 3223322648

### Address to store the OOD evaluation point
const Z_PTR = 3223322652

### Address to store the zero word, mainly used in the context of Poseidon2
const ZERO_WORD_PTR = 3223322656

### Address to store the non-deterministically provided DEEP polynomial batching randomness
const ALPHA_DEEP_ND_PTR = 3223322660

### Address to store the fixed terms, across all queries, of the DEEP queries.
const OOD_FIXED_TERM_HORNER_EVALS_PTR = 3223322664

### Addresses to store the state of Poseidon2-based random coin
const C_PTR = 3223322668
const R1_PTR = 3223322672
const R2_PTR = 3223322676

### Addresses used for storing temporary values
const TMP1 = 3223322680
const TMP2 = 3223322684
const TMP3 = 3223322688
const TMP4 = 3223322692

### Scratch word used by the FRI verifier to persist loop state between queries.
### Stores [query_ptr, layer_ptr, rem_ptr, g].
const FRI_VERIFY_STATE_PTR = 3223322696

### Address of the composition challenges [alpha0, alpha1, beta0, beta1].
const COMPOSITION_COEF_PTR = 3223322700

### Address to the randomness used in computing the DEEP polynomial
const DEEP_RAND_CC_PTR = 3223322704

### Addresses of the digests of dynamically executed procedures
const DYNAMIC_PROCEDURE_0_PTR = 3223322708
const DYNAMIC_PROCEDURE_1_PTR = 3223322712
const DYNAMIC_PROCEDURE_2_PTR = 3223322716
const DYNAMIC_PROCEDURE_3_PTR = 3223322720
const DYNAMIC_PROCEDURE_4_PTR = 3223322724

### Relation metadata for this verifier instance.
const RELATION_DIGEST_PTR = 3223322728
const ACE_REGISTRY_ROOT_PTR = 3223322732

### Shared per-AIR log-height scratch. Generic consumers take the base and count as
### arguments; each relation owns the meaning of its offsets. The registry-backed
### order tag fits in u32 for at most 12 AIRs, while 16 cells leave aligned headroom.
const AIR_TRACE_LENGTH_LOGS_PTR = 3223322736
const AIR_TRACE_LENGTH_LOGS_CAPACITY = 16

### Addresses to store parameters needed for calls to the ACE chiplet.
const NUM_FIXED_LEN_PUBLIC_INPUTS_PTR = 3223322752
const NUM_ACE_INPUTS_PTR = 3223322753
const NUM_ACE_GATES_PTR = 3223322754
const MAX_CYCLE_LEN_LOG_PTR = 3223322755

### Addresses to store proof-of-work bit counts.
### query_pow_bits: PoW before query index sampling (PCS_PARAMS.query_pow_bits)
### deep_pow_bits: PoW before DEEP challenge sampling (PCS_PARAMS.deep.deep_pow_bits)
### folding_pow_bits: PoW per FRI folding round (PCS_PARAMS.fri.folding_pow_bits), same for all layers
const QUERY_POW_BITS_PTR = 3223322756
const DEEP_POW_BITS_PTR = 3223322757
const FOLDING_POW_BITS_PTR = 3223322758

### Random-coin buffer lengths.
### The input length counts pending rate elements awaiting absorption (0..7).
### The output length counts rate elements still available for sampling (0..8).
const RANDOM_COIN_INPUT_LEN_PTR = 3223322759
const RANDOM_COIN_OUTPUT_LEN_PTR = 3223322760

### Address storing the relation-local start of the OOD evaluation rows.
const OOD_EVALUATIONS_ADDRESS_PTR = 3223322761

### Address storing the relation-local query-row buffer.
const CURRENT_TRACE_ROW_ADDRESS_PTR = 3223322762

### Reserved to align the following relation-owned frame to a word boundary.
const GENERIC_ALIGNMENT_PADDING_PTR = 3223322763

## FRI
##
##       (FRI_COM_PTR - 600)     ---|
##              .
##              .                   | <- FRI queries
##              .
##         FRI_COM_PTR           ---|
##              .
##              .                   | <- FRI layer commitments and folding challenges
##              .
##       (FRI_COM_PTR + 256)     ---|
##              .
##              .                   | <- Remainder polynomial
##              .
##       (FRI_COM_PTR + 512-1)   ---|
##
## For each FRI layer, we need 8 memory slots, one for storing the FRI layer commitment and one for
## storing the word [a0, a1, log2(lde_size), lde_size] where a := (a0, a1) is the folding randomness
## and lde_size is the size of the LDE domain of the corresponding FRI layer.
## Since we are using a folding factor of 4 and the maximal degree of the remainder polynomial
## that we allow is 127, an upper limit of 32 FRI layers is ample and the number of memory slots
## we thus allocate for this is 256. Moreover, we allocate an additional 256 slots for the remainder
## polynomial which is expected to be laid out right after the FRI commitments.
##
## Starts at address 3229614080 = 2**31 + 2**30 + 2**23 and the memory region grows backward and forward
## and is of variable length in both directions.
## As described above, the size in the backward direction is determined by the number of FRI layers i.e.,
## the number of FRI oracles. The size in the forward direction is determined by the size of the FRI
## remainder polynomial.
const FRI_COM_PTR = 4294912800

