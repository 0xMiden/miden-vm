# CONSTANTS
# =================================================================================================

# Naming: a name ending in `_PTR` is the memory address of the datum it names, and one ending in
# `_ADDRESS_PTR` is the address of a cell holding an address written at runtime. Other names are
# plain values.

# General constants
pub const ROOT_UNITY = 1753635133440165772

# Log2 of the blowup factor: the LDE domain is 8 times the trace length.
pub const LOG_BLOWUP_FACTOR = 3

# FRI parameters (hardcoded; future versions may make these configurable)
pub const LOG_FINAL_DEGREE = 7
pub const FRI_FOLD_ARITY = 4

# MEMORY POINTERS
# =================================================================================================

## General
## The generic frame occupies the half-open range 3223322624..3223322764. Relation-owned
## storage begins at the next address.

### Addresses to store the LDE domain parameters
### The info word layout is [lde_size, log(lde_size), lde_g, 0]; log(lde_size) is also the depth
### of the LDE domain Merkle tree.
pub const LDE_DOMAIN_INFO_PTR = 3223322624
pub const LDE_DOMAIN_SIZE_PTR = 3223322624
pub const LOG_LDE_DOMAIN_SIZE_PTR = 3223322625
pub const LDE_DOMAIN_GENERATOR_PTR = 3223322626

### Address to store the number of FRI queries
pub const NUM_QUERIES_PTR = 3223322628

### Address to store the size of the FRI remainder polynomial: the number of coefficients,
### equivalently its degree plus one.
pub const REMAINDER_POLY_SIZE_PTR = 3223322629

### Address to store the number of FRI folded oracles
pub const NUM_FRI_LAYERS_PTR = 3223322630

### The first address of the region of memory storing the FRI remainder polynomial
pub const REMAINDER_POLY_ADDRESS_PTR = 3223322631

### Address to store the length of the execution trace
pub const TRACE_LENGTH_PTR = 3223322632

### The first address of the region of memory storing the FRI queries, together with some useful
### data for running FRI check
pub const FRI_QUERIES_ADDRESS_PTR = 3223322633

### Address storing the maximum per-AIR log height.
### Used for the lifted-domain math (LDE size, max-AIR selectors, vanishing).
pub const LOG_TRACE_LENGTH_PTR = 3223322634

### The LDE coset offset is the canonical lifted-domain shift
### `g^(2^(TWO_ADICITY - log_lde))` (g = 7, the field generator), so it depends on the
### LDE domain size and is computed per proof in `random_coin::init_seed`.
pub const DOMAIN_OFFSET_PTR = 3223322635
pub const DOMAIN_OFFSET_INV_PTR = 3223322636

### Address storing the trace-domain generator.
pub const TRACE_DOMAIN_GENERATOR_PTR = 3223322637

### Address storing a pointer to the public inputs.
pub const PUBLIC_INPUTS_ADDRESS_PTR = 3223322638

### Proof-order tag. Its relation-specific active-leaf bound is supplied by the caller.
pub const ORDER_TAG_PTR = 3223322639

### Addresses to store the commitments to main, auxiliary and constraints composition polynomials traces
pub const MAIN_TRACE_COM_PTR = 3223322640
pub const AUX_TRACE_COM_PTR = 3223322644
pub const COMPOSITION_POLY_COM_PTR = 3223322648

### Address to store the OOD evaluation point `z` and its power `z^N` (`N = trace_len`).
### The word stored is `[z^n_0, z^n_1, z_0, z_1]`.
pub const OOD_POINT_PTR = 3223322652

### Address to store the zero word, mainly used in the context of Poseidon2
pub const ZERO_WORD_PTR = 3223322656

### Address to store the non-deterministically provided DEEP polynomial batching randomness
pub const DEEP_ALPHA_ADVICE_PTR = 3223322660

### Address to store the fixed terms, across all queries, of the DEEP queries.
pub const OOD_FIXED_TERM_HORNER_EVALUATIONS_PTR = 3223322664

### Addresses to store the state of the Poseidon2-based random coin: the capacity word `C`
### and the two rate words `R1` and `R2`.
pub const RANDOM_COIN_CAPACITY_PTR = 3223322668
pub const RANDOM_COIN_RATE_1_PTR = 3223322672
pub const RANDOM_COIN_RATE_2_PTR = 3223322676

### Addresses used for storing temporary values
pub const TMP1_PTR = 3223322680
pub const TMP2_PTR = 3223322684
pub const TMP3_PTR = 3223322688
pub const TMP4_PTR = 3223322692

### Scratch word used by the FRI verifier to persist loop state between queries.
### Stores [query_ptr, layer_ptr, rem_ptr, g].
pub const FRI_VERIFY_STATE_PTR = 3223322696

### Address of the composition challenges [alpha0, alpha1, beta0, beta1].
pub const CONSTRAINT_COMPOSITION_COEFS_PTR = 3223322700

### Address to the randomness used in computing the DEEP polynomial
pub const DEEP_COMPOSITION_COEFS_PTR = 3223322704

### Addresses of the digests of the relation hooks that `stark::verifier::verify` executes
### dynamically. Each cell holds one word (the procedure digest); the hook names match the
### procedures the relation wrapper supplies.
pub const HOOK_COMPUTE_DEEP_COMPOSITION_POLYNOMIAL_QUERIES_PTR = 3223322708
pub const HOOK_EXECUTE_CONSTRAINT_EVALUATION_CHECK_PTR = 3223322712
pub const HOOK_PROCESS_ROW_OOD_EVALUATIONS_PTR = 3223322716
pub const HOOK_PROCESS_PUBLIC_INPUTS_PTR = 3223322720
pub const HOOK_OBSERVE_AUX_TRACE_PTR = 3223322724

### Relation metadata for this verifier instance.
pub const RELATION_DIGEST_PTR = 3223322728
pub const ACE_REGISTRY_ROOT_PTR = 3223322732

### Shared per-AIR log-height scratch. Generic consumers take the base and count as
### arguments; each relation owns the meaning of its offsets. The registry-backed
### order tag fits in u32 for at most 12 AIRs, while 16 cells leave aligned headroom.
pub const LOG_AIR_TRACE_LENGTHS_PTR = 3223322736
pub const LOG_AIR_TRACE_LENGTHS_CAPACITY = 16

### Addresses to store parameters needed for calls to the ACE chiplet.
pub const NUM_FIXED_LENGTH_PUBLIC_INPUTS_PTR = 3223322752
pub const NUM_ACE_INPUTS_PTR = 3223322753
pub const NUM_ACE_GATES_PTR = 3223322754
pub const LOG_MAX_CYCLE_LENGTH_PTR = 3223322755

### Addresses to store proof-of-work bit counts.
### query_pow_bits: PoW before query index sampling (PCS_PARAMS.query_pow_bits)
### deep_pow_bits: PoW before DEEP challenge sampling (PCS_PARAMS.deep.deep_pow_bits)
### folding_pow_bits: PoW per FRI folding round (PCS_PARAMS.fri.folding_pow_bits), same for all layers
pub const QUERY_POW_BITS_PTR = 3223322756
pub const DEEP_POW_BITS_PTR = 3223322757
pub const FOLDING_POW_BITS_PTR = 3223322758

### Random-coin buffer lengths.
### The input length counts pending rate elements awaiting absorption (0..7).
### The output length counts rate elements still available for sampling (0..8).
pub const RANDOM_COIN_INPUT_LENGTH_PTR = 3223322759
pub const RANDOM_COIN_OUTPUT_LENGTH_PTR = 3223322760

### Address storing the relation-local start of the OOD evaluation rows.
pub const OOD_EVALUATIONS_ADDRESS_PTR = 3223322761

### Address storing the relation-local query-row buffer.
pub const CURRENT_TRACE_ROW_ADDRESS_PTR = 3223322762

### Reserved to align the following relation-owned frame to a word boundary.
pub const GENERIC_ALIGNMENT_PADDING_PTR = 3223322763

## FRI
##
##       (FRI_COM_PTR - 600)     ---|
##              .
##              .                   | <- FRI queries
##              .
##         FRI_COM_PTR           ---|
##              .
##              .                   | <- FRI layer commitments and folding challenges
##              .
##       (FRI_COM_PTR + 256)     ---|
##              .
##              .                   | <- Remainder polynomial
##              .
##       (FRI_COM_PTR + 512-1)   ---|
##
## For each FRI layer, we need 8 memory slots, one for storing the FRI layer commitment and one for
## storing the word [a0, a1, log2(lde_size), lde_size] where a := (a0, a1) is the folding randomness
## and lde_size is the size of the LDE domain of the corresponding FRI layer.
## Since we are using a folding factor of 4 and the maximal degree of the remainder polynomial
## that we allow is 127, an upper limit of 32 FRI layers is ample and the number of memory slots
## we thus allocate for this is 256. Moreover, we allocate an additional 256 slots for the remainder
## polynomial which is expected to be laid out right after the FRI commitments.
##
## Starts at address 3229614080 = 2**31 + 2**30 + 2**23 and the memory region grows backward and forward
## and is of variable length in both directions.
## As described above, the size in the backward direction is determined by the number of FRI layers i.e.,
## the number of FRI oracles. The size in the forward direction is determined by the size of the FRI
## remainder polynomial.
pub const FRI_COM_PTR = 4294912800

# ACCESSORS
# =================================================================================================

#! Rejects an order tag outside a relation's active registry leaves.
#!
#! The relation supplies its active order count (`n!` for `n` AIRs), not the registry tree's
#! power-of-two leaf count. This keeps padding leaves unreachable before `mtree_get`.
#!
#! Inputs:  [order_tag_count, ...]
#! Outputs: [...]
pub proc assert_valid_order_tag(order_tag_count: u32)
    mem_load.ORDER_TAG_PTR
    swap u32lt assert.err="invalid order tag"
end

# HELPER
# =================================================================================================

#! Overwrites the top stack word with zeros.
pub proc zeroize_stack_word(value: word) -> word
    mem_loadw_le.ZERO_WORD_PTR
end
