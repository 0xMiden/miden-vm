#! Returns the base pointer of the per-AIR log-height cells.
#!
#! Generic consumers take this pointer and a count as arguments; the relation owns the
#! meaning of each offset.
#!
#! Inputs:  []
#! Outputs: [ptr]
#!
#! Where:
#! - `ptr` is the base address of the per-AIR log-height cells.
#!
#! Invocation: exec
pub proc air_trace_length_logs_ptr
    push.AIR_TRACE_LENGTH_LOGS_PTR
end

#! Number of per-AIR log-height cells reserved in the shared memory map.
pub proc air_trace_length_logs_capacity
    push.AIR_TRACE_LENGTH_LOGS_CAPACITY
end

