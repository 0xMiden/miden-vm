use {
    CONSTRAINT_ALPHA_HI_PTR,
    CONSTRAINT_COMPOSITION_COEFS_PTR,
    LOG_TRACE_LENGTH_PTR,
    OOD_POINT_HI_PTR,
    OOD_POINT_LO_PTR,
    OOD_POINT_PTR,
    TRACE_DOMAIN_GENERATOR_PTR,
} from miden::core::stark::constants
use miden::core::stark::types

# AIR k's selector triple follows the ten-slot prologue in canonical instance order.
const FIRST_SELECTOR_OFFSET = 20
const SELECTOR_STRIDE = 6

#! Sets up the multi-AIR ACE input layout shared by relation verifiers.
#!
#! The stark-vars block starts with 10 EF slots:
#!
#!   Word 0 (slots 0-1): alpha, z^N
#!   Word 1 (slots 2-3): z_k, is_first
#!   Word 2 (slots 4-5): is_last, is_transition
#!   Word 3 (slots 6-7): reserved, weight0
#!   Word 4 (slots 8-9): f, s0
#!
#! The global selector slots in words 1-2 are unused by multi-AIR circuits. The per-AIR
#! selectors start at slot 10: AIR k occupies slots 10 + 3k through 12 + 3k.
#!
#! The per-AIR fold coefficients that follow the selectors are staged by each relation's generated
#! evaluator (`stage_air_fold_coefficients` in `sys/<relation>/constraints_eval.masm`) from the
#! proof-order maps, after this procedure has run.
#!
#! `heights_ptr` addresses the relation's `num_airs` consecutive per-AIR log-height
#! cells; AIR k's selectors are derived from the height at `heights_ptr + k`.
#! `proof_order_ids_ptr` addresses a permutation of those AIR indices sorted by increasing height.
#! The relation must compute this map from its validated heights before calling this procedure.
#! Heights and `max_cycle_len_log` must not exceed the maximum height stored at
#! `LOG_TRACE_LENGTH_PTR`. Reverse proof order lets the lifted OOD point and inverse domain
#! generator advance by squaring, while selectors are stored in canonical order.
#!
#! `stark_vars_ptr` is the relation's stark-vars base. The ACE READ section is one dense
#! vector whose region spacing must equal the relation's circuit layout spacing, so this
#! base is relation-local rather than a shared constant.
#! The output region must be disjoint from both input arrays and the shared domain state.
#!
#! For quotient arity D and maximum trace length N, the relation supplies
#! quot_first_shift = s0 = shift^N, quot_shift_ratio (a primitive D-th root of unity), and
#! quot_first_weight = 1 / (D * s0^(D-1)). D and the LDE blowup are separate protocol parameters.
#!
#! Input:  [max_cycle_len_log, num_airs, heights_ptr, stark_vars_ptr, quot_first_weight,
#!          quot_first_shift, quot_shift_ratio, proof_order_ids_ptr, ...]
#! Output: [...]
pub proc set_up_auxiliary_inputs_ace(
    max_cycle_len_log: u8,
    num_airs: u8,
    heights_ptr: types::Address,
    stark_vars_ptr: types::Address,
    quot_first_weight: felt,
    quot_first_shift: felt,
    quot_shift_ratio: felt,
    proof_order_ids_ptr: types::Address,
)
    # Retain the block base below the setup inputs and selector-loop state.
    movup.3 movdn.6
    # => [max_cycle_len_log, num_airs, heights_ptr, weight0, s0, f, base, ids_ptr, ...]

    # f and s0 (word 4), then the reserved slot with weight0 (word 3).
    movup.5 push.0 movup.6 push.0 movup.3
    # => [f, 0, s0, 0, max_cycle_len_log, num_airs, heights_ptr, weight0, base, ids_ptr, ...]
    dup.8 add.16
    mem_storew_le
    dropw
    # => [max_cycle_len_log, num_airs, heights_ptr, weight0, base, ids_ptr, ...]

    movup.3
    # => [weight0, max_cycle_len_log, num_airs, heights_ptr, base, ids_ptr, ...]
    push.0.0
    # => [0, 0, weight0, ...]
    push.0 movdn.3
    # => [0, 0, weight0, 0, max_cycle_len_log, num_airs, heights_ptr, base, ids_ptr, ...]
    dup.7 add.12
    mem_storew_le
    dropw
    # => [max_cycle_len_log, num_airs, heights_ptr, base, ids_ptr, ...]

    # Read the OOD point and z^N once, and pair z^N with alpha for the first ACE word.
    padw mem_loadw_le.OOD_POINT_PTR
    mem_load.CONSTRAINT_ALPHA_HI_PTR
    mem_load.CONSTRAINT_COMPOSITION_COEFS_PTR
    # => [alpha(2), z_n(2), z(2), max_cycle_len_log, num_airs, heights_ptr, base, ids_ptr, ...]
    # k squarings give z_k = z^(2^k), where k = log_trace_length - max_cycle_len_log.
    mem_load.LOG_TRACE_LENGTH_PTR
    movup.7 sub
    movdn.6
    # => [alpha(2), z_n(2), z(2), k, num_airs, heights_ptr, base, ids_ptr, ...]
    dup.9 mem_storew_le dropw
    # => [z_0, z_1, k, num_airs, heights_ptr, base, ids_ptr, ...]

    # A cycle spanning the full trace has k = 0 and leaves z unchanged.
    dup.2 neq.0
    while.true
        dup.1 dup.1 ext2mul
        movup.2 sub.1 dup movdn.3
        neq.0
    end
    movup.2 drop
    # => [z_k_0, z_k_1, num_airs, heights_ptr, base, ids_ptr, ...]

    push.0.0 movup.3 movup.3
    dup.6 add.4 mem_storew_le dropw
    # => [num_airs, heights_ptr, base, ids_ptr, ...]

    # Visit log heights from the maximum H downwards, squaring once per height step.
    # At height h, t = z^(2^(H - h)) and g_inv = g_H^(-2^(H - h)); ties skip the squaring loop.
    u32assert
    movup.3 dup movdn.2 add
    # => [order_end, order_start, heights_ptr, base, ...]
    dup dup.2 neq
    if.true
        mem_load.TRACE_DOMAIN_GENERATOR_PTR inv
        mem_load.OOD_POINT_HI_PTR
        mem_load.OOD_POINT_LO_PTR
        mem_load.LOG_TRACE_LENGTH_PTR
        # => [height, z0, z1, g_inv, cursor, start, heights_ptr, base, ...]
        push.1
        while.true
            movup.4 sub.1 dup movdn.5 mem_load
            # => [id, height, z0, z1, g_inv, cursor, start, heights_ptr, base, ...]
            dup dup.8 add mem_load
            dup movdn.3 movup.2 swap sub
            # => [height_gap, id, next_height, point(2), g_inv, cursor, start, heights_ptr, base, ...]
            movup.3 movup.4 movup.5 swap.2
            # => [point(2), g_inv, height_gap, id, next_height, cursor, start, heights_ptr, base, ...]
            dup.3 neq.0
            while.true
                dup.1 dup.1 ext2mul
                movup.2 dup mul movdn.2
                movup.3 sub.1 dup movdn.4 neq.0
            end
            movup.3 drop

            # Compute this AIR's selectors without consuming the lifted domain state.
            movup.3 mul.SELECTOR_STRIDE dup.8 add add.FIRST_SELECTOR_OFFSET
            dup.8 swap dup.4 dup.4 dup.4
            exec.store_lifted_selectors
            movup.3
            # => [next_height, z0, z1, g_inv, cursor, start, heights_ptr, base, ...]
            dup.4 dup.6 neq
        end
        dropw dropw
    else
        dropw
    end
end

#! Load the quad field element stored at `[addr, addr + 1]`.
#!
#! Input:  [addr, ...]
#! Output: [q0, q1, ...]
proc load_quad(address: ptr<types::QuadFelt>) -> types::QuadFelt
    dup add.1 mem_load
    swap mem_load
end

#! Writes first-row, last-row, and transition selectors to the six cells at `out_ptr`.
#!
#! For lifted point t and inverse generator g_inv, these are (z^N - 1)/(t - 1),
#! (z^N - 1)/(t - g_inv), and t - g_inv. The shared z^N input is at `stark_vars_ptr + 2`.
#! Both divisions check their inverses and reject a zero denominator.
proc store_lifted_selectors(
    point: types::QuadFelt,
    generator_inverse: felt,
    out_ptr: types::Address,
    stark_vars_ptr: types::Address,
)
    movup.4 add.2 exec.load_quad
    sub.1
    # => [van_0, van_1, z_lift_0, z_lift_1, g_air_inv, out_ptr, ...]

    dup.3 dup.3
    sub.1 ext2inv
    dup.3 dup.3 ext2mul
    # => [if_0, if_1, van_0, van_1, z_lift_0, z_lift_1, g_air_inv, out_ptr, ...]
    dup.7 mem_store
    dup.6 add.1 mem_store
    # => [van_0, van_1, z_lift_0, z_lift_1, g_air_inv, out_ptr, ...]

    movup.4
    # => [g_air_inv, van_0, van_1, z_lift_0, z_lift_1, out_ptr, ...]

    movup.3 swap sub
    movup.3
    swap
    # => [it_0, it_1, van_0, van_1, out_ptr, ...]

    dup.1 dup.1
    ext2inv
    movup.5 movup.5
    ext2mul
    # => [il_0, il_1, it_0, it_1, out_ptr, ...]

    dup.4 add.2 mem_store
    dup.3 add.3 mem_store
    # => [it_0, it_1, out_ptr, ...]

    dup.2 add.4 mem_store
    dup.1 add.5 mem_store
    # => [out_ptr, ...]
    drop
end
