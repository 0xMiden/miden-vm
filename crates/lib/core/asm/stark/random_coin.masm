#! Random coin procedures for the STARK verifier.
#!
#! Field samples are below 2^63, and quadratic-extension samples have two such coefficients.
#! These transcript procedures use restricted sampling, unlike Rust EidosRandomCoin field draws.
#!
#! The `eidos_*` procedures implement the Eidos challenger. Unprefixed sampling and observe
#! helpers are recursive-verifier entry points over that state machine.
#! The `eidos_absorb_*` block helpers require an empty absorb buffer. Use `eidos_observe_*` to
#! append to buffered input.
#!
#! Eidos challenger memory layout:
#!   RANDOM_COIN_CV_PTR             - 4-felt chaining value
#!   RANDOM_COIN_OUTPUT_WORD_PTR    - 4-felt output cache
#!   RANDOM_COIN_INPUT_BUF_PTR      - 8-felt absorb block
#!   RANDOM_COIN_INPUT_LENGTH_PTR   - position in the absorb block, 0..8
#!   RANDOM_COIN_COUNTER_PTR        - 0 = absorbing; otherwise next counter-mode block index
#!   RANDOM_COIN_OUTPUT_LENGTH_PTR  - felts left in the output cache, 0..4

use {
    AUX_RAND_ELEM_ADDRESS_PTR,
    CONSTRAINT_COMPOSITION_COEFS_PTR,
    DEEP_ALPHA_ADVICE_PTR,
    DEEP_COMPOSITION_COEFS_PTR,
    DEEP_POW_BITS_PTR,
    DOMAIN_OFFSET_INV_PTR,
    DOMAIN_OFFSET_PTR,
    FOLDING_POW_BITS_PTR,
    FRI_FOLD_ARITY,
    FRI_QUERIES_ADDRESS_PTR,
    LDE_DOMAIN_INFO_PTR,
    LOG_BLOWUP_FACTOR,
    LOG_FINAL_DEGREE,
    LOG_LDE_DOMAIN_SIZE_PTR,
    LOG_TRACE_LENGTH_PTR,
    NUM_QUERIES_PTR,
    OOD_POINT_PTR,
    PREPROCESSED_TRACE_COM_PTR,
    QUERY_POW_BITS_PTR,
    RANDOM_COIN_COUNTER_PTR,
    RANDOM_COIN_CV_PTR,
    RANDOM_COIN_INPUT_BUF_PTR,
    RANDOM_COIN_INPUT_LENGTH_PTR,
    RANDOM_COIN_OUTPUT_LENGTH_PTR,
    RANDOM_COIN_OUTPUT_WORD_PTR,
    RELATION_DIGEST_PTR,
    TMP3_PTR,
    TRACE_DOMAIN_GENERATOR_PTR,
    TRACE_LENGTH_PTR,
    ZERO_WORD_PTR,
} from miden::core::stark::constants

use miden::core::stark::types
use miden::core::crypto::hashes::eidos
use miden::core::stark::utils

# Eidos transcript-local root labels. These helper procs are available for typed
# transcript events even when the main recursive verifier uses the generic stream.
const MAIN_TRACE_ROOT_LABEL = 1
const AUX_TRACE_ROOT_LABEL = 2
const QUOTIENT_ROOT_LABEL = 3

# Eidos::transcript_init_cv(STARK_TRANSCRIPT), using the registered Miden VM transcript domain.
const EIDOS_TRANSCRIPT_INIT_CV_0 = 4280581857109607681
const EIDOS_TRANSCRIPT_INIT_CV_1 = 2688637132020383744
const EIDOS_TRANSCRIPT_INIT_CV_2 = 1947077364412317696
const EIDOS_TRANSCRIPT_INIT_CV_3 = 6620516959492505600

# Eidos challenger
# =============================================================================================

#! Enter absorbing mode after an Eidos absorb.
#!
#! Input: [...]
#! Output: [...]
pub proc eidos_enter_absorbing()
    push.0 mem_store.RANDOM_COIN_COUNTER_PTR
    push.0 mem_store.RANDOM_COIN_OUTPUT_LENGTH_PTR
end

#! Clear the generic Eidos absorb buffer.
#!
#! Input: [...]
#! Output: [...]
pub proc eidos_clear_buffer()
    padw mem_storew_le.RANDOM_COIN_INPUT_BUF_PTR
    push.RANDOM_COIN_INPUT_BUF_PTR add.4 mem_storew_le dropw
    push.0 mem_store.RANDOM_COIN_INPUT_LENGTH_PTR
end

#! Compress the block stored at `RANDOM_COIN_INPUT_BUF_PTR` into the Eidos chaining value.
#!
#! Input: [...]
#! Output: [...]
pub proc eidos_compress_block()
    padw mem_loadw_le.RANDOM_COIN_CV_PTR
    padw push.RANDOM_COIN_INPUT_BUF_PTR add.4 mem_loadw_le
    padw mem_loadw_le.RANDOM_COIN_INPUT_BUF_PTR
    compress
    swapw.2
    mem_storew_le.RANDOM_COIN_CV_PTR dropw
    dropw dropw
end

#! Absorb a fully specified 8-felt Eidos block.
#!
#! The absorb buffer must be empty.
#!
#! Input: [block_lo, block_hi, ...]
#! Output: [...]
pub proc eidos_absorb_block(block_lo: word, block_hi: word)
    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    assertz.err="eidos_absorb_block: buffer must be empty"

    padw mem_loadw_le.RANDOM_COIN_CV_PTR
    swapw.2
    swapw
    compress
    swapw.2
    mem_storew_le.RANDOM_COIN_CV_PTR dropw
    dropw dropw
    exec.eidos_clear_buffer
    exec.eidos_enter_absorbing
end

#! Observe one felt through the generic Eidos streaming interface.
#!
#! Input: [value, ...]
#! Output: [...]
pub proc eidos_observe_felt(value: felt)
    exec.eidos_enter_absorbing

    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    dup push.8 u32lt assert.err="eidos_observe_felt: buffer_len exceeds block width"
    swap
    dup.1
    push.RANDOM_COIN_INPUT_BUF_PTR add mem_store
    add.1
    dup mem_store.RANDOM_COIN_INPUT_LENGTH_PTR
    push.8 eq
    if.true
        exec.eidos_compress_block
        exec.eidos_clear_buffer
    end
end

#! Observe one word through the generic Eidos streaming interface.
#!
#! Word-aligned transcript state (`buffer_len` 0 or 4) uses a direct memory fast path. Other
#! prefixes fall back to four scalar observations so this remains equivalent to observing the
#! word's felts individually.
#!
#! Input: [word, ...]
#! Output: [...]
pub proc eidos_observe_word(value: word)
    exec.eidos_enter_absorbing

    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    dup push.0 eq
    if.true
        drop
        mem_storew_le.RANDOM_COIN_INPUT_BUF_PTR dropw
        padw push.RANDOM_COIN_INPUT_BUF_PTR add.4 mem_storew_le dropw
        push.4 mem_store.RANDOM_COIN_INPUT_LENGTH_PTR
    else
        dup push.4 eq
        if.true
            drop
            push.RANDOM_COIN_INPUT_BUF_PTR add.4 mem_storew_le dropw
            exec.eidos_compress_block
            exec.eidos_clear_buffer
        else
            drop
            exec.eidos_observe_felt
            exec.eidos_observe_felt
            exec.eidos_observe_felt
            exec.eidos_observe_felt
        end
    end
end

#! Observe the top two stack words as one Eidos block without changing the stack.
#!
#! Intended for `adv_pipe` loops that must keep both piped words available.
pub proc eidos_observe_piped_words(block_lo: word, block_hi: word) -> (word, word)
    dupw
    exec.eidos_observe_word
    swapw
    dupw
    exec.eidos_observe_word
    swapw
end

#! Absorb one word as `[word, 0, 0, 0, 0]`.
#!
#! Input: [word, ...]
#! Output: [...]
pub proc eidos_absorb_word(value: word)
    padw
    swapw
    exec.eidos_absorb_block
end

#! Absorb the main trace commitment root.
#!
#! Input: [root, ...]
#! Output: [...]
pub proc eidos_absorb_main_trace_root(root: types::Digest)
    push.0.0.0.MAIN_TRACE_ROOT_LABEL
    swapw
    exec.eidos_absorb_block
end

#! Absorb the auxiliary trace commitment root.
#!
#! Input: [root, ...]
#! Output: [...]
pub proc eidos_absorb_aux_trace_root(root: types::Digest)
    push.0.0.0.AUX_TRACE_ROOT_LABEL
    swapw
    exec.eidos_absorb_block
end

#! Absorb the quotient commitment root.
#!
#! Input: [root, ...]
#! Output: [...]
pub proc eidos_absorb_quotient_root(root: types::Digest)
    push.0.0.0.QUOTIENT_ROOT_LABEL
    swapw
    exec.eidos_absorb_block
end

#! Initialize the Eidos challenger from a transcript-init CV and relation digest.
#!
#! Input: [relation_digest, transcript_init_cv, ...]
#! Output: [...]
pub proc eidos_init_challenger(
    relation_digest: types::Digest,
    transcript_init_cv: eidos::ChainingValue,
)
    swapw
    mem_storew_le.RANDOM_COIN_CV_PTR dropw

    exec.eidos_clear_buffer
    padw mem_storew_le.RANDOM_COIN_OUTPUT_WORD_PTR dropw
    push.0 mem_store.RANDOM_COIN_OUTPUT_LENGTH_PTR

    exec.eidos_absorb_word
end

#! Refill the 4-felt Eidos output word.
#!
#! Input: [...]
#! Output: [...]
pub proc eidos_refill_output_word()
    mem_load.RANDOM_COIN_COUNTER_PTR
    dup push.0 eq
    if.true
        drop
        mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
        dup push.8 u32lt assert.err="eidos_refill_output_word: buffer_len exceeds block width"
        push.RANDOM_COIN_CV_PTR add.3 mem_load
        swap add.1 add
        push.RANDOM_COIN_CV_PTR add.3 mem_store
        exec.eidos_compress_block
        exec.eidos_clear_buffer
        push.1 mem_store.RANDOM_COIN_COUNTER_PTR
    else
        dup add.1 mem_store.RANDOM_COIN_COUNTER_PTR
        push.0.0.0
        movup.3
        mem_storew_le.RANDOM_COIN_INPUT_BUF_PTR
        drop push.0
        push.RANDOM_COIN_INPUT_BUF_PTR add.4 mem_storew_le dropw
        push.RANDOM_COIN_CV_PTR add.3 mem_load
        push.9 add
        push.RANDOM_COIN_CV_PTR add.3 mem_store
        exec.eidos_compress_block
        exec.eidos_clear_buffer
    end

    padw mem_loadw_le.RANDOM_COIN_CV_PTR
    mem_storew_le.RANDOM_COIN_OUTPUT_WORD_PTR dropw
    push.4 mem_store.RANDOM_COIN_OUTPUT_LENGTH_PTR
end

#! Sample one base field element from the Eidos transcript.
#!
#! Input: [...]
#! Output: [x, ...]
pub proc eidos_sample_felt() -> felt
    mem_load.RANDOM_COIN_OUTPUT_LENGTH_PTR
    dup push.0 eq
    if.true
        drop
        exec.eidos_refill_output_word
        push.4
    end

    dup push.4 u32lte assert.err="eidos_sample_felt: output_len exceeds word width"
    sub.1
    dup mem_store.RANDOM_COIN_OUTPUT_LENGTH_PTR

    push.3 swap sub
    push.RANDOM_COIN_OUTPUT_WORD_PTR add mem_load
end

#! Sample one quadratic extension element from the Eidos transcript.
#!
#! Input: [...]
#! Output: [x0, x1, ...]
pub proc eidos_sample_ext() -> types::QuadFelt
    exec.eidos_sample_felt
    exec.eidos_sample_felt
    swap
end

#! Sample bits from the Eidos transcript.
#!
#! Input: [bits, ...]
#! Output: [value, ...]
pub proc eidos_sample_bits(bits: u8) -> u32
    dup
    pow2
    u32assert u32overflowing_sub.1 assertz
    exec.eidos_sample_felt
    u32split
    swap
    drop
    u32and
    swap
    drop
end

#! Return the next full Eidos output word.
#!
#! Input: [...]
#! Output: [word, ...]
pub proc eidos_squeeze_word() -> word
    mem_load.RANDOM_COIN_OUTPUT_LENGTH_PTR
    push.0 assert_eq
    exec.eidos_refill_output_word
    padw mem_loadw_le.RANDOM_COIN_OUTPUT_WORD_PTR
    push.0 mem_store.RANDOM_COIN_OUTPUT_LENGTH_PTR
end

#! Sample a single base field element from the transcript.
#!
#! Input: [...]
#! Output: [x, ...]
pub proc sample_felt() -> felt
    exec.eidos_sample_felt
end

#! Sample a quadratic extension field element from the transcript.
#!
#! Input: [...]
#! Output: [x0, x1, ...]
pub proc sample_ext() -> types::QuadFelt
    exec.eidos_sample_ext
end

#! Sample a number of bits from the transcript.
#!
#! Input: [bits, ...]
#! Output: [value, ...]
pub proc sample_bits(bits: u8) -> u32
    exec.eidos_sample_bits
end

#! Observe a single felt through the transcript stream.
#!
#! Input: [value, ...]
#! Output: [...]
pub proc observe_felt(value: felt)
    exec.eidos_observe_felt
end

#! Observe one word through the Eidos transcript stream.
#!
#! Input: [word, ...]
#! Output: [...]
pub proc observe_word(value: word)
    exec.eidos_observe_word
end

#! Flush a partially absorbed Eidos block so subsequent sampling sees it.
#! This is a no-op when the absorb buffer is empty.
pub proc flush_buffer()
    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    push.0 neq
    if.true
        exec.eidos_refill_output_word
    end
end

#! Observe one word and flush the resulting transcript prefix before sampling.
#!
#! Input: [word, ...]
#! Output: [...]
pub proc observe_word_and_flush_buffer(value: word)
    exec.eidos_observe_word
    exec.eidos_refill_output_word
end

#! Initializes the Eidos Fiat-Shamir transcript, then derives trace domain parameters.
#!
#! The instance-specific wrapper stores the relation digest in memory before calling the generic
#! verifier.
#!
#! The blowup factor is fixed to 8.
#!
#! Precondition: num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, relation digest,
#! and trace-height metadata must already be stored in memory before calling this procedure.
#!
#! Input: [...]
#! Output: [...]
pub proc init_seed()
    # Initialize the zero word.
    padw
    mem_storew_le.ZERO_WORD_PTR
    dropw
    #=> [...]

    # ---- Relation digest + PCS params ----

    push.EIDOS_TRANSCRIPT_INIT_CV_3.EIDOS_TRANSCRIPT_INIT_CV_2.EIDOS_TRANSCRIPT_INIT_CV_1.EIDOS_TRANSCRIPT_INIT_CV_0
    padw mem_loadw_le.RELATION_DIGEST_PTR
    exec.eidos_init_challenger

    # Absorb PCS parameters as one full Eidos block:
    # [nq, query_pow_bits, deep_pow_bits, folding_pow_bits,
    #  log_blowup, log_final_degree, fold_arity, 0].
    mem_load.FOLDING_POW_BITS_PTR
    mem_load.DEEP_POW_BITS_PTR
    mem_load.QUERY_POW_BITS_PTR
    mem_load.NUM_QUERIES_PTR

    push.0
    push.FRI_FOLD_ARITY
    push.LOG_FINAL_DEGREE
    push.LOG_BLOWUP_FACTOR
    swapw
    exec.eidos_absorb_block
    #=> [...]

    # Bind the trusted preprocessed-trace commitment before statement-owned inputs, matching
    # `StarkProof::from_data`. It remains buffered until the claim commitment completes the block.
    padw mem_loadw_le.PREPROCESSED_TRACE_COM_PTR
    exec.eidos_observe_word

    # ---- Derive trace domain parameters ----
    #
    # Reload log(trace_length) from memory (it was saved earlier) and derive
    # trace_length, LDE domain size, LDE generator, and trace generator.

    mem_load.LOG_TRACE_LENGTH_PTR
    #=> [log(trace_length), ...]

    ## Compute trace_length = 2^log(trace_length)
    dup
    pow2
    u32test assert.err="trace length overflows u32"
    #=> [trace_length, log(trace_length), ...]

    ## Save the trace length to memory
    dup mem_store.TRACE_LENGTH_PTR
    #=> [trace_length, log(trace_length), ...]

    ## Compute log size of LDE domain
    swap
    push.LOG_BLOWUP_FACTOR
    add
    #=> [log(lde_size), trace_length, ...]

    ## Compute size of LDE domain
    dup
    pow2
    #=> [lde_size, log(lde_size), trace_length, ...]

    # Compute lde_domain generator
    dup.1
    exec.utils::compute_lde_generator
    movdn.2
    #=> [lde_size, log(lde_size), lde_g, trace_length, ...]

    # Store the LDE coset shift used by the lifted domains. It depends on LDE size and is used
    # by quotient recomposition and DEEP query points.
    dup.1
    exec.utils::compute_lde_shift
    dup mem_store.DOMAIN_OFFSET_PTR
    inv mem_store.DOMAIN_OFFSET_INV_PTR
    #=> [lde_size, log(lde_size), lde_g, trace_length, ...]

    push.0
    movdn.3
    #=> [lde_size, log(lde_size), lde_g, 0, trace_length, ...]

    # Save `[0, lde_g, log(lde_size), lde_size]`
    mem_storew_le.LDE_DOMAIN_INFO_PTR
    #=> [lde_size, log(lde_size), lde_g, 0, trace_length, ...]

    # clean stack
    drop drop
    #=> [lde_g, 0, trace_length, ...]

    # Compute trace generator `trace_g` = `lde_g^blowup_factor`
    repeat.3
        dup mul
    end
    #=> [trace_g, 0, trace_length, ...]

    # Save `trace_g` to memory
    mem_store.TRACE_DOMAIN_GENERATOR_PTR
    #=> [0, trace_length, ...]

    # Clean up the stack.
    drop drop
end

#! Observe the main-trace commitment after statement shape binding.
#!
#! Input: [c0, c1, c2, c3, ...]
#! Output: [...]
pub proc reseed_main_after_shape(root: types::Digest)
    exec.eidos_observe_felt
    exec.eidos_observe_felt
    exec.eidos_observe_felt
    exec.eidos_observe_felt
end

#! Observe a commitment word and stage the per-round PoW witness.
#!
#! Input: [felt, w0, w1, w2, w3, ...]
#! Output: [...]
pub proc reseed_with_felt(value: felt, commitment: types::Digest)
    mem_store.TMP3_PTR
    exec.eidos_observe_word
end

#! Observe one commitment word.
#!
#! Input: [w0, w1, w2, w3, ...]
#! Output: [...]
pub proc reseed_direct(value: word)
    exec.eidos_observe_word
end

#! Verify per-round FRI folding proof-of-work and sample one extension field element.
#!
#! Reads the folding PoW bit count from memory (set by load_security_params). For a nonzero bit
#! count, observes the staged witness and requires the sampled low bits to be zero. A zero bit
#! count requires a zero witness and skips both its observation and the PoW sample.
#!
#! Must be called immediately after `reseed_with_felt`; the witness is staged at `TMP3_PTR`.
#!
#! Input: [...]
#! Output: [a0, a1, ...]
pub proc sample_folding_pow_and_ext() -> types::QuadFelt
    mem_load.FOLDING_POW_BITS_PTR
    dup push.0 neq
    if.true
        mem_load.TMP3_PTR
        exec.eidos_observe_felt
        exec.eidos_sample_bits
        assertz.err="per-round FRI folding grinding check failed"
    else
        drop
        mem_load.TMP3_PTR
        assertz.err="FRI folding proof-of-work nonce must be zero when grinding factor is zero"
    end

    exec.eidos_sample_ext
end

#! Observe a FRI layer commitment and folding PoW witness, then sample the folding challenge.
#!
#! For nonzero folding PoW this specializes the sequence:
#! `reseed_with_felt; sample_folding_pow_and_ext`.
#! The absorb buffer must be empty when the folding PoW bit count is nonzero.
#!
#! Input: [pow_witness, commitment, ...]
#! Output: [alpha0, alpha1, ...]
pub proc reseed_with_folding_pow_and_ext(
    pow_witness: felt,
    commitment: types::Digest,
) -> types::QuadFelt
    mem_load.FOLDING_POW_BITS_PTR
    dup push.0 neq
    if.true
        mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
        assertz.err="reseed_with_folding_pow_and_ext: buffer must be empty"
        exec.eidos_enter_absorbing

        # Build the absorbed block `[commitment, pow_witness, 0, 0, 0]`, keeping pow_bits below it.
        movdn.5
        movdn.4
        push.0.0.0
        movup.7
        swapw

        padw mem_loadw_le.RANDOM_COIN_CV_PTR
        movup.3 add.6 movdn.3
        swapw.2
        swapw
        compress

        swapw.2
        mem_storew_le.RANDOM_COIN_OUTPUT_WORD_PTR
        mem_storew_le.RANDOM_COIN_CV_PTR
        dropw dropw dropw

        push.0 mem_store.RANDOM_COIN_INPUT_LENGTH_PTR
        push.1 mem_store.RANDOM_COIN_COUNTER_PTR
        push.1 mem_store.RANDOM_COIN_OUTPUT_LENGTH_PTR

        # Consume output[0] for the grinding check and output[1], output[2] for alpha, leaving
        # output[3] cached as the next transcript sample.
        dup
        pow2
        u32assert u32overflowing_sub.1 assertz
        mem_load.RANDOM_COIN_OUTPUT_WORD_PTR
        u32split
        swap
        drop
        u32and
        assertz.err="per-round FRI folding grinding check failed"
        drop
        push.RANDOM_COIN_OUTPUT_WORD_PTR add.1 mem_load
        push.RANDOM_COIN_OUTPUT_WORD_PTR add.2 mem_load
        swap
    else
        drop
        exec.reseed_with_felt
        exec.sample_folding_pow_and_ext
    end
end

#! Alias used by the FRI verifier helpers for the Eidos folding reseed.
#!
#! Input: [pow_witness, commitment, ...]
#! Output: [alpha0, alpha1, ...]
pub proc reseed_check_folding_pow_and_sample_alpha(
    pow_witness: felt,
    commitment: types::Digest,
) -> types::QuadFelt
    exec.reseed_with_folding_pow_and_ext
end

# COEFFICIENT GENERATION
# =============================================================================================

#! Draws alpha and beta for the LogUp multiset hash
#! `h(m) = alpha + \sum_{i=0}^{|m| - 1} m_i * beta^i` and stores them at the address held in
#! `constants::AUX_RAND_ELEM_ADDRESS_PTR`.
#!
#! Input: [...]
#! Output: [...]
#!
#! Invocation: exec
pub proc generate_aux_randomness()

    exec.sample_ext
    exec.sample_ext
    # => [beta0, beta1, alpha0, alpha1, ...]

    mem_load.AUX_RAND_ELEM_ADDRESS_PTR mem_storew_le
    dropw
    #=> [...]
end

#! Draw the constraint-composition challenges.
#!
#! Stores `[alpha0, alpha1, beta0, beta1]` at `CONSTRAINT_COMPOSITION_COEFS_PTR`. The generic
#! verifier uses `alpha` for constraint folding; each relation copies `beta` into its own
#! multi-AIR fold slot.
#!
#! Input: [...]
#! Output: [...]
pub proc generate_constraint_composition_coefficients()
    # Sample alpha (constraint folding challenge), then beta (proof-order Horner folding).
    exec.sample_ext
    exec.sample_ext
    # => [beta0, beta1, alpha0, alpha1, ...]
    movup.3 movup.3
    # => [alpha0, alpha1, beta0, beta1, ...]
    push.CONSTRAINT_COMPOSITION_COEFS_PTR
    mem_storew_le dropw
end

#! Draw deep composition polynomial random coefficient and save it at `DEEP_COMPOSITION_COEFS_PTR`.
#!
#! As this random challenge has already been used non-deterministically in prior computations, we
#! also check that the generated challenge matches the non-deterministically provided one.
#!
#! Input: [...]
#! Output: [...]
pub proc generate_deep_composition_random_coefficients()
    # Sample challenge_columns (deep alpha) for batching columns.
    exec.sample_ext
    padw
    mem_loadw_le.DEEP_ALPHA_ADVICE_PTR
    # => [alpha0_nd, alpha1_nd, 0, 0, alpha0, alpha1, ...]

    dup.4 assert_eq
    dup.4 assert_eq
    push.DEEP_COMPOSITION_COEFS_PTR
    mem_storew_le
    dropw

    # Sample challenge_points (deep beta) for batching evaluation points.
    # p3-miden's DEEP formula weights the gz term by beta:
    #   Q(X) = [f(z)-f(X)]/(z-X) + beta * [f(gz)-f(X)]/(gz-X)
    exec.sample_ext
    # => [beta0, beta1, ...]

    # Store [beta0, beta1, alpha0, alpha1] at DEEP_COMPOSITION_COEFS_PTR.
    # (alpha was already stored at positions 2,3 by the mem_storew_le above)
    mem_store.DEEP_COMPOSITION_COEFS_PTR
    push.DEEP_COMPOSITION_COEFS_PTR add.1 mem_store
    #=> [...]
end


# OOD POINT GENERATION
# =============================================================================================

#! Generate the OOD challenge point `z = (z0, z1)` and compute `z^N` where N is
#! the trace length. The resulting word `[(z_0, z_1)^N, z0, z1]` is stored in the
#! global memory address `OOD_POINT_PTR` reserved for it.
#!
#! Input: [X, ...]
#! Output: [...]
#! Note: The top word on the stack is consumed by this procedure.
pub proc generate_z_zN()
    # Sample z and load log trace length N
    exec.sample_ext
    mem_load.LOG_TRACE_LENGTH_PTR
    # => [log(trace_len), z_0, z_1, ...]

    dup.2 dup.2
    # => [z_0, z_1, log(trace_len), z_0, z_1, ...]

    # Compute z^N using the fact that z^N = z^(2^log(N))
    # Loop starts with `i=log(trace_len)`
    push.1
    while.true
        dup.1 dup.1 ext2mul
        # => [(z_0, z_1)^n, i, z_0, z_1, ...]

        dup.2 sub.1 swap.3 push.1 neq
        # => [b, (z_0, z_1)^n, i-1, z_0, z_1, ...]
    end

    movup.2 drop
    # => [(z_0, z_1)^n, z_0, z_1, ...]

    # Store z and z^N
    mem_storew_le.OOD_POINT_PTR
    dropw
end


# INDEX GENERATION
# =============================================================================================

#! Generate a list of `num_queries` number of random indices in the range
#! [0, lde_size) and store it in memory starting from `query_ptr`.
#! The list is stored as `(index, depth, index, 0)` where `index` is the sampled domain-order
#! index and `depth` is `log(lde_domain_size)`, which is needed when computing the DEEP queries.
#!
#! Input: [...]
#! Output: [...]
pub proc generate_list_indices()
    mem_load.NUM_QUERIES_PTR
    mem_load.FRI_QUERIES_ADDRESS_PTR
    #=> [query_ptr, num_queries, ...]

    mem_load.LOG_LDE_DOMAIN_SIZE_PTR
    swap movup.2 swap
    #=> [query_ptr, num_queries, depth, ...]

    dup.2 eq.32
    if.true
        push.0xffffffff
    else
        dup.2 pow2 u32assert u32overflowing_sub.1 assertz
    end
    movdn.3
    #=> [query_ptr, num_queries, depth, index_mask, ...]

    dup.1 push.0 neq
    while.true
        exec.eidos_sample_felt
        u32split swap drop
        dup.4 u32and
        #=> [index, query_ptr, num_queries, depth, index_mask, ...]

        movdn.4
        #=> [query_ptr, num_queries, depth, index_mask, index, ...]

        push.0
        dup.5
        dup.4
        dup.1
        #=> [index, depth, index, 0, query_ptr, num_queries, depth, index_mask, index, ...]

        dup.4 mem_storew_le dropw
        #=> [query_ptr, num_queries, depth, index_mask, index, ...]

        add.4
        movup.4 drop
        #=> [query_ptr + 4, num_queries, depth, index_mask, ...]

        swap sub.1 swap
        #=> [query_ptr + 4, num_queries - 1, depth, index_mask, ...]

        dup.1 push.0 neq
    end

    drop drop drop drop
end

#! Check query PoW and generate the configured query index list.
#!
#! Input: [...]
#! Output: [...]
pub proc check_query_pow_and_generate_list_indices()
    exec.check_query_pow
    exec.generate_list_indices
end


# PROOF-OF-WORK CHECK
# =============================================================================================

#! Verify a proof-of-work witness given pow_bits on the stack.
#!
#! When pow_bits != 0, reads the nonce from advice, observes it, and checks that the next
#! sampled bits are zero.
#! When pow_bits == 0, consumes the witness (must be zero) without affecting the transcript.
#!
#! Used by check_query_pow (query phase) and check_deep_pow (DEEP phase).
#! FRI folding PoW uses a separate path (sample_folding_pow_and_ext) because the
#! witness is bundled with the commitment reseed.
#!
#! Input: [pow_bits, ...]
#! Output: [...]
proc check_pow(pow_bits: u8)
    dup
    push.0 neq
    if.true
        adv_push
        exec.eidos_observe_felt
        exec.eidos_sample_bits
        assertz.err="proof-of-work check failed"
    else
        # Consume witness to keep advice layout, but do not affect transcript.
        adv_push
        assertz.err="proof-of-work nonce must be zero when grinding factor is zero"
        drop
    end
end

#! Check the DEEP proof-of-work.
#!
#! Called before sampling DEEP composition polynomial challenges.
#!
#! Input: [...]
#! Output: [...]
pub proc check_deep_pow()
    mem_load.DEEP_POW_BITS_PTR
    exec.check_pow
end

#! Check DEEP PoW and then sample the DEEP composition challenges.
pub proc check_deep_pow_and_generate_deep_composition_random_coefficients()
    exec.check_deep_pow
    exec.generate_deep_composition_random_coefficients
end

#! Check the query proof-of-work.
#!
#! Called after loading the FRI remainder, before sampling query indices.
#!
#! Input: [...]
#! Output: [...]
pub proc check_query_pow()
    mem_load.QUERY_POW_BITS_PTR
    exec.check_pow
end
