use miden::core::stark::constants
use {
    HOOK_PROCESS_PUBLIC_INPUTS_PTR,
    TMP1_PTR,
    TMP2_PTR,
    ZERO_WORD_PTR,
} from miden::core::stark::constants
use miden::core::stark::types

#! Processes the public inputs.
#!
#! This generic procedure dispatches to the relation-specific public-input handler via `dynexec`.
#! The relation handler owns its public-input schema and Fiat-Shamir observation schedule.
#!
#! Inputs:  [...]
#! Outputs: [...]
#!
#! Invocation: exec
pub proc process_public_inputs()
    push.HOOK_PROCESS_PUBLIC_INPUTS_PTR dynexec
end

#! Loads 8 base-field elements from memory, stores them as 8 extension-field elements, and leaves
#! the base elements in the block slots for one complete Eidos compression.
#!
#! The caller is responsible for absorbing the returned block into its transcript.
#!
#! Both pointers must be word-aligned. The source and destination ranges must be disjoint from
#! one another and from the words at `TMP1_PTR`, `TMP2_PTR`, and `ZERO_WORD_PTR`.
#! Overwrites the words at `TMP1_PTR` and `TMP2_PTR`; `ZERO_WORD_PTR` must contain four zeros.
#!
#! Inputs:  [block(8), CV(4), dst, src, ...]
#! Outputs: [A0(4), A1(4), CV(4), dst + 16, src + 8, ...]
#!
#! A0 and A1 are the original base-element words from memory, in increasing address order.
#!
#! Invocation: exec
pub proc load_base_store_extension_double_word_from_mem(
    state: types::EidosState,
    dst: ptr<types::QuadFelt>,
    src: types::Address,
) -> (types::EidosState, ptr<types::QuadFelt>, types::Address)
    dup.13 mem_loadw_le
    mem_storew_le.TMP1_PTR
    movup.13 add.4 movdn.13

    swapw
    exec.constants::zeroize_stack_word
    # => [0, 0, 0, 0, a0, a1, a2, a3, CV(4), dst, src + 4, ...]
    movdn.7
    movdn.5
    movdn.3
    swap
    # => [a0, 0, a1, 0, a2, 0, a3, 0, CV(4), dst, src + 4, ...]

    dup.12
    mem_storew_le

    dup.13 mem_loadw_le
    mem_storew_le.TMP2_PTR
    movup.13 add.4 movdn.13
    swapw
    # => [a2, 0, a3, 0, a4, a5, a6, a7, CV(4), dst, src + 8, ...]

    dup.12 add.4
    mem_storew_le

    exec.constants::zeroize_stack_word
    movdn.7
    movdn.5
    movdn.3
    swap
    # => [a4, 0, a5, 0, a6, 0, a7, 0, CV(4), dst, src + 8, ...]

    dup.12
    add.8
    mem_storew_le
    mem_loadw_le.TMP2_PTR
    swapw

    dup.12
    add.16 swap.13
    add.12
    mem_storew_le
    mem_loadw_le.TMP1_PTR
    # => [a0, a1, a2, a3, a4, a5, a6, a7, CV(4), dst + 16, src + 8, ...]
end

#! Copies 8 base-field elements from `src` to 8 extension-field slots at `dst`.
#! Each output slot contains the source element followed by a zero high coordinate.
#!
#! Both pointers must be word-aligned. The word at `ZERO_WORD_PTR` must contain four zeros,
#! and the destination must not overlap it. All 8 source elements are read before any write.
#! The three scratch words may contain arbitrary values and are overwritten.
#!
#! Inputs:  [scratch(12), src, dst, ...]
#! Outputs: [scratch(12), src + 8, dst + 16, ...]
#!
#! Invocation: exec
pub proc copy_base_to_extension_double_word(
    scratch0: word,
    scratch1: word,
    scratch2: word,
    src: types::Address,
    dst: ptr<types::QuadFelt>,
) -> (word, word, word, types::Address, ptr<types::QuadFelt>)
    mem_stream
    swapw swapw.2
    mem_loadw_le.ZERO_WORD_PTR
    movdn.7 movdn.5 movdn.3 swap
    # => [a0, 0, a1, 0, a2, 0, a3, 0, a4, a5, a6, a7, src + 8, dst, ...]
    dup.13 mem_storew_le
    swapw
    dup.13 add.4 mem_storew_le
    swapw.2 swapw
    mem_loadw_le.ZERO_WORD_PTR
    movdn.7 movdn.5 movdn.3 swap
    dup.13 add.8 mem_storew_le
    swapw
    dup.13 add.12 mem_storew_le
    movup.13 add.16 movdn.13
    # => [scratch(12), src + 8, dst + 16, ...]
end
