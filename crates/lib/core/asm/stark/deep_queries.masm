use miden::core::stark::types
use {
    CURRENT_TRACE_ROW_ADDRESS_PTR,
    DEEP_ALPHA_ADVICE_PTR,
    DEEP_COMPOSITION_COEFS_PTR,
    DOMAIN_OFFSET_PTR,
    FRI_COM_PTR,
    FRI_QUERIES_ADDRESS_PTR,
    HOOK_COMPUTE_DEEP_COMPOSITION_POLYNOMIAL_QUERIES_PTR,
    LDE_DOMAIN_INFO_PTR,
    OOD_FIXED_TERM_HORNER_EVALUATIONS_PTR,
    OOD_POINT_PTR,
    TMP1_PTR,
    TMP2_PTR,
    TRACE_DOMAIN_GENERATOR_PTR,
} from miden::core::stark::constants

#! Takes a query index and computes poe := domain_gen^index and x := offset * poe. It also computes
#! the denominators (x - z) and (x - gz).
#!
#! Input: [Y, Y, index, query_ptr, ...]
#! Output: [Z, Y, poe, index, query_ptr, ...]
#!
#! where:
#! - Z := [x - z0, -z1, x - gz0, -gz1]
#! - poe := domain_gen^index
#! - x := offset * poe
#! - Y is a "garbage" word
proc compute_denominators(
    scratch: word,
    preserved: word,
    index: u32,
    query_ptr: ptr<word>,
) -> (types::EvaluationPair, word, felt, u32, ptr<word>)
    # Compute poe and x.
    mem_loadw_le.LDE_DOMAIN_INFO_PTR
    #=> [lde_size, depth, domain_gen, 0, Y, index, query_ptr, ...]
    movup.2
    #=> [domain_gen, lde_size, depth, 0, Y, index, query_ptr, ...]
    dup.8
    #=> [index, domain_gen, lde_size, depth, 0, Y, index, query_ptr, ...]
    exp.u32
    dup movdn.8
    mem_load.DOMAIN_OFFSET_PTR mul
    #=> [x, lde_size, depth, 0, Y, poe, index, ...]

    # Get z and gz from memory
    movdn.3
    #=> [lde_size, depth, 0, x, Y, poe, index, ...]
    push.0
    mem_loadw_le.TMP1_PTR
    #=> [-z0, -z1, -gz0, -gz1, x, Y, poe, index, ...]

    # Compute denominators and place poe after Y for word alignment.
    dup.4 add
    #=> [x - z0, -z1, -gz0, -gz1, x, Y, poe, index, ...]
    movup.4
    #=> [x, x - z0, -z1, -gz0, -gz1, Y, poe, index, ...]
    movup.3 add
    #=> [x - gz0, x - z0, -z1, -gz1, Y, poe, index, ...]
    movdn.2
    #=> [x - z0, -z1, x - gz0, -gz1, Y, poe, index, ...]
end

#! Computes the DEEP query.
#!
#! Input: [Z, X, Y, W, query_ptr, ...]
#! Output: [eval0, eval1, Y, W, query_ptr, ...]
#!
#! where:
#!
#! 1. X is [q_x_at_alpha_0, q_x_at_alpha_1, q_x_at_alpha_0, q_x_at_alpha_1]
#! 2. W is [q_z_0, q_z_1, q_gz_0, q_gz_1]
proc divide_and_add(
    denominators: types::EvaluationPair,
    query_evaluations: types::EvaluationPair,
    cursor: types::DeepQueryCursor,
    fixed_evaluations: types::EvaluationPair,
    query_ptr: ptr<word>,
) -> (types::QuadFelt, types::DeepQueryCursor, types::EvaluationPair, ptr<word>)
    swapw
    #=> [X, Z, Y, W, query_ptr, ...]
    dupw.3
    #=> [W, X, Z, Y, query_ptr, ...]
    #=> [q_z_0, q_z_1, q_gz_0, q_gz_1, q_x_at_alpha_0, q_x_at_alpha_1, q_x_at_alpha_0, q_x_at_alpha_1, Z, Y, query_ptr, ...]

    movdn.5 movdn.5
    #=> [q_gz_0, q_gz_1, q_x_at_alpha_0, q_x_at_alpha_1, q_z_0, q_z_1, q_x_at_alpha_0, q_x_at_alpha_1, Z, Y, query_ptr, ...]

    ext2add
    #=> [num_gz_0, num_gz_1, q_z_0, q_z_1, q_x_at_alpha_0, q_x_at_alpha_1, Z, Y, query_ptr, ...]

    swap movdn.9 movdn.8
    #=> [q_z_0, q_z_1, q_x_at_alpha_0, q_x_at_alpha_1, Z, num_gz_0, num_gz_1, Y, query_ptr, ...]

    ext2add
    #=> [num_z_0, num_z_1, Z, num_gz_0, num_gz_1, Y, query_ptr, ...]

    movup.3 movup.3
    ext2div
    #=> [res_z_0, res_z_1, gz0_0, gz0_1, num_gz_0, num_gz_1, Y, query_ptr, ...]
    movdn.5 movdn.5
    #=> [gz0_0, gz0_1, num_gz_0, num_gz_1, res_z_0, res_z_1, Y, query_ptr, ...]
    ext2div
    #=> [res_gz_0, res_gz_1, res_z_0, res_z_1, Y, query_ptr, ...]

    # Multiply res_gz by challenge_points (beta) for point batching.
    # DEEP formula: Q(X) = res_z + beta * res_gz
    # beta is stored at DEEP_COMPOSITION_COEFS_PTR (positions 0,1).
    mem_load.DEEP_COMPOSITION_COEFS_PTR
    push.DEEP_COMPOSITION_COEFS_PTR add.1 mem_load
    swap
    #=> [beta0, beta1, res_gz_0, res_gz_1, res_z_0, res_z_1, Y, query_ptr, ...]
    ext2mul
    #=> [beta_res_gz_0, beta_res_gz_1, res_z_0, res_z_1, Y, query_ptr, ...]

    ext2add
    # => [eval0, eval1, Y, W, query_ptr, ...]
end

#! Prepares the stack for the computation of the DEEP composition polynomial FRI queries.
#!
#! It also performs some pre-computations that are common to all queries as an optimization.
#!
#! Input: [...]
#! Output: [Y, query_ptr, query_end_ptr, W, query_ptr, ...]
#!
#! where:
#!
#! 1. `Y` is a garbage word,
#! 2. `query_ptr` is a pointer to the memory region from where the query indices will be fetched
#!    and to where the computed FRI queries will be stored in a word-aligned manner,
#! 3. `query_end_ptr` is a memory pointer used to indicate the end of the memory region used in
#!    storing the computed FRI queries,
#! 4. `W` is the word `[q_z_0, q_z_1, q_gz_0, q_gz_1]` where `q_z = (q_z_0, q_z_1)` and
#!    `q_gz = (q_gz_0, q_gz_1)` represent the constant terms across all FRI queries computations.
pub proc prepare_stack_deep_queries_computation() -> (
    word,
    ptr<word>,
    ptr<word>,
    types::EvaluationPair,
    ptr<word>,
)
    mem_load.FRI_QUERIES_ADDRESS_PTR
    # => [query_ptr, ...]

    padw mem_loadw_le.OOD_FIXED_TERM_HORNER_EVALUATIONS_PTR
    # => [q_z_0, q_z_1, q_gz_0, q_gz_1, query_ptr, ...]
    # => [W, query_ptr, ...] where W is [q_z_0, q_z_1, q_gz_0, q_gz_1]

    # Get pointer to help test for the last query to be processed
    push.FRI_COM_PTR
    # => [query_end_ptr, W, query_ptr, ...]
    dup.5
    # => [query_ptr, query_end_ptr, W, query_ptr, ...]

    # Store the relation-local query-row pointer, alpha pointer, and a fresh accumulator (0, 0).
    push.0.0
    push.DEEP_ALPHA_ADVICE_PTR
    mem_load.CURRENT_TRACE_ROW_ADDRESS_PTR
    mem_storew_le.TMP2_PTR

    # Compute the negations of z and gz where z is the OOD point
    # We do it here as this computation is common to all queries.
    mem_loadw_le.OOD_POINT_PTR
    # => [zN_0, zN_1, z0, z1, query_ptr, query_end_ptr, W, query_ptr, ...]
    drop drop
    neg swap neg
    swap
    # => [-z0, -z1, query_ptr, query_end_ptr, W, query_ptr, ...]
    dup
    mem_load.TRACE_DOMAIN_GENERATOR_PTR mul
    # => [-gz0, -z0, -z1, query_ptr, query_end_ptr, W, query_ptr, ...]
    dup.2
    mem_load.TRACE_DOMAIN_GENERATOR_PTR mul
    # => [-gz1, -gz0, -z0, -z1, query_ptr, query_end_ptr, W, query_ptr, ...]
    movdn.3 movdn.2
    # => [-z0, -z1, -gz0, -gz1, query_ptr, query_end_ptr, W, query_ptr, ...]
    # Save to temporary location `TMP1_PTR` for later use when computing the denominators
    mem_storew_le.TMP1_PTR
    # => [Y, query_ptr, query_end_ptr, W, query_ptr, ...]
end

#! Compute the DEEP composition polynomial FRI query at `index`.
#!
#! Input: [Y, X, index, query_ptr, query_end_ptr, W, query_ptr, ...]
#! Output: [?, Y, query_ptr+4, query_end_ptr, ...]
#!
#! where:
#! 1. `Y` is a garbage word,
#! 2. `X` is `[q_x_at_alpha_0, q_x_at_alpha_1, q_x_at_alpha_0, q_x_at_alpha_1]` where
#!    `q_x = (q_x_0, q_x_1)` is the variable part of the query,
#! 3. `index` is the query index in the FRI domain,
#! 4. `query_ptr` is a pointer to the memory region from where the query indices will be fetched
#!    and to where the computed FRI queries will be stored in a word-aligned manner,
#! 5. `query_end_ptr` is a memory pointer used to indicate the end of the memory region used in
#!    storing the computed FRI queries,
#! 6. `W` is the word `[q_z_0, q_z_1, q_gz_0, q_gz_1]` where `q_z = (q_z_0, q_z_1)` and
#!    `q_gz = (q_gz_0, q_gz_1)` represent the constant terms across all FRI queries computations.
#! 7. `?` is a binary flag indicating if there are further queries to process.
pub proc compute_deep_query(
    scratch: word,
    evaluations: types::EvaluationPair,
    index: u32,
    query_ptr: ptr<word>,
    query_end_ptr: ptr<word>,
    fixed_evaluations: types::EvaluationPair,
    queries_ptr: ptr<word>,
) -> (i1, types::FriQuery, ptr<word>, ptr<word>, types::EvaluationPair, ptr<word>)
    # 1) Compute poe := domain_gen^index, x := offset * poe, and denominators (x - z)
    # and (x - gz).
    exec.compute_denominators
    #=> [Z, X, poe, index, query_ptr, query_end_ptr, W, query_ptr, ...]

    # 2) Compute final result
    exec.divide_and_add
    #=> [eval0, eval1, poe, index, query_ptr, query_end_ptr, W, query_ptr, ...]

    # 3) Store [poe, index, eval0, eval1] and prepare stack for next iteration.

    ## a) Bring poe and index to the top of the stack.
    movup.3 movup.3
    #=> [poe, index, eval0, eval1, query_ptr, query_end_ptr, W, query_ptr, ...]

    ## b) Store [poe, index, eval0, eval1].
    dup.4 add.4 swap.5
    mem_storew_le
    #=> [poe, index, eval0, eval1, query_ptr+4, query_end_ptr, W, query_ptr, ...]

    ## c) Prepare stack for next iteration
    dup.5 dup.5
    neq
    #=> [?, Y, query_ptr+4, query_end_ptr, ...]
end

#! Computes the DEEP composition polynomial FRI queries.
#!
#! Inputs:  [...]
#! Outputs: [...]
#!
#! Invocation: exec
pub proc compute_deep_composition_polynomial_queries()
    # Prepare the stack for the core procedure computing the queries
    exec.prepare_stack_deep_queries_computation
    # => [Y, query_ptr, query_end_ptr, W, query_ptr]
    push.HOOK_COMPUTE_DEEP_COMPOSITION_POLYNOMIAL_QUERIES_PTR dynexec
    # => [...]
end
