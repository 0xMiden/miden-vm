use miden::core::stark::types
use {
    CURRENT_TRACE_ROW_PTR,
    DEEP_ALPHA_ADVICE_PTR,
    DEEP_COMPOSITION_COEFS_PTR,
    DEEP_POINT_BATCHING_COEF_HI_PTR,
    DOMAIN_OFFSET_PTR,
    FRI_COM_PTR,
    FRI_QUERIES_ADDRESS_PTR,
    HOOK_COMPUTE_DEEP_COMPOSITION_POLYNOMIAL_QUERIES_PTR,
    LDE_DOMAIN_GENERATOR_PTR,
    OOD_FIXED_TERM_HORNER_EVALUATIONS_PTR,
    OOD_POINT_PTR,
    TMP1_PTR,
    TMP2_PTR,
    TRACE_DOMAIN_GENERATOR_PTR,
} from miden::core::stark::constants

#! Computes the unshifted domain point poe = domain_gen^index and the two DEEP denominators.
#! The actual evaluation point is x = offset * poe. TMP1_PTR must hold [-z0, -z1, -gz0, -gz1],
#! as initialized by prepare_stack_deep_queries_computation. The second input word is preserved.
#!
#! Input:  [scratch(4), preserved(4), index, query_ptr, ...]
#! Output: [x-z0, -z1, x-gz0, -gz1, preserved(4), poe, index, query_ptr, ...]
proc compute_denominators(
    scratch: word,
    preserved: word,
    index: u32,
    query_ptr: ptr<word>,
) -> (types::EvaluationPair, word, felt, u32, ptr<word>)
    # Discard one scratch slot so the index is at native dup.7 depth.
    drop dup.7
    mem_load.LDE_DOMAIN_GENERATOR_PTR swap
    # => [index, domain_gen, scratch(3), preserved(4), index, query_ptr, ...]
    exp.u32
    dup movdn.8
    mem_load.DOMAIN_OFFSET_PTR mul
    # => [x, scratch(3), preserved(4), poe, index, query_ptr, ...]

    movdn.3 push.0
    mem_loadw_le.TMP1_PTR
    # => [-z0, -z1, -gz0, -gz1, x, preserved(4), poe, index, query_ptr, ...]

    # Add x to the base coordinate of each negated OOD point.
    dup.4 add
    #=> [x - z0, -z1, -gz0, -gz1, x, preserved(4), poe, index, query_ptr, ...]
    movup.4
    #=> [x, x - z0, -z1, -gz0, -gz1, preserved(4), poe, index, query_ptr, ...]
    movup.3 add
    #=> [x - gz0, x - z0, -z1, -gz1, preserved(4), poe, index, query_ptr, ...]
    movdn.2
    #=> [x - z0, -z1, x - gz0, -gz1, preserved(4), poe, index, query_ptr, ...]
end

#! Combines the current- and next-row DEEP quotients with one checked extension division.
#!
#! Let d_z = x-z, d_gz = x-gz and q_x be the column fold of the opened row. The fixed word
#! contains q_z = -Q_current(alpha) and q_gz = -Q_next(alpha). With the transcript-derived
#! point challenge beta, the result is (q_x+q_z)/d_z + beta*(q_x+q_gz)/d_gz.
#! Both denominators must be nonzero, even when a numerator or beta is zero.
#!
#! Input:  [denominators(4), q_x(2), q_x(2), cursor(4), fixed(4), queries_ptr, ...]
#! Output: [eval0, eval1, cursor(4), fixed(4), queries_ptr, ...]
proc divide_and_add(
    denominators: types::EvaluationPair,
    query_evaluations: types::EvaluationPair,
    cursor: types::DeepQueryCursor,
    fixed_evaluations: types::EvaluationPair,
    query_ptr: ptr<word>,
) -> (types::QuadFelt, types::DeepQueryCursor, types::EvaluationPair, ptr<word>)
    # Form (q_x + q_z) * d_gz, retaining both denominators for their product.
    movup.7 movup.7
    dup.13 dup.13
    ext2add
    dup.5 dup.5
    ext2mul
    # => [term_z(2), denominators(4), q_x(2), cursor(4), fixed(4), queries_ptr, ...]

    # Form beta * (q_x + q_gz) * d_z.
    movup.7 movup.7
    dup.15 dup.15
    ext2add
    mem_load.DEEP_POINT_BATCHING_COEF_HI_PTR
    mem_load.DEEP_COMPOSITION_COEFS_PTR
    ext2mul
    dup.5 dup.5
    ext2mul
    ext2add
    # => [numerator(2), denominators(4), cursor(4), fixed(4), queries_ptr, ...]

    # numerator / (d_z * d_gz) = (q_x + q_z) / d_z + beta * (q_x + q_gz) / d_gz.
    # In the extension field, d_z * d_gz is nonzero exactly when both denominators are nonzero.
    # ext2div checks the inverse of that product, rejecting either zero denominator.
    movdn.5 movdn.5
    ext2mul
    ext2div
    # => [eval0, eval1, cursor(4), fixed(4), queries_ptr, ...]
end

#! Initializes the shared state for the relation's DEEP query loop.
#!
#! Reads the query-region base, negated OOD folds, OOD point and trace generator.
#! Writes [-z0, -z1, -gz0, -gz1] to TMP1_PTR and
#! [CURRENT_TRACE_ROW_PTR, DEEP_ALPHA_ADVICE_PTR, 0, 0] to TMP2_PTR.
#! These words remain live throughout the query loop.
#! The fixed word is [-Q_current(alpha), -Q_next(alpha)], encoded as two extension values.
#! The query region ends at FRI_COM_PTR; its original base is retained for final cleanup.
#!
#! Input:  [...]
#! Output: [scratch(4), query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
pub proc prepare_stack_deep_queries_computation() -> (
    word,
    ptr<word>,
    ptr<word>,
    types::EvaluationPair,
    ptr<word>,
)
    mem_load.FRI_QUERIES_ADDRESS_PTR
    # => [queries_ptr, ...]

    padw mem_loadw_le.OOD_FIXED_TERM_HORNER_EVALUATIONS_PTR
    # => [fixed(4), queries_ptr, ...]

    # Keep the region's end and original base below the advancing query cursor.
    push.FRI_COM_PTR
    # => [query_end_ptr, fixed(4), queries_ptr, ...]
    dup.5
    # => [query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]

    # Store the shared query-row pointer, alpha pointer, and a fresh accumulator (0, 0).
    push.0.0
    push.DEEP_ALPHA_ADVICE_PTR
    push.CURRENT_TRACE_ROW_PTR
    mem_storew_le.TMP2_PTR

    # Compute the negations of z and gz where z is the OOD point
    # We do it here as this computation is common to all queries.
    mem_loadw_le.OOD_POINT_PTR
    # => [zN_0, zN_1, z0, z1, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
    drop drop
    neg swap neg
    swap
    # => [-z0, -z1, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
    dup
    mem_load.TRACE_DOMAIN_GENERATOR_PTR mul
    # => [-gz0, -z0, -z1, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
    dup.2
    mem_load.TRACE_DOMAIN_GENERATOR_PTR mul
    # => [-gz1, -gz0, -z0, -z1, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
    movdn.3 movdn.2
    # => [-z0, -z1, -gz0, -gz1, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
    # Save to temporary location `TMP1_PTR` for later use when computing the denominators
    mem_storew_le.TMP1_PTR
    # => [scratch(4), query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
end

#! Computes and stores one DEEP query, then advances the query cursor by four cells.
#!
#! The two copies of q_x are the column fold of the authenticated row. The fixed word holds
#! the negated current/next OOD folds. Requires the shared state initialized by
#! prepare_stack_deep_queries_computation, and query_ptr < query_end_ptr in an aligned
#! four-felt record region. Stores [poe, index, eval0, eval1] at query_ptr, where
#! poe = domain_gen^index is the unshifted FRI point. The stored word remains on the stack
#! for reuse as scratch in the next iteration; more_queries is next_ptr != query_end_ptr.
#!
#! Input:  [scratch(4), q_x(2), q_x(2), index, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
#! Output: [more_queries, query(4), next_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
pub proc compute_deep_query(
    scratch: word,
    evaluations: types::EvaluationPair,
    index: u32,
    query_ptr: ptr<word>,
    query_end_ptr: ptr<word>,
    fixed_evaluations: types::EvaluationPair,
    queries_ptr: ptr<word>,
) -> (i1, types::FriQuery, ptr<word>, ptr<word>, types::EvaluationPair, ptr<word>)
    # 1) Compute poe := domain_gen^index, x := offset * poe, and denominators (x - z)
    # and (x - gz).
    exec.compute_denominators
    #=> [denominators(4), q_x(2), q_x(2), poe, index, query_ptr, query_end_ptr,
    #    fixed(4), queries_ptr, ...]

    # 2) Compute final result
    exec.divide_and_add
    #=> [eval0, eval1, poe, index, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]

    # 3) Store [poe, index, eval0, eval1] and prepare stack for next iteration.

    ## a) Bring poe and index to the top of the stack.
    movup.3 movup.3
    #=> [poe, index, eval0, eval1, query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]

    ## b) Store [poe, index, eval0, eval1].
    dup.4 add.4 swap.5
    mem_storew_le
    #=> [poe, index, eval0, eval1, query_ptr+4, query_end_ptr, fixed(4), queries_ptr, ...]

    ## c) Prepare stack for next iteration
    dup.5 dup.5
    neq
    #=> [more_queries, query(4), query_ptr+4, query_end_ptr, fixed(4), queries_ptr, ...]
end

#! Computes the DEEP composition polynomial FRI queries.
#!
#! Inputs:  [...]
#! Outputs: [...]
#!
#! Invocation: exec
pub proc compute_deep_composition_polynomial_queries()
    # Prepare the stack for the core procedure computing the queries
    exec.prepare_stack_deep_queries_computation
    # => [scratch(4), query_ptr, query_end_ptr, fixed(4), queries_ptr, ...]
    push.HOOK_COMPUTE_DEEP_COMPOSITION_POLYNOMIAL_QUERIES_PTR dynexec
    # => [...]
end
