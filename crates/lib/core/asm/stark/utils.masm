use miden::core::stark::constants

# Accepted transcript-bound security-parameter envelope for the recursive verifier. These bounds
# also define the domain over which its returned descriptor may be passed to the common estimator.
const NUM_QUERIES_MIN = 7
const NUM_QUERIES_MAX = 150
const POW_BITS_MAX = 31

# Largest AIR count a relation may declare. Bounded by the Lehmer rank of a full permutation
# fitting in u32 (13! overflows it), which the shared ranking still uses to enumerate every
# proof order for tests, even though the verifier no longer routes by rank. Must match the shared
# Rust `miden_ace_codegen::MAX_ORDER_AIRS` (enforced by cross-tests).
const MAX_ORDER_AIRS = 12

#! Loads the proof's security parameters from advice into the generic verifier context.
#!
#! Advice order: [num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits].
#! Inputs:  [...]
#! Outputs: [...]
pub proc load_security_params
    adv_push exec.constants::set_number_queries
    adv_push exec.constants::set_query_pow_bits
    adv_push exec.constants::set_deep_pow_bits
    adv_push exec.constants::set_folding_pow_bits
end

#! Compute the LDE domain generator from the log2 of its size.
#!
#! Input: [log2(domain_size), ..]
#! Output: [domain_gen, ..]
pub proc compute_lde_generator
    push.32
    swap
    sub
    pow2
    exec.constants::get_root_unity
    swap
    exp.u32
    # => [domain_gen, ..]
end

#! Compute the canonical LDE coset shift from the log2 of its size.
#!
#! This mirrors `LiftedDomain::canonical_lde_shift(log_lde_order)` on the Rust side:
#! `Felt::GENERATOR^(2^(TWO_ADICITY - log_lde_order))`.
#!
#! Input: [log2(domain_size), ..]
#! Output: [domain_shift, ..]
pub proc compute_lde_shift
    push.32
    swap
    sub
    pow2
    push.7
    swap
    # => [exponent, generator, ..]
    exp.u32
    # => [domain_shift, ..]
end

#! Validates generic security parameters for the recursive verifier.
#!
#! The instance-specific wrapper validates shape and stores these parameters before calling the
#! generic verifier.
#!
#! Input: [...]
#! Output: [...]
pub proc validate_inputs
    # The query upper bound is a soft restriction imposed by the current verifier memory layout.
    exec.constants::get_number_queries
    dup u32lte.NUM_QUERIES_MAX assert.err="num_queries must be at most 150"
    u32gte.NUM_QUERIES_MIN assert.err="num_queries must be at least 7"

    # PoW bit counts must fit in the verifier's u32 bit masking.
    exec.constants::get_query_pow_bits
    u32lte.POW_BITS_MAX assert.err="query_pow_bits must be less than 32"

    exec.constants::get_deep_pow_bits
    u32lte.POW_BITS_MAX assert.err="deep_pow_bits must be less than 32"

    exec.constants::get_folding_pow_bits
    u32lte.POW_BITS_MAX assert.err="folding_pow_bits must be less than 32"
end

#! Reverse the lowest `bits` bits of `index` using parallel bit-swap.
#! `pow2_shift` must equal 2^(32 - bits); the caller pre-computes it once.
#!
#! The algorithm has two parts:
#!
#! 1) Left-shift: multiply index by pow2_shift = 2^(32-bits) to place the `bits`
#!    meaningful bits into the top of a 32-bit word. Since index < 2^bits, the
#!    product is always < 2^32 so u32wrapping_mul is exact.
#!
#! 2) Full 32-bit reversal via 5 parallel swap steps. Each step k (for k=1,2,4,8,16)
#!    swaps every adjacent group of k bits. A mask isolates the even-positioned
#!    groups; the odd-positioned groups are the complement. Shifting each half by
#!    k positions and combining swaps all groups simultaneously. After all 5 steps,
#!    bit position i has moved to position 31-i, which (because of the initial
#!    left-shift) is exactly position (bits-1-i) of the original -- i.e., the
#!    reversed index. No final shift is needed.
#!
#! The two halves never overlap, so XOR = OR = ADD; we use XOR (1 cycle vs 3 for
#! u32wrapping_add).
#!
#! Input: [index, pow2_shift, ...]
#! Output: [rev_index, ...]
pub proc bit_reverse_len_parallel
    u32wrapping_mul

    # Step 1: swap adjacent bits
    # x = ((x >> 1) & 0x55555555) ^ ((x & 0x55555555) << 1)
    dup u32shr.1 push.0x55555555 u32and
    swap push.0x55555555 u32and u32shl.1
    u32xor
    #=> [x1, ...]

    # Step 2: swap bit pairs
    # x = ((x >> 2) & 0x33333333) ^ ((x & 0x33333333) << 2)
    dup u32shr.2 push.0x33333333 u32and
    swap push.0x33333333 u32and u32shl.2
    u32xor
    #=> [x2, ...]

    # Step 3: swap nibbles
    # x = ((x >> 4) & 0x0F0F0F0F) ^ ((x & 0x0F0F0F0F) << 4)
    dup u32shr.4 push.0x0F0F0F0F u32and
    swap push.0x0F0F0F0F u32and u32shl.4
    u32xor
    #=> [x3, ...]

    # Step 4: swap bytes
    # x = ((x >> 8) & 0x00FF00FF) ^ ((x & 0x00FF00FF) << 8)
    dup u32shr.8 push.0x00FF00FF u32and
    swap push.0x00FF00FF u32and u32shl.8
    u32xor
    #=> [x4, ...]

    # Step 5: swap halfwords
    # x = (x >> 16) ^ (x << 16)  (no mask needed, both halves fit in 16 bits)
    dup u32shr.16
    swap u32shl.16
    u32xor
    #=> [rev_index, ...]
end

#! Executes the constraints evaluation check.
#!
#! Inputs:  [...]
#! Outputs: [...]
#!
#! Invocation: exec
pub proc execute_constraint_evaluation_check
    exec.constants::get_procedure_digest_execute_constraint_evaluation_check_ptr dynexec
end

#! Observes the auxiliary trace: draws aux randomness, reseeds with the aux trace commitment,
#! and absorbs aux trace boundary values into the transcript.
#!
#! For AIRs without an auxiliary trace, the implementation should be a no-op.
#!
#! Inputs:  [...]
#! Outputs: [...]
#!
#! Invocation: exec
pub proc observe_aux_trace
    exec.constants::get_procedure_digest_observe_aux_trace_ptr dynexec
end

#! Stores digests of dynamically executed procedures.
#!
#! Input: [D0, D1, D2, D3, D4, ...]
#! Output: [...]
pub proc store_dynamically_executed_procedures
    exec.constants::get_procedure_digest_observe_aux_trace_ptr mem_storew_le dropw
    exec.constants::get_procedure_digest_process_public_inputs_ptr mem_storew_le dropw
    exec.constants::get_procedure_digest_process_row_ood_evaluations_ptr mem_storew_le dropw
    exec.constants::get_procedure_digest_execute_constraint_evaluation_check_ptr mem_storew_le dropw
    exec.constants::get_procedure_digest_compute_deep_composition_polynomial_queries_ptr mem_storew_le dropw
    # => [...]
end

#! Returns one canonical AIR's position in the stable height-sorted proof order.
#!
#! The proof order sorts the relation's AIRs by ascending log height, with the canonical instance
#! order breaking ties (a stable sort): earlier AIRs precede the target on equal heights, later
#! AIRs precede it only on a strictly smaller height. Relation hooks use this to route each AIR's
#! canonical data to, or read it from, its position in the proof stream.
#!
#! Precondition: `target_index < num_airs <= MAX_ORDER_AIRS` and `num_airs >= 2`.
#!
#! Input:  [target_index, num_airs, heights_ptr]
#! Output: [proof_order_position]
pub proc proof_order_position_from_heights
    dup.1 u32lte.MAX_ORDER_AIRS assert.err="num_airs exceeds supported proof-order range"
    dup dup.2 u32lt assert.err="target AIR index exceeds relation size"

    # Load the target height.
    dup.2 dup.1 add mem_load
    # => [h_k, k, num_airs, heights_ptr]

    push.0.0
    # => [m = 0, inv = 0, h_k, k, num_airs, heights_ptr]

    # Count earlier AIRs that sort after the target.
    dup.3 dup.1 u32gt
    while.true
        dup.5 dup.1 add mem_load
        # => [h_m, m, inv, h_k, k, num_airs, heights_ptr]

        dup dup.4 u32gt
        movup.3 add movdn.2

        drop add.1
        dup.3 dup.1 u32gt
    end
    drop
    # => [inv, h_k, k, num_airs, heights_ptr]

    # Among the k earlier AIRs, exactly k - inv precede the target.
    dup.2 dup.1 sub
    swap
    # => [inv, pos = k - inv, h_k, k, num_airs, heights_ptr]

    # Count later AIRs with a strictly smaller height.
    dup.3 add.1
    dup.5 dup.1 u32gt
    while.true
        dup.6 dup.1 add mem_load
        # => [h_m, m, inv, pos, h_k, k, num_airs, heights_ptr]

        dup dup.5 u32lt
        movup.4 add movdn.3

        drop add.1
        dup.5 dup.1 u32gt
    end
    drop
    # => [inv, pos, h_k, k, num_airs, heights_ptr]

    drop
    # => [pos, h_k, k, num_airs, heights_ptr]
    swap drop
    swap drop
    swap drop
    swap drop
end

#! Computes x! for small x.
#!
#! Input:  [x]
#! Output: [x!]
pub proc factorial
    push.1 swap
    dup neq.0
    while.true
        dup movup.2 mul
        swap sub.1
        dup neq.0
    end
    drop
end
