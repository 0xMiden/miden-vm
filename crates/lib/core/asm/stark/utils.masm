use {
    DEEP_POW_BITS_PTR,
    FOLDING_POW_BITS_PTR,
    HOOK_COMPUTE_DEEP_COMPOSITION_POLYNOMIAL_QUERIES_PTR,
    HOOK_EXECUTE_CONSTRAINT_EVALUATION_CHECK_PTR,
    HOOK_OBSERVE_AUX_TRACE_PTR,
    HOOK_PROCESS_PUBLIC_INPUTS_PTR,
    HOOK_PROCESS_ROW_OOD_EVALUATIONS_PTR,
    NUM_QUERIES_PTR,
    QUERY_POW_BITS_PTR,
    ROOT_UNITY,
} from miden::core::stark::constants
use miden::core::stark::types

# Accepted transcript-bound security-parameter envelope for the recursive verifier. These bounds
# also define the domain over which its returned descriptor may be passed to the common estimator.
const NUM_QUERIES_MIN = 7
const NUM_QUERIES_MAX = 150
const POW_BITS_MAX = 31

#! Loads the proof's security parameters from advice into the generic verifier context.
#!
#! Advice order: [num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits].
#! Inputs:  [...]
#! Outputs: [...]
pub proc load_security_params()
    adv_push mem_store.NUM_QUERIES_PTR
    adv_push mem_store.QUERY_POW_BITS_PTR
    adv_push mem_store.DEEP_POW_BITS_PTR
    adv_push mem_store.FOLDING_POW_BITS_PTR
end

#! Compute the LDE domain generator from the log2 of its size.
#!
#! Input: [log2(domain_size), ..]
#! Output: [domain_gen, ..]
pub proc compute_lde_generator(log_domain_size: u8) -> felt
    push.32
    swap
    sub
    pow2
    push.ROOT_UNITY
    swap
    exp.u32
    # => [domain_gen, ..]
end

#! Compute the canonical LDE coset shift from the log2 of its size.
#!
#! This mirrors `LiftedDomain::canonical_lde_shift(log_lde_order)` on the Rust side:
#! `Felt::GENERATOR^(2^(TWO_ADICITY - log_lde_order))`.
#!
#! Input: [log2(domain_size), ..]
#! Output: [domain_shift, ..]
pub proc compute_lde_shift(log_domain_size: u8) -> felt
    push.32
    swap
    sub
    pow2
    push.7
    swap
    # => [exponent, generator, ..]
    exp.u32
    # => [domain_shift, ..]
end

#! Validates generic security parameters for the recursive verifier.
#!
#! The instance-specific wrapper validates shape and stores these parameters before calling the
#! generic verifier.
#!
#! Input: [...]
#! Output: [...]
pub proc validate_inputs()
    # The query upper bound is a soft restriction imposed by the current verifier memory layout.
    mem_load.NUM_QUERIES_PTR
    dup u32lte.NUM_QUERIES_MAX assert.err="num_queries must be at most 150"
    u32gte.NUM_QUERIES_MIN assert.err="num_queries must be at least 7"

    # PoW bit counts must fit in the verifier's u32 bit masking.
    mem_load.QUERY_POW_BITS_PTR
    u32lte.POW_BITS_MAX assert.err="query_pow_bits must be less than 32"

    mem_load.DEEP_POW_BITS_PTR
    u32lte.POW_BITS_MAX assert.err="deep_pow_bits must be less than 32"

    mem_load.FOLDING_POW_BITS_PTR
    u32lte.POW_BITS_MAX assert.err="folding_pow_bits must be less than 32"
end

#! Executes the constraints evaluation check.
#!
#! Inputs:  [...]
#! Outputs: [...]
#!
#! Invocation: exec
pub proc execute_constraint_evaluation_check()
    push.HOOK_EXECUTE_CONSTRAINT_EVALUATION_CHECK_PTR dynexec
end

#! Observes the auxiliary trace: draws aux randomness, reseeds with the aux trace commitment,
#! and absorbs aux trace boundary values into the transcript.
#!
#! For AIRs without an auxiliary trace, the implementation should be a no-op.
#!
#! Inputs:  [...]
#! Outputs: [...]
#!
#! Invocation: exec
pub proc observe_aux_trace()
    push.HOOK_OBSERVE_AUX_TRACE_PTR dynexec
end

#! Stores digests of dynamically executed procedures.
#!
#! Input: [D0, D1, D2, D3, D4, ...]
#! Output: [...]
pub proc store_dynamically_executed_procedures(hooks: types::VerifierHooks)
    mem_storew_le.HOOK_OBSERVE_AUX_TRACE_PTR dropw
    mem_storew_le.HOOK_PROCESS_PUBLIC_INPUTS_PTR dropw
    mem_storew_le.HOOK_PROCESS_ROW_OOD_EVALUATIONS_PTR dropw
    mem_storew_le.HOOK_EXECUTE_CONSTRAINT_EVALUATION_CHECK_PTR dropw
    mem_storew_le.HOOK_COMPUTE_DEEP_COMPOSITION_POLYNOMIAL_QUERIES_PTR dropw
    # => [...]
end

#! Computes x! for small x.
#!
#! Input:  [x]
#! Output: [x!]
pub proc factorial(value: u8) -> felt
    push.1 swap
    dup neq.0
    while.true
        dup movup.2 mul
        swap sub.1
        dup neq.0
    end
    drop
end
