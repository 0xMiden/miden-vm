use {
    COMPOSITION_POLY_COM_PTR,
    DEEP_POW_BITS_PTR,
    FOLDING_POW_BITS_PTR,
    MAIN_TRACE_COM_PTR,
    NUM_QUERIES_PTR,
    QUERY_POW_BITS_PTR,
} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::pcs::fri::frie2f4
use miden::core::pcs::fri::helper

use miden::core::stark::deep_queries
use miden::core::stark::random_coin
use miden::core::stark::ood_frames
use miden::core::stark::public_inputs
use miden::core::stark::utils

#! Verifies a STARK proof.
#!
#! Generic verifier used by relation-specific wrappers. It expects the following parameters on the
#! stack from the caller:
#!
#! 1. `[D0, D1, D2, D3, D4]` which are the digests for dynamic execution of:
#!   D0. `observe_aux_trace`
#!   D1. `process_public_inputs`
#!   D2. `process_row_ood_evaluations`
#!   D3. `execute_constraint_evaluation_check`
#!   D4. `compute_deep_composition_polynomial_queries`
#!
#! Before calling this procedure, a relation wrapper must:
#!
#! - store the transcript-bound security parameters, which this procedure validates;
#! - store its relation digest, preprocessed commitment at `PREPROCESSED_TRACE_COM_PTR`, and
#!   canonical AIR heights; and
#! - supply the five hooks listed above in the documented ABI order.
#!
#! The relation's ACE READ vector must place the lookup challenges at `AUX_RAND_ELEM_PTR` and
#! its first OOD row at `OOD_EVALUATIONS_PTR`. ACE alignment slots must be zero, as in a fresh
#! execution context. Its query row must fit from `CURRENT_TRACE_ROW_PTR` up to the FRI query
#! reservation at `FRI_COM_PTR - 4 * NUM_QUERIES_MAX`. The relation generator checks these extents.
#!
#! Relation-dependent constants live under `sys/<relation>`. The circuit digest and circuit shape
#! must be derived by regeneration, while any hand-written copy must be pinned to that source.
#!
#! LOG_TRACE_LENGTH_PTR must contain the maximum checked AIR log height, at least
#! LOG_FINAL_DEGREE - 1, so fold-by-four reaches one of the two remainder specializations.
#!
#! Protocol parameters:
#!
#! - Blowup factor: 8.
#! - FRI folding and remainder bounds: generated in `pcs/fri/parameters.masm`.
#! - Constraint folding, OOD evaluations, and aux-trace values use the quadratic extension field.
#!
#! Rust counterpart: `miden_stark::VerifierInstance::verify`. Rust checks PCS openings
#! before evaluating constraints; this procedure evaluates constraints first. Constraint evaluation
#! does not change the Fiat-Shamir transcript, so the order of challenges is the same.
#!
#! Inputs:  [D0(4), D1(4), D2(4), D3(4), D4(4), ...]
#! Outputs: [num_queries, query_pow_bits, deep_pow_bits, folding_pow_bits, ...]
pub proc verify(hooks: types::VerifierHooks) -> types::StackProofParameters

    #==============================================================================================
    #       I)  Observe proof context and load public inputs
    #==============================================================================================

    # Store digests of dynamically executed procedures
    exec.utils::store_dynamically_executed_procedures
    # => [...]

    # Validate generic security parameters.
    exec.utils::validate_inputs
    # => [...]

    # Initialize the Eidos challenger with DSFS seeding and derive trace domain parameters.
    # Security params, relation digest, and trace-height metadata are read from memory.
    exec.random_coin::init_seed
    # => [...]

    # Load and observe public inputs. The relation-specific implementation also appends any
    # transcript items that must precede the main-trace commitment.
    exec.public_inputs::process_public_inputs
    # => [...]

    # Load the main-trace commitment, observe it onto the buffered stream, and flush before
    # sampling auxiliary randomness.
    padw adv_loadw
    mem_storew_le.MAIN_TRACE_COM_PTR
    # => [main_trace_commitment(4), ...]
    exec.random_coin::observe_word_and_flush_buffer
    # => [...]

    #==============================================================================================
    #       II) Observe auxiliary trace
    #==============================================================================================

    # The AIR-specific implementation handles: drawing aux randomness, reseeding with the
    # aux trace commitment, absorbing aux trace boundary values into the transcript, and
    # asserting any AIR-specific boundary identities over the absorbed values.
    # For AIRs without an auxiliary trace, the implementation is a no-op.
    exec.utils::observe_aux_trace
    # => [...]

    #==============================================================================================
    #       III) Draw constraint composition coefficients
    #==============================================================================================

    exec.random_coin::generate_constraint_composition_coefficients
    # => [...]

    #==============================================================================================
    #       IV) Reseed with commitment to constraint composition polynomial H evaluations over LDE
    #          and generate the Out-of-Domain (OOD) challenge z
    #==============================================================================================

    # Bind the constraint-composition commitment before drawing the OOD point.
    padw adv_loadw
    mem_storew_le.COMPOSITION_POLY_COM_PTR
    exec.random_coin::reseed_direct
    exec.random_coin::generate_z_zN
    # => [...]

    #==============================================================================================
    #       V) Read and fold the preprocessed, main, auxiliary and quotient OOD evaluations.
    #==============================================================================================

    exec.ood_frames::load_and_horner_eval_ood_frames

    #==============================================================================================
    #       VI) Evaluate constraints
    #==============================================================================================

    exec.utils::execute_constraint_evaluation_check

    #==============================================================================================
    #       VII) FRI
    #==============================================================================================

    #============================================
    #   1) Check DEEP PoW and draw random
    #       coefficients for DEEP composition
    #       polynomial.
    #============================================

    exec.random_coin::check_deep_pow_and_generate_deep_composition_random_coefficients

    #============================================
    #   2) Compute and store the number of FRI
    #      layers and the remainder polynomial size.
    #============================================

    exec.helper::generate_fri_parameters
    # => [...]

    #============================================
    #   3) Load and reseed with FRI layer commitments
    #      and draw the folding challenges for
    #      computing the degree respecting projection
    #============================================

    exec.helper::load_fri_layer_commitments
    # => [...]

    #============================================
    #   4) Load the remainder polynomial and absorb
    #      it into the transcript.
    #============================================

    exec.helper::load_and_verify_remainder
    # => [...]

    #============================================
    #   5) Check FRI Queries PoW nonce and sample query indices
    #============================================

    # Compute the pointer to the first query using the pointer to
    # the first layer commitment and the total number of queries.
    exec.helper::compute_query_pointer

    exec.random_coin::check_query_pow_and_generate_list_indices
    # => [...]

    #============================================
    #   6) Compute evaluations of DEEP composition
    #   polynomial at randomly chosen query positions
    #============================================

    exec.deep_queries::compute_deep_composition_polynomial_queries
    # => [...]

    #============================================
    #   7) Call the FRI verifier
    #============================================

    exec.frie2f4::verify

    # Return the transcript-bound parameters for the relation wrapper's caller to grade.
    mem_load.FOLDING_POW_BITS_PTR
    mem_load.DEEP_POW_BITS_PTR
    mem_load.QUERY_POW_BITS_PTR
    mem_load.NUM_QUERIES_PTR
end
