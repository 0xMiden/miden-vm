#! Top-level module for internal MASM precompile support.
#!
#! Concrete precompile support modules live here and in submodules. The helper procedures in this
#! module are shared by generated and hand-written wrappers.

pub mod hashes
pub mod fields
pub mod curves
pub mod u256

# Framework data tag used for generic CHUNKS nodes: Tag::CHUNKS = [2, 0, 0, 0].
const CHUNKS_TAG = [2, 0, 0, 0]

# Registered Eidos domain selectors. These must match `miden_core::deferred`.
const DEFERRED_AND_DOMAIN = 0x01000301
const DEFERRED_CHUNKS_DOMAIN = 0x01000401

# Eidos initial-CV bases. Kept local so this package remains independent of `miden-core`; they
# match `miden::core::crypto::eidos`.
const EIDOS_INIT_CV_0_BASE = 4280581857092829184
const EIDOS_INIT_CV_1_BASE = 2688637132020383744
const EIDOS_INIT_CV_2_BASE = 1947077364412317696
const EIDOS_INIT_CV_3_BASE = 6620516959492505600

# Initial chaining words for one, two, and three framework CHUNKS payload blocks. Each word is
# `init(DEFERRED_CHUNKS_DOMAIN, [8 * n_chunks, 0, 0])`.
const DEFERRED_CHUNKS_INIT_CV_1 = [4280581857109607425, 2688637132020383752, 1947077364412317696, 6620516959492505600]
const DEFERRED_CHUNKS_INIT_CV_2 = [4280581857109607425, 2688637132020383760, 1947077364412317696, 6620516959492505600]
const DEFERRED_CHUNKS_INIT_CV_3 = [4280581857109607425, 2688637132020383768, 1947077364412317696, 6620516959492505600]

#! Constructs an Eidos chaining word from a registered selector and three selector-defined
#! parameters.
#! Input: [selector, param0, param1, param2, ...]
#! Output: [CV, ...]
proc init_deferred_cv
    u32assert2.err="Eidos init values must fit in u32"
    movup.3 movup.3 u32assert2.err="Eidos init values must fit in u32"

    push.EIDOS_INIT_CV_2_BASE add
    swap push.EIDOS_INIT_CV_3_BASE add
    movup.3 push.EIDOS_INIT_CV_1_BASE add
    movup.3 push.EIDOS_INIT_CV_0_BASE add
    movup.3 movdn.2
end

#! Constructs `init(selector, [length, 0, 0])`.
#! Input: [length, selector, ...]
#! Output: [CV, ...]
proc init_deferred_cv_in_domain
    u32assert2.err="Eidos init values must fit in u32"

    push.EIDOS_INIT_CV_1_BASE add
    swap push.EIDOS_INIT_CV_0_BASE add
    push.EIDOS_INIT_CV_3_BASE.EIDOS_INIT_CV_2_BASE
    movdn.3 movdn.3
end

#! Constructs the initial Eidos chaining word for a precompile-owned deferred node.
#! The tag's reserved lane must be zero; every value injected into the CV must fit in a u32.
#! Input: [payload_len, TAG=[selector, arg0, arg1, reserved], ...]
#! Output: [CV, ...]
proc init_precompile_deferred_cv
    movup.4 assertz.err="deferred tag reserved lane must be zero"
    swap
    exec.init_deferred_cv
end

#! Returns whether two words are equal, consuming both words.
#!
#! This helper keeps generated precompile modules independent of `miden-core`. Importing
#! `miden::core::word::eq` here would create a dependency cycle because `miden-core` dynamically
#! depends on `miden-precompiles`.
#!
#! Inputs:  [RHS, LHS]
#! Outputs: [is_equal]
#!
#! Where:
#! - RHS is the first word to compare.
#! - LHS is the second word to compare.
#! - is_equal is one if the words are equal, and zero otherwise.
#!
#! Invocation: exec
pub proc word_eq
    movup.4 eq swap
    movup.4 eq and swap
    movup.3 eq and
    movdn.2 eq and
end

# ===== DEFERRED-DAG HELPERS =======================================================================
#
# The internal `miden::precompiles` support namespace cannot import `miden-core` because
# `miden-core` depends on the precompile package. These procedures implement the same registration
# contracts as the core system helpers and must remain semantically aligned with them.
#
# `register_value` / `register_mem` bind their registration inputs by deriving the node digest with
# VM instructions from the exact same tag and payload. There is intentionally no `evaluate` proc
# here — deferred evaluation returns an *unbound* host hint (`adv.evaluate_deferred_payload` for
# payload-only callers, or `adv.evaluate_deferred` when the canonical tag is also needed), and using
# it soundly requires re-hashing with VM instructions and logging a predicate the verifier
# re-checks.
# That discipline is precompile-specific, so each precompile wraps the raw event itself rather than
# calling a deceptively "safe" shared helper.

#! Registers a one-chunk expression node and returns its Eidos content-addressed digest.
#!
#! `adv.register_deferred` interns the node host-side (no stack or advice output). The VM binds the
#! tag selector, payload length, and two tag arguments into the initial Eidos chaining word, then
#! compresses the payload block once.
#!
#! Input:  [PAYLOAD_LO, PAYLOAD_HI, TAG, ...]
#! Output: [NODE_DIGEST, ...]
pub proc digest_expr
    adv.register_deferred

    movupw.2 push.8 exec.init_precompile_deferred_cv
    movdnw.2 compress
    dropw dropw
end

#! Registers an expression-bodied node `(tag, payload)` in the deferred-computation DAG and returns
#! its content-addressed digest on top of the operand stack.
#!
#! Input:  [TAG, PAYLOAD_LO, PAYLOAD_HI, ...]
#! Output: [NODE_DIGEST, ...]
pub proc register_expr
    movdnw.2
    # => [PAYLOAD_LO, PAYLOAD_HI, TAG, ...]
    exec.digest_expr
end

#! Registers an expression-bodied node `(tag, payload)` in the deferred-computation DAG and returns
#! its content-addressed digest on top of the operand stack.
#!
#! Alias of `register_expr` for callers that register value-shaped nodes.
#!
#! Input:  [TAG, PAYLOAD_LO, PAYLOAD_HI, ...]
#! Output: [NODE_DIGEST, ...]
pub proc register_value
    exec.register_expr
end

#! Registers a data-bodied node (`n` eight-Felt blocks of bulk data at `ptr`) in the
#! deferred-computation DAG and returns its content-addressed digest on top of the operand stack.
#!
#! `adv.register_deferred_data` interns the node host-side by reading `8n` felts from memory at
#! `ptr`, where `n` is the stack-supplied `n_chunks`; it produces no stack or advice output. The
#! event leaves those stack arguments unchanged, but its direct host read adds no AIR memory access.
#! This wrapper binds the registration input with the same Eidos construction as `Node::digest`:
#! the tag selector, `8n` payload length, and two tag arguments initialize the chaining word, then
#! the `n` payload chunks are compressed. Empty data bodies are forbidden, so `n ≥ 1`.
#!
#! Input:  [TAG, ptr, n_chunks, ...]
#! Output: [NODE_DIGEST, ...]
@locals(1)
pub proc register_mem
    adv.register_deferred_data

    # Retain n_chunks in one scalar local while keeping TAG on the operand stack.
    movup.5 loc_store.0
    # => [TAG, ptr, ...]

    # end_addr = ptr + 8 * n_chunks.
    loc_load.0 mul.8 dup.5 add movdn.5
    # => [TAG, ptr, end_addr, ...]

    loc_load.0 mul.8 exec.init_precompile_deferred_cv
    # => [CV, ptr, end_addr, ...]

    padw padw
    # => [BLOCK_LO=0w, BLOCK_HI=0w, CV, ptr, end_addr, ...]

    push.1
    while.true
        mem_stream compress
        dup.13 dup.13 neq
    end
    dropw dropw
    movup.4 drop movup.4 drop
end

#! Registers memory as framework CHUNKS data and returns its content-addressed digest.
#!
#! Input:  [ptr, n_chunks, ...]
#! Output: [CHUNKS_DIGEST, ...]
pub proc register_chunks_mem
    push.CHUNKS_TAG
    # => [Tag::CHUNKS=[2,0,0,0], ptr, n_chunks, ...]
    adv.register_deferred_data

    dropw
    # => [ptr, n_chunks, ...]

    # Build end_addr while retaining n_chunks for Eidos length framing.
    dup.1 mul.8 dup.1 add
    # => [end_addr, ptr, n_chunks, ...]
    movdn.2
    # => [ptr, n_chunks, end_addr, ...]

    push.DEFERRED_CHUNKS_DOMAIN movup.2 mul.8
    # => [num_elements=8*n_chunks, domain, ptr, end_addr, ...]
    exec.init_deferred_cv_in_domain
    padw padw
    # => [BLOCK_LO=0w, BLOCK_HI=0w, CV, ptr, end_addr, ...]

    push.1
    while.true
        mem_stream compress
        dup.13 dup.13 neq
    end
    dropw dropw
    movup.4 drop movup.4 drop
end

#! Registers exactly one 8-felt memory chunk as framework CHUNKS data.
#!
#! Input:  [ptr, ...]
#! Output: [CHUNKS_DIGEST, ...]
pub proc register_chunks_mem_1
    push.1 swap push.CHUNKS_TAG
    # => [Tag::CHUNKS, ptr, n_chunks=1, ...]
    adv.register_deferred_data

    dropw
    # => [ptr, n_chunks=1, ...]

    push.DEFERRED_CHUNKS_INIT_CV_1 padw padw
    # => [BLOCK_LO=0w, BLOCK_HI=0w, CV, ptr, n_chunks=1, ...]
    mem_stream compress
    dropw dropw
    movup.4 drop movup.4 drop
end

#! Registers exactly two contiguous 8-felt memory chunks as framework CHUNKS data.
#!
#! Input:  [ptr, ...]
#! Output: [CHUNKS_DIGEST, ...]
pub proc register_chunks_mem_2
    push.2 swap push.CHUNKS_TAG
    # => [Tag::CHUNKS, ptr, n_chunks=2, ...]
    adv.register_deferred_data

    dropw
    # => [ptr, n_chunks=2, ...]

    push.DEFERRED_CHUNKS_INIT_CV_2 padw padw
    # => [BLOCK_LO=0w, BLOCK_HI=0w, CV, ptr, n_chunks=2, ...]
    repeat.2
        mem_stream compress
    end
    dropw dropw
    movup.4 drop movup.4 drop
end

#! Registers exactly three contiguous 8-felt memory chunks as framework CHUNKS data.
#!
#! Input:  [ptr, ...]
#! Output: [CHUNKS_DIGEST, ...]
pub proc register_chunks_mem_3
    push.3 swap push.CHUNKS_TAG
    # => [Tag::CHUNKS, ptr, n_chunks=3, ...]
    adv.register_deferred_data

    dropw
    # => [ptr, n_chunks=3, ...]

    push.DEFERRED_CHUNKS_INIT_CV_3 padw padw
    # => [BLOCK_LO=0w, BLOCK_HI=0w, CV, ptr, n_chunks=3, ...]
    repeat.3
        mem_stream compress
    end
    dropw dropw
    movup.4 drop movup.4 drop
end

#! Folds a deferred node digest into the rolling deferred root using `log_deferred`.
#! The digest must reference a node that will reduce to TRUE under the installed precompiles.
#!
#! The opcode replaces NODE_DIGEST with the updated deferred root, which this helper drops.
#!
#! Input:  [NODE_DIGEST, ...]
#! Output: `[...]` (the deferred commitment root advances; node is folded in)
pub proc log_deferred
    log_deferred
    dropw
end
