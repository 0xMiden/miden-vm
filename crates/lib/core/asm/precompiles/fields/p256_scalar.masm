    adv_pushw
    adv_pushw
    swapw
    exec.load
    dupw
    movupw.2
    exec.mul
    exec.push_one_digest
    movupw.3 movdnw.2
    # => [ONE, PRODUCT, ROOT, INV_DIGEST, ...]
    exec.assert_eq_with_root
    swapw
end

#! Caller-root form of `div`; never logs into the VM root.
#! Input:  [NUMERATOR, DENOMINATOR, ROOT, ...]
#! Output: [QUOTIENT_EXPR, NEXT_ROOT, ...]
pub proc div_with_root(
    numerator: Expr,
    denominator: Expr,
    root: precompiles::Digest,
) -> (Expr, precompiles::Digest)
    movdnw.2
    # => [DENOMINATOR, ROOT, NUMERATOR, ...]
    exec.inv_with_root
    # => [INVERSE, NEXT_ROOT, NUMERATOR, ...]
    movupw.2
    exec.mul
end

#! Evaluates a field expression digest and returns whether its canonical VALUE digest matches a target.
#! Input:  [TARGET_DIGEST, EXPR_DIGEST, ...]
#! Output: [is_equal, ...]
#!
#! Advice is untrusted: `adv.evaluate_deferred_payload` leaves `EXPR_DIGEST` on stack and
#! pushes only the canonical value payload to advice. MASM derives a VALUE node digest from
#! the advised payload, logs `eq(EXPR_DIGEST, VALUE_DIGEST)` to bind it, then compares
#! `VALUE_DIGEST` with `TARGET_DIGEST` to produce a safe boolean.
pub proc is_eq_digest(target: Expr, value: Expr) -> i1
    swapw
    # => [EXPR_DIGEST, TARGET_DIGEST, ...]

    adv.evaluate_deferred_payload
    # => [EXPR_DIGEST, TARGET_DIGEST, ...]

    # Derive the digest of the advised canonical VALUE payload without materializing its limbs as
    # the return value.
    adv_pushw adv_pushw
    # => [VALUE_LO, VALUE_HI, EXPR_DIGEST, TARGET_DIGEST, ...]
    push.VALUE_INIT_CV
    # => [CV(VALUE), VALUE_LO, VALUE_HI, EXPR_DIGEST, TARGET_DIGEST, ...]
    exec.precompiles::register_fixed_expr
    # => [VALUE_DIGEST, EXPR_DIGEST, TARGET_DIGEST, ...]

    # Log eq(VALUE_DIGEST, EXPR_DIGEST). This binds the untrusted advised VALUE node to the input
    # expression digest while preserving VALUE_DIGEST for the final comparison.
    dupw movdnw.2
    # => [VALUE_DIGEST, EXPR_DIGEST, VALUE_DIGEST, TARGET_DIGEST, ...]
    push.EQ_INIT_CV
    # => [CV(EQ), VALUE_DIGEST, EXPR_DIGEST, VALUE_DIGEST, TARGET_DIGEST, ...]
    exec.precompiles::register_fixed_expr
    # => [EQ_DIGEST, VALUE_DIGEST, TARGET_DIGEST, ...]
    exec.precompiles::log_deferred
    # => [VALUE_DIGEST, TARGET_DIGEST, ...]

    exec.precompiles::word_eq
    # => [is_equal, ...]
end

#! Opens an already proof-bound canonical field VALUE digest and returns its eight
#! little-endian u32 limbs.
#! Input:  [VALUE_DIGEST, ...]
#! Output: [VALUE_U32[8], ...]
#!
#! Advice is untrusted, so this re-hashes the advised payload with this module's VALUE frame and
#! asserts raw digest equality in the VM. This does not evaluate arbitrary expression digests or
#! independently prove registration or canonicity; callers must establish that VALUE_DIGEST is an
#! already proof-bound canonical VALUE node for this domain.
pub proc open_value(value: Expr) -> Value
    adv.evaluate_deferred_payload
    # => [VALUE_DIGEST, ...]

    adv_pushw adv_pushw
    # => [VALUE_LO, VALUE_HI, VALUE_DIGEST, ...]

    # Hash the advised payload with the VALUE frame while preserving the payload for the return.
    dupw.1 dupw.1
    # => [VALUE_LO, VALUE_HI, VALUE_LO, VALUE_HI, VALUE_DIGEST, ...]
    push.VALUE_INIT_CV
    # => [CV(VALUE), VALUE_LO, VALUE_HI, VALUE_LO, VALUE_HI, VALUE_DIGEST, ...]
    exec.precompiles::register_fixed_expr
    # => [ADVISED_VALUE_DIGEST, VALUE_LO, VALUE_HI, VALUE_DIGEST, ...]

    movupw.3
    # => [VALUE_DIGEST, ADVISED_VALUE_DIGEST, VALUE_LO, VALUE_HI, ...]
    assert_eqw.err="open_value: advised payload does not match VALUE digest"
    # => [VALUE_LO, VALUE_HI, ...]
end

#! Evaluates a field expression digest and returns its eight little-endian u32 limbs on the stack.
#! Input:  [EXPR_DIGEST, ...]
#! Output: [VALUE_U32[8], ...]
#!
#! Advice is untrusted. `adv.evaluate_deferred_payload` leaves `EXPR_DIGEST` on stack and
#! pushes only the canonical value payload to advice. MASM derives a VALUE node digest from the
#! advised payload, logs `eq(EXPR_DIGEST, VALUE_DIGEST)` to bind the result, then returns the
#! now-safe canonical value.
pub proc eval(value: Expr) -> Value
    # `adv.evaluate_deferred_payload` leaves EXPR_DIGEST on the operand stack and pushes
    # VALUE_U32[8] to advice. Keep EXPR_DIGEST on stack; no need to copy it to locals.
    adv.evaluate_deferred_payload
    # => [EXPR_DIGEST, ...]

    # Bring the two value words onto the operand stack in VALUE node payload order. Using
    # `repeat.8 adv_push` would reverse the limb order and require the same reordering cost as the
    # two word loads below.
    adv_pushw adv_pushw
    # => [VALUE_LO, VALUE_HI, EXPR_DIGEST, ...]

    # Build a stack-backed VALUE node over the advised value. Keep a second copy of the value below
    # the register payload so it can be returned after the binding predicate is logged.
    dupw.1 dupw.1
    # => [VALUE_LO, VALUE_HI, VALUE_LO, VALUE_HI, EXPR_DIGEST, ...]
    push.VALUE_INIT_CV
    # => [CV(VALUE), VALUE_LO, VALUE_HI, VALUE_LO, VALUE_HI, EXPR_DIGEST, ...]
    exec.precompiles::register_fixed_expr
    # => [VALUE_DIGEST, VALUE_LO, VALUE_HI, EXPR_DIGEST, ...]

    # Log eq(EXPR_DIGEST, VALUE_DIGEST). This binds the untrusted advised VALUE_U32[8] to the
    # expression digest evaluated by the host, while preserving the value words for the return.
    movupw.3
    # => [EXPR_DIGEST, VALUE_DIGEST, VALUE_LO, VALUE_HI, ...]
    push.EQ_INIT_CV
    # => [CV(EQ), EXPR_DIGEST, VALUE_DIGEST, VALUE_LO, VALUE_HI, ...]
    exec.precompiles::register_fixed_expr
    # => [EQ_DIGEST, VALUE_LO, VALUE_HI, ...]
    exec.precompiles::log_deferred
    # => [VALUE_LO, VALUE_HI, ...]
end

#! Caller-root form of `assert_eq`; never logs into the VM root.
#! Input:  [LHS, RHS, ROOT, ...]
#! Output: [NEXT_ROOT, ...]
pub proc assert_eq_with_root(lhs: Expr, rhs: Expr, root: precompiles::Digest) -> precompiles::Digest
    push.EQ_INIT_CV
    exec.precompiles::register_fixed_expr
    exec.precompiles::append_root
end

#! Caller-root form of `eval`; never logs into the VM root.
#! Input:  [EXPR, ROOT, ...]
#! Output: [VALUE_LO, VALUE_HI, NEXT_ROOT, ...]
#! The advised canonical value is bound to the expression by an equality in NEXT_ROOT.
pub proc eval_with_root(value: Expr, root: precompiles::Digest) -> (Value, precompiles::Digest)
    adv.evaluate_deferred_payload
    adv_pushw adv_pushw
    # => [VALUE_LO, VALUE_HI, EXPR, ROOT, ...]
    dupw.1 dupw.1
    push.VALUE_INIT_CV
    exec.precompiles::register_fixed_expr
    # => [VALUE_DIGEST, VALUE_LO, VALUE_HI, EXPR, ROOT, ...]
    movupw.3
    push.EQ_INIT_CV
    exec.precompiles::register_fixed_expr
    movupw.3 swapw
    # => [EQ_DIGEST, ROOT, preserved results..., ...]
    exec.precompiles::append_root
    movdnw.2
end

#! Caller-root form of `is_eq_digest`; never logs into the VM root.
#! Input:  [TARGET, EXPR, ROOT, ...]
#! Output: [is_equal, NEXT_ROOT, ...]
#! The advised canonical value is bound to the expression by an equality in NEXT_ROOT.
pub proc is_eq_digest_with_root(
    target: Expr,
    value: Expr,
    root: precompiles::Digest,
) -> (i1, precompiles::Digest)
    swapw
    # => [EXPR, TARGET, ROOT, ...]
    adv.evaluate_deferred_payload
    adv_pushw adv_pushw
    push.VALUE_INIT_CV
    exec.precompiles::register_fixed_expr
    # => [VALUE_DIGEST, EXPR, TARGET, ROOT, ...]
    dupw movdnw.2
    push.EQ_INIT_CV
    exec.precompiles::register_fixed_expr
    movupw.3 swapw
    # => [EQ_DIGEST, ROOT, preserved results..., ...]
    exec.precompiles::append_root
    movdnw.2
    exec.precompiles::word_eq
end

#! Evaluates and binds a canonical VALUE digest without returning its limbs.
#! Input:  [EXPR, ROOT, ...]
#! Output: [VALUE_DIGEST, NEXT_ROOT, ...]
proc eval_digest_with_root(value: Expr, root: precompiles::Digest) -> (Expr, precompiles::Digest)
    adv.evaluate_deferred_payload
    adv_pushw adv_pushw
    push.VALUE_INIT_CV
    exec.precompiles::register_fixed_expr
    # => [VALUE_DIGEST, EXPR, ROOT, ...]

    # Preserve VALUE_DIGEST and the binding order used by eval_with_root: EQ(EXPR, VALUE).
    dupw movupw.2
    # => [EXPR, VALUE_DIGEST, VALUE_DIGEST, ROOT, ...]
    push.EQ_INIT_CV
    exec.precompiles::register_fixed_expr
    # => [EQ_DIGEST, VALUE_DIGEST, ROOT, ...]
    movupw.2 swapw
    # => [EQ_DIGEST, ROOT, VALUE_DIGEST, ...]
    exec.precompiles::append_root
    swapw
    # => [VALUE_DIGEST, NEXT_ROOT, ...]
end

#! Caller-root form of `is_eq`; never logs into the VM root.
#! Input:  [LHS, RHS, ROOT, ...]
#! Output: [is_equal, NEXT_ROOT, ...]
#! A false comparison succeeds; both advised values are bound into NEXT_ROOT.
pub proc is_eq_with_root(
    lhs: Expr,
    rhs: Expr,
    root: precompiles::Digest,
) -> (i1, precompiles::Digest)
    movupw.2 swapw
    # => [LHS, ROOT, RHS, ...]
    exec.eval_digest_with_root
    # => [LHS_VALUE, ROOT1, RHS, ...]
    movdnw.2 swapw
    # => [RHS, ROOT1, LHS_VALUE, ...]
    exec.eval_digest_with_root
    # => [RHS_VALUE, NEXT_ROOT, LHS_VALUE, ...]
    movupw.2 swapw
    # => [RHS_VALUE, LHS_VALUE, NEXT_ROOT, ...]

    # Raw digest equality is sound here: both operands are canonical VALUE nodes, and their
    # equality bindings to the original expressions are included in NEXT_ROOT.
    exec.precompiles::word_eq
    # => [is_equal, NEXT_ROOT, ...]
end

#! Caller-root form of `is_zero`; never logs into the VM root.
#! Input:  [EXPR, ROOT, ...]
#! Output: [is_zero, NEXT_ROOT, ...]
#! A false predicate succeeds; the advised value remains bound into NEXT_ROOT.
pub proc is_zero_with_root(value: Expr, root: precompiles::Digest) -> (i1, precompiles::Digest)
    exec.push_zero_digest
    exec.is_eq_digest_with_root
end

#! Caller-root form of `is_one`; never logs into the VM root.
#! Input:  [EXPR, ROOT, ...]
#! Output: [is_one, NEXT_ROOT, ...]
#! A false predicate succeeds; the advised value remains bound into NEXT_ROOT.
pub proc is_one_with_root(value: Expr, root: precompiles::Digest) -> (i1, precompiles::Digest)
    exec.push_one_digest
    exec.is_eq_digest_with_root
end
