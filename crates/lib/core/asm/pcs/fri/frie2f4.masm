use {
    FRI_COM_PTR,
    FRI_QUERIES_ADDRESS_PTR,
    FRI_VERIFY_STATE_PTR,
    LDE_DOMAIN_GENERATOR_PTR,
    REMAINDER_POLY_ADDRESS_PTR,
    REMAINDER_POLY_SIZE_PTR,
    TMP1_PTR,
    TMP2_PTR,
} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::crypto::hashes::eidos
use miden::core::pcs::fri::helper
use {REMAINDER_HALF_COEFFICIENTS} from miden::core::pcs::fri::helper

# Initial CV for the Eidos LMCS leaf hasher over one opened FRI row (8 Felts).
const FRI_ROW_HASH_INIT_CV = [13503953893947607809, 11912009168875159560, 11170449401267093504, 6620516959492505600]
const FRI_LAYER_LEAF_DIGEST_MISMATCH = "FRI layer leaf hash mismatch"

#! Authenticates one opened FRI row, checks the incoming value against its selected element,
#! and folds the row to the next layer with fri_ext2fold4. Advances layer_ptr by eight felts.
#!
#! Input:  [layer_ptr, layer_ptr, poe, p, e0, e1, layer_ptr, rem_ptr, x, x, x, x, x, x, x, x, ...]
#! Output: [is_not_last_layer, layer_ptr+8, layer_ptr+8, poe^4, f_pos, ne0, ne1, layer_ptr+8, rem_ptr, x, x, x, x, x, x, x, x, ...]
pub proc verify_query_layer(
    layer_ptr0: types::Address,
    layer_ptr1: types::Address,
    query: types::FriQuery,
    layer_ptr: types::Address,
    rem_ptr: types::Address,
    scratch0: word,
    scratch1: word,
) -> (
    i1,
    types::Address,
    types::Address,
    types::FriQuery,
    types::Address,
    types::Address,
    word,
    word,
)

    # Load layer commitment C and layer metadata.
    swapdw
    movup.8
    add.4
    mem_loadw_le   # load [d_size, t_depth, a0, a1] from layer_ptr + 4
    swapw
    movup.8
    mem_loadw_le   # load C from layer_ptr
    # => [C, d_size, t_depth, a0, a1, poe, p, e0, e1, layer_ptr, rem_ptr, ...]

    # Verify the Merkle auth path for (index = f_pos, depth = t_depth, root = C).
    swapw.2             # [poe, p, e0, e1, d_size, t_depth, a0, a1, C, layer_ptr, rem_ptr, ...]
    swap                # [p, poe, e0, e1, d_size, t_depth, a0, a1, C, layer_ptr, rem_ptr, ...]
    movup.4             # [d_size, p, poe, e0, e1, t_depth, a0, a1, C, layer_ptr, rem_ptr, ...]

    # Split the query position into the Merkle leaf position and the fold-4 coset.
    u32divmod           # [f_pos, coset, poe, e0, e1, t_depth, a0, a1, C, layer_ptr, rem_ptr, ...]
    # => [f_pos, coset, poe, e0, e1, t_depth, a0, a1, C, layer_ptr, rem_ptr, ...]
    movup.5
    movupw.2
    dup.5

    movup.5             # [t_depth, f_pos, C, f_pos, coset, poe, e0, e1, a0, a1, layer_ptr, rem_ptr, ...]
    mtree_get           # [V, C, f_pos, coset, poe, e0, e1, a0, a1, layer_ptr, rem_ptr, ...]
    adv.push_mapval
    # Reuse the root word for the first half of the opened row. The row stays on the stack
    # through hashing and folding; it does not need a memory copy.
    swapw adv_loadw
    padw adv_loadw
    # => [ROW_HI, ROW_LO, V, f_pos, coset, poe, e0, e1, a0, a1, layer_ptr, rem_ptr, ...]
    push.FRI_ROW_HASH_INIT_CV
    swapw.2
    # => [row(8), CV, V, f_pos, coset, poe, e0, e1, a0, a1, layer_ptr, rem_ptr, ...]
    exec.eidos::compress

    # Compression preserves the opened row. Compare its digest with the authenticated leaf.
    swapdw
    assert_eqw.err=FRI_LAYER_LEAF_DIGEST_MISMATCH
    # => [v0, ..., v7, f_pos, coset, poe, e0, e1, a0, a1, layer_ptr, rem_ptr, ...]
    fri_ext2fold4
    # => [x, x, x, x, x, x, x, x, layer_ptr+8, layer_ptr+8, poe^4, f_pos, ne0, ne1, layer_ptr+8, rem_ptr, ...]

    # Prepare for the next layer.
    swapdw
    # => [layer_ptr+8, layer_ptr+8, poe^4, f_pos, ne0, ne1, layer_ptr+8, rem_ptr, x, x, x, x, x, x, x, x, ...]
    dup.7
    # => [rem_ptr, layer_ptr+8, layer_ptr+8, poe^4, f_pos, ne0, ne1, layer_ptr+8, rem_ptr, ...]
    dup.1
    # => [layer_ptr+8, rem_ptr, layer_ptr+8, layer_ptr+8, poe^4, f_pos, ne0, ne1, layer_ptr+8, rem_ptr, ...]
    neq
    # => [is_not_last_layer, layer_ptr+8, layer_ptr+8, poe^4, f_pos, ne0, ne1, layer_ptr+8, rem_ptr, x, x, x, x, x, x, x, x, ...]
end

# In the following stack diagrams, N = REMAINDER_MAX_COEFFICIENTS.
# Keep verify_query_half and verify_query_max in sync; only their remainder evaluators differ.

#! Verifies a query through all FRI layers, then checks it against a remainder containing
#! REMAINDER_MAX_COEFFICIENTS / 2 extension coefficients.
#!
#! Input:  [poe, p, e0, e1, layer_ptr, rem_ptr, ...]
#! Output: [scratch(12), ...]
#!
#! Here poe = g^p for the initial domain generator g, and (e0, e1) is the initial-layer value at p.
#! Word-aligned layer records occupy [layer_ptr, rem_ptr) in eight-felt steps; equal pointers mean
#! no layers. The remainder at rem_ptr contains extension coefficients in descending degree order.
#!
#! TMP1_PTR must hold [rem_ptr, TMP2_PTR, 0, 0]. TMP2_PTR is overwritten with the evaluation
#! point. Neither scratch word may overlap the remainder.
pub proc verify_query_half(
    query: types::FriQuery,
    layer_ptr: types::Address,
    rem_ptr: types::Address,
) -> (word, word, word)

    # Prepare the stack to match the shape expected by `verify_query_layer`.
    dup.5
    dup.5
    padw
    padw
    swapdw
    dup
    dup
    movup.3
    neq
    # => [layer_ptr != rem_ptr, layer_ptr, layer_ptr, poe, p, e0, e1, layer_ptr, rem_ptr,
    #     scratch(8), ...]

    # verify correctness of layer folding
    while.true
        exec.verify_query_layer
    end
    # => [rem_ptr, rem_ptr, poe_final, f_pos, ne0, ne1, rem_ptr, rem_ptr, scratch(8), ...]

    # The repeated remainder pointers subtract to zero, including with no query layers.
    # Discard f_pos and reuse these slots for the Horner evaluation point.
    sub
    movup.2 drop
    push.0.0 movup.3
    # => [poe_final, 0, 0, 0, ne0, ne1, rem_ptr, rem_ptr, scratch(8), ...]
    mem_storew_le.TMP2_PTR
    mem_loadw_le.TMP1_PTR
    # => [rem_ptr, TMP2_PTR, 0, 0, ne0, ne1, rem_ptr, rem_ptr, scratch(8), ...]

    swapw swapdw
    # => [scratch(8), ne0, ne1, rem_ptr, rem_ptr, rem_ptr, TMP2_PTR, 0, 0, ...]

    exec.helper::evaluate_fri_remainder_poly_max_degree_plus_1_half
    # => [coeffs(8), ne0, ne1, rem_ptr, rem_ptr, rem_ptr+N, TMP2_PTR, r0, r1, ...]

    swapdw
    # => [ne0, ne1, rem_ptr, rem_ptr, rem_ptr+N, TMP2_PTR, r0, r1, coeffs(8), ...]
    movup.6 assert_eq
    movup.5 assert_eq
    # => [scratch(12), ...]
end

#! Uses `verify_query_half`'s contract with the maximum-length remainder.
pub proc verify_query_max(
    query: types::FriQuery,
    layer_ptr: types::Address,
    rem_ptr: types::Address,
) -> (word, word, word)

    # Prepare the stack to match the shape expected by `verify_query_layer`.
    dup.5
    dup.5
    padw
    padw
    swapdw
    dup
    dup
    movup.3
    neq
    # => [layer_ptr != rem_ptr, layer_ptr, layer_ptr, poe, p, e0, e1, layer_ptr, rem_ptr,
    #     scratch(8), ...]

    # verify correctness of layer folding
    while.true
        exec.verify_query_layer
    end
    # => [rem_ptr, rem_ptr, poe_final, f_pos, ne0, ne1, rem_ptr, rem_ptr, scratch(8), ...]

    # The repeated remainder pointers subtract to zero, including with no query layers.
    # Discard f_pos and reuse these slots for the Horner evaluation point.
    sub
    movup.2 drop
    push.0.0 movup.3
    # => [poe_final, 0, 0, 0, ne0, ne1, rem_ptr, rem_ptr, scratch(8), ...]
    mem_storew_le.TMP2_PTR
    mem_loadw_le.TMP1_PTR
    # => [rem_ptr, TMP2_PTR, 0, 0, ne0, ne1, rem_ptr, rem_ptr, scratch(8), ...]

    swapw swapdw
    # => [scratch(8), ne0, ne1, rem_ptr, rem_ptr, rem_ptr, TMP2_PTR, 0, 0, ...]

    exec.helper::evaluate_fri_remainder_poly_max_degree_plus_1
    # => [coeffs(8), ne0, ne1, rem_ptr, rem_ptr, rem_ptr+2*N, TMP2_PTR, r0, r1, ...]
    swapdw
    # => [ne0, ne1, rem_ptr, rem_ptr, rem_ptr+2*N, TMP2_PTR, r0, r1, coeffs(8), ...]
    movup.6 assert_eq
    movup.5 assert_eq
    # => [scratch(12), ...]
end


# Keep verify_half and verify_max in sync; only their query verifiers differ.

#! Verifies every query with the half-sized remainder, using `verify`'s memory contract.
#!
#! Input:  [query_ptr, layer_ptr, rem_ptr, g, ...]
#! Output: [...]
proc verify_half(
    query_ptr: types::Address,
    layer_ptr: types::Address,
    rem_ptr: types::Address,
    generator: felt,
)

    # Store [query_ptr, layer_ptr, rem_ptr, g] to keep track of all queries.
    mem_storew_le.FRI_VERIFY_STATE_PTR

    dup
    dup.2
    neq
    # => [query_ptr != layer_ptr, query_ptr, layer_ptr, rem_ptr, g, ...]

    # Save a word containing a fresh accumulator for Horner evaluating the remainder polynomial,
    # a pointer to the evaluation point and a pointer to the location of the polynomial.
    push.0.0
    push.TMP2_PTR mem_load.REMAINDER_POLY_ADDRESS_PTR
    mem_storew_le.TMP1_PTR
    movup.4

    while.true
        # Load [poe, p, e0, e1] for the next query.
        movup.4
        mem_loadw_le
        # => [poe, p, e0, e1, layer_ptr, rem_ptr, g, ...]

        # Verify query p.
        exec.verify_query_half

        # Prepare for the next query.
        # => [x, x, x, x, x, x, x, x, x, x, x, x, g, ...]
        dropw drop
        # => [x, x, x, x, x, x, x, g, ...]
        mem_loadw_le.FRI_VERIFY_STATE_PTR
        add.4
        mem_storew_le.FRI_VERIFY_STATE_PTR
        swapw
        # => [x, x, x, x, query_ptr + 4, layer_ptr, rem_ptr, g, ...]
        dup.5
        dup.5
        neq
        # => [query_ptr + 4 != layer_ptr, scratch(4), query_ptr + 4, layer_ptr, rem_ptr, g, ...]
    end
    # => [x, x, x, x, x, x, x, x, ...]

    dropw dropw
end

#! Uses `verify_half`'s memory and stack contract with the maximum-length remainder.
proc verify_max(
    query_ptr: types::Address,
    layer_ptr: types::Address,
    rem_ptr: types::Address,
    generator: felt,
)

    # Store [query_ptr, layer_ptr, rem_ptr, g] to keep track of all queries.
    mem_storew_le.FRI_VERIFY_STATE_PTR

    dup
    dup.2
    neq
    # => [query_ptr != layer_ptr, query_ptr, layer_ptr, rem_ptr, g, ...]

    # Save a word containing a fresh accumulator for Horner evaluating the remainder polynomial,
    # a pointer to the evaluation point and a pointer to the location of the polynomial.
    push.0.0
    push.TMP2_PTR mem_load.REMAINDER_POLY_ADDRESS_PTR
    mem_storew_le.TMP1_PTR
    movup.4

    while.true
        # Load [poe, p, e0, e1] for the next query.
        movup.4
        mem_loadw_le
        # => [poe, p, e0, e1, layer_ptr, rem_ptr, g, ...]

        # Verify query p.
        exec.verify_query_max

        # Prepare for the next query.
        # => [x, x, x, x, x, x, x, x, x, x, x, x, g, ...]
        dropw drop
        # => [x, x, x, x, x, x, x, g, ...]
        mem_loadw_le.FRI_VERIFY_STATE_PTR
        add.4
        mem_storew_le.FRI_VERIFY_STATE_PTR
        swapw
        # => [x, x, x, x, query_ptr + 4, layer_ptr, rem_ptr, g, ...]
        dup.5
        dup.5
        neq
        # => [query_ptr + 4 != layer_ptr, scratch(4), query_ptr + 4, layer_ptr, rem_ptr, g, ...]
    end
    # => [x, x, x, x, x, x, x, x, ...]

    dropw dropw
end

#! Verifies a FRI proof where the proof was generated over the quadratic extension of the base
#! field and layer folding was performed using folding factor 4.
#!
#! Query records [g^p, p, e0, e1] occupy a nonempty word-aligned range from the address stored
#! in FRI_QUERIES_ADDRESS_PTR to FRI_COM_PTR. Here g is the initial LDE domain generator.
#! Eight-felt layer records follow, ending at the address stored in REMAINDER_POLY_ADDRESS_PTR;
#! each stored domain size and tree depth must fit u32. The remainder contains descending-degree
#! extension coefficients. REMAINDER_POLY_SIZE_PTR must hold REMAINDER_MAX_COEFFICIENTS or half
#! that count, matching the stored coefficients.
#!
#! Initializes TMP1_PTR for Horner evaluation and overwrites FRI_VERIFY_STATE_PTR and TMP2_PTR.
#! These scratch words must not overlap the query, layer or coefficient regions.
#!
#! Input:  [...]
#! Output: [...]
pub proc verify()
    # Get domain generator and pointer to the remainder polynomial.
    mem_load.LDE_DOMAIN_GENERATOR_PTR
    mem_load.REMAINDER_POLY_ADDRESS_PTR
    # => [remainder_poly_ptr, g, ...]

    # Get the pointer to the first layer commitment.
    push.FRI_COM_PTR
    # => [fri_layer_ptr, remainder_poly_ptr, g, ...]

    # Get the pointer to the first FRI query.
    mem_load.FRI_QUERIES_ADDRESS_PTR
    # => [query_ptr, fri_layer_ptr, remainder_poly_ptr, g, ...]

    dup dup.2 u32assert2 u32lt assert.err="fri query region must be non-empty"

    mem_load.REMAINDER_POLY_SIZE_PTR
    push.REMAINDER_HALF_COEFFICIENTS
    eq

    if.true
        exec.verify_half
    else
        exec.verify_max
    end
    # => [...]
end
