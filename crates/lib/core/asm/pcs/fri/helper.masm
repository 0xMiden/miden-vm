use {
    FRI_COM_PTR,
    FRI_QUERIES_ADDRESS_PTR,
    LDE_DOMAIN_INFO_PTR,
    LOG_TRACE_LENGTH_PTR,
    NUM_FRI_LAYERS_PTR,
    NUM_QUERIES_PTR,
    RANDOM_COIN_CV_PTR,
    RANDOM_COIN_INPUT_LENGTH_PTR,
    REMAINDER_POLY_ADDRESS_PTR,
    REMAINDER_POLY_SIZE_PTR,
    TMP1_PTR,
} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::stark::random_coin
use {LOG_FINAL_DEGREE, REMAINDER_MAX_COEFFICIENTS} from miden::core::pcs::fri::parameters

# CONSTANTS
# =================================================================================================

# One eight-felt block contains four quadratic-extension coefficients.
const REMAINDER_MAX_BLOCKS = REMAINDER_MAX_COEFFICIENTS // 4
pub const REMAINDER_HALF_COEFFICIENTS = REMAINDER_MAX_COEFFICIENTS // 2
const REMAINDER_HALF_BLOCKS = REMAINDER_MAX_BLOCKS // 2
const REMAINDER_HALF_LOG_DEGREE = LOG_FINAL_DEGREE - 1

# HELPERS
# =================================================================================================

#! Loads and absorbs REMAINDER_MAX_COEFFICIENTS / 2 extension coefficients from advice.
proc load_fri_remainder_poly_max_degree_plus_1_half(
    state: types::EidosState,
    dst: types::Address,
) -> (types::EidosState, types::Address)
    repeat.REMAINDER_HALF_BLOCKS
        adv_pipe
        compress
    end
end

#! Loads and absorbs REMAINDER_MAX_COEFFICIENTS extension coefficients from advice.
proc load_fri_remainder_poly_max_degree_plus_1(
    state: types::EidosState,
    dst: types::Address,
) -> (types::EidosState, types::Address)
    repeat.REMAINDER_MAX_BLOCKS
        adv_pipe
        compress
    end
end

#! Uses `evaluate_fri_remainder_poly_max_degree_plus_1`'s contract with N/2 extension
#! coefficients, where N = REMAINDER_MAX_COEFFICIENTS. Advances the coefficient cursor by N felts.
pub proc evaluate_fri_remainder_poly_max_degree_plus_1_half(
    scratch0: word,
    scratch1: word,
    preserved: word,
    horner: types::HornerState,
) -> (word, word, word, types::HornerState)
    repeat.REMAINDER_HALF_BLOCKS
        mem_stream
        horner_eval_ext
    end
end

#! Processes N = REMAINDER_MAX_COEFFICIENTS extension coefficients using Horner's method.
#!
#! Coefficients are descending-degree (c0, c1) pairs at a word-aligned cursor. The point pointer
#! must address an aligned [x0, x1, 0, 0] word. The supplied accumulator is updated; set it to zero
#! to evaluate the polynomial.
#!
#! Input:  [scratch(8), preserved(4), coefficients, point_ptr, acc0, acc1, ...]
#! Output: [coeffs(8), preserved(4), coefficients+2*N, point_ptr, acc0', acc1', ...]
pub proc evaluate_fri_remainder_poly_max_degree_plus_1(
    scratch0: word,
    scratch1: word,
    preserved: word,
    horner: types::HornerState,
) -> (word, word, word, types::HornerState)
    repeat.REMAINDER_MAX_BLOCKS
        mem_stream
        horner_eval_ext
    end
end

#! Stores the fold count and remainder coefficient count derived from LOG_TRACE_LENGTH_PTR.
#!
#! The stored log trace height must be at least LOG_FINAL_DEGREE - 1. Fold-by-four reduces it
#! by two per round, leaving a remainder of the configured maximum length or half that length.
#!
#! Input: [...]
#! Output: [...]
pub proc generate_fri_parameters()
    # Measured from the smaller endpoint, even distances reach the half-sized remainder;
    # odd distances reach the maximum. This depends on the polynomial bound, not the LDE size.
    mem_load.LOG_TRACE_LENGTH_PTR
    sub.REMAINDER_HALF_LOG_DEGREE
    dup is_odd
    if.true
        sub.1
        push.REMAINDER_MAX_COEFFICIENTS
    else
        push.REMAINDER_HALF_COEFFICIENTS
    end
    # => [remainder_coefficients, twice_num_fri_layers, ...]
    mem_store.REMAINDER_POLY_SIZE_PTR
    div.2 mem_store.NUM_FRI_LAYERS_PTR
    # => [...]
end

#! Get FRI layer commitments and reseed with them in order to draw folding challenges.
#!
#! Input: [...]
#! Output: [...]
pub proc load_fri_layer_commitments()
    # We need to store the current FRI layer LDE domain size and its logarithm.
    padw mem_loadw_le.LDE_DOMAIN_INFO_PTR
    mem_storew_le.TMP1_PTR
    # => [Y, ...] where `Y` is a garbage word

    # Address containing the first layer commitment
    push.0.0
    push.FRI_COM_PTR
    mem_load.NUM_FRI_LAYERS_PTR
    # => [num_layers, ptr_layer, y, y, Y, ...] where `y` values are garbage

    dup
    push.0
    neq
    while.true
        swapw
        adv_loadw
        # => [COM, num_layers, ptr_layer, y, y, ...]

        # Save FRI layer commitment
        dup.5
        add.4
        swap.6
        mem_storew_le
        #=> [COM, num_layers, ptr_layer + 4, y, y, ...]

        # Reseed with commitment, check the per-round PoW witness, and sample alpha.
        adv_push
        exec.random_coin::reseed_check_folding_pow_and_sample_alpha
        #=> [a0, a1, num_layers, ptr_layer + 4, y, y, ...]
        padw
        mem_loadw_le.TMP1_PTR
        # => [lde_size, log2(lde_size), lde_generator, 0, a0, a1,
        #     num_layers, ptr_layer + 4, y, y, ...]

        # Compute and save to memory new lde_size and its new logarithm
        div.4
        swap
        sub.2
        swap
        mem_storew_le.TMP1_PTR
        # => [lde_size / 4, log2(lde_size) - 2, lde_generator, 0, a0, a1, num_layers, ptr_layer + 4, y, y, ...]

        # Move the pointer higher up the stack
        movup.2 drop
        movup.2 drop
        # => [lde_size / 4, log2(lde_size) - 2, a0, a1, num_layers, ptr_layer + 4, y, y, ...]
        # Save [lde_size / 4, log2(lde_size) - 2, a0, a1] in memory next to the layer commitment
        dup.5
        add.4
        swap.6
        mem_storew_le
        swapw
        # => [num_layers, ptr_layer + 8, y, y, lde_size / 4, log2(lde_size) - 2, a0, a1, ...]

        # Decrement the FRI layer counter
        sub.1
        dup
        push.0
        neq
    end
    # => [Y, Y, ...]
    dropw
    dropw
    #=> [...]
end

#! Loads the remainder coefficients from advice into memory and absorbs them into the transcript.
#!
#! Requires an empty transcript buffer and a stored remainder length of N or N/2, where
#! N = REMAINDER_MAX_COEFFICIENTS. Coefficients arrive in descending degree order.
#! `frie2f4::verify` checks their evaluations against folded queries.
#!
#! Inputs:  [...]
#! Outputs: [...]
pub proc load_and_verify_remainder()
    # Each FRI layer stores [root(4), d_size, t_depth, alpha0, alpha1] in eight cells.
    # The remainder coefficients follow these layers in memory.
    mem_load.NUM_FRI_LAYERS_PTR
    mul.8 push.FRI_COM_PTR add
    # => [remainder_poly_ptr, ...]
    dup mem_store.REMAINDER_POLY_ADDRESS_PTR
    #=> [remainder_poly_ptr, ...]

    mem_load.RANDOM_COIN_INPUT_LENGTH_PTR
    assertz.err="FRI remainder absorption requires an empty transcript buffer"

    mem_load.REMAINDER_POLY_SIZE_PTR
    push.REMAINDER_HALF_COEFFICIENTS

    eq
    if.true
        # Half-sized remainder.
        # Keep the transcript CV on stack while streaming the remainder coefficients.
        padw mem_loadw_le.RANDOM_COIN_CV_PTR
        padw padw
        # => [Y, Y, cv, remainder_poly_ptr, ...]

        exec.load_fri_remainder_poly_max_degree_plus_1_half
    else
        # Maximum-length remainder.
        # Keep the transcript CV on stack while streaming the remainder coefficients.
        padw mem_loadw_le.RANDOM_COIN_CV_PTR
        padw padw
        # => [Y, Y, cv, remainder_poly_ptr, ...]

        exec.load_fri_remainder_poly_max_degree_plus_1
    end
    # => [Y, Y, cv, remainder_end_ptr, ...]

    # Store the updated transcript CV and reopen the absorbing phase with an empty buffer.
    swapw.2
    mem_storew_le.RANDOM_COIN_CV_PTR
    dropw dropw dropw
    exec.random_coin::eidos_clear_buffer
    exec.random_coin::eidos_enter_absorbing
    drop
    #=> [...]
end

#! Stores the start of the query records in FRI_QUERIES_ADDRESS_PTR.
#!
#! Each query occupies four felts immediately before the layer commitments, so the start is
#! FRI_COM_PTR minus four times the number of queries.
#!
#! Input: [...]
#! Output: [...]
pub proc compute_query_pointer()
    push.FRI_COM_PTR
    mem_load.NUM_QUERIES_PTR
    mul.4
    # => [num_queries*4, FRI_COM_PTR,  ...]

    sub
    # => [query_ptr, ...]

    mem_store.FRI_QUERIES_ADDRESS_PTR
    # => [...]
end
