# ===== EIDOS HASH PROCEDURES ===================================================================

#! Eidos hash helpers built on the VM-native Eidos compression operation.
#!
#! Procedures which operate on a three-word state use the layout `[BLOCK_LO, BLOCK_HI, CV]`.
#! After `compress`, `CV` contains the updated chaining word.

const EIDOS_INIT_CV_0_BASE = 4280581857092829184
const EIDOS_INIT_CV_1_BASE = 2688637132020383744
const EIDOS_INIT_CV_2_BASE = 1947077364412317696
const EIDOS_INIT_CV_3_BASE = 6620516959492505600

const EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_0 = 6347876015119529679
const EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_1 = 7689086723714803787
const EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_2 = 447594322480659107
const EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_3 = 5651722801955730124

#! Constructs an Eidos chaining word from a registered selector and three selector-defined
#! parameters. Every input must fit in a u32. Each occupies the low lane of one packed Felt; the
#! corresponding high lane is a fixed masked IV word.
#!
#! Input:  [selector, param0, param1, param2, ...]
#! Output: [CV, ...]
#!
#! Invocation: exec
pub proc init_chaining_word_with_params
    u32assert2.err="Eidos init values must fit in u32"
    movup.3 movup.3 u32assert2.err="Eidos init values must fit in u32"

    push.EIDOS_INIT_CV_2_BASE add
    swap push.EIDOS_INIT_CV_3_BASE add
    movup.3 push.EIDOS_INIT_CV_1_BASE add
    movup.3 push.EIDOS_INIT_CV_0_BASE add
    movup.3 movdn.2
end

#! Returns the Eidos digest of an empty Felt sequence under selector zero.
#!
#! Input:  [...]
#! Output: [DIGEST, ...]
#!
#! Invocation: exec
pub proc empty_felt_sequence_digest
    push.EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_3.EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_2.EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_1.EIDOS_EMPTY_FELT_SEQUENCE_DIGEST_0
end

#! Constructs `Eidos::init_chaining_word(0, n)`.
#! `n` must fit in a u32.
#!
#! Input:  [n, ...]
#! Output: [CV, ...]
#!
#! Invocation: exec
pub proc init_chaining_word
    u32assert.err="num_elements must fit in a u32"

    push.EIDOS_INIT_CV_1_BASE add
    push.EIDOS_INIT_CV_3_BASE.EIDOS_INIT_CV_2_BASE
    movup.2
    push.EIDOS_INIT_CV_0_BASE
end

#! Constructs `Eidos::init_chaining_word(selector, n)`.
#! `n` and `selector` must fit in a u32.
#!
#! Input:  [n, selector, ...]
#! Output: [CV, ...]
#!
#! Invocation: exec
pub proc init_chaining_word_in_domain
    u32assert2.err="Eidos init values must fit in u32"

    push.EIDOS_INIT_CV_1_BASE add
    swap push.EIDOS_INIT_CV_0_BASE add
    push.EIDOS_INIT_CV_3_BASE.EIDOS_INIT_CV_2_BASE
    movdn.3 movdn.3
    # => [CV, ...]
end

#! Adds two zero block words above a caller-supplied chaining word.
#!
#! Input:  [CV, ...]
#! Output: [BLOCK_LO=0w, BLOCK_HI=0w, CV, ...]
#!
#! Invocation: exec
pub proc init_with_chaining_word
    padw padw
end

#! Initializes a three-word state for a message of `num_elements` Felts in domain zero.
#! `num_elements` must fit in a u32.
#! An empty message still requires one zero-block compression after initialization.
#!
#! Input:  [num_elements, ...]
#! Output: [BLOCK_LO=0w, BLOCK_HI=0w, CV, ...]
#!
#! Invocation: exec
pub proc init
    exec.init_chaining_word
    exec.init_with_chaining_word
end

#! Initializes a three-word state for a message of `num_elements` Felts in the given domain.
#! `num_elements` and `domain` must fit in a u32.
#! An empty message still requires one zero-block compression after initialization.
#!
#! Input:  [num_elements, domain, ...]
#! Output: [BLOCK_LO=0w, BLOCK_HI=0w, CV, ...]
#!
#! Invocation: exec
pub proc init_in_domain
    exec.init_chaining_word_in_domain
    exec.init_with_chaining_word
end

#! Performs one Eidos compression.
#!
#! Input:  [BLOCK_LO, BLOCK_HI, CV, ...]
#! Output: [BLOCK_LO, BLOCK_HI, CV', ...]
#!
#! Invocation: exec
pub proc compress
    compress
end

#! Returns the current chaining word from a three-word state by dropping the two block words.
#!
#! The returned word is a final digest only after the framed Eidos schedule is complete.
#!
#! Input:  [BLOCK_LO, BLOCK_HI, CV, ...]
#! Output: [CV, ...]
#!
#! Invocation: exec
pub proc digest
    dropw
    dropw
end

#! Copies the current chaining word to the top of the stack.
#!
#! It is expected to have the hasher state at the top of the stack at the beginning of the procedure
#! execution. The copied word is a final digest only after the framed Eidos schedule is complete.
#!
#! Input: [BLOCK_LO, BLOCK_HI, CV, ...]
#! Output: [CV_COPY, BLOCK_LO, BLOCK_HI, CV, ...]
#!
#! Where:
#! - `BLOCK_LO` is the first preserved block word (positions 0-3, on top of stack).
#! - `BLOCK_HI` is the second preserved block word (positions 4-7).
#! - `CV` is the current chaining word (positions 8-11).
#! - `CV_COPY` is a copy of `CV`.
#!
#! Invocation: exec
pub proc copy_digest
    dupw.2
end

#! Hashes the memory `start_addr` to `end_addr` given a three-word VM hasher state.
#!
#! This requires that `end_addr = start_addr + 8n` where n = {0, 1, 2 ...}, otherwise the procedure
#! will enter an infinite loop.
#!
#! Input: [BLOCK_LO, BLOCK_HI, CV, start_addr, end_addr, ...]
#! Output: [BLOCK_LO', BLOCK_HI', CV', start_addr', end_addr, ...]
#! where `start_addr' = end_addr`.
#!
#! Where:
#! - `BLOCK_LO` is the first preserved block word (positions 0-3, on top of stack).
#! - `BLOCK_HI` is the second preserved block word (positions 4-7).
#! - `CV` is the current chaining word (positions 8-11).
#!
#! Invocation: exec
pub proc absorb_double_words_from_memory
    dup.13 dup.13 neq
    while.true
        mem_stream exec.compress
        dup.13 dup.13 neq
    end
end

#! Hashes a memory range containing zero or more complete 8-Felt blocks.
#!
#! The range length must be a multiple of 8. The input length is bound into the initial chaining
#! word.
#!
#! Input: [start_addr, end_addr, ...]
#! Output: [HASH, ...]
#!
#! Invocation: exec
pub proc hash_double_words
    # enforce `start_addr <= end_addr`
    dup.1 dup.1 u32assert2
    u32gte assert.err="start address should be less or equal to the end address"
    # => [start_addr, end_addr, ...]

    dup.1 dup.1 sub u32mod.8
    assertz.err="range length must be a multiple of 8"
    # => [start_addr, end_addr, ...]

    exec.hash_words
end

#! Hashes the word-aligned memory range `[start_addr, end_addr)` with a domain identifier.
#!
#! Requires `start_addr <= end_addr`, `end_addr` is not inclusive.
#! Requires `start_addr` and `end_addr` to be word-aligned.
#!
#! Input: [domain, start_addr, end_addr, ...]
#! Output: [H, ...]
#!
#! Invocation: exec
pub proc hash_words_with_domain
    movdn.2
    # => [start_addr, end_addr, domain, ...]

    dup.1 dup.1 u32assert2 u32gte assert
    # => [start_addr, end_addr, domain, ...]

    dup.1 dup.1 sub
    # => [num_elements, start_addr, end_addr, domain, ...]

    movup.2 drop swap
    # => [start_addr, num_elements, domain, ...]

    exec.hash_elements_in_domain
end

#! Hashes the word-aligned memory range `[start_addr, end_addr)`.
#!
#! Equivalent to `hash_words_with_domain` with `domain = 0`.
#!
#! Requires `start_addr <= end_addr`, `end_addr` is not inclusive.
#! Requires `start_addr` and `end_addr` to be word-aligned.
#!
#! Input: [start_addr, end_addr, ...]
#! Output: [H, ...]
#!
#! Invocation: exec
pub proc hash_words
    push.0
    # => [domain=0, start_addr, end_addr, ...]

    exec.hash_words_with_domain
end

#! Prepares a domain-tagged state for `hash_elements_with_state`.
#!
#! Input:  [ptr, num_elements, domain, ...]
#! Output: [BLOCK_LO=0w, BLOCK_HI=0w, CV, ptr, end_pairs_addr, num_elements%8, ...]
proc prepare_hasher_state_in_domain
    # move number of inputs to the top of the stack
    swap
    # => [num_elements, ptr, domain]

    dup
    # => [num_elements, num_elements, ptr, domain]

    u32assert.err="num_elements must fit in a u32"

    # Get the number of double words.
    u32divmod.8
    swap
    # => [num_elements/8, num_elements%8, num_elements, ptr, domain]

    # get the end address for absorb_double_words_from_memory procedure (end address for pairs of
    # words)
    mul.8 dup.3 add movup.3
    # => [ptr, end_pairs_addr, num_elements%8, num_elements, domain]

    movup.4 movup.4 exec.init_chaining_word_in_domain
    # => [CV, ptr, end_pairs_addr, num_elements%8]

    # prepare the three-word VM hasher state
    padw padw
    # => [BLOCK_LO, BLOCK_HI, CV, ptr, end_pairs_addr, num_elements%8]

    # Eidos represents the empty message by compressing one zero block. Do that during preparation
    # so that an empty continuation remains a no-op in `hash_elements_with_state`.
    dup.14 eq.0
    dup.13 dup.15 eq
    and
    if.true
        exec.compress
    end
end

proc prepare_padded_hasher_state
    # move the unpadded length to the top of the stack
    swap
    # => [num_elements, ptr, padded_len]

    dup
    # => [num_elements, num_elements, ptr, padded_len]

    u32assert.err="num_elements must fit in a u32"

    u32divmod.8
    swap
    # => [num_elements/8, num_elements%8, num_elements, ptr, padded_len]

    mul.8 dup.3 add movup.3
    # => [ptr, end_pairs_addr, num_elements%8, num_elements, padded_len]

    movup.4 movup.4 drop
    # => [padded_len, ptr, end_pairs_addr, num_elements%8]

    exec.init_chaining_word
    # => [CV, ptr, end_pairs_addr, num_elements%8]

    padw padw
    # => [BLOCK_LO, BLOCK_HI, CV, ptr, end_pairs_addr, num_elements%8]

    dup.14 eq.0
    dup.13 dup.15 eq
    and
    if.true
        exec.compress
    end
end

#! Initializes the state required by `hash_elements_with_state`.
#!
#! If `pad_inputs_flag` is zero, the initial chaining word binds `num_elements`. If the flag is
#! one, it binds `ceil(num_elements / 8) * 8`. Unused lanes of the final block are replaced with
#! zeros, so their memory contents are not committed.
#!
#! Input:  [ptr, num_elements, pad_inputs_flag, ...]
#! Output: [BLOCK_LO=0w, BLOCK_HI=0w, CV, ptr, end_pairs_addr, num_elements%8, ...]
#!
#! `ptr` must be word-aligned, `num_elements` must fit in a u32, and `pad_inputs_flag` must be zero
#! or one. Padded-length overflow is rejected.
#! For an empty input, the prepared CV already includes the required zero-block compression.
#!
#! Invocation: exec
pub proc prepare_hasher_state
    movup.2
    # => [pad_inputs_flag, ptr, num_elements]

    dup dup sub.1 mul assertz.err="pad_inputs_flag must be 0 or 1"

    if.true
        # Bind the length of the zero-padded stream.
        dup.1 u32assert.err="num_elements must fit in a u32"
        u32overflowing_add.7
        assertz.err="padded input length exceeds a u32"
        u32div.8 mul.8 movdn.2
        # => [ptr, num_elements, padded_len]

        exec.prepare_padded_hasher_state
    else
        # Bind the logical input length in domain zero.
        push.0 movdn.2
        # => [ptr, num_elements, domain=0]

        exec.prepare_hasher_state_in_domain
    end
end

#! Computes hash of Felt values starting at the specified memory address using the provided hasher
#! state.
#!
#! This procedure divides the hashing process into two parts: hashing pairs of words using
#! `absorb_double_words_from_memory` procedure and hashing the remaining values with `compress`
#! procedure.
#! An empty continuation returns the supplied chaining word unchanged.
#!
#! Inputs:  [BLOCK_LO, BLOCK_HI, CV, ptr, end_pairs_addr, num_elements%8]
#! Outputs: [HASH]
#!
#! Where:
#! - ptr is the memory address of the first element to be hashed. This address must be
#!   word-aligned - i.e., divisible by 4.
#! - BLOCK_LO and BLOCK_HI are block words, and CV is the current chaining word.
#! - end_pairs_addr is the memory address at which the pairs of words end.
#! - num_elements%8 is the number of elements that did not fit into word pairs and should be
#!   hashed separately.
#! - HASH is the resulting hash of the provided memory values.
#!
#! Invocation: exec
pub proc hash_elements_with_state
    # hash every pair of words
    exec.absorb_double_words_from_memory
    # => [BLOCK_LO, BLOCK_HI, CV', ptr', end_pairs_addr, num_elements%8]
    # where ptr' = end_pairs_addr

    # hash remaining input values if there are any left
    # if num_elements%8 is ZERO and there are no elements to hash
    dup.14 eq.0
    if.true
        # clean the stack
        exec.digest
        swapw drop drop drop movdn.4
        # => [HASH]
    else
        # load the remaining double word
        mem_stream
        # => [BLOCK_LO, BLOCK_HI, CV', ptr'+2, end_pairs_addr, num_elements%8]

        # clean the stack
        movup.12 drop movup.12 drop
        # => [BLOCK_LO, BLOCK_HI, CV', num_elements%8]

        # get the number of elements we need to drop
        # notice that drop_counter could be any number from 1 to 7
        push.8 movup.13 sub movdn.12
        # => [BLOCK_LO, BLOCK_HI, CV', drop_counter]
        # => [a0, a1, a2, a3, b0, b1, b2, b3, CV', drop_counter]

        ### 0th value ########################################################

        # we need to drop the last value anyway, since number of values is not divisible by 8
        # push the padding 0 on to the stack
        movup.7 drop push.0
        # => [0, a0, a1, a2, a3, b0, b1, b2, CV', drop_counter]

        ### 1st value ########################################################

        # bring b2 to top and prepare for cdrop
        movup.7 push.0 swap
        # => [b2, 0, 0, a0, a1, a2, a3, b0, b1, CV', drop_counter]

        # push latch variable onto the stack; this will be the control for the cdrop instruction
        push.0
        # => [latch=0, b2, 0, 0, a0, a1, a2, a3, b0, b1, CV', drop_counter]

        # get the flag whether the drop counter is equal 1
        dup.14 eq.1
        # => [drop_counter==1, latch=0, b2, 0, 0, a0, a1, a2, a3, b0, b1, CV', drop_counter]

        # update the latch: if drop_counter == 1, latch will become 1
        or
        # => [latch', b2, 0, 0, a0, a1, a2, a3, b0, b1, CV', drop_counter]

        # save the latch value
        dup movdn.14
        # => [latch', b2, 0, 0, a0, a1, a2, a3, b0, b1, CV', latch', drop_counter]

        # if latch == 1, keep 0; otherwise keep b2
        cdrop
        # => [b2_or_0, 0, a0, a1, a2, a3, b0, b1, CV', latch', drop_counter]

        ### 2nd value ########################################################

        # bring b1 to top and prepare for cdrop
        movup.7 push.0 swap
        # => [b1, 0, b2_or_0, 0, a0, a1, a2, a3, b0, CV', latch', drop_counter]

        # update latch: if drop_counter == 2, latch becomes 1
        movup.13 dup.14 eq.2 or
        dup movdn.14
        # => [latch', b1, 0, b2_or_0, 0, a0, a1, a2, a3, b0, CV', latch', drop_counter]

        cdrop
        # => [b1_or_0, b2_or_0, 0, a0, a1, a2, a3, b0, CV', latch', drop_counter]

        ### 3rd value ########################################################

        # bring b0 to top and prepare for cdrop
        movup.7 push.0 swap
        # => [b0, 0, b1_or_0, b2_or_0, 0, a0, a1, a2, a3, CV', latch', drop_counter]

        movup.13 dup.14 eq.3 or
        dup movdn.14
        cdrop
        # => [b0_or_0, b1_or_0, b2_or_0, 0, a0, a1, a2, a3, CV', latch', drop_counter]

        ### 4th value ########################################################

        # bring a3 to top and prepare for cdrop
        movup.7 push.0 swap
        # => [a3, 0, b0_or_0, b1_or_0, b2_or_0, 0, a0, a1, a2, CV', latch', drop_counter]

        movup.13 dup.14 eq.4 or
        dup movdn.14
        cdrop
        # => [a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, a0, a1, a2, CV', latch', drop_counter]

        ### 5th value ########################################################

        # bring a2 to top and prepare for cdrop
        movup.7 push.0 swap
        # => [a2, 0, a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, a0, a1, CV', latch', drop_counter]

        movup.13 dup.14 eq.5 or
        dup movdn.14
        cdrop
        # => [a2_or_0, a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, a0, a1, CV', latch', drop_counter]

        ### 6th value ########################################################

        # bring a1 to top and prepare for cdrop
        movup.7 push.0 swap
        # => [a1, 0, a2_or_0, a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, a0, CV', latch', drop_counter]

        movup.13 movup.14 eq.6 or
        cdrop
        # => [a1_or_0, a2_or_0, a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, a0, CV']
        # Notice that we don't need to check a0: entering the else branch means that
        # we have number of elements not divisible by 8, so we will have at least one
        # element to hash here (which is a0).

        # Reorder to get [BLOCK_LO, BLOCK_HI, CV'] format for compression.
        # Current: [a1_or_0, a2_or_0, a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, a0, CV']
        # Need:    [a0, a1_or_0, a2_or_0, a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, CV']
        movup.7
        # => [a0, a1_or_0, a2_or_0, a3_or_0, b0_or_0, b1_or_0, b2_or_0, 0, CV']

        exec.compress
        # => [BLOCK_LO', BLOCK_HI', CV']

        exec.digest
        # => [HASH]
    end
end

#! Computes a domain-tagged hash of Felt values starting at the specified memory address.
#!
#! This procedure divides the hashing process into two parts: hashing pairs of words using
#! `absorb_double_words_from_memory` procedure and hashing the remaining values with `compress`
#! procedure.
#!
#! Inputs:  [ptr, num_elements, domain]
#! Outputs: [HASH]
#!
#! Where:
#! - ptr is the memory address of the first element to be hashed. This address must be
#!   word-aligned - i.e., divisible by 4.
#! - num_elements is the number of elements to be hashed and must fit in a u32.
#! - domain is the domain identifier mixed into the initial chaining word.
#! - HASH is the resulting hash of the provided memory values.
#!
#! Invocation: exec
pub proc hash_elements_in_domain
    exec.prepare_hasher_state_in_domain
    # => [BLOCK_LO, BLOCK_HI, CV, ptr, end_pairs_addr, num_elements%8]

    exec.hash_elements_with_state
    # => [HASH]
end

#! Hashes Felt values starting at the specified memory address in domain zero.
#!
#! Input:  [ptr, num_elements, ...]
#! Output: [HASH, ...]
#!
#! `ptr` must be word-aligned, and `num_elements` must fit in a u32.
#!
#! Invocation: exec
pub proc hash_elements
    push.0 movdn.2
    # => [ptr, num_elements, domain=0]

    exec.hash_elements_in_domain
end

#! Hashes Felt values after padding the logical input length to a full 8-Felt block.
#!
#! This is not a hasher-internal padding rule. It changes the committed stream from
#! `elements[..num_elements]` to `elements[..padded_len]`, where
#! `padded_len = ceil(num_elements / 8) * 8`. The padding zeros are synthesized by this helper;
#! callers do not need to store them in memory. An empty sequence uses the canonical Eidos
#! empty-message path, including its required zero-block compression.
#!
#! Inputs:  [ptr, num_elements]
#! Outputs: [HASH]
#!
#! Where:
#! - ptr is the memory address of the first element to be hashed. This address must be
#!   word-aligned - i.e., divisible by 4.
#! - num_elements is the number of elements to be hashed and must fit in a u32.
#! - HASH is the resulting hash of the provided memory values.
#!
#! Invocation: exec
pub proc pad_and_hash_elements
    push.1 movdn.2
    # => [ptr, num_elements, pad_inputs_flag=1]

    exec.prepare_hasher_state
    # => [BLOCK_LO, BLOCK_HI, CV, ptr, end_pairs_addr, num_elements%8]

    exec.hash_elements_with_state
end

#! Computes the VM-native hash of a single word (256-bit input).
#!
#! Inputs:  [A]
#! Outputs: [B]
#!
#! Where:
#! - A is the word to be hashed.
#! - B is the resulting hash.
#!
#! Invocation: exec
pub proc hash
    hash
end

#! Merges two words (256-bit digests) via the VM-native hash.
#!
#! Inputs:  [A, B]
#! Outputs: [C]
#!
#! Where:
#! - A and B are the words to be merged.
#! - C is the resulting hash.
#!
#! Invocation: exec
pub proc merge
    hmerge
end

#! Merges two words using a caller-supplied chaining word for their single 8-Felt block.
#!
#! Inputs:  [CV, A, B, ...]
#! Outputs: [C, ...]
#!
#! Invocation: exec
pub proc merge_with_chaining_word
    movdnw.2
    compress
    exec.digest
end

#! Merges two words (256-bit digests) via the VM-native hash with a domain identifier.
#!
#! Inputs:  [domain, A, B, ...]
#! Outputs: [C, ...]
#!
#! Where:
#! - A and B are the words to be merged (A is the first block word).
#! - C is `hash_elements_in_domain(A || B, domain)`.
#!
#! Invocation: exec
pub proc merge_in_domain
    movdn.8
    # => [A, B, domain, ...]

    movup.8 push.8 exec.init_chaining_word_in_domain movdnw.2
    # => [A, B, CV, ...]

    compress
    exec.digest
end
