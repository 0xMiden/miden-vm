# Internal stream and MAC operations. The public AEAD procedures check input lengths and
# memory ranges before calling these helpers. Scratch is allocated above the caller's local frame.

use miden::core::crypto::hashes::eidos

# Constants
# ================================================================================================

# Eidos::init_chaining_word(AEAD_CTR_KEY, 0), where AEAD_CTR_KEY = 0x00000602.
# Fixed-arity derivations use registered domain tags for separation; variable-length Eidos hashes
# also bind their length in the initial chaining value.
const AEAD_CTR_INIT_CV_0 = 13503953893947606530
const AEAD_CTR_INIT_CV_1 = 11912009168875159552
const AEAD_CTR_INIT_CV_2 = 11170449401267093504
const AEAD_CTR_INIT_CV_3 = 6620516959492505600

# Eidos::init_chaining_word(AEAD_MAC_KEY, 0), where AEAD_MAC_KEY = 0x00000702.
const AEAD_MAC_INIT_CV_0 = 13503953893947606786
const AEAD_MAC_INIT_CV_1 = 11912009168875159552
const AEAD_MAC_INIT_CV_2 = 11170449401267093504
const AEAD_MAC_INIT_CV_3 = 6620516959492505600

# auth_expanded_exact locals:
# loc[0..4]  = [r0, r1, 0, 0]               MAC evaluation point
# loc[4..8]  = [ad_ptr, ad_len, ct_ptr, ct_len]
# loc[8..16] = pending batch(8)
const AUTH_ALPHA_LOC = 0
const AUTH_AD_PTR_LOC = 4
const AUTH_AD_LEN_LOC = 5
const AUTH_CT_PTR_LOC = 6
const AUTH_CT_LEN_LOC = 7
const AUTH_BATCH_LOC = 8
const AUTH_BATCH_TAIL_LOC = AUTH_BATCH_LOC + 4


# Types
# ================================================================================================

#! AEAD secret key in stack element order.
pub type Key = word
#! AEAD nonce in stack element order.
pub type Nonce = word
#! Eidos chaining value used by the counter-mode stream.
pub type CtrKey = eidos::ChainingValue
#! MAC evaluation point and final mask in `[r0, r1, s0, s1]` order.
pub type MacKey = word
#! Quadratic-extension authentication tag in coefficient order.
pub type Tag = struct { c0: felt, c1: felt }

# Key derivation
# ================================================================================================

#! Derives the CTR chaining value (`K_CTR`) from a key and nonce.
#!
#! Input:  [key(4), nonce(4), ...]
#! Output: [K_CTR(4), ...]
#!
#! Invocation: exec
pub proc derive_ctr_key(key: Key, nonce: Nonce) -> CtrKey
    push.AEAD_CTR_INIT_CV_3.AEAD_CTR_INIT_CV_2.AEAD_CTR_INIT_CV_1.AEAD_CTR_INIT_CV_0
    movdnw.2
    # => [key(4), nonce(4), CV(4), ...]
    compress
    exec.eidos::digest
end

#! Derives the MAC key `[r0, r1, s0, s1]` from a key and nonce.
#! The pairs `r = (r0, r1)` and `s = (s0, s1)` are the evaluation point and final mask.
#!
#! Input:  [key(4), nonce(4), ...]
#! Output: [K_MAC(4), ...]
#!
#! Invocation: exec
pub proc derive_mac_key(key: Key, nonce: Nonce) -> MacKey
    push.AEAD_MAC_INIT_CV_3.AEAD_MAC_INIT_CV_2.AEAD_MAC_INIT_CV_1.AEAD_MAC_INIT_CV_0
    movdnw.2
    # => [key(4), nonce(4), CV(4), ...]
    compress
    exec.eidos::digest
end

# Encryption
# ================================================================================================

#! Encrypts `num_felts` plaintext Felts into expanded ciphertext limbs.
#!
#! Input:  [K_CTR(4), src_ptr, dst_ptr, counter, num_felts, ...]
#! Output: [K_CTR(4), src_ptr + num_felts, dst_ptr + 2*num_felts,
#!          counter + ceil(num_felts / 8), ...]
#!
#! The caller supplies disjoint, word-aligned u32 ranges below its local frame and a u32
#! counter span that does not overflow. Public encryption starts at zero; its message limit
#! keeps the counter span within u32.
#!
#! Clears any tail scratch on return. The returned counter may be 2^32 after its last block.
#!
#! Invocation: exec
pub proc encrypt_felts_expanded(
    key: CtrKey,
    source: ptr<felt>,
    destination: ptr<felt>,
    counter: u32,
    num_felts: u32,
) -> (CtrKey, ptr<felt>, ptr<felt>, felt)
    movup.7
    u32divmod.8
    swap
    # => [full_blocks, tail, K_CTR(4), src_ptr, dst_ptr, counter, ...]

    swap movdn.8
    movdn.7
    exec.encrypt_blocks_stream_validated
    # => [K_CTR(4), src_ptr_full, dst_ptr_full, counter_full, tail, ...]

    movup.7
    dup neq.0
    if.true
        exec.encrypt_tail_expanded_validated
    else
        drop
    end
end

# Encrypts complete plaintext blocks after the caller has enforced the pointer, range, and
# counter preconditions of `encrypt_felts_expanded`.
#
# Input:  [K_CTR(4), src_ptr, dst_ptr, counter, num_blocks, ...]
# Output: [K_CTR(4), src_ptr + 8*num_blocks, dst_ptr + 16*num_blocks,
#          counter + num_blocks, ...]
proc encrypt_blocks_stream_validated
    # Put the counter before the pointers, as required by `crypto_stream`.
    movup.6
    movdn.4
    # => [K_CTR(4), counter, src_ptr, dst_ptr, remaining, ...]

    # Handle the initial num_blocks % 8 blocks, then process eight blocks per loop iteration
    # to reduce loop overhead.
    dup.7 u32mod.2
    if.true
        crypto_stream
    end

    dup.7 u32mod.4 eq.2
    if.true
        repeat.2
            crypto_stream
        end
    end

    dup.7 u32mod.8 eq.4
    if.true
        repeat.4
            crypto_stream
        end
    end

    dup.7 neq.0
    while.true
        repeat.8
            crypto_stream
        end
        dup.7 neq.0
    end

    movup.7
    drop
    movup.4
    movdn.6
    # => [K_CTR(4), src_ptr, dst_ptr, counter, ...]
end

# Encrypts a final partial block with 1 <= tail <= 7 plaintext Felts.
# Uses the ranges and counter supplied to `encrypt_felts_expanded`.
#
# Local scratch: loc[0..8] = plaintext block, loc[8..24] = expanded ciphertext block.
# Only the first tail plaintext Felts and 2*tail ciphertext limbs belong to the message.
#
# Input:  [tail, K_CTR(4), src_ptr_full, dst_ptr_full, counter_full, ...]
# Output: [K_CTR(4), src_ptr_full + tail, dst_ptr_full + 2*tail, counter_full + 1, ...]
@locals(24)
proc encrypt_tail_expanded_validated
    # crypto_stream needs a whole block. Encrypt into scratch, then copy only the message's
    # limbs to the destination. Each Felt is encrypted independently, so scratch beyond the
    # plaintext tail need not be initialized.
    padw dup.9 mem_loadw_le
    loc_storew_le.0 dropw
    dup push.4 u32gt
    if.true
        padw dup.9 add.4 mem_loadw_le
        loc_storew_le.4 dropw
    end

    # Keep the tail length and caller pointers below the `crypto_stream` inputs.
    movdn.4
    movup.7
    push.1 locaddr.8 locaddr.0
    movup.3
    swapw
    # => [K_CTR(4), counter_full, tail_pt_ptr, tail_ct_ptr, 1, tail, src_ptr_full,
    #     dst_ptr_full, ...]
    crypto_stream
    # => [K_CTR(4), counter_tail, tail_pt_ptr + 8, tail_ct_ptr + 16, 0, tail, src_ptr_full,
    #     dst_ptr_full, ...]

    # Copy exactly 2 * tail ciphertext limbs to the destination.
    dup.8 mul.2
    dup.11
    locaddr.8
    # => [tail_ct_ptr, dst_ptr_full, 2*tail, K_CTR(4), counter_tail, tail_pt_ptr + 8,
    #     tail_ct_ptr + 16, 0, tail, src_ptr_full, dst_ptr_full, ...]
    exec.copy_expanded_tail
    drop
    # => [dst_ptr_full + 2*tail, K_CTR(4), counter_tail, tail_pt_ptr + 8, tail_ct_ptr + 16, 0,
    #     tail, src_ptr_full, dst_ptr_full, ...]

    movup.11 drop
    movup.10 movup.10 add
    # => [src_ptr_full + tail, dst_ptr_full + 2*tail, K_CTR(4), counter_tail, tail_pt_ptr + 8,
    #     tail_ct_ptr + 16, 0, ...]
    movup.9 drop movup.8 drop movup.7 drop
    swap movdn.5 movdn.4
    # => [K_CTR(4), src_ptr_full + tail, dst_ptr_full + 2*tail, counter_tail, ...]

    # Clear this frame's plaintext and ciphertext scratch.
    padw
    loc_storew_le.0 loc_storew_le.4 loc_storew_le.8
    loc_storew_le.12 loc_storew_le.16 loc_storew_le.20
    dropw
end

# Copies an even number of Felts between aligned, validated ranges, with 2 <= count <= 14.
# Bits 3, 2, and 1 select disjoint 8-, 4-, and 2-Felt chunks. The original count remains live
# until the final chunk, avoiding a residual-length loop for the bounded encryption tail.
# Input: [src, dst, count, ...]. Output: [src + count, dst + count, ...].
proc copy_expanded_tail
    dup.2 u32and.8 neq.0
    if.true
        padw dup.4 mem_loadw_le
        dup.5 mem_storew_le
        dup.4 add.4 mem_loadw_le
        dup.5 add.4 mem_storew_le
        dropw
        add.8 swap add.8 swap
    end
    dup.2 u32and.4 neq.0
    if.true
        padw dup.4 mem_loadw_le
        dup.5 mem_storew_le dropw
        add.4 swap add.4 swap
    end
    movup.2 u32and.2 neq.0
    if.true
        dup mem_load dup.2 mem_store
        dup add.1 mem_load dup.2 add.1 mem_store
        add.2 swap add.2 swap
    end
end

# Authentication
# ================================================================================================

#! Authenticates associated data and expanded ciphertext, using lengths in Felts.
#!
#! MAC input:
#! `nonce(4) || AD(ad_len) || ciphertext(ct_len) || [ad_len, ct_len] || zero_padding`
#!
#! Pad only the end of this stream to a multiple of eight Felts, not each segment separately.
#! Thus an odd-length segment pairs its last Felt with the next segment's first Felt.
#! The length pair distinguishes data from padding, including when the data ends in zeros.
#!
#! Pair adjacent Felts as quadratic-extension coefficients `c_0, ..., c_(m-1)`.
#! For evaluation point r and mask s from K_MAC:
#! `a_0 = 1`
#! `a_(i+1) = a_i*r + c_i`
#! `tag = a_m*r + s`
#!
#! Starting at one binds the coefficient count. The final multiplication makes every input
#! coefficient multiply a positive power of r.
#!
#! Input:  [K_MAC(4), nonce(4), ad_ptr, ad_len, ct_ptr, ct_len, ...]
#! Output: [tag0, tag1, ...]
#!
#! The caller checks word-aligned u32 pointers, u32 lengths, and non-empty ranges below its
#! local frame. The padded input must fit in 2^28 Felts. Ciphertext limbs must be u32 values;
#! encryption produces them, and decryption checks them by re-encrypting the plaintext witness.
#!
#! All locals are cleared on successful return; the mask is removed from the operand stack.
#! This does not erase the private execution trace.
#!
#! Invocation: exec
@locals(16)
pub proc auth_expanded_exact(
    mac_key: MacKey,
    nonce: Nonce,
    associated_data: ptr<felt>,
    associated_data_len: u32,
    ciphertext: ptr<felt>,
    ciphertext_len: u32,
) -> Tag
    # The accumulator covers complete eight-Felt batches. The buffer holds the remaining suffix
    # across segment boundaries; only the final batch is padded.
    # Store the evaluation point and keep the mask below the live MAC state on the stack.
    push.0.0 movup.3 movup.3 loc_storew_le.AUTH_ALPHA_LOC dropw
    movdn.9 movdn.9
    # Seed batch[0..4] with the nonce and save both input ranges in one word.
    loc_storew_le.AUTH_BATCH_LOC dropw
    loc_storew_le.AUTH_AD_PTR_LOC dropw

    push.0.1 locaddr.AUTH_ALPHA_LOC locaddr.AUTH_BATCH_LOC push.4
    # => [used=4, batch_ptr, alpha_ptr, acc0=1, acc1=0, mask(2), ...]
    loc_load.AUTH_AD_LEN_LOC loc_load.AUTH_AD_PTR_LOC
    exec.auth_absorb_segment
    loc_load.AUTH_CT_LEN_LOC loc_load.AUTH_CT_PTR_LOC
    exec.auth_absorb_segment
    # Append the two length fields. Only the first can complete a batch before the second.
    loc_load.AUTH_AD_LEN_LOC dup.1 dup.3 add mem_store
    add.1 dup eq.8
    if.true
        drop exec.auth_eval_buffer push.0
    end
    loc_load.AUTH_CT_LEN_LOC dup.1 dup.3 add mem_store
    add.1
    # => [used, batch_ptr, alpha_ptr, acc0, acc1, mask(2), ...]

    # Appending ct_len leaves 1..8 initialized Felts. Clear only the unused suffix.
    dup neq.8
    while.true
        push.0 dup.1 dup.3 add mem_store
        add.1 dup neq.8
    end
    drop
    exec.auth_eval_buffer
    drop
    # => [alpha_ptr, acc0, acc1, mask(2), ...]
    # Give every unmasked input coefficient a positive power of the evaluation point.
    dup add.1 mem_load swap mem_load
    ext2mul
    ext2add

    padw loc_storew_le.AUTH_ALPHA_LOC loc_storew_le.AUTH_AD_PTR_LOC
    loc_storew_le.AUTH_BATCH_LOC loc_storew_le.AUTH_BATCH_TAIL_LOC dropw
end

#! Authenticates `ct_len` expanded ciphertext Felts with empty associated data.
#!
#! Uses the MAC stream defined by `auth_expanded_exact` with `ad_len = 0`:
#! `nonce(4) || ciphertext(ct_len) || [0, ct_len] || zero_padding`.
#!
#! Input:  [K_MAC(4), nonce(4), ct_ptr, ct_len, ...]
#! Output: [tag0, tag1, ...]
#!
#! Uses the same length and memory preconditions as auth_expanded_exact, with empty AD.
#! ct_len must be even: each plaintext Felt contributes two ciphertext limbs.
#!
#! Invocation: exec
@locals(4)
pub proc auth_empty_ad_expanded_exact(
    mac_key: MacKey,
    nonce: Nonce,
    ciphertext: ptr<felt>,
    ciphertext_len: u32,
) -> Tag
    locaddr.0
    exec.auth_empty_ad_expanded_exact_validated
    padw loc_storew_le.0 dropw
end

# Appends a segment without padding its boundary, retaining an incomplete eight-Felt batch.
# Input:  [src, len, used, batch_ptr, alpha_ptr, acc0, acc1, ...]
# Output: [used', batch_ptr, alpha_ptr, acc0', acc1', ...]
#
# used (0..7) counts initialized Felts at batch_ptr. batch_ptr and alpha_ptr are word-aligned.
# alpha_ptr addresses [r0, r1, 0, 0]. The eight-Felt buffer is writable and disjoint from the
# evaluation point and source. The caller checks source bounds; only the buffer is written.
proc auth_absorb_segment
    dup.1 neq.0
    if.true
        # Complete a pending batch before processing the segment's full batches.
        dup.2 neq.0
        if.true
            exec.auth_fill_buffer
            dup.2 eq.8
            if.true
                movdn.6 movdn.6 drop
                # => [batch_ptr, alpha_ptr, acc0, acc1, src, len, ...]
                exec.auth_eval_buffer
                movup.5 movup.5 push.0 movdn.2
            end
        end
        # => [src, len, used, batch_ptr, alpha_ptr, acc0, acc1, ...]
        # Either used = 0 or len = 0; only the former can enter the bulk path.
        dup.1 u32gte.8
        if.true
            dup u32mod.4 eq.0
            if.true
                exec.auth_absorb_aligned
            else
                exec.auth_absorb_unaligned
            end
        end
        # Retain the final partial batch for the next segment; do not pad its boundary.
        dup.1 neq.0
        if.true
            exec.auth_fill_buffer
        end
    end
    drop drop
end

# Folds complete batches without using the pending-batch buffer.
# Input:  [src, len, 0, batch_ptr, alpha_ptr, acc0, acc1, ...]
# Output: [src + 8*(len // 8), len % 8, 0, batch_ptr, alpha_ptr, acc0', acc1', ...]
# The source is word-aligned, len >= 8, and its full range is readable.
# alpha_ptr is the word-aligned address of [r0, r1, 0, 0].
proc auth_absorb_aligned
    movup.2 drop
    swap u32divmod.8
    movup.3 swap
    push.0 movdn.2
    padw padw
    # => [BLOCK(8), tail_len, batch_ptr, 0, batches, src, alpha_ptr, acc0, acc1, ...]
    exec.auth_horner_stream_loop
    dropw dropw
    movup.2 drop movup.2 drop
    movup.2 push.0 movdn.2
end

# Same contract as auth_absorb_aligned, without the source-alignment requirement.
# A segment boundary can leave src between words, so each batch loads eight individual Felts.
proc auth_absorb_unaligned
    movup.2 drop movdn.2 swap
    push.0.0 movdn.3 movdn.3
    # => [batch_ptr, len, pad(2), src, alpha_ptr, acc0, acc1, ...]
    do
        dup.4 add.7 mem_load
        dup.5 add.6 mem_load
        dup.6 add.5 mem_load
        dup.7 add.4 mem_load
        dup.8 add.3 mem_load
        dup.9 add.2 mem_load
        dup.10 add.1 mem_load
        dup.11 mem_load
        horner_eval_ext
        dropw dropw
        movup.4 add.8 movdn.4
        swap sub.8 swap
    while
        dup.1 u32gte.8
    end
    movup.2 drop movup.2 drop
    swap movup.2
    push.0 movdn.2
end

# Appends n = min(len, 8 - used) Felts from src at batch_ptr + used, without evaluation or padding.
# The source range is readable and disjoint from the eight-Felt writable batch.
# On entry, len > 0 and 0 <= used < 8.
#
# Input:  [src, len, used, batch_ptr, alpha_ptr, acc0, acc1, ...]
# Output: [src + n, len - n, used + n, batch_ptr, alpha_ptr, acc0, acc1, ...]
proc auth_fill_buffer
    do
        dup mem_load
        dup.3 dup.5 add mem_store
        add.1 swap sub.1 swap
        movup.2 add.1 movdn.2
    while
        dup.1 neq.0 dup.3 neq.8 and
    end
end

# Folds the eight initialized batch Felts into the accumulator.
# Input/output: [batch_ptr, alpha_ptr, acc0, acc1, ...], with the accumulator updated.
# Both pointers are word-aligned; alpha_ptr addresses [r0, r1, 0, 0].
proc auth_eval_buffer
    push.0.0.0.0
    padw dup.8 add.4 mem_loadw_le
    padw dup.12 mem_loadw_le
    # => [BATCH(8), pad(4), batch_ptr, alpha_ptr, acc0, acc1, ...]
    horner_eval_ext
    dropw dropw dropw
end

# Authenticates exact-length expanded ciphertext whose range the caller has validated.
#
# The caller must check that `ct_ptr` is a word-aligned u32 and that `ct_len` is even, fits in a
# u32, and does not exceed the AEAD message limit. For non-empty ciphertext, the last address must
# fit in u32 and be below the caller's local frame. `alpha_ptr` must be word-aligned and address
# four writable Felts in that frame; the helper uses them for the MAC evaluation point.
#
# Input:  [alpha_ptr, K_MAC(4), nonce(4), ct_ptr, ct_len, ...]
# Output: [tag0, tag1, ...]
proc auth_empty_ad_expanded_exact_validated
    # `horner_eval_ext` requires an aligned word `[r0, r1, 0, 0]` for the evaluation point.
    # Keep the mask `(s0, s1)` below the accumulator until the final multiply and addition.
    movdn.4
    push.0.0 movup.3 movup.3
    dup.6 mem_storew_le dropw
    # => [s0, s1, alpha_ptr, nonce(4), ct_ptr, ct_len, ...]

    movdn.6 movdn.6
    movup.8 movup.8
    push.0.1
    movup.4 movup.4 movup.4
    # => [ct_ptr, ct_len, alpha_ptr, acc0, acc1, nonce(4), s0, s1, ...]

    dup.1 push.4 u32gte
    if.true
        # After the first four ciphertext Felts, split the rest into `middle` full 8-Felt batches
        # and a `tail` of 0, 2, 4, or 6 Felts. The slots preserved by `mem_stream` and
        # `horner_eval_ext` hold [0, ct_len, tail, middle], with `middle` in the batch-count slot.
        dup add.4 movdn.2
        dup.1 sub.4 u32divmod.8
        movup.3 push.0
        # => [0, ct_len, tail, middle, ct_ptr, stream_ptr, alpha_ptr, acc0, acc1, nonce(4), ...]

        # First batch: nonce(4) || ciphertext[0..4].
        padw movup.8 mem_loadw_le
        movupw.3
        horner_eval_ext
        # => [nonce(4), ciphertext[0..4], 0, ct_len, tail, middle, stream_ptr, alpha_ptr, ...]

        # Middle batches, streamed directly from the input.
        exec.auth_horner_stream_loop
        # => [BLOCK(8), 0, ct_len, tail, 0, tail_ptr, alpha_ptr, acc0, acc1, ...]

        # The even tail and [ad_len=0, ct_len] fit in one 8-Felt batch. Pad the rest with zeros.
        # Word loads may read beyond the ciphertext; replace those values before evaluation.
        dup.10 push.4 u32lt
        if.true
            dropw dropw
            # => [0, ct_len, tail, 0, tail_ptr, alpha_ptr, ...]
            dup.2 eq.0
            if.true
                # No tail: [0, ct_len, 0, 0, 0, 0, 0, 0].
                padw push.0.0 dup.7 push.0
            else
                # Tail 2: [tail0, tail1, 0, ct_len, 0, 0, 0, 0].
                padw
                padw dup.12 mem_loadw_le
                dup.9
                exec.auth_pad_tail_word
            end
            # => [BATCH(8), 0, ct_len, tail, 0, tail_ptr, alpha_ptr, ...]
            horner_eval_ext
        else
            dup.12 mem_loadw_le
            # => [tail[0..4], X(4), 0, ct_len, tail, 0, tail_ptr, alpha_ptr, ...]
            dup.10 eq.4
            if.true
                swapw dropw
                push.0.0 dup.7 push.0
                swapw
            else
                # Tail 6: the second word is [tail4, tail5, 0, ct_len].
                swapw
                dup.12 add.4 mem_loadw_le
                dup.9
                exec.auth_pad_tail_word
                swapw
            end
            # => [BATCH(8), 0, ct_len, tail, 0, tail_ptr, alpha_ptr, ...]
            horner_eval_ext
        end
    else
        # ct_len is 0 or 2, so nonce, ciphertext, and both lengths fit in one batch.
        dup.1 eq.0
        if.true
            drop drop
            padw padw push.0
        else
            padw movup.4
            padw movup.4 mem_loadw_le
            # => [W(4), 0, 0, 0, 0, ct_len, alpha_ptr, acc0, acc1, nonce(4), ...]
            dup.8
            exec.auth_pad_tail_word
        end
        movupw.3
        # => [nonce(4), padded_ciphertext(4), 0, 0, 0, 0, ct_len, alpha_ptr, acc0, acc1, ...]
        horner_eval_ext
    end

    dropw dropw dropw drop
    # => [alpha_ptr, acc0, acc1, s0, s1, ...]

    # Multiply by the evaluation point before adding the mask, so the unmasked MAC polynomial
    # has constant coefficient zero.
    dup add.1 mem_load
    swap mem_load
    # => [r0, r1, acc0, acc1, s0, s1, ...]
    ext2mul
    ext2add
end

# Prepares the final partial ciphertext word for empty-AD MAC evaluation.
#
# A partial ciphertext word contains two limbs. Replace the values read past its end
# with [ad_len=0, ct_len].
#
# Input:  [ct_len, w0, w1, w2, w3, ...]
# Output: [w0, w1, 0, ct_len, ...]
proc auth_pad_tail_word
    movup.3 drop movup.3 drop
    push.0 movup.3 movup.3
end

# Folds `num_batches` consecutive 8-Felt memory batches into the MAC accumulator.
#
# `mem_stream` loads each batch into the coefficient slots used by `horner_eval_ext`, so no
# stack rearrangement is needed between the two instructions. Both preserve slots 8..11. The
# loop uses slot 11 for its remaining batch count and leaves the three caller values in
# slots 8..10 unchanged.
#
# Input:  [BLOCK(8), saved(3), num_batches, stream_ptr, alpha_ptr, acc0, acc1, ...]
# Output: [BLOCK'(8), saved(3), 0, stream_ptr + 8*num_batches, alpha_ptr, acc0', acc1', ...]
proc auth_horner_stream_loop
    # Handle the initial num_batches % 8 batches, then process eight batches per loop iteration
    # to reduce loop overhead.
    dup.11 u32mod.2
    if.true
        movup.11
        sub.1
        movdn.11

        mem_stream
        horner_eval_ext
    end

    dup.11 u32mod.4 eq.2
    if.true
        movup.11
        sub.2
        movdn.11

        repeat.2
            mem_stream
            horner_eval_ext
        end
    end

    dup.11 u32mod.8 eq.4
    if.true
        movup.11
        sub.4
        movdn.11

        repeat.4
            mem_stream
            horner_eval_ext
        end
    end

    dup.11 neq.0
    while.true
        movup.11
        sub.8
        movdn.11

        repeat.8
            mem_stream
            horner_eval_ext
        end

        dup.11 neq.0
    end
end

# Plaintext witness verification
# ================================================================================================

# Loads the plaintext witness, re-encrypts it, and compares every ciphertext limb.
# The caller has authenticated the ciphertext and checked the memory ranges.
# Input: [src_ptr, dst_ptr, num_felts, scratch_ptr, key(4), nonce(4), ...]
# Output: [...]
pub proc verify_plaintext(
    source: ptr<felt>, destination: ptr<felt>, num_felts: u32, scratch: ptr<felt>,
    key: Key, nonce: Nonce,
)
    dup.2 dup.2
    exec.load_advice_felts_to_memory
    drop

    # Re-encrypt the claimed plaintext into scratch.
    dupw.1 dupw.3 swapw
    exec.derive_ctr_key
    # => [K_CTR(4), src_ptr, dst_ptr, num_felts, scratch_ptr, key(4), nonce(4), ...]

    dup.6 push.0 dup.9 dup.8
    swapw
    # => [K_CTR(4), dst_ptr, scratch_ptr, 0, num_felts, src_ptr, dst_ptr, num_felts, scratch_ptr,
    #     key(4), nonce(4), ...]
    exec.encrypt_felts_expanded
    dropw drop drop drop
    # => [src_ptr, dst_ptr, num_felts, scratch_ptr, key(4), nonce(4), ...]

    dup.2 mul.2 dup.1 dup.5
    # => [scratch_ptr, src_ptr, ct_len, ...]
    exec.assert_ciphertexts_equal
    dropw dropw dropw
    # => [...]
end

# Loads `count` Felts from advice into memory.
#
# Input:  [dst_ptr, count, ...]
# Output: [0, ...]
proc load_advice_felts_to_memory
    dup.1
    u32divmod.8
    swap
    movup.2
    # => [dst_ptr, full_batches, tail, count, ...]

    padw padw padw
    # => [BLOCK_LO(4)=0w, BLOCK_HI(4)=0w, CV(4)=0w, dst_ptr, full_batches, tail, count, ...]

    dup.13 u32mod.2
    if.true
        movup.13 sub.1 movdn.13
        adv_pipe
    end

    dup.13 u32mod.4 eq.2
    if.true
        movup.13 sub.2 movdn.13
        repeat.2
            adv_pipe
        end
    end

    dup.13 u32mod.8 eq.4
    if.true
        movup.13 sub.4 movdn.13
        repeat.4
            adv_pipe
        end
    end

    dup.13 neq.0
    while.true
        movup.13 sub.8 movdn.13
        # => [BLOCK_LO(4), BLOCK_HI(4), CV(4), dst_ptr, remaining_batches - 8, tail, count, ...]
        repeat.8
            adv_pipe
        end
        # => [BLOCK_LO(4), BLOCK_HI(4), CV(4), dst_ptr + 64, remaining_batches, tail, count, ...]
        dup.13 neq.0
    end

    dropw dropw dropw
    swap drop
    # => [dst_ptr + 8*full_batches, tail, count, ...]

    dup.1 push.4 u32gte
    if.true
        padw adv_loadw
        # => [WORD(4), dst_ptr, tail, count, ...]
        dup.4 mem_storew_le
        dropw
        add.4
        swap sub.4 swap
        # => [dst_ptr + 4, tail - 4, count, ...]
    end
    # => [dst_ptr + 8*full_batches + word_tail, tail % 4, count, ...]

    dup.1 neq.0
    while.true
        adv_push
        dup.1 mem_store
        add.1
        swap sub.1 swap
        dup.1 neq.0
    end
    drop
    swap drop
end

# Asserts equality of two expanded-ciphertext ranges.
#
# The caller must supply word-aligned u32 pointers and an even u32 `count`. Each non-empty
# range must stay within the u32 address space.
#
# Input:  [lhs_ptr, rhs_ptr, count, ...]
# Output: [...]
proc assert_ciphertexts_equal
    movup.2 u32divmod.4
    # => [tail, full_words, lhs_ptr, rhs_ptr, ...]
    swap mul.4 dup.2 add
    # => [lhs_word_end, tail, lhs_ptr, rhs_ptr, ...]
    movup.3
    movup.3
    # => [lhs_ptr, rhs_ptr, lhs_word_end, tail, ...]

    # lhs_word_end is the first address after the complete words; tail is zero or two.
    dup dup.3 neq
    while.true
        padw dup.4 mem_loadw_le
        # => [LHS_WORD(4), lhs_ptr, rhs_ptr, lhs_word_end, tail, ...]
        padw dup.9 mem_loadw_le
        # => [RHS_WORD(4), LHS_WORD(4), lhs_ptr, rhs_ptr, lhs_word_end, tail, ...]
        assert_eqw.err="AEAD ciphertext mismatch"
        # => [lhs_ptr, rhs_ptr, lhs_word_end, tail, ...]

        add.4
        swap add.4 swap
        # => [lhs_ptr + 4, rhs_ptr + 4, lhs_word_end, tail, ...]
        dup dup.3 neq
    end

    movup.2 drop
    # => [lhs_ptr + 4*full_words, rhs_ptr + 4*full_words, tail, ...]

    # An odd plaintext length leaves exactly two ciphertext limbs after the full words.
    movup.2 neq.0
    if.true
        dup mem_load
        dup.2 mem_load
        assert_eq.err="AEAD ciphertext mismatch"
        add.1
        swap add.1
        # => [rhs_ptr + 4*full_words + 1, lhs_ptr + 4*full_words + 1, ...]
        dup mem_load
        dup.2 mem_load
        assert_eq.err="AEAD ciphertext mismatch"
    end
    drop drop
end
