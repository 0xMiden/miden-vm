use miden::core::crypto::hashes::poseidon2
use miden::core::precompiles::hashes::keccak256
use miden::core::precompiles::curves::secp256k1
use miden::core::precompiles::fields::k1_base
use miden::core::precompiles::fields::k1_scalar
use miden::core::word

const ECDSA_RECOVER_EVENT = event("miden::core::crypto::dsa::ecdsa_k256_keccak::recover")

# ENCODING CONVENTIONS
# ================================================================================================
#
# - Native secp256k1 values are stored as little-endian numeric u32 limbs, one limb per Felt.
# - The public-key commitment is `Poseidon2::hash_elements(QX[8] || QY[8])` over the native
#   coordinate limbs in advice/memory order.
# - MSG_WORD is a word whose four felts are split into eight little-endian u32 limbs before Keccak256.
# - Variable-length messages are stored as packed little-endian u32 limbs in word-aligned memory.

# PROCEDURES
# ================================================================================================

#! Verifies a secp256k1 ECDSA witness using the `miden-crypto::ecdsa_k256_keccak` message,
#! public-key commitment, and signature-scalar conventions, encoded in the native limb ABI below.
#! Acceptance intentionally differs from the Rust verifier: high-s witnesses are accepted.
#!
#! Inputs:
#!   Operand stack: [PK_COMM, MSG_WORD, ...]
#!   Advice stack:  [QX[8] | QY[8] | SIG_R[8] | SIG_S[8] | ...]
#! Outputs:
#!   Operand stack: [...]
#!   Advice stack:  [...]
#!
#! Where:
#! - `PK_COMM`: Poseidon2 hash commitment of `QX[8] || QY[8]`, where coordinates are native
#!   little-endian numeric u32 limbs, one limb per Felt.
#! - `MSG_WORD`: single word / 4 felts representing the 32-byte message to verify.
#! - `QX[8]`, `QY[8]`: native public-key coordinates as little-endian u32 limbs.
#! - `SIG_R[8]`, `SIG_S[8]`: native signature scalars as little-endian u32 limbs.
#!
#! Local memory layout (element addresses):
#!   - loc[0 ..16] : native public key, QX[8] || QY[8].
#!   - loc[16..24] : Keccak256 message/digest scratch buffer.
#!
#! No result word is pushed. The procedure traps on malformed native limbs, invalid/off-curve public
#! keys, invalid signature scalars, or failed signature verification.
#!
#! Low-s is intentionally not enforced: this procedure proves that some untrusted advice satisfies
#! the ECDSA equation, and `(r, s)` and `(r, n - s)` are equivalent witnesses. An adaptation that
#! verifies a committed signature must bind the exact signature encoding inside the VM. Low-s is a
#! separate canonicality policy and only needs to be enforced when the caller requires it.
#!
#! Advice is untrusted. This procedure binds QX/QY to `PK_COMM`, and validates the public key,
#! reduced Keccak prehash, and signature scalars through precompile-backed deferred evaluation.
#!
#! Invocation: exec
@locals(24)
pub proc verify
    locaddr.0
    # => [pubkey_ptr=loc[0], PK_COMM, MSG_WORD, ...]
    exec.load_and_verify_public_key
    # => [pubkey_ptr+16=loc[16], MSG_WORD, ...]

    movdn.4
    # => [MSG_WORD, digest_ptr=loc[16], ...]

    # stage MSG_WORD[32] in loc[16..24], hash it in-place via the memory-oriented Keccak precompile,
    # then convert the digest bytes into the native little-endian scalar limbs used as ECDSA z.
    exec.store_word_u32s_le
    # => [digest_ptr, ...]  (MSG_U32[8] written to loc[16..24])

    dup dup push.32 swap
    # => [in_ptr=loc[16], len_bytes=32, out_ptr=loc[16], digest_ptr=loc[16], ...]
    exec.keccak256::hash_1_chunk_mem
    # => [digest_ptr=loc[16], ...]  (DIGEST_U32[8] written to loc[16..24])

    locaddr.0 swap
    # => [digest_ptr=loc[16], pubkey_ptr=loc[0], ...]
    exec.load_keccak_digest_as_z
    # => [PREHASH_U32[8], pubkey_ptr, ...] where PREHASH[0] = byte_reverse(KeccakDigest[7])

    exec.verify_digest_impl
    # => [...]
end

#! Verifies a secp256k1 ECDSA witness over a variable-length message stored as bytes in memory.
#!
#! Inputs:
#!   Operand stack: [PK_COMM, MSG_PTR, MSG_LEN_BYTES, ...]
#!   Advice stack:  [QX[8] | QY[8] | SIG_R[8] | SIG_S[8] | ...]
#! Outputs:
#!   Operand stack: [...]
#!   Advice stack:  [...]
#!
#! Where:
#! - `PK_COMM`: Poseidon2 hash commitment of `QX[8] || QY[8]`, where coordinates are native
#!   little-endian numeric u32 limbs, one limb per Felt.
#! - `MSG_PTR`: word-aligned address containing the message as packed little-endian u32 limbs.
#! - `MSG_LEN_BYTES`: number of message bytes to hash. Unused bytes in the final u32 and remaining felts
#!   in the final 32-byte chunk must be zero.
#! - `QX[8]`, `QY[8]`: native public-key coordinates as little-endian u32 limbs.
#! - `SIG_R[8]`, `SIG_S[8]`: native signature scalars as little-endian u32 limbs.
#!
#! No result word is pushed. The procedure traps if:
#! - `MSG_PTR` is not word-aligned.
#! - `MSG_LEN_BYTES` exceeds the configured `max_hash_len_bytes` execution limit.
#! - a message-memory felt is not a valid u32.
#! - unused message bytes or felts in the final 32-byte chunk are nonzero.
#! - public-key or signature limbs are malformed, the public key is invalid/off-curve, the signature
#!   scalars are invalid, or signature verification fails.
#!
#! Advice is untrusted. This procedure binds QX/QY to `PK_COMM`, hashes the specified memory range,
#! and validates the reduced Keccak prehash and signature scalars through precompile-backed deferred
#! evaluation.
#!
#! Invocation: exec
@locals(24)
pub proc verify_bytes
    locaddr.0
    # => [pubkey_ptr=loc[0], PK_COMM, MSG_PTR, MSG_LEN_BYTES, ...]
    exec.load_and_verify_public_key
    # => [out_ptr=loc[16], MSG_PTR, MSG_LEN_BYTES, ...]

    movdn.2
    # => [MSG_PTR, MSG_LEN_BYTES, out_ptr=loc[16], ...]
    exec.keccak256::hash_bytes_mem
    # => [...]

    locaddr.0 locaddr.16
    # => [digest_ptr=loc[16], pubkey_ptr=loc[0], ...]  (DIGEST_U32[8] written to loc[16..24])
    exec.load_keccak_digest_as_z
    # => [PREHASH_U32[8], pubkey_ptr=loc[0], ...]
    exec.verify_digest_impl
    # => [...]
end

#! Recovers the secp256k1 public key from a native EVM recovery witness over a Word message.
#!
#! Inputs:
#!   Operand stack: [MSG_WORD, SIG_PTR, ...]
#! Outputs:
#!   Operand stack: [QX[8] | QY[8], ...]
#!
#! Where:
#! - `MSG_WORD`: four felts split into eight little-endian u32 limbs and hashed exactly as by
#!   `verify`.
#! - `SIG_PTR`: word-aligned address of caller-owned memory containing the native EVM recovery
#!   witness `R_LE_U32[8] || S_LE_U32[8] || V`. The memory must remain unchanged until the procedure
#!   returns.
#! - `R_LE_U32[8]`, `S_LE_U32[8]`: signature scalars as little-endian u32 limbs.
#! - `V`: EVM recovery byte 27 or 28.
#! - `QX[8]`, `QY[8]`: recovered affine public-key coordinates as little-endian u32 limbs.
#!
#! Panics if:
#! - `SIG_PTR` is not word-aligned.
#! - a signature limb is not a u32, or `r` or `s` is zero or not a canonical secp256k1 scalar.
#! - `V` is not 27 or 28.
#! - candidate public-key advice or the derived recovery point is invalid or inconsistent with the
#!   exact message, signature, and recovery byte.
#!
#! Exact `r`, `s`, and `v`, including high-s, are bound; low-s is a separate caller policy. A wrong
#! message can recover a different valid key; callers must authenticate the returned key against
#! trusted state.
#! Raw signature bytes are not a replay key because equivalent low-s and high-s encodings exist.
#!
#! Invocation: exec
@locals(8)
pub proc recover
    locaddr.0 movdn.4
    # => [MSG_WORD, digest_ptr=loc[0], SIG_PTR, ...]
    exec.store_word_u32s_le
    # => [digest_ptr, SIG_PTR, ...]

    dup dup push.32 swap
    # => [in_ptr=loc[0], len_bytes=32, out_ptr=loc[0], digest_ptr=loc[0], SIG_PTR, ...]
    exec.keccak256::hash_1_chunk_mem
    # => [digest_ptr=loc[0], SIG_PTR, ...]

    exec.recover_digest
    # => [QX[8] | QY[8], ...]
end

#! Recovers the secp256k1 public key from a native EVM recovery witness over bytes in memory.
#!
#! Inputs:
#!   Operand stack: [MSG_PTR, MSG_LEN_BYTES, SIG_PTR, ...]
#! Outputs:
#!   Operand stack: [QX[8] | QY[8], ...]
#!
#! Where:
#! - `MSG_PTR`: word-aligned address containing the message as packed little-endian u32 limbs.
#! - `MSG_LEN_BYTES`: number of message bytes to hash. Unused bytes in the final u32 and remaining
#!   felts in the final 32-byte chunk must be zero.
#! - `SIG_PTR`: word-aligned address of caller-owned memory containing the native EVM recovery
#!   witness `R_LE_U32[8] || S_LE_U32[8] || V`. The memory must remain unchanged until the procedure
#!   returns.
#! - `R_LE_U32[8]`, `S_LE_U32[8]`: signature scalars as little-endian u32 limbs.
#! - `V`: EVM recovery byte 27 or 28.
#! - `QX[8]`, `QY[8]`: recovered affine public-key coordinates as little-endian u32 limbs.
#!
#! Panics if:
#! - `MSG_PTR` or `SIG_PTR` is not word-aligned.
#! - `MSG_LEN_BYTES` exceeds the configured `max_hash_len_bytes` execution limit.
#! - a message-memory felt is not a u32, or final-chunk padding is nonzero.
#! - a signature limb is not a u32, or `r` or `s` is zero or not a canonical secp256k1 scalar.
#! - `V` is not 27 or 28.
#! - candidate public-key advice or the derived recovery point is invalid or inconsistent with the
#!   exact message, signature, and recovery byte.
#!
#! Exact `r`, `s`, and `v`, including high-s, are bound; low-s is a separate caller policy. A wrong
#! message can recover a different valid key; callers must authenticate the returned key against
#! trusted state.
#!
#! Invocation: exec
@locals(8)
pub proc recover_bytes
    locaddr.0 movdn.2
    # => [MSG_PTR, MSG_LEN_BYTES, digest_ptr=loc[0], SIG_PTR, ...]
    exec.keccak256::hash_bytes_mem
    # => [SIG_PTR, ...]  (DIGEST_U32[8] written to loc[0..8])

    locaddr.0
    # => [digest_ptr=loc[0], SIG_PTR, ...]
    exec.recover_digest
    # => [QX[8] | QY[8], ...]
end

# INTERNAL PROCEDURES — ECDSA
# ================================================================================================

#! Completes ECDSA verification after the Keccak digest has been converted to native scalar limbs.
#!
#! Input:  [Z_U32[8], pubkey_ptr, ...]
#! Advice: [SIG_R[8] | SIG_S[8] | ...]
#! Output: [...]
proc verify_digest_impl
    exec.prepare_verify_inputs
    # => [U1, Q, U2, SIG_R, ...]
    exec.secp256k1::push_generator
    # => [G, U1, Q, U2, SIG_R, ...]
    exec.secp256k1::msm2
    # => [VERIFY_POINT, SIG_R, ...]
    exec.assert_x_eq_scalar_k1
    # => [...]
end

#! Recovers and constrains a public key for a Keccak digest and native EVM recovery witness.
#!
#! Input:  [digest_ptr, SIG_PTR, ...]
#! Output: [QX[8] | QY[8], ...]
#!
#! `digest_ptr` addresses eight packed little-endian u32 felts containing the Keccak digest.
#! `SIG_PTR` is word-aligned and addresses `R_LE_U32[8] || S_LE_U32[8] || V`, with V = 27 or 28.
#! The recovery event supplies only the candidate `QX[8] || QY[8]`; all witness data is loaded
#! independently from memory and the advice point is constrained before it is returned.
@locals(16)
proc recover_digest
    emit.ECDSA_RECOVER_EVENT
    # => [digest_ptr, SIG_PTR, ...]  Advice: [QX[8] | QY[8] | ...]

    # Bind the digest and signature before writing candidate-point advice into procedure locals.
    # SIG_PTR must be caller-owned; this ordering is also robust to an out-of-contract absolute
    # pointer into this local frame.
    exec.load_keccak_digest_as_z
    # => [PREHASH_U32[8], SIG_PTR, ...]
    exec.k1_scalar::load_reduced_256
    # => [Z, SIG_PTR, ...]
    exec.load_recovery_signature_k1
    # => [SIG_S, SIG_R, Z, SIG_R_BASE, recovery_parity, ...]

    # Stream the candidate point into local memory. The sponge words are scratch; no digest is
    # derived from the untrusted advice here.
    locaddr.0 padw padw padw
    adv_pipe
    adv_pipe
    # => [QY_RATE[8], C, end_ptr=loc[16], SIG_S, SIG_R, Z, SIG_R_BASE, recovery_parity, ...]
    dropw dropw dropw sub.16
    # => [pubkey_ptr=loc[0], SIG_S, SIG_R, Z, SIG_R_BASE, recovery_parity, ...]
    exec.secp256k1::load_mem
    # => [Q, SIG_S, SIG_R, Z, SIG_R_BASE, recovery_parity, ...]
    movdnw.3
    # => [SIG_S, SIG_R, Z, Q, SIG_R_BASE, recovery_parity, ...]

    exec.compute_ecdsa_scalars
    # => [U1, Q, U2, SIG_R, SIG_R_BASE, recovery_parity, ...]
    exec.secp256k1::push_generator
    # => [G, U1, Q, U2, SIG_R, SIG_R_BASE, recovery_parity, ...]
    exec.secp256k1::msm2
    # => [RECOVERY_POINT, SIG_R, SIG_R_BASE, recovery_parity, ...]
    swapw dropw
    # => [RECOVERY_POINT, SIG_R_BASE, recovery_parity, ...]
    exec.assert_recovery_point
    # => [...]

    # Return the now-constrained point in the same native layout used for public-key commitments.
    padw loc_loadw_le.12
    padw loc_loadw_le.8
    padw loc_loadw_le.4
    padw loc_loadw_le.0
    # => [QX[8] | QY[8], ...]
end

#! Loads QX || QY from advice, binds it to PK_COMM, and returns the end of the public-key buffer.
#!
#! Input:  [pubkey_ptr, PK_COMM, ...]
#! Advice: [QX[8] | QY[8] | ...]
#! Output: [pubkey_ptr + 16, ...]
proc load_and_verify_public_key
    # Since there are exactly 16 elements, `hash_elements` has a zero capacity word and requires no
    # partial-block padding. `adv_pipe` exposes each written chunk in the rate slots in the same
    # order that `mem_stream` would read it back from memory.
    padw padw padw
    # => [R0=0w, R1=0w, C=0w, write_ptr=pubkey_ptr, PK_COMM, ...]
    adv_pipe
    # => [QX_RATE[8], C=0w, write_ptr=pubkey_ptr+8, PK_COMM, ...]
    hperm
    # => [R0, R1, C, write_ptr=pubkey_ptr+8, PK_COMM, ...]
    adv_pipe
    # => [QY_RATE[8], C, write_ptr=pubkey_ptr+16, PK_COMM, ...]
    hperm
    # => [R0, R1, C, write_ptr=pubkey_ptr+16, PK_COMM, ...]
    exec.poseidon2::squeeze_digest
    # => [PK_HASH, write_ptr=pubkey_ptr+16, PK_COMM, ...]
    movup.4 movdn.8
    # => [PK_HASH, PK_COMM, write_ptr=pubkey_ptr+16, ...]
    assert_eqw.err="invalid public key commitment"
    # => [pubkey_ptr+16, ...]
end

#! Converts a packed Keccak256 digest in memory to native scalar limbs.
#!
#! Input:  [digest_ptr, ...]
#! Output: [PREHASH_U32[8], ...]
#!
#! Preconditions:
#! - digest_ptr points to DIGEST_U32[8] packed little-endian u32 limbs. Each felt is u32-constrained
#!   by the Keccak memory interface before `reverse_u32_bytes` consumes it.
proc load_keccak_digest_as_z
    repeat.8
        dup mem_load
        exec.reverse_u32_bytes
        swap add.1
    end
    # => [read_ptr=digest_ptr+8, PREHASH_U32[8], ...]
    drop
    # => [PREHASH_U32[8], ...] where PREHASH[0] = byte_reverse(KeccakDigest[7])
end

#! Computes ECDSA scalars U1 = z/s and U2 = r/s, keeping SIG_R for the final check.
#!
#! Input:  [Z_U32[8], pubkey_ptr, ...]
#! Advice: [SIG_R[8] | SIG_S[8] | ...]
#! Output: [U1_DIGEST, Q_DIGEST, U2_DIGEST, SIG_R_DIGEST, ...]
#!
#! Preconditions/provenance:
#! - Z_U32[8] is the Keccak256 message digest converted to little-endian scalar limbs;
#! - pubkey_ptr points to QX[8] || QY[8], already bound to PK_COMM by a public verifier;
#! - SIG_R/S advice is untrusted, loaded canonically by `load_signature_k1`, and checked below.
proc prepare_verify_inputs
    exec.k1_scalar::load_reduced_256
    # => [Z, pubkey_ptr, ...]

    movup.4
    # => [pubkey_ptr, Z, ...]
    exec.secp256k1::load_mem
    # => [Q, Z, ...]
    swapw
    # => [Z, Q, ...]

    exec.load_signature_k1
    # => [SIG_S, SIG_R, Z, Q, ...]

    exec.compute_ecdsa_scalars
    # => [U1, Q, U2, SIG_R, ...]
end

#! Loads a native EVM recovery witness before any procedure-local writes can alias its memory.
#!
#! Input:  [Z_SCALAR_EXPR_DIGEST, SIG_PTR, ...]
#! Output: [SIG_S_SCALAR_VALUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, Z_SCALAR_EXPR_DIGEST,
#!          SIG_R_BASE_VALUE_DIGEST, recovery_parity, ...]
#!
#! `SIG_PTR` is word-aligned and addresses `R_LE_U32[8] || S_LE_U32[8] || V`, with V = 27 or 28.
#! Loading r in both uint domains is sound because scalar canonicality proves `r < n < p`.
proc load_recovery_signature_k1
    movup.4
    # => [SIG_PTR, Z, ...]

    # Validate V first and move the normalized parity below Z.
    dup add.16 mem_load sub.27
    dup dup sub.1 mul assertz.err="invalid EVM recovery byte: expected 27 or 28"
    # => [recovery_parity, SIG_PTR, Z, ...]
    movdn.5
    # => [SIG_PTR, Z, recovery_parity, ...]

    # Register r in the base domain for the final exact-X comparison, and independently in the
    # scalar domain for the ECDSA relation.
    dup exec.k1_base::load_mem
    # => [SIG_R_BASE, SIG_PTR, Z, recovery_parity, ...]
    movup.4
    dup exec.k1_scalar::load_mem
    # => [SIG_R, SIG_PTR, SIG_R_BASE, Z, recovery_parity, ...]
    movup.4 add.8 exec.k1_scalar::load_mem
    # => [SIG_S, SIG_R, SIG_R_BASE, Z, recovery_parity, ...]

    movupw.3 movdnw.2
    # => [SIG_S, SIG_R, Z, SIG_R_BASE, recovery_parity, ...]
end

#! Loads SIG_R and SIG_S from advice as k1 scalar VALUE digests and returns SIG_S on top.
#!
#! Advice: [SIG_R[8] | SIG_S[8] | ...]
#! Output: [SIG_S_SCALAR_VALUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
proc load_signature_k1
    exec.load_scalar_k1_from_advice
    # => [SIG_R, ...]

    exec.load_scalar_k1_from_advice
    # => [SIG_S, SIG_R, ...]
end

#! Loads one canonical k1 scalar from advice.
#!
#! Advice: [VALUE_LO_U32[4] | VALUE_HI_U32[4] | ...]
#! Output: [VALUE_SCALAR_DIGEST, ...]
proc load_scalar_k1_from_advice
    adv_pushw
    # => [VALUE_LO_U32[4], ...]
    adv_pushw
    # => [VALUE_HI_U32[4], VALUE_LO_U32[4], ...]
    swapw
    # => [VALUE_LO_U32[4], VALUE_HI_U32[4], ...]
    exec.k1_scalar::load
    # => [VALUE_SCALAR_DIGEST, ...]
end

#! Checks the ECDSA signature scalars and computes `U1 = z/s` and `U2 = r/s`.
#!
#! Input:  [SIG_S, SIG_R, Z, Q, ...]
#! Output: [U1, Q, U2, SIG_R, ...]
#!
#! SIG_R/S are canonical k1-scalar VALUE digests from the scalar loaders; Z is a k1-scalar
#! expression digest from `load_reduced_256`; Q originates from `secp256k1::load_mem`. Thus direct
#! comparison of SIG_R with the pinned zero VALUE digest is sound.
proc compute_ecdsa_scalars
    # Inversion rejects s = 0; check r explicitly.
    dupw.1
    exec.k1_scalar::push_zero_digest
    exec.word::eq
    assertz.err="invalid ECDSA signature: r is zero"
    # => [SIG_S, SIG_R, Z, Q, ...]

    exec.k1_scalar::inv
    # => [S_INV, SIG_R, Z, Q, ...]

    dupw
    movupw.3
    exec.k1_scalar::mul
    # => [U1 = Z*S_INV, S_INV, SIG_R, Q, ...]

    dupw.1
    dupw.3
    exec.k1_scalar::mul
    # => [U2 = SIG_R*S_INV, U1, S_INV, SIG_R, Q, ...]

    swapw.2
    # => [S_INV, U1, U2, SIG_R, Q, ...]
    dropw
    # => [U1, U2, SIG_R, Q, ...]

    movupw.3 swapw
    # => [U1, Q, U2, SIG_R, ...]
end

#! Evaluates VERIFY_POINT once, rejects the identity, reduces x(VERIFY_POINT) modulo n, and
#! compares the resulting scalar-field expression against SIG_R.
#!
#! Input:  [VERIFY_POINT_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
#! Output: [...]
#!
#! Preconditions/provenance:
#! - SIG_R_SCALAR_VALUE_DIGEST is a canonical k1 scalar VALUE digest, e.g. from load_signature_k1;
#! - secp256k1::eval binds VERIFY_POINT_DIGEST to the returned canonical curve VALUE payload;
#! - after identity rejection succeeds, X_OR_TRUE_DIGEST/Y_OR_TRUE_DIGEST are real coordinate digests.
proc assert_x_eq_scalar_k1
    exec.secp256k1::eval
    # => [VERIFY_POINT_VALUE_DIGEST, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]

    # Reject identity at the curve VALUE-digest level. `eval` returns the canonical VALUE digest
    # alongside the coordinate payload, so direct comparison to the registered identity VALUE digest
    # is sound and avoids a second curve evaluation.
    exec.secp256k1::push_identity
    # => [IDENTITY_VALUE_DIGEST, VERIFY_POINT_VALUE_DIGEST, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
    exec.word::eq
    # => [is_identity, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
    assertz.err="invalid ECDSA verification point: identity"
    # => [X_DIGEST, Y_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
    swapw dropw
    # => [X_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]

    # X_DIGEST is a canonical k1-base VALUE child of the proof-bound curve VALUE above. Open that
    # commitment directly; ordinary `eval` remains necessary for arbitrary expression digests.
    exec.k1_base::open_value
    # => [X_U32[8], SIG_R_SCALAR_VALUE_DIGEST, ...]
    exec.k1_scalar::load_reduced_256
    # => [X_SCALAR_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]

    # Deferred registration evaluates this same-domain scalar equality eagerly, so a mismatch traps
    # during main-VM execution as well as being committed to the deferred root.
    exec.k1_scalar::assert_eq
    # => [...]
end

#! Checks exact x-coordinate and y parity for parity-only EVM public-key recovery.
#!
#! Input:  [RECOVERY_POINT_DIGEST, SIG_R_BASE_VALUE_DIGEST, recovery_parity, ...]
#! Output: [...]
#!
#! The x-coordinate is compared without reduction: recovery bytes 27 and 28 select only the
#! `x(R) = r` branches, not the mathematical recovery-ID branches where `x(R) = r + n`.
proc assert_recovery_point
    # Keep the curve evaluation inline in each final-check mode: placing it behind a non-tail helper
    # adds three cycles to the existing verifier hot path.
    exec.secp256k1::eval
    # => [RECOVERY_POINT_VALUE_DIGEST, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R_BASE, recovery_parity, ...]

    # Identity has TRUE_DIGEST children, so the exact base-field X comparison below rejects it.
    dropw
    # => [X_DIGEST, Y_DIGEST, SIG_R_BASE, recovery_parity, ...]

    # Both operands are canonical base-field VALUE digests. Raw equality is exact and cannot admit
    # x = r + n; identity has TRUE_DIGEST children and therefore also fails this comparison.
    movupw.2
    # => [R_BASE_VALUE_DIGEST, X_BASE_VALUE_DIGEST, Y_DIGEST, recovery_parity, ...]
    assert_eqw.err="ECDSA recovery point x-coordinate does not equal r"
    # => [Y_DIGEST, recovery_parity, ...]

    exec.k1_base::open_value
    # => [Y_U32[8], recovery_parity, ...]
    push.1 u32and
    # => [y_parity, Y_U32[1..8], recovery_parity, ...]
    movup.8 assert_eq.err="ECDSA recovery point has the wrong y parity"
    repeat.7
        drop
    end
    # => [...]
end

# INTERNAL PROCEDURES — BYTE OPS
# ================================================================================================

#! Stores a word as the eight little-endian u32 limbs used as the 32-byte Keccak message.
#!
#! Input:  [w0, w1, w2, w3, ptr, ...]
#! Output: [ptr, ...]
proc store_word_u32s_le
    swap u32split
    # => [w1_lo, w1_hi, w0, w2, w3, ptr, ...]
    movup.2 u32split
    # => [w0_lo, w0_hi, w1_lo, w1_hi, w2, w3, ptr, ...]
    dup.6 mem_storew_le dropw
    # => [w2, w3, ptr, ...]  (ptr[0..4] = [w0_lo, w0_hi, w1_lo, w1_hi])

    swap u32split
    # => [w3_lo, w3_hi, w2, ptr, ...]
    movup.2 u32split
    # => [w2_lo, w2_hi, w3_lo, w3_hi, ptr, ...]
    dup.4 add.4 mem_storew_le dropw
    # => [ptr, ...]  (ptr[4..8] = [w2_lo, w2_hi, w3_lo, w3_hi])
end

#! Reverses the byte order of a u32 limb.
#!
#! Input:  [x, ...]
#! Output: [byte_reverse(x), ...]
#! Precondition: x is a u32.
proc reverse_u32_bytes
    dup u32shr.8 push.0x00FF00FF u32and
    # => [(x >> 8) & 0x00ff00ff, x, ...]
    swap push.0x00FF00FF u32and mul.256
    # => [(x & 0x00ff00ff) << 8, shifted, ...]
    u32xor
    # => [x with adjacent bytes swapped, ...]

    u32rotr.16
    # => [byte_reverse(x), ...]
end
