use miden::precompiles::hashes::keccak256
use miden::precompiles::curves::secp256k1
use miden::precompiles::fields::k1_base
use miden::precompiles::fields::k1_scalar
use miden::core::crypto::hashes::poseidon2
use miden::core::word

const ECRECOVER_EVENT = event("miden::core::crypto::dsa::ecdsa_k256_keccak::ecrecover")

# The last packed-u32 element of the 32-byte big-endian encodings of v = 27 and v = 28: the value
# byte is byte 31 of the field, so it lands in the element's top byte.
const ECRECOVER_V_27_LAST_ELEMENT = 0x1B000000
const ECRECOVER_V_28_LAST_ELEMENT = 0x1C000000

# ENCODING CONVENTIONS
# ================================================================================================
#
# - Native secp256k1 values are stored as little-endian numeric u32 limbs, one limb per Felt.
# - The public-key commitment is `Poseidon2::hash_elements(QX[8] || QY[8])` over the native
#   coordinate limbs in advice/memory order.
# - MSG_WORD is a word whose four felts are split into eight little-endian u32 limbs before Keccak256.
# - Variable-length messages are stored as packed little-endian u32 limbs in word-aligned memory.

# PROCEDURES
# ================================================================================================

#! Verifies a secp256k1 ECDSA witness using the `miden-crypto::ecdsa_k256_keccak` message,
#! public-key commitment, and signature-scalar conventions, encoded in the native limb ABI below.
#! Acceptance intentionally differs from the Rust verifier: high-s witnesses are accepted.
#!
#! Inputs:
#!   Operand stack: [PK_COMM, MSG_WORD, ...]
#!   Advice stack:  [QX[8] | QY[8] | SIG_R[8] | SIG_S[8] | ...]
#! Outputs:
#!   Operand stack: [...]
#!   Advice stack:  [...]
#!
#! Where:
#! - `PK_COMM`: Poseidon2 hash commitment of `QX[8] || QY[8]`, where coordinates are native
#!   little-endian numeric u32 limbs, one limb per Felt.
#! - `MSG_WORD`: single word / 4 felts representing the 32-byte message to verify.
#! - `QX[8]`, `QY[8]`: native public-key coordinates as little-endian u32 limbs.
#! - `SIG_R[8]`, `SIG_S[8]`: native signature scalars as little-endian u32 limbs.
#!
#! Local memory layout (element addresses):
#!   - loc[0 ..16] : native public key, QX[8] || QY[8].
#!   - loc[16..24] : Keccak256 message/digest scratch buffer.
#!
#! No result word is pushed. The procedure traps on malformed native limbs, invalid/off-curve public
#! keys, invalid signature scalars, or failed signature verification.
#!
#! Low-s is intentionally not enforced: this procedure proves that some untrusted advice satisfies
#! the ECDSA equation, and `(r, s)` and `(r, n - s)` are equivalent witnesses. An adaptation that
#! verifies a committed or canonical Ethereum signature must bind the exact signature encoding inside
#! the VM and enforce low-s on that bound value.
#!
#! Advice is untrusted. This procedure binds QX/QY to `PK_COMM`, and validates the public key,
#! reduced Keccak prehash, and signature scalars through precompile-backed deferred evaluation.
#!
#! Invocation: exec
@locals(24)
pub proc verify
    # load QX || QY from advice into the verifier public-key buffer while absorbing the same
    # two chunks into the Poseidon2 `hash_elements` state. Since there are exactly 16 elements,
    # the `hash_elements` capacity word is zero and no partial-block padding is required.
    # `adv_pipe` exposes each just-written chunk in the rate slots in the same order that
    # `mem_stream` would read it back from memory.
    locaddr.0 padw padw padw
    # => [R0=0w, R1=0w, C=0w, write_ptr=loc[0], PK_COMM, MSG_WORD, ...]
    adv_pipe
    # => [QX_RATE[8], C=0w, write_ptr=loc[8], PK_COMM, MSG_WORD, ...]
    hperm
    # => [R0, R1, C, write_ptr=loc[8], PK_COMM, MSG_WORD, ...]
    adv_pipe
    # => [QY_RATE[8], C, write_ptr=loc[16], PK_COMM, MSG_WORD, ...]
    hperm
    # => [R0, R1, C, write_ptr=loc[16], PK_COMM, MSG_WORD, ...]
    # assert Poseidon2::hash_elements(QX[8] || QY[8]) == PK_COMM.
    exec.poseidon2::squeeze_digest
    # => [PK_HASH, write_ptr=loc[16], PK_COMM, MSG_WORD, ...]
    movup.4 movdn.8
    # => [PK_HASH, PK_COMM, write_ptr=loc[16], MSG_WORD, ...]
    assert_eqw.err="invalid public key commitment"
    # => [write_ptr=loc[16], MSG_WORD, ...]

    movdn.4
    # => [MSG_WORD, digest_ptr=loc[16], ...]

    # stage MSG_WORD[32] in loc[16..24], hash it in-place via the memory-oriented Keccak precompile,
    # then convert the digest bytes into the native little-endian scalar limbs used as ECDSA z.
    exec.store_word_u32s_le
    # => [digest_ptr, ...]  (MSG_U32[8] written to loc[16..24])

    dup dup push.32 swap
    # => [in_ptr=loc[16], len_bytes=32, out_ptr=loc[16], digest_ptr=loc[16], ...]
    exec.keccak256::hash_1_chunk_mem
    # => [digest_ptr=loc[16], ...]  (DIGEST_U32[8] written to loc[16..24])

    dup sub.16 swap
    # => [read_ptr=loc[16], pubkey_ptr=loc[0], ...]
    repeat.8
        dup mem_load
        exec.reverse_u32_bytes
        swap add.1
    end
    # => [read_ptr=loc[24], PREHASH_U32[8], pubkey_ptr, ...]
    drop
    # => [PREHASH_U32[8], pubkey_ptr, ...] where PREHASH[0] = byte_reverse(KeccakDigest[7])

    exec.verify_digest_impl
    # => [...]
end

#! Verifies a secp256k1 ECDSA witness over a variable-length message stored as bytes in memory.
#!
#! Inputs:
#!   Operand stack: [PK_COMM, MSG_PTR, MSG_LEN_BYTES, ...]
#!   Advice stack:  [QX[8] | QY[8] | SIG_R[8] | SIG_S[8] | ...]
#! Outputs:
#!   Operand stack: [...]
#!   Advice stack:  [...]
#!
#! Where:
#! - `PK_COMM`: Poseidon2 hash commitment of `QX[8] || QY[8]`, where coordinates are native
#!   little-endian numeric u32 limbs, one limb per Felt.
#! - `MSG_PTR`: word-aligned address containing the message as packed little-endian u32 limbs.
#! - `MSG_LEN_BYTES`: number of message bytes to hash. Unused bytes in the final u32 and remaining felts
#!   in the final 32-byte chunk must be zero.
#! - `QX[8]`, `QY[8]`: native public-key coordinates as little-endian u32 limbs.
#! - `SIG_R[8]`, `SIG_S[8]`: native signature scalars as little-endian u32 limbs.
#!
#! No result word is pushed. The procedure traps if:
#! - `MSG_PTR` is not word-aligned.
#! - `MSG_LEN_BYTES` exceeds the configured `max_hash_len_bytes` execution limit.
#! - a message-memory felt is not a valid u32.
#! - unused message bytes or felts in the final 32-byte chunk are nonzero.
#! - public-key or signature limbs are malformed, the public key is invalid/off-curve, the signature
#!   scalars are invalid, or signature verification fails.
#!
#! Advice is untrusted. This procedure binds QX/QY to `PK_COMM`, hashes the specified memory range,
#! and validates the reduced Keccak prehash and signature scalars through precompile-backed deferred
#! evaluation.
#!
#! Invocation: exec
@locals(24)
pub proc verify_bytes
    locaddr.0
    # => [pubkey_ptr=loc[0], PK_COMM, MSG_PTR, MSG_LEN_BYTES, ...]
    exec.load_and_verify_public_key
    # => [out_ptr=loc[16], MSG_PTR, MSG_LEN_BYTES, ...]

    movdn.2
    # => [MSG_PTR, MSG_LEN_BYTES, out_ptr=loc[16], ...]
    exec.keccak256::hash_bytes_mem
    # => [...]

    locaddr.16
    # => [digest_ptr=loc[16], ...]  (DIGEST_U32[8] written to loc[16..24])
    exec.load_keccak_digest_as_z
    # => [PREHASH_U32[8], pubkey_ptr=loc[0], ...]
    exec.verify_digest_impl
    # => [...]
end

#! Recovers an Ethereum address from a secp256k1 signature and message hash.
#!
#! Input:  [INPUT_PTR, ...]
#! Output: [ADDRESS_U32[8], ...]
#!
#! `INPUT_PTR` must be word-aligned and point to the standard 128-byte ECRECOVER input, packed into
#! little-endian u32 memory elements:
#!
#!     HASH[32] || V[32] || R[32] || S[32]
#!
#! The four fields use Ethereum's big-endian encoding. `V` must encode 27 or 28, and `R` and `S`
#! must be nonzero canonical secp256k1 scalars. High-s signatures are accepted.
#!
#! The result is the packed little-endian u32 form of
#! `0[12] || Keccak256(QX_BE || QY_BE)[12..]`.
#!
#! Invalid input traps instead of returning the EVM precompile's empty failure output. The recovered
#! key is untrusted advice; deferred curve and Keccak checks bind it to the input and result.
#!
#! Invocation: exec
# loc: native Q[0..16] for the curve wrapper; serialized QX_BE || QY_BE[16..32] for the address
# hash; the Keccak digest lands on [0..8] over the spent QX limbs.
@locals(32)
pub proc ecrecover
    # Memory-backed precompile wrappers require word alignment.
    dup u32mod.4 assertz.err="ECRECOVER input pointer must be word-aligned"

    # Require V to be the 32-byte big-endian encoding of 27 or 28: the leading seven elements
    # must be zero and the last element must be one of the two packed encodings. The v = 28
    # comparison bit is the recovery parity, kept below the pointer.
    padw dup.4 add.8 mem_loadw_le
    repeat.4
        assertz.err="ECRECOVER v must be 27 or 28"
    end
    padw dup.4 add.12 mem_loadw_le
    repeat.3
        assertz.err="ECRECOVER v must be 27 or 28"
    end
    # => [v_element, input_ptr, ...]
    dup eq.ECRECOVER_V_28_LAST_ELEMENT
    swap eq.ECRECOVER_V_27_LAST_ELEMENT
    dup.1 or assert.err="ECRECOVER v must be 27 or 28"
    swap
    # => [input_ptr, recovery_parity, ...]

    # Convert r and s to native limbs on the stack and register them as scalar VALUE digests,
    # the same stack-resident registration the verifiers use for advice scalars.
    dup add.16 exec.load_be_u256_mem
    exec.k1_scalar::load movup.4
    # => [input_ptr, SIG_R, recovery_parity, ...]
    dup add.24 exec.load_be_u256_mem
    exec.k1_scalar::load movup.4
    # => [input_ptr, SIG_S, SIG_R, recovery_parity, ...]

    # The host supplies Q as advice; the deferred checks below bind it to the input.
    emit.ECRECOVER_EVENT
    # => [input_ptr, SIG_S, SIG_R, recovery_parity, ...]

    # Stream QX || QY into loc[0..16] for the curve wrapper. `adv_pipe` exposes each just-written
    # chunk in the rate slots, so serialize that copy as QX_BE || QY_BE into loc[16..32] for the
    # address hash instead of re-reading memory. No hperm runs, so the state words are scratch:
    # `mem_storew_le` leaves each stored word in place as the next pipe's rate input.
    locaddr.0 padw padw padw
    adv_pipe
    # => [QX_RATE[8], C, write_ptr=loc[8], input_ptr, ...]
    exec.reverse_u256_bytes
    locaddr.16 mem_storew_le
    swapw
    locaddr.20 mem_storew_le
    # => [SCRATCH[8], C, write_ptr=loc[8], input_ptr, ...]
    adv_pipe
    # => [QY_RATE[8], C, write_ptr=loc[16], input_ptr, ...]
    exec.reverse_u256_bytes
    locaddr.24 mem_storew_le
    swapw
    locaddr.28 mem_storew_le
    dropw dropw dropw drop
    # => [input_ptr, SIG_S, SIG_R, recovery_parity, ...]

    # Check that R = (z/s)G + (r/s)Q has the requested x-coordinate and parity.
    locaddr.0 swap
    # => [input_ptr, pubkey_ptr=loc[0], SIG_S, SIG_R, recovery_parity, ...]
    exec.load_be_u256_mem
    # => [Z_U32[8], pubkey_ptr, SIG_S, SIG_R, recovery_parity, ...]
    exec.prepare_recover_inputs
    # => [U1, Q, U2, SIG_R, recovery_parity, ...]
    exec.recover_point_2base
    # => [RECOVERY_POINT, SIG_R, recovery_parity, ...]
    exec.assert_recovery_point
    # => [...]

    # Hash the serialized key.
    locaddr.0 push.64 locaddr.16
    # => [in_ptr=loc[16], len_bytes=64, out_ptr=loc[0], ...]
    exec.keccak256::hash_2_chunks_mem
    # => [...]  (DIGEST_U32[8] written to loc[0..8] over the spent QX limbs)

    # Return 0[12] || digest[12..32] in packed-u32 byte order.
    padw loc_loadw_le.4
    loc_load.3
    push.0.0.0
    # => [ADDRESS_U32[8], ...]
end

# INTERNAL PROCEDURES — ECDSA
# ================================================================================================

#! Loads QX || QY from advice, binds it to PK_COMM, and returns the end of the public-key buffer.
#!
#! Input:  [pubkey_ptr, PK_COMM, ...]
#! Advice: [QX[8] | QY[8] | ...]
#! Output: [pubkey_ptr + 16, ...]
proc load_and_verify_public_key
    # Since there are exactly 16 elements, `hash_elements` has a zero capacity word and requires no
    # partial-block padding. `adv_pipe` exposes each written chunk in the rate slots in the same
    # order that `mem_stream` would read it back from memory.
    padw padw padw
    # => [R0=0w, R1=0w, C=0w, write_ptr=pubkey_ptr, PK_COMM, ...]
    adv_pipe
    # => [QX_RATE[8], C=0w, write_ptr=pubkey_ptr+8, PK_COMM, ...]
    hperm
    # => [R0, R1, C, write_ptr=pubkey_ptr+8, PK_COMM, ...]
    adv_pipe
    # => [QY_RATE[8], C, write_ptr=pubkey_ptr+16, PK_COMM, ...]
    hperm
    # => [R0, R1, C, write_ptr=pubkey_ptr+16, PK_COMM, ...]
    exec.poseidon2::squeeze_digest
    # => [PK_HASH, write_ptr=pubkey_ptr+16, PK_COMM, ...]
    movup.4 movdn.8
    # => [PK_HASH, PK_COMM, write_ptr=pubkey_ptr+16, ...]
    assert_eqw.err="invalid public key commitment"
    # => [pubkey_ptr+16, ...]
end

#! Converts a packed Keccak256 digest in the local scratch buffer to native scalar limbs.
#!
#! Input:  [digest_ptr, ...]
#! Output: [PREHASH_U32[8], pubkey_ptr, ...]
#!
#! Preconditions:
#! - digest_ptr = pubkey_ptr + 16 and points to DIGEST_U32[8] packed little-endian u32 limbs.
proc load_keccak_digest_as_z
    repeat.8
        dup mem_load
        exec.reverse_u32_bytes
        swap add.1
    end
    # => [read_ptr=digest_ptr+8, PREHASH_U32[8], ...]
    sub.24 movdn.8
    # => [PREHASH_U32[8], pubkey_ptr, ...] where PREHASH[0] = byte_reverse(KeccakDigest[7])
end

#! Computes `R = u1*G + u2*Q` as a plain 2-base joint wNAF MSM, folding the degenerate `Q == G`
#! case into a single `(u1+u2)*G` multiply, the one collision a 2-base MSM has.
#!
#! Input:  [U1, Q, U2, ...]
#! Output: [VERIFY_POINT, ...]
proc verify_point_2base
    dupw.1
    # => [Q, U1, Q, U2, ...]
    exec.secp256k1::push_generator
    # => [G, Q, U1, Q, U2, ...]
    exec.word::eq
    # => [is_q_generator, U1, Q, U2, ...]
    if.true
        movupw.2 swapw
        # => [U1, U2, Q, ...]
        exec.k1_scalar::add
        # => [U1_PLUS_U2, Q, ...]
        swapw dropw
        # => [U1_PLUS_U2, ...]
        exec.secp256k1::mul_scalar_generator
    else
        exec.secp256k1::push_generator
        # => [G, U1, Q, U2, ...]
        exec.secp256k1::msm2
    end
    # => [VERIFY_POINT, ...]
end

#! Computes `u1*G + u2*Q`. The deferred MSM requires nonzero scalars, so `u1 = 0` uses a single
#! scalar multiplication.
#!
#! Input:  [U1, Q, U2, ...]
#! Output: [RECOVERY_POINT, ...]
proc recover_point_2base
    dupw
    exec.k1_scalar::is_zero
    # => [is_u1_zero, U1, Q, U2, ...]
    if.true
        dropw
        # => [Q, U2, ...]
        exec.secp256k1::mul_scalar
    else
        exec.verify_point_2base
    end
    # => [RECOVERY_POINT, ...]
end

#! Completes ECDSA verification after the Keccak digest has been converted to native scalar limbs.
#!
#! Input:  [Z_U32[8], pubkey_ptr, ...]
#! Advice: [SIG_R[8] | SIG_S[8] | ...]
#! Output: [...]
proc verify_digest_impl
    exec.prepare_verify_inputs
    # => [U1, Q, U2, SIG_R, ...]
    exec.verify_point_2base
    # => [VERIFY_POINT, SIG_R, ...]
    exec.assert_x_eq_scalar_k1
    # => [...]
end

#! Computes ECDSA scalars U1 = z/s and U2 = r/s, keeping SIG_R for the final check.
#!
#! Input:  [Z_U32[8], pubkey_ptr, ...]
#! Advice: [SIG_R[8] | SIG_S[8] | ...]
#! Output: [U1_DIGEST, Q_DIGEST, U2_DIGEST, SIG_R_DIGEST, ...]
#!
#! Preconditions/provenance:
#! - Z_U32[8] is the Keccak256 message digest converted to little-endian scalar limbs;
#! - pubkey_ptr points to QX[8] || QY[8], already bound to PK_COMM by a public verifier;
#! - SIG_R/S advice is untrusted and loaded as canonical scalars by `load_signature_k1`.
proc prepare_verify_inputs
    exec.k1_scalar::load_reduced_256
    # => [Z, pubkey_ptr, ...]

    movup.4
    # => [pubkey_ptr, Z, ...]
    exec.secp256k1::load_mem
    # => [Q, Z, ...]
    swapw
    # => [Z, Q, ...]

    exec.load_signature_k1
    # => [SIG_S, SIG_R, Z, Q, ...]
    exec.compute_ecdsa_scalars
    # => [U1, Q, U2, SIG_R, ...]
end

#! Loads Q from memory, takes r and s as already-registered scalar digests, and computes
#! U1 = z/s and U2 = r/s.
#!
#! Input:  [Z_U32[8], pubkey_ptr, SIG_S_DIGEST, SIG_R_DIGEST, ...]
#! Output: [U1_DIGEST, Q_DIGEST, U2_DIGEST, SIG_R_DIGEST, ...]
#!
#! `pubkey_ptr[0..16]` holds the native QX[8] || QY[8].
proc prepare_recover_inputs
    exec.k1_scalar::load_reduced_256
    # => [Z, pubkey_ptr, SIG_S, SIG_R, ...]

    movup.4
    exec.secp256k1::load_mem
    # => [Q, Z, SIG_S, SIG_R, ...]
    swapw swapdw
    # => [SIG_S, SIG_R, Z, Q, ...]

    exec.compute_ecdsa_scalars
    # => [U1, Q, U2, SIG_R, ...]
end

#! Checks r and s, then computes U1 = z/s and U2 = r/s.
#!
#! Input:  [SIG_S, SIG_R, Z, Q, ...]
#! Output: [U1, Q, U2, SIG_R, ...]
proc compute_ecdsa_scalars
    # Inversion rejects s = 0; check r explicitly.
    dupw.1
    exec.k1_scalar::push_zero_digest
    exec.word::eq
    assertz.err="invalid ECDSA signature: r is zero"
    # => [SIG_S, SIG_R, Z, Q, ...]

    exec.k1_scalar::inv
    # => [S_INV, SIG_R, Z, Q, ...]

    dupw
    movupw.3
    exec.k1_scalar::mul
    # => [U1 = Z*S_INV, S_INV, SIG_R, Q, ...]

    dupw.1
    dupw.3
    exec.k1_scalar::mul
    # => [U2 = SIG_R*S_INV, U1, S_INV, SIG_R, Q, ...]

    swapw.2 dropw
    # => [U1, U2, SIG_R, Q, ...]
    movupw.3 swapw
    # => [U1, Q, U2, SIG_R, ...]
end

#! Loads SIG_R and SIG_S from advice as k1 scalar VALUE digests and returns SIG_S on top.
#!
#! Advice: [SIG_R[8] | SIG_S[8] | ...]
#! Output: [SIG_S_SCALAR_VALUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
proc load_signature_k1
    exec.load_scalar_k1_from_advice
    # => [SIG_R, ...]

    exec.load_scalar_k1_from_advice
    # => [SIG_S, SIG_R, ...]
end

#! Loads one canonical k1 scalar from advice.
#!
#! Advice: [VALUE_LO_U32[4] | VALUE_HI_U32[4] | ...]
#! Output: [VALUE_SCALAR_DIGEST, ...]
proc load_scalar_k1_from_advice
    adv_pushw
    # => [VALUE_LO_U32[4], ...]
    adv_pushw
    # => [VALUE_HI_U32[4], VALUE_LO_U32[4], ...]
    swapw
    # => [VALUE_LO_U32[4], VALUE_HI_U32[4], ...]
    exec.k1_scalar::load
    # => [VALUE_SCALAR_DIGEST, ...]
end

#! Evaluates VERIFY_POINT once, rejects the identity, reduces x(VERIFY_POINT) modulo n, and
#! compares the resulting scalar-field expression against SIG_R.
#!
#! Input:  [VERIFY_POINT_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
#! Output: [...]
#!
#! Preconditions/provenance:
#! - SIG_R_SCALAR_VALUE_DIGEST is a canonical k1 scalar VALUE digest, e.g. from load_signature_k1;
#! - secp256k1::eval binds VERIFY_POINT_DIGEST to the returned canonical curve VALUE payload;
#! - after identity rejection succeeds, X_OR_TRUE_DIGEST/Y_OR_TRUE_DIGEST are real coordinate digests.
proc assert_x_eq_scalar_k1
    exec.secp256k1::eval
    # => [VERIFY_POINT_VALUE_DIGEST, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]

    # Reject identity at the curve VALUE-digest level. `eval` returns the canonical VALUE digest
    # alongside the coordinate payload, so direct comparison to the registered identity VALUE digest
    # is sound and avoids a second curve evaluation.
    exec.secp256k1::push_identity
    # => [IDENTITY_VALUE_DIGEST, VERIFY_POINT_VALUE_DIGEST, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
    exec.word::eq
    # => [is_identity, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
    assertz.err="invalid ECDSA verification point: identity"
    # => [X_DIGEST, Y_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]
    swapw dropw
    # => [X_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]

    # X_DIGEST is a canonical k1-base VALUE child of the proof-bound curve VALUE above. Open that
    # commitment directly; ordinary `eval` remains necessary for arbitrary expression digests.
    exec.k1_base::open_value
    # => [X_U32[8], SIG_R_SCALAR_VALUE_DIGEST, ...]
    exec.k1_scalar::load_reduced_256
    # => [X_SCALAR_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, ...]

    swapw
    # => [SIG_R_SCALAR_VALUE_DIGEST, X_SCALAR_DIGEST, ...]
    exec.k1_scalar::is_eq_digest
    # => [x_matches_sig_r, ...]
    assert.err="ECDSA verification failed: x(VERIFY_POINT) != SIG_R"
    # => [...]
end

#! Rejects identity and checks x(R) = r and parity(y(R)) = recovery_parity. The x-coordinate is
#! compared exactly: recovery IDs 27 and 28 do not select the x = r + n branches.
#!
#! Input:  [RECOVERY_POINT_DIGEST, SIG_R_SCALAR_VALUE_DIGEST, recovery_parity, ...]
#! Output: [...]
proc assert_recovery_point
    exec.secp256k1::eval
    # => [POINT_VALUE_DIGEST, X_OR_TRUE_DIGEST, Y_OR_TRUE_DIGEST, SIG_R, recovery_parity, ...]
    exec.secp256k1::push_identity
    exec.word::eq
    assertz.err="invalid ECRECOVER recovery point: identity"
    # => [X_DIGEST, Y_DIGEST, SIG_R, recovery_parity, ...]

    # Compare y parity with v - 27.
    swapw
    movup.12 movdn.4
    # => [Y_DIGEST, recovery_parity, X_DIGEST, SIG_R, ...]
    exec.k1_base::open_value
    # => [Y_U32[8], recovery_parity, X_DIGEST, SIG_R, ...]
    push.1 u32and
    movup.8 assert_eq.err="ECRECOVER recovery point has the wrong y parity"
    repeat.7 drop end
    # => [X_DIGEST, SIG_R, ...]

    # Compare x and r directly, without reducing x modulo n.
    exec.k1_base::open_value
    # => [X_U32[8], SIG_R, ...]
    movupw.2
    exec.k1_scalar::open_value
    # => [R_U32[8], X_U32[8], ...]
    movupw.2
    exec.word::eq
    # => [lo_equal, R_HI, X_HI, ...]
    movdn.8
    exec.word::eq
    and assert.err="ECRECOVER recovery point x-coordinate does not equal r"
    # => [...]
end

# INTERNAL PROCEDURES — BYTE OPS
# ================================================================================================

#! Stores a word as the eight little-endian u32 limbs used as the 32-byte Keccak message.
#!
#! Input:  [w0, w1, w2, w3, ptr, ...]
#! Output: [ptr, ...]
proc store_word_u32s_le
    swap u32split
    # => [w1_lo, w1_hi, w0, w2, w3, ptr, ...]
    movup.2 u32split
    # => [w0_lo, w0_hi, w1_lo, w1_hi, w2, w3, ptr, ...]
    dup.6 mem_storew_le dropw
    # => [w2, w3, ptr, ...]  (ptr[0..4] = [w0_lo, w0_hi, w1_lo, w1_hi])

    swap u32split
    # => [w3_lo, w3_hi, w2, ptr, ...]
    movup.2 u32split
    # => [w2_lo, w2_hi, w3_lo, w3_hi, ptr, ...]
    dup.4 add.4 mem_storew_le dropw
    # => [ptr, ...]  (ptr[4..8] = [w2_lo, w2_hi, w3_lo, w3_hi])
end

#! Reverses the byte order of a u32 limb.
#!
#! Input:  [x, ...]
#! Output: [byte_reverse(x), ...]
proc reverse_u32_bytes
    dup u32shr.8 push.0x00FF00FF u32and
    # => [(x >> 8) & 0x00ff00ff, x, ...]
    swap push.0x00FF00FF u32and mul.256
    # => [(x & 0x00ff00ff) << 8, shifted, ...]
    u32xor
    # => [x with adjacent bytes swapped, ...]

    dup u32shr.16
    # => [x >> 16, x, ...]
    swap u32shl.16
    # => [(x << 16) mod 2^32, x >> 16, ...]
    u32xor
    # => [byte_reverse(x), ...]
end

#! Reverses the 32 bytes of a u256 held as eight packed u32 limbs on the stack. This converts
#! between packed big-endian bytes and native little-endian numeric limbs in either direction.
#!
#! Input:  [PACKED_U32[8], ...]
#! Output: [REVERSED_U32[8], ...]
proc reverse_u256_bytes
    reversedw
    repeat.8
        exec.reverse_u32_bytes movdn.7
    end
end

#! Loads a packed 32-byte big-endian integer from memory as native little-endian u32 limbs.
#!
#! Input:  [source_ptr, ...]
#! Output: [VALUE_U32[8], ...]
#!
#! `source_ptr` must be word-aligned. The least-significant limb is on top.
proc load_be_u256_mem
    padw dup.4 add.4 mem_loadw_le
    # => [PACKED_BE_HI_U32[4], source_ptr, ...]
    padw movup.8 mem_loadw_le
    # => [PACKED_BE_U32[8], ...]
    exec.reverse_u256_bytes
    # => [VALUE_U32[8], ...]
end
