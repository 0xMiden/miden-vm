use miden::core::crypto::hashes::eidos

# CONSTANTS
# =================================================================================================

const M = 12289
const M_HALF = 6144 # (M-1) / 2
const M_DOUBLE = 24578
const M_SQUARE = 151019521
const TWO_POW_32_MOD_M = 10952
const J_PLUS_M_HALF = 77322000896 # 512 * M^2 + M_HALF
const NEG_M_HALF = 18446744069414578177 # -M_HALF as a field element, i.e., Q - M_HALF
const SQUARE_NORM_BOUND = 34034726
const FALCON_DIV_EVENT = event("miden::core::crypto::dsa::falcon512_eidos::falcon_div")

# Eidos chaining word for the registered Falcon hash-to-point domain and an empty framed prefix.
const FALCON_H2P_INIT_CV = [
    4280581857092830210,
    2688637132020383744,
    1947077364412317696,
    6620516959492505600
]
# Eidos chaining word for the registered 512-Felt Falcon public-key commitment.
const FALCON_PUBLIC_KEY_INIT_CV = [
    4280581857092830465,
    2688637132020384256,
    1947077364412317696,
    6620516959492505600
]
# Eidos chaining word for the VM-registered 1,544-Felt Falcon product-check transcript.
const FALCON_PRODUCT_INIT_CV = [
    4280581857109608962,
    2688637132020385288,
    1947077364412317696,
    6620516959492505600
]

# MODULAR REDUCTION FALCON PRIME
# =============================================================================================

#! Falcon coefficient reduced modulo 12289.
pub type Coefficient = u16
#! In memory each reduced coefficient occupies a full felt, rather than a packed u16.
#! Use this for coefficient buffers; scalar stack arguments use Coefficient.
pub type StoredCoefficient = struct @align(4) { value: Coefficient }
#! Forty-byte Falcon nonce encoded as eight field elements in byte order.
#! Each felt holds five little-endian bytes; lo holds bytes 0..20 and hi holds bytes 20..40.
pub type Nonce = struct { lo: word, hi: word }
#! Coefficient of the signed integer convolution, represented in the Miden field.
pub type ProductCoefficient = felt
#! Squared polynomial norm, represented in one felt (may exceed u32).
pub type SquaredNorm = felt

#! Reduces a 64-bit dividend modulo M = 12289 using the `falcon_div` advice event.
#! The caller must ensure that both input limbs are u32; this procedure checks the
#! event's quotient and remainder. `verify` uses the VM divider directly.
#!
#! Input: [a_lo, a_hi, ...]
#! Output: [a mod M, ...]
pub proc mod_12289(value: u64) -> Coefficient
    emit.FALCON_DIV_EVENT
    # Advice stack: [qhi, qlo, r, ...], where q = qhi * 2^32 + qlo is the quotient.

    adv_push adv_push
    u32assert2
    # => [qlo, qhi, a_lo, a_hi, ...]

    push.M
    u32widening_mul swap
    # => [overflow, M * qlo % 2^32, qhi, a_lo, a_hi, ...]

    movup.2
    push.M
    # => [M, qhi, overflow, M * qlo % 2^32, a_lo, a_hi, ...]
    u32widening_madd swap
    # => [t1, t0, M * qlo % 2^32, a_lo, a_hi, ...]
    # Here t = t1 * 2^32 + t0 = M * qhi + overflow. A valid quotient requires t1 = 0.
    assertz.err="comparison failed: quotient overflow"
    # => [res_hi, res_lo, a_lo, a_hi, ...], the two limbs of M * q

    adv_push
    # Advice values are untrusted. U32SUB/U32ADD only constrain their output limbs in the AIR,
    # so we must validate the remainder before feeding it into u32 arithmetic.
    dup u32assert2
    push.M
    u32overflowing_sub
    # => [borrow, diff, r, res_hi, res_lo, a_lo, a_hi, ...]
    # borrow = 1 when r < M (underflow). Assert borrow != 0, then drop diff.
    assert.err="comparison failed: modulus" drop
    # => [r, res_hi, res_lo, a_lo, a_hi, ...]

    dup
    movup.3
    u32overflowing_add
    # => [carry, (res_lo + r) % 2^32, r, res_hi, a_lo, a_hi, ...]

    movup.3
    u32overflowing_add
    # => [overflow, final_res_hi, final_res_lo, r, a_lo, a_hi, ...]
    assertz.err="comparison failed: addition overflow"
    # => [final_res_hi, final_res_lo, r, a_lo, a_hi, ...]

    movup.4
    assert_eq
    movup.2
    assert_eq
    # => [r, ...]
end

# HASH-TO-POINT
# =============================================================================================

# Derives the fixed expansion seed by absorbing the nonce and message under the Falcon domain.
# Input: [MSG(4), NONCE(8), ...]
# Output: [SEED(4), ...]
proc init_hash_to_point(message: word, nonce: Nonce) -> eidos::ChainingValue
    movdnw.2
    push.FALCON_H2P_INIT_CV movdnw.2
    # => [NONCE(8), CV(4), MSG(4), ...]
    exec.eidos::compress

    dropw dropw
    swapw padw swapw
    # => [MSG(4), 0(4), CV(4), ...]
    exec.eidos::compress
    dropw dropw
end

#! Computes the squared norm of s1 = c - pi in Z_M[x]/(x^512 + 1), generating the hash-to-point
#! coefficients c from the message and nonce as they are needed.
#! Generated coefficients are consumed on the stack without being stored in memory.
#!
#! The word-aligned pi_ptr points to 1024 coefficients of the signed integer product pi = h * s2,
#! represented in the Miden field. Each product coefficient pi_i must satisfy
#! |pi_i| <= 512 * (M - 1) * M_HALF, since h_j is in [0, M) and centered s2_j is in
#! [-M_HALF, M_HALF]. The caller must establish these input ranges and the product identity;
#! `verify` uses `load_h_s2_and_product` to check the ranges and probabilistically check the
#! product identity.
#!
#! A fixed Eidos seed is derived from the eight-Felt nonce and the zero-padded message word.
#! Each counter from 0 through 127 occupies the first element of an otherwise zero block;
#! compressing that block under the seed emits four 63-bit samples in word order.
#! Direct modular reduction replaces rejection sampling as described on page 31 of
#! https://falcon-sign.info/falcon.pdf, with 63-bit samples here.
#!
#! For each i, the unreduced coefficient of s1 is c_i + pi_{i+512} - pi_i. Under the product
#! bound, adding J + M_HALF, where J = 512 * M^2, makes the product term positive and below 2J.
#! The reduction returns r = (s1_i + M_HALF) mod M in [0, M), so r - M_HALF is the centered
#! s1 coefficient in [-M_HALF, M_HALF] whose square contributes to the returned norm.
#! `verify` adds the squared norm of s2 and checks ||s1||^2 + ||s2||^2 < SQUARE_NORM_BOUND.
#!
#! Input: [pi_ptr, MSG(4), NONCE(8), ...]
#! Output: [norm_sq(s1), ...]
#!
pub proc hash_to_point_s1_norm_sq(
    pi_ptr: ptr<ProductCoefficient>,
    message: word,
    nonce: Nonce,
) -> SquaredNorm
    movdn.12
    exec.init_hash_to_point
    push.0.0.0 movup.7 swap
    # => [acc, pi_ptr, counter, 0, SEED(4), ...]

    repeat.128
        # The four control slots keep SEED word-aligned and pi_ptr at native dup.13 depth.
        dupw.1 padw push.0.0.0 dup.13
        # => [counter, 0(7), SEED(4), acc, pi_ptr, counter, 0, SEED(4), ...]
        exec.eidos::compress

        # Reuse the block slots for the two product words.
        dup.13 mem_loadw_le
        swapw
        dup.13 add.512 mem_loadw_le
        # => [PI_HI(4), PI_LO(4), C(4), acc, pi_ptr, counter, 0, SEED(4), ...]

        exec.s1_norm_sq_word
        add swap add.4 swap
        movup.2 add.1 movdn.2
        # => [acc + norm, pi_ptr + 4, counter + 1, 0, SEED(4), ...]
    end
    movdn.7 dropw drop drop drop
end


# PROBABILISTIC POLYNOMIAL MULTIPLICATION IN Z_Q[x]
# =============================================================================================

#! Loads the expanded public key h, shifted signature s2', and claimed product pi from
#! advice into consecutive memory regions starting at `ptr`. It checks that h hashes to
#! `public_key`, that h and s2' have coefficients in [0, M), and that pi = h * s2
#! at a Fiat-Shamir point in the quadratic extension of the Miden field.
#!
#! Here s2'_i = s2_i + M_HALF, with centered s2_i in [-M_HALF, M_HALF], and
#! pi is the product with centered s2. The evaluation point is supplied on advice
#! to permit evaluation while hashing; the procedure checks it against the digest
#! of the public-key commitment, s2', and pi. The identity check is probabilistic.
#! For a true polynomial product, each pi coefficient represents a signed convolution
#! value with absolute value at most 512 * (M - 1) * M_HALF.
#!
#! Inputs:
#!   Operand stack: [ptr, PK, ...]
#!   Advice stack:  [tau1, tau0, h_0, ..., h_511, s2'_0, ..., s2'_511, pi_0, ..., pi_1023, ...]
#! Outputs:
#!   Operand stack: [...]
#!   Advice stack:  [...]
#!
@locals(12)
pub proc load_h_s2_and_product(ptr: ptr<felt>, public_key: eidos::Digest)
    # Local addresses:
    # 1. 0..4 the public key,
    # 2. 4..8 the inverse evaluation point as [tau_inv0, tau_inv1, 0, 0],
    # 3. 8..12 the evaluation point as [tau0, tau1, 0, 0].

    # 1) Set up the stack for loading the coefficients of the polynomials, evaluating and hashing them

    ## a) Set up the accumulator for `horner_eval_base` and the memory pointers
    push.0.0
    locaddr.4
    movup.3
    # => [ptr, tau_inv_ptr, 0, 0, PK, ...]

    ## b) Save PK to later compare it with the hash of the h polynomial
    swapw
    loc_storew_le.0
    # => [PK, ptr, tau_inv_ptr, acc0, acc1, ...]

    ## c) Prepare the public-key commitment state.
    dropw
    push.FALCON_PUBLIC_KEY_INIT_CV
    padw
    # => [Y, C, ptr, tau_inv_ptr, acc0, acc1, ...], where Y is a "garbage" word

    ## d) Load the evaluation point tau from the advice tape, compute its inverse and save both
    ## The coefficients are loaded constant-first, i.e. not in the reversed order Horner evaluation
    ## expects, so with multiplier `tau_inv = tau^{-1}` the accumulator for a polynomial f with n
    ## coefficients is
    ##
    ## A_f := sum_k f_k * tau_inv^{n-1-k} = tau^{-(n-1)} * f(tau)
    ##
    ## With n = 512 for h and s2 and
    ## n = 1024 for pi, the product relation pi = h * s2 gives
    ##
    ## A_h * A_s2 = tau^{-1022} * pi(tau) = A_pi * tau
    ##
    ## which is the equality checked below.
    push.0.0
    adv_push adv_push
    # => [tau0, tau1, 0, 0, ...]
    loc_storew_le.8
    ext2inv
    loc_storew_le.4
    # => [tau_inv0, tau_inv1, 0, 0, Y, C, ptr, tau_inv_ptr, acc0, acc1, ...]

    # 2) Load h and accumulate its reversed evaluation at tau_inv
    repeat.64
        adv_pipe

        # check that all coefficients are less than Falcon prime
        # Assert borrow != 0 (r < M), then drop diff
        dupw.1
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop

        dupw
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop

        horner_eval_base

        exec.eidos::compress
    end
    # => [Y0, Y1, C, ptr, tau_inv_ptr, acc0, acc1, ...] where C is the digest expected to be PK

    # 3) Load PK, the saved claimed hash of h, and compare hashes.
    dropw dropw
    dupw
    padw loc_loadw_le.0
    assert_eqw.err="comparison failed: public key"
    # => [C, ptr, tau_inv_ptr, A_h(2), ...]

    # 4) Start the Falcon product transcript with the public-key commitment.
    padw
    swapw
    push.FALCON_PRODUCT_INIT_CV exec.eidos::merge_with_chaining_word
    padw padw
    # => [BLOCK_LO, BLOCK_HI, CV, ptr, tau_inv_ptr, A_h(2), ...]

    # 5) Load shifted s2' and accumulate its reversed evaluation at tau_inv

    ## a) Reset the accumulator, update the pointers and set up the state of the hasher
    push.0 movdn.14
    push.0 movdn.14
    # => [0(8), CV, ptr, tau_inv_ptr, 0, 0, A_h(2), ...]

    ## b) Load and evaluate shifted s2' at tau_inv
    repeat.64
        adv_pipe

        # check that all coefficients are less than Falcon prime
        # Assert borrow != 0 (r < M), then drop diff
        dupw.1
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop

        dupw
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        u32assert2
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop
        push.M u32overflowing_sub assert.err="comparison failed: modulus" drop

        horner_eval_base
        exec.eidos::compress
    end
    # => [BLOCK_LO, BLOCK_HI, CV, ptr, tau_inv_ptr, A_s2_shifted(2), A_h(2), ...]

    # 6) Load claimed h * s2 in Z_Q[x]

    ## a) Reset the accumulator, update the pointers and set up the state of the hasher
    push.0 movdn.14
    push.0 movdn.14
    # => [BLOCK_LO, BLOCK_HI, CV, ptr, tau_inv_ptr, 0, 0, A_s2_shifted(2), A_h(2), ...]

    repeat.128
        adv_pipe
        horner_eval_base
        exec.eidos::compress
    end
    # => [Y0, Y1, C, ptr, tau_inv_ptr, A_pi(2), A_s2_shifted(2), A_h(2), ...]

    # 7) Check that the challenge we computed the evaluations with is the correct one

    ## a) Clean up the stack
    dropw dropw
    # => [tau0(D), tau1(D), D[2], D[3], ptr, tau_inv_ptr, A_pi(2), A_s2_shifted(2), A_h(2), ...]

    ## b) Load from memory the challenge we got from the advice stack and assert equality between
    ##    the two challenges
    padw loc_loadw_le.8
    # => [tau0, tau1, 0, 0, tau0(D), tau1(D), D[2], D[3], ptr, tau_inv_ptr, A_pi(2), ...]
    movdn.3 movdn.3 drop drop
    # => [tau0, tau1, tau0(D), tau1(D), D[2], D[3], ptr, tau_inv_ptr, A_pi(2), ...]

    dup.2 assert_eq.err="comparison failed: tau"             # assert tau0 == tau0(D)
    dup.2 assert_eq.err="comparison failed: tau"             # assert tau1 == tau1(D)
    # => [tau0, tau1, D[2], D[3], ptr, tau_inv_ptr, A_pi(2), ...]

    movdn.5                     # move tau0 past D[2], D[3], ptr, tau_inv_ptr
    movdn.5                     # move tau1 past D[2], D[3], ptr, tau_inv_ptr
    loc_loadw_le.4              # load tau_inv over the word about to be dropped
    # => [tau_inv0, tau_inv1, 0, 0, tau0, tau1, A_pi(2), A_s2_shifted(2), A_h(2), ...]
    movdn.3 movdn.3 drop drop
    # => [tau_inv0, tau_inv1, tau0, tau1, A_pi(2), A_s2_shifted(2), A_h(2), ...]

    exec.assert_product_evaluation
end

# Checks A_pi * tau = A_h * (A_s2_shifted - M_HALF * U(tau_inv)), where
# U(x) = sum_{i=0}^{511} x^i. The caller must supply nonzero tau and tau_inv = tau^(-1).
# The A values are the reversed Horner evaluations described in load_h_s2_and_product.
# The shift correction is M_HALF * U(tau_inv), since tau^(-511) * U(tau) = U(tau_inv).
#
# Input: [tau_inv(2), tau(2), A_pi(2), A_s2_shifted(2), A_h(2), ...]
# Output: [...]
proc assert_product_evaluation(
    tau_inv: [felt; 2],
    tau: [felt; 2],
    product_eval: [felt; 2],
    s2_shifted_eval: [felt; 2],
    h_eval: [felt; 2],
)
    # Compute corr := -M_HALF * U(tau_inv). The factorization
    # U(x) = product_{k=0}^{8} (1 + x^{2^k}) avoids inverting x - 1 at x = 1.
    # Keep [p, s] = [x^{2^k}, U_{2^k}(x)] on the stack,
    # where U_n(x) = sum_{j=0}^{n-1} x^j.
    push.0.1 movdn.3 movdn.3
    # => [p0, p1, s0, s1, tau0, tau1, ...] where p = tau_inv and s = 1
    repeat.8
        dup.1 dup.1 add.1
        movup.5 movup.5 ext2mul
        # => [(s * (1 + p))(2), p(2), tau0, tau1, ...]
        movup.3 movup.3
        dup.1 dup.1 ext2mul
        # => [p^2(2), (s * (1 + p))(2), tau0, tau1, ...]
    end
    dup.1 dup.1 add.1
    movup.5 movup.5 ext2mul
    # => [U0, U1, p0, p1, tau0, tau1, ...] where U = U(tau_inv)
    movdn.3 movdn.3 drop drop
    # => [U0, U1, tau0, tau1, ...]
    mul.NEG_M_HALF swap mul.NEG_M_HALF swap
    # => [corr0, corr1, tau0, tau1, A_pi(2), A_s2_shifted(2), A_h(2), ...]

    # Correct the shifted s2 accumulator.
    movup.7 movup.7
    # => [A_s2_shifted(2), corr0, corr1, tau0, tau1, A_pi(2), A_h(2), ...]
    ext2add
    movdn.5 movdn.5
    # => [tau0, tau1, A_pi(2), A_s2(2), A_h(2), ...]

    ext2mul
    # => [LHS_0, LHS_1, A_s2(2), A_h(2), ...]

    movdn.5 movdn.5
    ext2mul
    # => [RHS_0, RHS_1, LHS_0, LHS_1, ...]

    movup.2
    assert_eq
    assert_eq
    # => [...]
end


# SQUARE NORM OF Z_M[x]/(phi) POLYNOMIALS
# =============================================================================================

#! Returns the square of the centered representative of e in [0, M).
#!
#! We use the following formula to do so:
#! normalize(e) = e^2 - phi * (2*M*e - M^2) where phi := (e > (M - 1)/2)
#!
#! The formula implements:
#!
#! if e > (M-1)/2:
#!   return (M - e)^2
#! else:
#!   return e^2
#!
#! The use of the formula avoids using the if-else block.
#!
#! Input: [e, ...]
#! Output [norm(e)^2, ...]
#!
#! Cycles: 20
pub proc norm_sq(coefficient: Coefficient) -> u32
    dup
    dup mul
    #=> [e^2, e, ...]

    push.M_HALF
    dup.2
    u32lt
    #=> [phi, e^2, e, ...]

    movup.2
    push.M_DOUBLE       # 2*M
    mul
    push.M_SQUARE       # M^2
    sub
    #=> [2*M*e - M^2, phi, e^2, ...]

    mul sub
    #=> [norm(e)^2, ...]
end

# Reduces c + shift modulo M for any Miden field element c and 0 < shift < 2 * J,
# where J = 512 * M^2. Replacing c with c_lo + c_hi * (2^32 mod M) preserves its residue
# modulo M and keeps the sum with shift below the Miden prime.
# Input: [c, shift, ...]
# Output: [r, ...], with r in [0, M)
proc reduce_shifted_sample(c: felt, shift: felt) -> Coefficient
    u32split swap mul.TWO_POW_32_MOD_M add
    add
    # => [Y, ...], with Y congruent to c + shift (mod M) and Y < 2^46

    u32split
    # => [Y_lo, Y_hi, ...], with Y_hi < 2^14

    # The U32DIV AIR range-checks quotient and remainder and enforces r < M.
    u32divmod.M
    # => [Y_lo mod M, q0, Y_hi, ...]
    movup.2 mul.TWO_POW_32_MOD_M add
    # => [Y_hi * TWO_POW_32_MOD_M + Y_lo mod M, q0, ...], with dividend < 2^28

    u32divmod.M
    # => [r, q1, q0, ...], with r in [0, M)
    movdn.2 drop drop
end

# Sums the squared centered residues of c_i + pi_hi_i - pi_lo_i for four matching lanes.
# Each product coefficient must satisfy |pi_i| <= 512 * (M - 1) * M_HALF.
# Thus J + M_HALF + pi_hi_i - pi_lo_i is in (0, 2 * J), where J = 512 * M^2.
# Input: [PI_HI(4), PI_LO(4), C(4), ...]
# Output: [norm, ...]
proc s1_norm_sq_word(pi_hi: word, pi_lo: word, c: word) -> SquaredNorm
    movup.4 sub add.J_PLUS_M_HALF movup.7
    exec.reduce_shifted_sample
    sub.M_HALF dup mul
    # => [e0, PI_HI(3), PI_LO(3), C(3), ...]

    swap movup.4 sub add.J_PLUS_M_HALF movup.6
    exec.reduce_shifted_sample
    sub.M_HALF dup mul add
    # => [e0 + e1, PI_HI(2), PI_LO(2), C(2), ...]

    swap movup.3 sub add.J_PLUS_M_HALF movup.4
    exec.reduce_shifted_sample
    sub.M_HALF dup mul add
    # => [e0 + e1 + e2, pi_hi3, pi_lo3, c3, ...]

    swap movup.2 sub add.J_PLUS_M_HALF movup.2
    exec.reduce_shifted_sample
    sub.M_HALF dup mul add
end


#! Compute the square norm of the polynomial s2 given a pointer to its coefficients.
#!
#! The coefficients are stored as s2'_i = s2_i + M_HALF in [0, M), as checked by
#! `load_h_s2_and_product`. The centered coefficient is s2'_i - M_HALF.
#!
#! Input: [s2_ptr, ...]
#! Output: [norm_sq(s2), ...]
#!
pub proc compute_s2_norm_sq(s2_ptr: ptr<StoredCoefficient>) -> SquaredNorm
    push.0 swap
    padw padw padw
    # => [0(12), s2_ptr, acc, ...]

    repeat.64
        mem_stream
        # => [S2_PRIME(8), 0(4), s2_ptr + 8, acc, ...]

        sub.M_HALF dup mul
        swap sub.M_HALF dup mul add
        swap sub.M_HALF dup mul add
        swap sub.M_HALF dup mul add
        swap sub.M_HALF dup mul add
        swap sub.M_HALF dup mul add
        swap sub.M_HALF dup mul add
        swap sub.M_HALF dup mul add
        # => [n, 0(4), s2_ptr + 8, acc, ...]

        movup.6 add movdn.5
        # => [0(4), s2_ptr + 8, acc + n, ...]

        padw padw
    end

    dropw dropw dropw drop
end


# FALCON SIGNATURE VERIFICATION ALGORITHM
# =============================================================================================

#! Verifies a Falcon signature against the public-key commitment PK and message word MSG.
#! PK is the Eidos Falcon commitment returned by `PublicKey::to_commitment()`.
#! The signature advice supplies the expanded key, shifted signature, claimed product, and nonce.
#!
#! The procedure returns when the public key hash, Fiat-Shamir product check, and
#! signature norm bound pass. The product check is probabilistic.
#!
#! Inputs:
#!   Operand stack: [PK, MSG, ...]
#!   Advice stack:  [SIGNATURE]
#! Outputs:
#!   Operand stack: [...]
#!   Advice stack:  [...]
#!
#! SIGNATURE = [tau1, tau0, h(512), s2'(512), pi(1024), nonce(8)],
#! where:
#! - tau = (tau0, tau1) is an element in the quadratic field extension at which the product relation
#!   between `h * s2 = pi` is checked.
#! - h_i are the coefficients of the expanded public key polynomial.
#! - s2'_i are the coefficients of the signature polynomial in the shifted representation
#!   s2'_i = s2_i + M_HALF, where s2_i is the centered representative of the i-th coefficient
#!   (see `load_h_s2_and_product`).
#! - pi_i are the coefficients of `h * s2` in Z_Q[x] where Q is the Miden VM prime and s2 is
#!   centered.
#! - nonce_i are field elements representing the nonce associated to the signature.
#!
@locals(2048)
pub proc verify(public_key: eidos::Digest, message: word)
    # 1) Load the public key polynomial h and the signature polynomial s2 and the product of
    # the two polynomials pi := h * s2 in Z_Q[x]. This checks that h hashes to PK and verifies
    # the product identity at a Fiat-Shamir challenge derived from PK, shifted s2, and pi.

    locaddr.0
    exec.load_h_s2_and_product
    #=> [MSG, ...]

    # 2) Load the NONCE from the advice provider. This is encoded as 8 field elements

    adv_pushw
    adv_pushw
    #=> [NONCE1, NONCE0, MSG, ...]
    swapw
    #=> [NONCE0, NONCE1, MSG, ...]

    # 3) Derive hash-to-point coefficients and accumulate the squared norm of s1 := c - h * s2
    # in Z_M[x]/(x^512 + 1), using the product stored at local offset 1024.

    movupw.2
    locaddr.1024
    exec.hash_to_point_s1_norm_sq
    #=> [norm_sq(s1), ...]

    # 4) Compute the squared norm of s2

    locaddr.512
    #=> [s2_ptr, norm_sq(s1), ...]

    exec.compute_s2_norm_sq
    #=> [norm_sq(s2), norm_sq(s1), ...]

    # 5) Check that ||(s1, s2)||^2 < K. Each centered coefficient has magnitude at most
    # M_HALF, so the sum is at most 1024 * M_HALF^2 < Q and cannot wrap in the field.

    add
    #=> [norm_sq(s1) + norm_sq(s2), ...]

    push.SQUARE_NORM_BOUND
    u32assert2 u32lt assert.err="comparison failed: norm bound"
    #=> [...]
end

# HELPERS
# =============================================================================================

#! Moves the signature from the advice map to the advice stack, where the signature is stored in
#! the hashmap at key `hash(PK || MSG)`, where `hash()` is the VM-native hash. The signature is
#! expected to be stored in reverse order, so that it gets pushed on the advice stack in the
#! correct order.
#!
#! Inputs:
#!   Operand stack: [PK, MSG, ...]
#!   Advice stack:  []
#!   Advice map: hash(PK || MSG) -> SIGNATURE
#! Outputs:
#!   Operand stack: [PK, MSG, ...]
#!   Advice stack:  [SIGNATURE]
pub proc move_sig_from_map_to_adv_stack(
    public_key: eidos::Digest,
    message: word,
) -> (eidos::Digest, word)
    dupw.1 dupw.1 hmerge
    #=> [hash(PK || MSG), PK, MSG, ...]

    adv.push_mapval dropw
    #=> [PK, MSG, ...]
    #=> advice stack: [SIGNATURE]
end
