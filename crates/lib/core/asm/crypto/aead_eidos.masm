#! Eidos authenticated encryption for Felt messages and associated data.
#!
#! Each plaintext Felt m is split as m = lo + 2^32 * hi. Encryption XORs the two u32 limbs with
#! the keystream and stores them as two Felts. The encrypted limbs cannot always be packed into
#! one Felt: their 64-bit value may exceed the Goldilocks modulus. A message of n Felts therefore
#! needs 2*n ciphertext Felts, plus a two-Felt authentication tag.
#!
#! Associated data is authenticated but not encrypted. Use a fresh nonce for each encryption
#! under the same key. The ciphertext and tag match Rust's Eidos expanded-ciphertext format.

mod primitives

pub use {Key, Nonce, Tag} from self::primitives

const MAX_AUTHENTICATED_INPUT_FELTS = 268435456
const DECRYPT_EVENT = event("miden::core::crypto::aead_eidos::decrypt")

#! Encrypts a Felt message and returns its authentication tag.
#!
#! Input:  [key(4), nonce(4), src_ptr, plaintext_len, dst_ptr, ...]
#! Output: [tag0, tag1, ...]
#!
#! Writes 2*plaintext_len ciphertext Felts at dst_ptr. The pointers must be word-aligned u32
#! values, and plaintext_len must fit in u32. Non-empty ranges must end below the local frame
#! without overflowing u32, and the destination must not overlap the plaintext.
#! The padded MAC input, including its nonce and lengths, must fit in 2^28 Felts.
#! Fails if these conditions are not met, before writing ciphertext.
#!
#! Invocation: exec
pub proc encrypt(
    key: Key, nonce: Nonce, source: ptr<felt>, plaintext_len: u32, destination: ptr<felt>,
) -> Tag
    push.0 movdn.10 push.0 movdn.10
    exec.encrypt_with_ad
end

#! Encrypts a Felt message and authenticates associated data.
#!
#! Input:  [key(4), nonce(4), src_ptr, plaintext_len, ad_ptr, ad_len, dst_ptr, ...]
#! Output: [tag0, tag1, ...]
#!
#! Writes 2*plaintext_len ciphertext Felts at dst_ptr. In addition to encrypt's requirements,
#! ad_ptr must be word-aligned and fit in u32, and ad_len must fit in u32. A non-empty AD range
#! must end below the local frame without overflowing u32. The destination must not overlap AD;
#! plaintext and AD may overlap each other. The padded MAC input
#! nonce(4) || AD || ciphertext || [ad_len, ciphertext_len] must fit in 2^28 Felts.
#! Fails if any range or length is invalid, before writing ciphertext.
#!
#! Invocation: exec
@locals(8)
pub proc encrypt_with_ad(
    key: Key, nonce: Nonce, source: ptr<felt>, plaintext_len: u32,
    associated_data: ptr<felt>, associated_data_len: u32, destination: ptr<felt>,
) -> Tag
    # loc[0..4] = [src_ptr, plaintext_len, ad_ptr, ad_len]; loc[4] = dst_ptr.
    # Key and nonce stay on the operand stack throughout encryption and authentication.
    movupw.2 loc_storew_le.0 dropw movup.8 loc_store.4
    loc_load.3 loc_load.1 exec.assert_message_lengths
    locaddr.0 loc_load.1 loc_load.0 exec.assert_range
    locaddr.0 loc_load.3 loc_load.2 exec.assert_range
    locaddr.0 loc_load.1 mul.2 loc_load.4 exec.assert_range
    loc_load.1 mul.2 loc_load.4 loc_load.1 loc_load.0 exec.assert_disjoint
    loc_load.1 mul.2 loc_load.4 loc_load.3 loc_load.2 exec.assert_disjoint

    dupw.1 dupw.1 exec.primitives::derive_ctr_key
    loc_load.1 push.0 loc_load.4 loc_load.0 swapw
    # => [K_CTR(4), src_ptr, dst_ptr, counter=0, plaintext_len, key(4), nonce(4), ...]
    exec.primitives::encrypt_felts_expanded
    dropw drop drop drop

    loc_load.1 mul.2 loc_load.4 loc_load.3 loc_load.2
    movupw.2 dupw movupw.3 exec.primitives::derive_mac_key
    # => [K_MAC(4), nonce(4), ad_ptr, ad_len, ct_ptr, ct_len, ...]
    exec.authenticate
end

#! Authenticates and decrypts a Felt message.
#!
#! Input:  [key(4), nonce(4), src_ptr, dst_ptr, plaintext_len, scratch_ptr, tag0, tag1, ...]
#! Output: [...]
#!
#! src_ptr addresses 2*plaintext_len ciphertext Felts; dst_ptr receives plaintext_len Felts.
#! scratch_ptr addresses 2*plaintext_len writable Felts for checking the plaintext witness.
#! All pointers must be word-aligned u32 values and plaintext_len must fit in u32.
#! Non-empty ranges must end below the local frame without overflowing u32 and must be disjoint.
#! The padded MAC input must fit in 2^28 Felts.
#!
#! The VM verifies the tag before requesting plaintext from the core-library event handler.
#! It then re-encrypts that witness into scratch and checks every ciphertext limb.
#! Register the core-library handlers with the host. Fails on invalid ranges, lengths, tags,
#! or plaintext witnesses; invalid ranges and tags are rejected before requesting advice.
#!
#! Invocation: exec
pub proc decrypt(
    key: Key, nonce: Nonce, source: ptr<felt>, destination: ptr<felt>,
    plaintext_len: u32, scratch: ptr<felt>, tag: Tag,
)
    push.0 movdn.12 push.0 movdn.12
    exec.decrypt_with_ad
end

#! Authenticates associated data and decrypts a Felt message.
#!
#! Input:  [key(4), nonce(4), src_ptr, dst_ptr, plaintext_len, scratch_ptr,
#!          ad_ptr, ad_len, tag0, tag1, ...]
#! Output: [...]
#!
#! Uses decrypt's memory and witness contract. ad_ptr must also be a word-aligned u32, and
#! ad_len must fit in u32. Non-empty AD must end below the local frame without overflowing u32
#! and must not overlap the destination or scratch. It may overlap the ciphertext.
#! The padded MAC input nonce(4) || AD || ciphertext || [ad_len, ciphertext_len] must fit in
#! 2^28 Felts. Fails on invalid ranges, lengths, tags, or plaintext witnesses.
#!
#! Invocation: exec
@locals(8)
pub proc decrypt_with_ad(
    key: Key, nonce: Nonce, source: ptr<felt>, destination: ptr<felt>,
    plaintext_len: u32, scratch: ptr<felt>, associated_data: ptr<felt>,
    associated_data_len: u32, tag: Tag,
)
    # loc[0..4] = [src_ptr, dst_ptr, plaintext_len, scratch_ptr]
    # loc[4..8] = [ad_ptr, ad_len, tag0, tag1]
    movupw.3 loc_storew_le.4 dropw movupw.2 loc_storew_le.0 dropw
    loc_load.5 loc_load.2 exec.assert_message_lengths
    locaddr.0 loc_load.2 mul.2 loc_load.0 exec.assert_range
    locaddr.0 loc_load.2 loc_load.1 exec.assert_range
    locaddr.0 loc_load.2 mul.2 loc_load.3 exec.assert_range
    locaddr.0 loc_load.5 loc_load.4 exec.assert_range

    loc_load.2 loc_load.1 loc_load.2 mul.2 loc_load.0 exec.assert_disjoint
    loc_load.2 mul.2 loc_load.3 loc_load.2 mul.2 loc_load.0 exec.assert_disjoint
    loc_load.2 loc_load.1 loc_load.2 mul.2 loc_load.3 exec.assert_disjoint
    loc_load.2 loc_load.1 loc_load.5 loc_load.4 exec.assert_disjoint
    loc_load.2 mul.2 loc_load.3 loc_load.5 loc_load.4 exec.assert_disjoint
    # => [key(4), nonce(4), ...]

    # Keep key and nonce for the plaintext witness check after authentication.
    dupw.1 dupw.1
    loc_load.2 mul.2 loc_load.0 loc_load.5 loc_load.4
    movupw.2 dupw movupw.3 exec.primitives::derive_mac_key
    exec.authenticate
    loc_load.6 assert_eq.err="AEAD tag mismatch"
    loc_load.7 assert_eq.err="AEAD tag mismatch"
    # => [key(4), nonce(4), ...]

    padw loc_loadw_le.0 movdnw.2
    # => [key(4), nonce(4), src_ptr, dst_ptr, plaintext_len, scratch_ptr, ...]
    emit.DECRYPT_EVENT
    movupw.2 exec.primitives::verify_plaintext
end

# Uses the aligned ciphertext stream when AD is empty.
# Input: [K_MAC(4), nonce(4), ad_ptr, ad_len, ct_ptr, ct_len, ...]
# Output: [tag0, tag1, ...]
proc authenticate(
    mac_key: Key, nonce: Nonce, ad_ptr: ptr<felt>, ad_len: u32,
    ct_ptr: ptr<felt>, ct_len: u32,
) -> Tag
    dup.9 eq.0
    if.true
        movup.8 drop movup.8 drop
        exec.primitives::auth_empty_ad_expanded_exact
    else
        exec.primitives::auth_expanded_exact
    end
end

# The nonce and length pair occupy six Felts. Since the limit is a multiple of eight,
# bounding the unpadded stream also bounds its zero-padded length.
# Input: [plaintext_len, ad_len, ...]. Output: [...].
proc assert_message_lengths(plaintext_len: u32, ad_len: u32)
    u32assert.err="AEAD plaintext length must fit in a u32"
    swap u32assert.err="AEAD associated-data length must fit in a u32"
    swap mul.2 add add.6 push.MAX_AUTHENTICATED_INPUT_FELTS lte
    assert.err="AEAD authentication input exceeds its supported length"
end

# Checks a word-aligned u32 pointer and, for a non-empty range, its inclusive last address.
# Input: [ptr, len, local_start, ...]. Output: [...].
proc assert_range(ptr: ptr<felt>, len: u32, local_start: ptr<felt>)
    u32assert.err="AEAD pointer must fit in a u32"
    dup u32mod.4 assertz.err="AEAD pointer must be word-aligned"
    dup.1 neq.0
    if.true
        swap sub.1 u32overflowing_add
        assertz.err="AEAD memory range exceeds the u32 address space"
        u32gt assert.err="AEAD memory ranges must stay below the local frame"
    else
        drop drop drop
    end
end

# Validated ranges may meet at their endpoints. Empty ranges never overlap.
# Input: [a_ptr, a_len, b_ptr, b_len, ...]. Output: [...].
proc assert_disjoint(a_ptr: ptr<felt>, a_len: u32, b_ptr: ptr<felt>, b_len: u32)
    dup.1 neq.0 dup.4 neq.0 and
    if.true
        dup dup.2 add dup.3 lte movdn.4
        movup.2 movup.3 add swap lte
        swap drop or assert.err="AEAD memory ranges must not overlap"
    else
        dropw
    end
end
