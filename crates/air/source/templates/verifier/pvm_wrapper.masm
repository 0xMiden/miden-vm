    dup.1
    assert_eq.err="AIR log height must equal the relation's fixed height"
    dup
    dup.2
    mem_store
    movup.2
    u32max
    swap
    add.1
end

#! Preserve the relation-specific order of shape validation errors.
proc assert_shape_log(height: felt, min_log_height: u8) -> u8
    u32assert.err="AIR log height must be u32"
    dup
    u32lte.LOG_HEIGHT_MAX
    assert.err="AIR log height above maximum"
    dup.1
    dup.1
    u32lte
    assert.err="AIR log height below relation minimum"
    swap
    drop
end

