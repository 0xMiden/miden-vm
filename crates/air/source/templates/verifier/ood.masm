#! Generated by miden-air-source. {{ p.input.regeneration_command }}
#! Absorb in wire order and scatter each segment into its canonical AIR slot.

# preprocessed: {% for width in p.input.geometry.preprocessed %}{{ width }}{% if !loop.last %} + {% endif %}{% endfor %} = {{ p.deep.groups[0].width }} scalar evaluations
# main: {% for width in p.input.geometry.main %}{{ width }}{% if !loop.last %} + {% endif %}{% endfor %} = {{ p.deep.groups[1].width }} scalar evaluations
# aux: {% for width in p.input.geometry.aux_coordinates %}{{ width }}{% if !loop.last %} + {% endif %}{% endfor %} = {{ p.deep.groups[2].width }} scalar evaluations
# quotient: {{ p.input.geometry.quotient_coordinates }} scalar evaluations
# One row contains {{ p.ood.row_felts }} felts, read as {{ p.ood.row_blocks }} adv_pipe blocks.

use {LOG_AIR_TRACE_LENGTHS_PTR} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::sys::{{ p.relation_name }}::layout

const NUM_AIRS = {{ p.num_airs }}

{%- for helper in p.ood.helpers %}
proc pipe_{{ helper.blocks }}
    repeat.{{ helper.blocks }}
        adv_pipe
        horner_eval_ext
        compress
    end
end

{%- endfor %}
{%- include "verifier/proof_order.masm" %}

#! Dispatch pairs contain a canonical offset and the address of a digest word.
pub proc stage_ood_scatter_table()
    exec.layout::ood_scatter_table_ptr
{%- for helper in p.ood.helpers %}
    procref.pipe_{{ helper.blocks }}
    dup.4 add.{{ helper.digest_offset }} mem_storew_le dropw
{%- endfor %}
    exec.layout::proof_order_positions_ptr
{%- for air in p.ood.air_dispatch %}
    dup
{%- if air.id > 0 %}
    add.{{ air.id }}
{%- endif %}
    mem_load mul.2 dup.2 add
{%- for entry in air.entries %}
    push.{{ entry.destination }} dup.1 add.{{ entry.pair_offset }} mem_store
    dup.2 add.{{ entry.digest_offset }} dup.1 add.{{ entry.digest_pointer_offset }} mem_store
{%- endfor %}
    drop
{%- endfor %}
    drop drop
end

#! Consume one OOD row in preprocessed, main, auxiliary and quotient wire order.
#! Require a staged scatter table; update Eidos and extension Horner state while storing evaluations canonically.
#! Addresses and offsets count base felts; each scalar evaluation occupies two felts.
#! Return the stream pointer at row base plus the full row length and preserve caller values below the state frame.
pub proc process_row_ood_evaluations(
    state: types::EidosState,
    evaluation: types::HornerState,
) -> (types::EidosState, types::HornerState)
    dup.12 exec.layout::ood_scatter_table_ptr mem_store
{%- for group in p.ood.row_groups %}
{%- match group %}
{%- when RowGroup::Sole with { destination, blocks } %}
    exec.layout::ood_scatter_table_ptr mem_load
{%- if *destination > 0 %}
    add.{{ destination }}
{%- endif %}
    swap.13 drop
    exec.pipe_{{ blocks }}
{%- when RowGroup::Full with { calls } %}
{%- for call in calls %}
    exec.layout::ood_scatter_table_ptr
    dup add.{{ call.pair_offset }} mem_load
    swap mem_load add swap.13 drop
    exec.layout::ood_scatter_table_ptr add.{{ call.digest_pointer_offset }} mem_load
    dynexec
{%- endfor %}
{%- endmatch %}
{%- endfor %}
    exec.layout::ood_scatter_table_ptr mem_load add.{{ p.ood.row_felts }} swap.13 drop
end

