#! Generated shared DEEP query authentication. Trusted setup pointer/depth are explicit parameters.
use {AUX_TRACE_COM_PTR, COMPOSITION_POLY_COM_PTR, MAIN_TRACE_COM_PTR, TMP2_PTR, TMP3_PTR} from miden::core::stark::constants
use miden::core::stark::types
use miden::core::stark::deep_queries
use miden::core::sys::verifier::parameters
{% include "verifier/shared_parameter_imports.masm" %}
const PREPROCESSED_INDEX_MASK = 524287
const PREPROCESSED_LEAF_VALUE_MISMATCH = "preprocessed query leaf hash mismatch"
const MAIN_LEAF_VALUE_MISMATCH = "main query leaf hash mismatch"
const AUX_LEAF_VALUE_MISMATCH = "aux query leaf hash mismatch"
const QUOTIENT_LEAF_VALUE_MISMATCH = "quotient query leaf hash mismatch"
#! Authenticate each row before generic DEEP evaluation.
pub proc compute_deep_composition_polynomial_queries( scratch: word, query_ptr: ptr<word>, query_end_ptr: ptr<word>, fixed_terms: types::EvaluationPair, queries_start: ptr<word>, )
    push.1
    while.true
        exec.load_query_row
        exec.deep_queries::compute_deep_query
    end
    dropw
    dropw
    drop
    drop
    drop
end

#! Preserve preprocessed, main, auxiliary and quotient opening order.
proc load_query_row( scratch: word, query_ptr: ptr<word>, ) -> (word, types::EvaluationPair, u32, ptr<word>)
    exec.process_preprocessed_trace
    exec.process_main_trace
    exec.process_aux_trace
    exec.process_quotient_trace
    swapw
    drop
    drop
    dup.1
    dup.1
    swapw
end

proc process_preprocessed_trace( scratch: word, query_ptr: ptr<word>, ) -> (word, types::HornerState, u8, u32, ptr<word>)
    dup.4
    mem_loadw_le
    movdn.3
    movdn.2
    push.0.0
    exec.parameters::preprocessed_com_ptr
    mem_loadw_le
    dup.5
    push.PREPROCESSED_INDEX_MASK
    u32and
    mem_load.PREPROCESSED_DEPTH
    mtree_get
    mem_storew_le.TMP3_PTR
    adv.push_mapval
    mem_loadw_le.TMP2_PTR
    swapw
    padw mem_loadw_le.PREPROCESSED_LEAF_CV
    swapw
    padw
    push.PREPROCESSED_BASE_PIPE dynexec
    swapw.2
    padw
    mem_loadw_le.TMP3_PTR
    assert_eqw.err=PREPROCESSED_LEAF_VALUE_MISMATCH
    dropw
end



proc process_main_trace( scratch: word, evaluation: types::HornerState, depth: u8, index: u32, query_ptr: ptr<word>, ) -> (word, types::HornerState, u8, u32, ptr<word>)
    mem_loadw_le.MAIN_TRACE_COM_PTR
    dup.9
    dup.9
    mtree_get
    mem_storew_le.TMP3_PTR
    adv.push_mapval
    dropw
    padw mem_loadw_le.MAIN_LEAF_CV
    swapw
    padw
    push.MAIN_BASE_PIPE dynexec
    swapw.2
    padw
    mem_loadw_le.TMP3_PTR
    assert_eqw.err=MAIN_LEAF_VALUE_MISMATCH
    dropw
end



proc process_aux_trace( scratch: word, evaluation: types::HornerState, depth: u8, index: u32, query_ptr: ptr<word>, ) -> (word, types::HornerState, u8, u32, ptr<word>)
    mem_loadw_le.AUX_TRACE_COM_PTR
    dup.9
    dup.9
    mtree_get
    mem_storew_le.TMP3_PTR
    adv.push_mapval
    dropw
    padw mem_loadw_le.AUX_LEAF_CV
    swapw
    padw
    push.AUX_BASE_PIPE dynexec
    swapw.2
    padw
    mem_loadw_le.TMP3_PTR
    assert_eqw.err=AUX_LEAF_VALUE_MISMATCH
    dropw
end



proc process_quotient_trace( scratch: word, evaluation: types::HornerState, depth: u8, index: u32, query_ptr: ptr<word>, ) -> (word, types::HornerState, u32, ptr<word>)
    mem_loadw_le.COMPOSITION_POLY_COM_PTR
    dup.9
    movup.9
    mtree_get
    mem_storew_le.TMP3_PTR
    adv.push_mapval
    dropw
    padw mem_loadw_le.QUOTIENT_LEAF_CV
    swapw
    padw
    push.QUOTIENT_BASE_PIPE dynexec
    swapw.2
    padw
    mem_loadw_le.TMP3_PTR
    assert_eqw.err=QUOTIENT_LEAF_VALUE_MISMATCH
    dropw
end

