#! Generated by miden-air-source. {{ p.input.regeneration_command }}
#! Authenticate the accepted ACE stream before evaluating constraints.

use miden::core::crypto::hashes::eidos
use { CONSTRAINT_COMPOSITION_COEFS_PTR, LOG_AIR_TRACE_LENGTHS_PTR, PUBLIC_INPUTS_ADDRESS_PTR, } from miden::core::stark::constants
use miden::core::stark::constraints_eval_inputs
use miden::core::sys::{{ p.relation_name }}::layout

const NUM_INPUTS_CIRCUIT = {{ p.input.circuit.encoded_read_count }}
const NUM_EVAL_GATES_CIRCUIT = {{ p.input.circuit.eval_gate_count }}
const MAX_CYCLE_LEN_LOG = {{ p.input.circuit.max_cycle_log }}
const NUM_AIRS = {{ p.num_airs }}
const ACE_STREAM_BLOCKS = {{ p.stream_blocks }}
{%- for limb in p.input.circuit.stream_initial_cv %}
const ACE_STREAM_INIT_CV_{{ loop.index0 }} = {{ limb }}
{%- endfor %}
const QUOTIENT_SHIFT_RATIO = {{ p.input.quotient.shift_ratio }}
const QUOTIENT_FIRST_SHIFT = {{ p.input.quotient.first_shift }}
const QUOTIENT_FIRST_WEIGHT = {{ p.input.quotient.first_weight }}
{%- for limb in p.input.circuit.digest %}
const ACE_CIRCUIT_DIGEST_{{ loop.index0 }} = {{ limb }}
{%- endfor %}
const ERR_CIRCUIT_DIGEST_MISMATCH = "ACE circuit stream does not match the compiled-in circuit digest"

#! Stage auxiliary inputs and canonical AIR fold coefficients, then authenticate and evaluate the ACE circuit.
#! Require staged proof-order maps and verifier memory context; authenticate against the compiled-in digest before evaluation.
#! The logical stack is empty on entry and return.
pub proc execute_constraint_evaluation_check()
    push.QUOTIENT_SHIFT_RATIO
    push.QUOTIENT_FIRST_SHIFT
    push.QUOTIENT_FIRST_WEIGHT
    exec.layout::auxiliary_ace_inputs_ptr
    push.LOG_AIR_TRACE_LENGTHS_PTR
    push.NUM_AIRS
    push.MAX_CYCLE_LEN_LOG
    exec.constraints_eval_inputs::set_up_auxiliary_inputs_ace
    exec.stage_air_fold_coefficients
    exec.load_and_authenticate_ace_circuit
    push.NUM_EVAL_GATES_CIRCUIT
    push.NUM_INPUTS_CIRCUIT
    mem_load.PUBLIC_INPUTS_ADDRESS_PTR
    eval_circuit
    drop drop drop
end

proc load_and_authenticate_ace_circuit
    push.ACE_CIRCUIT_DIGEST_3.ACE_CIRCUIT_DIGEST_2.ACE_CIRCUIT_DIGEST_1.ACE_CIRCUIT_DIGEST_0
    adv.push_mapval
    exec.layout::ace_circuit_stream_ptr
    push.ACE_STREAM_INIT_CV_3.ACE_STREAM_INIT_CV_2.ACE_STREAM_INIT_CV_1.ACE_STREAM_INIT_CV_0
    padw padw
    repeat.ACE_STREAM_BLOCKS
        adv_pipe
        exec.eidos::compress
    end
    exec.eidos::digest
    movup.4 drop
    assert_eqw.err=ERR_CIRCUIT_DIGEST_MISMATCH
end

#! Stage beta^(N-1-p) into the canonical AIR slot named by proof position p.
proc stage_air_fold_coefficients
    exec.layout::proof_order_ids_ptr
    exec.layout::auxiliary_ace_inputs_ptr
    add.{{ p.layout.fold_coefficient_felt_offset }}
    padw
    mem_loadw_le.CONSTRAINT_COMPOSITION_COEFS_PTR
    drop drop
    push.0.1
{%- for position in p.fold_positions %}
    dup.5
{%- if *position > 0 %}
    add.{{ position }}
{%- endif %}
    mem_load
    mul.2
    dup.5 add
    dup.2 dup.2 dup.2
    mem_store
    swap add.1 mem_store
{%- if *position > 0 %}
    dup.3 dup.3 ext2mul
{%- endif %}
{%- endfor %}
    drop drop drop drop drop drop
end

