# Dynamic exec preserves two surrounding exec callers and unwinds one at a time.
# RUN: compile-masm %S/call_frames_dynexec.masm -o %t.masp
# RUN: miden-debug --commands %s %t.masp -- 5 2>&1 | filecheck %s --implicit-check-not 'error:'

break for mul
continue
backtrace
delete 0
finish
backtrace
finish
backtrace
finish
backtrace
continue
stack

# CHECK: Backtrace (4 frames):
# CHECK-NEXT: * #0 $exec::inner at {{.*}}call_frames_dynexec.masm:2:12
# CHECK-NEXT: #1 [inferred] $exec::middle
# CHECK-NEXT: #2 [inferred] $exec::outer
# CHECK-NEXT: #3 $exec::$main
# CHECK: Backtrace (3 frames):
# CHECK-NEXT: * #0 [inferred] $exec::middle
# CHECK-NEXT: #1 [inferred] $exec::outer
# CHECK-NEXT: #2 $exec::$main
# CHECK: Backtrace (2 frames):
# CHECK-NEXT: * #0 [inferred] $exec::outer
# CHECK-NEXT: #1 $exec::$main
# CHECK: Backtrace (1 frames):
# CHECK-NEXT: * #0 $exec::$main
# CHECK: Program terminated successfully
# CHECK-NEXT: Operand Stack (16 elements):
# CHECK-NEXT: > [0] 39 (0x27)
