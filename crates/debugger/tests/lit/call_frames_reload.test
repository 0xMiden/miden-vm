# Reload must discard the previous invocation chain and rebuild it on execution.
# RUN: compile-masm %S/call_frames.masm -o %t.masp
# RUN: miden-debug --commands %s %t.masp -- 5 2>&1 | filecheck %s --implicit-check-not 'error:'

break for mul
continue
backtrace
reload
backtrace
continue
backtrace
delete
finish
backtrace
continue
stack

# CHECK: Backtrace (3 frames):
# CHECK-NEXT: * #0 [inferred] $exec::inner
# CHECK-NEXT: #1 [inferred] $exec::outer
# CHECK-NEXT: #2 $exec::$main
# CHECK: Program reloaded
# CHECK-NEXT: No call stack
# CHECK: Backtrace (3 frames):
# CHECK-NEXT: * #0 [inferred] $exec::inner at {{.*}}call_frames.masm:2:12
# CHECK-NEXT: #1 [inferred] $exec::outer
# CHECK-NEXT: #2 $exec::$main
# CHECK: Backtrace (2 frames):
# CHECK-NEXT: * #0 [inferred] $exec::outer at {{.*}}call_frames.masm:8:5
# CHECK-NEXT: #1 $exec::$main
# CHECK: Program terminated successfully
# CHECK-NEXT: Operand Stack (16 elements):
# CHECK-NEXT: > [0] 26 (0x1a)
